---
/**
 * 가이드 글(설명형 콘텐츠) 공통 레이아웃.
 *
 * head(BaseHead/ClarityHead/AdSenseHead)·SiteHeader·SiteFooter·
 * <Disclaimer variant="guide" />를 여기서 한 번만 배선하고, 각 글은
 * <GuideLayout title={title} description={description}>에 <h1>부터
 * CTA까지 본문만 slot으로 넘긴다. Disclaimer는 이 레이아웃이 </main>
 * 직전에 자동으로 넣으므로 글 쪽에서 다시 쓰지 않는다.
 *
 * 본문 안의 .ad-slot 위치·개수는 글마다 다르므로 레이아웃이 강제하지
 * 않고, 각 글의 slot 콘텐츠 안에 그대로 둔다.
 */
import BaseHead from "../components/BaseHead.astro";
import ClarityHead from "../components/ClarityHead.astro";
import AdSenseHead from "../components/AdSenseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Disclaimer from "../components/Disclaimer.astro";
import RelatedContent from "../components/RelatedContent.astro";
import NextReads from "../components/NextReads.astro";
import ArticleThumb from "../components/ArticleThumb.astro";
import ArticleMeta from "../components/ArticleMeta.astro";
import ShareButtons from "../components/ShareButtons.astro";
import Toc from "../components/Toc.astro";
import { ogPathFor } from "../lib/og-pages";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** 원문 확인일(YYYY-MM-DD). 상단 메타의 "기준" 날짜로 표시 */
  updated: string;
}

const { title, description, updated } = Astro.props;
const path = Astro.url.pathname;

/**
 * Article 구조화 데이터.
 *
 * AI 검색이 인용할 때 "누가 언제 확인한 숫자인가"를 묻는다. 그 답이
 * 페이지 안에만 문장으로 있으면 기계가 못 읽는다 — dateModified 와
 * 출처 기관을 여기서 명시한다. updated 는 rates 의 원문 확인일이라
 * 지어낸 날짜가 아니다.
 */
const siteUrl = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: "ko",
  url: `${siteUrl}${path}`,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${siteUrl}${path}` },
  dateModified: updated,
  image: new URL(ogPathFor(path), Astro.site).href,
  author: { "@type": "Organization", name: "주포켓", url: siteUrl },
  publisher: { "@type": "Organization", name: "주포켓", url: siteUrl },
  isAccessibleForFree: true,
  citation: [
    { "@type": "Organization", name: "국세청", url: "https://www.nts.go.kr/" },
    { "@type": "Organization", name: "국민연금공단", url: "https://www.nps.or.kr/" },
    { "@type": "WebSite", name: "국가법령정보센터", url: "https://www.law.go.kr/" },
  ],
};
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <AdSenseHead />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <SiteHeader />
    <main class="guide-main">
      <article class="guide-body">
        <ArticleThumb path={path} title={title} />
        <ArticleMeta path={path} updated={updated} />
        <ShareButtons title={title} />
        <Toc variant="inline" />
        <slot />
        <NextReads path={path} />
        <Disclaimer variant="guide" />
      </article>
      <div class="guide-side">
        <Toc variant="side" />
        <RelatedContent path={path} />
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
