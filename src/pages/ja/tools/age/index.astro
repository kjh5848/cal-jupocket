---
/**
 * 満年齢計算 — 일본어판 만 나이(/ja/tools/age/). 한국어판 /tools/age/ 와 계산(lib/age.ts)·스크립트(scripts/age.ts)를
 * 같이 쓰고, 문장은 일본어로 새로 썼다(번역 아님). 학년은 일본 제도라 lib/jp/school-grade.ts 에 따로 뒀다.
 *
 * 소제목은 일본 구글 자동완성에서 왔다(keywords/ja-age-2026-10-19.csv):
 *   年齢計算に関する法律 誕生日の前日·民法143条 / 数え年 計算方法 / 年齢計算 学年·早見表 学年 /
 *   年齢 早見表 2026·西暦 / 年齢計算 エクセル·関数 / 満年齢 計算 赤ちゃん·月·週
 * 和暦·干支·厄年 축은 넣지 않았다 — 元号 정령·干支·厄年 은 허용 출처 원문을 확인하지 못했다.
 * 원문(e-Gov 法令API, 2026-10-19): 年齢計算ニ関スル法律 · 民法 第143条 · 年齢のとなえ方に関する法律 ·
 * 学校教育法 第17条 · 学校教育法施行規則 第59条.
 */
import BaseHead from "../../../../components/BaseHead.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import ClarityHead from "../../../../components/ClarityHead.astro";
import GtagHead from "../../../../components/GtagHead.astro";
import TrackLinks from "../../../../components/TrackLinks.astro";
import AdSenseHead from "../../../../components/AdSenseHead.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import "../../../../styles/global.css";
import { toDay } from "../../../../lib/date-calc";
import { age } from "../../../../lib/age";
import { labelJa } from "../../../../lib/date-format-ja";
import { schoolGrade, elementaryEntryYear } from "../../../../lib/jp/school-grade";

const title = "年齢計算 — 生年月日から満年齢・数え年・学年をすぐ計算";
const description =
  "生年月日を入れると、今日時点の満年齢を何歳何か月何日まで表示します。数え年、今年の誕生日で何歳になるか、赤ちゃんの月齢、生まれてからの日数、小学校・中学校の学年もいっしょに出します。";

const BASE = "2026-10-19";
const BIRTH = "1996-03-15";
const base = toDay(BASE)!;
const a0 = age(toDay(BIRTH)!, base)!;
const g0 = schoolGrade(toDay(BIRTH)!, base);
const stage0 =
  g0.stage === "preschool"
    ? "小学校入学前"
    : g0.stage === "elementary"
      ? `小学${g0.grade}年生`
      : g0.stage === "junior"
        ? `中学${g0.grade}年生`
        : "中学校卒業後";
const fmt = (n: number) => n.toLocaleString("ja-JP");

// 본문 예시 — 숫자는 계산 함수로
const apr1 = toDay("2019-04-01")!;
const apr2 = toDay("2019-04-02")!;
const entry1 = elementaryEntryYear(apr1);
const entry2 = elementaryEntryYear(apr2);
const leap = toDay("2008-02-29")!;
const leapEve = toDay("2027-02-28")!;
const leapDay = toDay("2027-03-01")!;
const leapBefore = age(leap, leapEve)!;
const leapAfter = age(leap, leapDay)!;
const babyBirth = toDay("2026-01-31")!;
const babyBase = toDay("2026-03-01")!;
const baby = age(babyBirth, babyBase)!;

const YEAR = 2026;
const rows = Array.from({ length: 101 }, (_, i) => YEAR - i);
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>年齢計算 — 満年齢・数え年・学年</h1>
      <p>
        生年月日を入れると、今日時点の満年齢がすぐに出ます。ほかの日の年齢を知りたいときは基準日を変えてください。数え年や小学校・中学校の学年も同じ入力から計算します。
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="birth">生年月日</label>
          <input type="date" id="birth" value={BIRTH} max="2100-12-31" />
        </div>
        <div class="calc-input-wrap">
          <label for="base">基準日（ふつうは今日）</label>
          <input type="date" id="base" value={BASE} />
          <div class="ux-presets" role="group" aria-label="基準日を選ぶ">
            <button type="button" data-preset="today">今日</button>
            <button type="button" data-preset="april">次の4月1日</button>
            <button type="button" data-preset="newyear">来年の元日</button>
          </div>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">{labelJa(base)}時点</p>
          <p class="big" id="hero-value">満{a0.years}歳</p>
          <p class="hint" id="hero-sub">{a0.years}歳{a0.months}か月{a0.days}日 · 次の誕生日まであと{fmt(a0.daysToNext)}日</p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          <div class="stat-chip">
            <span class="label">今年の誕生日で</span>
            <span class="value" id="v-year">{a0.yearAge}歳</span>
          </div>
          <div class="stat-chip">
            <span class="label">数え年</span>
            <span class="value" id="v-korean">{a0.koreanAge}歳</span>
          </div>
          <div class="stat-chip">
            <span class="label">月数</span>
            <span class="value" id="v-months">{fmt(a0.totalMonths)}か月</span>
          </div>
          <div class="stat-chip">
            <span class="label">生まれてから</span>
            <span class="value" id="v-lived">{fmt(a0.livedDays)}日（{fmt(Math.floor(a0.livedDays / 7))}週{a0.livedDays % 7}日）</span>
          </div>
          <div class="stat-chip">
            <span class="label" id="l-next">次の誕生日（{a0.nextAge}歳）</span>
            <span class="value" id="v-next">{labelJa(a0.next)}</span>
          </div>
          <div class="stat-chip">
            <span class="label">学年（基準日時点）</span>
            <span class="value" id="v-grade">{stage0}</span>
          </div>
          <div class="stat-chip">
            <span class="label">小学校入学</span>
            <span class="value" id="v-entry">{g0.elementaryEntry}年4月</span>
          </div>
        </div>
        <p class="hint" id="note"></p>

        <div class="actions">
          <button id="btn-download" type="button">画像で保存</button>
          <button id="btn-share" type="button" class="secondary">共有</button>
        </div>
      </div>

      <h2>満年齢の計算方法 — 誕生日の前日に年をとる？</h2>
      <p>
        満年齢は、生まれた日を0歳として、誕生日が来るたびに1歳ずつ増やす数え方です。年齢計算に関する法律は、年齢を<strong>出生の日から起算</strong>し、民法 第143条を準用すると定めています。
        民法 第143条 第2項では、年で定めた期間は起算日に応当する日の<strong>前日に満了</strong>します。生まれた日を1日目として数えるので、1年は誕生日の前日の終わりで満了します。
      </p>
      <p>
        つまり法律の上では「誕生日の前日が終わる瞬間」に1つ年をとります。ふだんの会話や書類では誕生日の当日から新しい年齢として扱うので、この計算機も誕生日の当日から1つ上の年齢を表示します。前日と当日の違いが効いてくるのは、次の学年の区切りのように「満◯歳に達した日」が条文に出てくる場面です。
      </p>

      <h2>数え年の計算方法</h2>
      <p>
        数え年は、生まれた年を1歳とし、元日（1月1日）が来るたびに1歳ずつ加える昔からの数え方です。計算は<strong>基準日の年 − 生まれた年 + 1</strong>で、誕生日は関係ありません。
        年齢のとなえ方に関する法律（昭和24年）は、数え年で言い表す従来のならわしを改め、満年齢（1年に達しないときは月数）で言い表すように定めています。国や地方公共団体が年齢を言い表すときも満年齢です。
      </p>
      <p>
        「今年の誕生日で」は<strong>今年 − 生まれた年</strong>で、今年の誕生日を迎えたあとの満年齢です。誕生日がまだなら、今の満年齢はこれより1つ下です。
      </p>

      <h2>学年の計算 — 4月1日生まれと4月2日生まれ</h2>
      <p>
        学校教育法 第17条は、子が<strong>満六歳に達した日の翌日以後における最初の学年の初め</strong>から小学校に就学させると定めています。小学校の学年は4月1日に始まり、翌年3月31日に終わります（学校教育法施行規則 第59条）。
      </p>
      <p>
        上の数え方では、6歳に「達する」のは6歳の誕生日の前日です。4月1日生まれは3月31日に満6歳に達するので、翌日の4月1日がちょうど最初の学年の初めになります。
        たとえば{labelJa(apr1)}生まれは{entry1}年4月、1日違いの{labelJa(apr2)}生まれは{entry2}年4月に小学校へ入学します。1月1日から4月1日までに生まれた人は、同じ年の4月2日以降に生まれた人より1つ上の学年です。
      </p>
      <p class="hint">学年の欄は、6年で小学校を、3年で中学校を修了した場合の学年です。中学校卒業後の学年は計算していません。</p>

      <h2>年齢早見表（<span id="hayami-year">{YEAR}</span>年）</h2>
      <p>生まれ年（西暦）ごとに、基準日の年に誕生日を迎えたあと・迎える前の満年齢と数え年をまとめました。基準日を変えると、その年の表に変わります。</p>
      <details>
        <summary>早見表を開く（101年分）</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>生まれ年</th><th>誕生日を迎えたあと</th><th>誕生日の前</th><th>数え年</th></tr>
            </thead>
            <tbody id="hayami-body">
              {rows.map((by) => (
                <tr><td>{by}年</td><td>{YEAR - by}歳</td><td>{YEAR - by === 0 ? "—" : `${YEAR - by - 1}歳`}</td><td>{YEAR - by + 1}歳</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>

      <h2>エクセルで年齢を計算する関数</h2>
      <p>
        エクセルでは <code>DATEDIF</code> 関数で満年齢を出せます。A1に生年月日を入れて <code>=DATEDIF(A1,TODAY(),"Y")</code> と書くと、今日時点の満年齢です。
        端数の月数は <code>"YM"</code>、端数の日数は <code>"MD"</code> に変えます。基準日を決めたいときは <code>TODAY()</code> の代わりにその日付のセルを入れてください。
      </p>

      <details>
        <summary>赤ちゃんの月齢・生まれて何週かは？</summary>
        <p>
          1歳になるまでは「◯か月」で表示します。年齢のとなえ方に関する法律も、1年に達しないときは月数で言い表すとしています。生まれてからの日数と、それを7で割った週数は「生まれてから」の欄に出ます。
          月末生まれは、応当する日がない月は月末で1か月が満了します（民法 第143条 第2項ただし書）。たとえば{labelJa(babyBirth)}生まれは{labelJa(babyBase)}に{baby.totalMonths}か月です。
        </p>
      </details>

      <details>
        <summary>2月29日生まれは、平年はいつ年をとりますか？</summary>
        <p>
          平年は2月29日がないので、民法 第143条 第2項ただし書により2月28日で1年が満了し、3月1日から1つ上の年齢として表示します。
          たとえば{labelJa(leap)}生まれは、{labelJa(leapEve)}は満{leapBefore.years}歳、{labelJa(leapDay)}は満{leapAfter.years}歳です。うるう年は2月29日の当日です。
        </p>
      </details>

      <details>
        <summary>和暦（令和・平成など）で入れられますか？</summary>
        <p>生年月日は西暦で入れてください。このページは和暦の入力・表示には対応していません。</p>
      </details>

      <p>
        2つの日付の間の日数は<a href="/ja/tools/date-diff/">日数計算・日付計算</a>、誕生日まであと何日かは<a href="/ja/tools/dday/">あと何日・カウントダウン</a>で数えられます。
      </p>

      <p>
        出典：<a href="https://laws.e-gov.go.jp/law/135AC1000000050" rel="noopener">年齢計算ニ関スル法律（明治三十五年法律第五十号）</a> ·
        <a href="https://laws.e-gov.go.jp/law/129AC0000000089" rel="noopener">民法（明治二十九年法律第八十九号）第143条</a> ·
        <a href="https://laws.e-gov.go.jp/law/324AC0100000096" rel="noopener">年齢のとなえ方に関する法律（昭和二十四年法律第九十六号）</a> ·
        <a href="https://laws.e-gov.go.jp/law/322AC0000000026" rel="noopener">学校教育法 第17条</a> ·
        <a href="https://laws.e-gov.go.jp/law/322M40000080011" rel="noopener">学校教育法施行規則 第59条</a> — e-Gov法令検索（2026年10月19日確認）
      </p>

      <AdSlot label="age-result-ja" />
    </main>
    <SiteFooter />
    <script src="../../../../scripts/age.ts"></script>
    <TrackLinks />
    <script src="../../../../scripts/calc-ui.ts"></script>
  </body>
</html>
