---
/**
 * 프로필 링크 허브 — 인스타 바이오에서 들어오는 사람이 착지하는 곳.
 *
 * 카드가 "더 자세한 내용은 13번 글" 이라고 지목하면 여기서 13번을 눈으로
 * 찾아 누른다. 그래서 번호가 먼저 읽히고, 19개를 스크롤 한 번에 훑을 수
 * 있어야 한다. 번호는 data/linkhub.ts 가 고정한다 — 이미 발행된 카드가
 * 가리키므로 바뀌면 안 된다.
 *
 * 링크트리·리틀리 관습대로 큼직한 버튼을 쓴다. 다만 줄마다 색 배지를 다는
 * 대신 색은 묶음 제목의 점에만 쓴다 — 19줄이 전부 알록달록하면 정작 번호가
 * 안 보인다.
 *
 * 검색용이 아니라 유입 착지용이라 noindex다. 광고도 넣지 않는다 —
 * 인스타에서 막 넘어온 첫 화면이라 글로 넘어가는 걸 방해하지 않는 게 낫다.
 */
import BaseHead from "../../components/BaseHead.astro";
import ClarityHead from "../../components/ClarityHead.astro";
import { hubGroups } from "../../data/linkhub";
import { clusterColor } from "../../data/clusters";
import "../../styles/global.css";

const title = "주포켓 — 계산기와 글 전체 목록";
const description =
  "3.3% 원천징수·부가세·국민연금 계산기와 세금 가이드 전체를 번호로 정리했습니다. 인스타에서 본 번호를 여기서 찾으세요.";

const BRAND = "#0b5cad";
const dot = (id: string | null) =>
  id ? (clusterColor[id]?.mark ?? BRAND) : BRAND;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex, follow" />
    <ClarityHead />
  </head>
  <body class="hub-page">
    <main class="hub">
      <header class="hub-head">
        <span class="hub-avatar" aria-hidden="true">₩</span>
        <h1>주포켓</h1>
        <p class="hub-handle">@jupocket.money</p>
        <p class="hub-bio">
          세금 계산기와 가이드.<br />직장인·사장님·프리랜서 누구나.
        </p>
      </header>

      <p class="hub-hint">인스타에서 본 번호를 아래에서 찾으세요</p>

      {
        hubGroups.map((g) => (
          <section class="hub-group" aria-label={g.label}>
            <p class="hub-glabel">
              <span class="hub-dot" style={`--d:${dot(g.cluster)}`} aria-hidden="true" />
              {g.label}
            </p>
            <ul class="hub-list">
              {g.entries.map((e) => (
                <li>
                  <a href={e.href}>
                    <span class="hub-no">{e.no}</span>
                    <span class="hub-label">{e.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <p class="hub-foot">
        <a href="/">jupocket.com</a>
        <span>세금 수치는 국세청·국민연금공단 원문을 확인해 씁니다.</span>
      </p>
    </main>
  </body>
</html>

<style>
  .hub-page {
    background: var(--accent-bg);
  }
  .hub {
    max-width: 28rem;
    margin: 0 auto;
    padding: 2.5rem 1.1rem 3.5rem;
  }

  .hub-head {
    text-align: center;
  }
  .hub-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    /* 링크인바이오는 원형 프로필이 관습이다. */
    border-radius: 50%;
    background: #0b5cad;
    color: #fff;
    font-size: 2.1rem;
    font-weight: 700;
  }
  .hub-head h1 {
    font-size: 1.4rem;
    margin: 0.8rem 0 0.15rem;
  }
  .hub-handle {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .hub-bio {
    margin: 0.7rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .hub-hint {
    margin: 1.6rem 0 1.9rem;
    text-align: center;
    font-size: 0.84rem;
    color: var(--muted);
  }

  .hub-group {
    margin-bottom: 1.9rem;
  }
  .hub-glabel {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.6rem 0.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .hub-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--d);
  }

  .hub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hub-list a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    /* 손가락으로 누르는 버튼이라 높이를 넉넉히 준다. */
    min-height: 58px;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(16 24 40 / 0.05);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .hub-list a:active {
    transform: scale(0.985);
    box-shadow: none;
  }

  .hub-no {
    flex: 0 0 auto;
    min-width: 1.6rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .hub-label {
    flex: 1;
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .hub-foot {
    margin: 2.4rem 0 0;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .hub-foot a {
    display: block;
    font-weight: 700;
    color: var(--link);
  }

  @media (prefers-color-scheme: dark) {
    .hub-list a {
      box-shadow: none;
      border: 1px solid var(--rule);
    }
  }
</style>
