---
/**
 * 디자인 토큰 참조 페이지.
 *
 * 토큰이 12개일 때는 머리로 외웠는데, 그러다 없는 변수(--card)를 쓰고
 * 모서리를 28곳에 12가지로 흩뿌렸다. 눈으로 볼 수 있어야 드리프트가
 * 잡힌다. 값은 CSS 변수에서 실제로 읽어 오므로 이 페이지가 낡을 일이 없다.
 *
 * 검사기(lib/__tests__/design-tokens.test.ts)가 규칙을 강제하고,
 * 이 페이지는 그 규칙이 실제로 어떻게 보이는지를 담당한다.
 *
 * 내부용이라 noindex + 사이트맵 제외.
 */
import BaseHead from "../../components/BaseHead.astro";
import { clusterColor } from "../../data/clusters";
import "../../styles/global.css";

const title = "디자인 토큰 — 주포켓";
const description = "색·모서리·그림자·글자 크기·간격 토큰 참조.";

const colors = [
  ["--bg", "페이지 바닥"],
  ["--surface", "그 위에 뜨는 카드"],
  ["--surface-2", "은은한 틴트"],
  ["--brand", "브랜드"],
  ["--brand-wash", "브랜드 워시(배경)"],
  ["--text", "본문"],
  ["--muted", "보조"],
  ["--rule", "경계선"],
  ["--link", "링크"],
];
const radii = ["--r-xs", "--r-sm", "--r-md", "--r-lg", "--r-pill"];
const shadows = ["--shadow-1", "--shadow-2"];
const types = ["--t-xs", "--t-sm", "--t-md", "--t-lg", "--t-xl", "--t-2xl"];
const spaces = ["--s-1", "--s-2", "--s-3", "--s-4", "--s-5", "--s-6", "--s-7"];
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="ds">
      <h1>디자인 토큰</h1>
      <p class="ds-lead">
        값은 CSS 변수에서 실제로 읽어옵니다. 여기서 어색해 보이면 토큰이
        잘못된 것이지 페이지가 낡은 게 아닙니다.
      </p>

      <h2>색</h2>
      <div class="ds-grid">
        {
          colors.map(([name, use]) => (
            <div class="ds-swatch">
              <span class="ds-chip" style={`background:var(${name})`} />
              <code>{name}</code>
              <span class="ds-use">{use}</span>
            </div>
          ))
        }
      </div>

      <h2>주제 색</h2>
      <div class="ds-grid">
        {
          Object.entries(clusterColor).map(([id, c]) => (
            <div class="ds-swatch">
              <span class="ds-chip" style={`background:${c.mark}`} />
              <code>{id}</code>
              <span class="ds-use">{c.mark}</span>
            </div>
          ))
        }
      </div>

      <h2>모서리</h2>
      <div class="ds-row">
        {
          radii.map((r) => (
            <div class="ds-item">
              <span class="ds-box" style={`border-radius:var(${r})`} />
              <code>{r}</code>
            </div>
          ))
        }
      </div>

      <h2>그림자</h2>
      <div class="ds-row">
        {
          shadows.map((s) => (
            <div class="ds-item">
              <span class="ds-box ds-box-plain" style={`box-shadow:var(${s})`} />
              <code>{s}</code>
            </div>
          ))
        }
      </div>
      <p class="ds-note">다크 모드에서는 둘 다 none 입니다 — 경계선이 그 역할을 합니다.</p>

      <h2>글자 크기</h2>
      <ul class="ds-list">
        {
          types.map((t) => (
            <li>
              <span style={`font-size:var(${t})`}>다람쥐 헌 쳇바퀴 12,345원</span>
              <code>{t}</code>
            </li>
          ))
        }
      </ul>

      <h2>간격</h2>
      <div class="ds-row ds-row-baseline">
        {
          spaces.map((s) => (
            <div class="ds-item">
              <span class="ds-space" style={`width:var(${s});height:var(${s})`} />
              <code>{s}</code>
            </div>
          ))
        }
      </div>

      <h2>규칙</h2>
      <ul class="ds-rules">
        <li>모서리는 위 다섯 가지와 <code>50%</code>만 씁니다. 리터럴 px 금지.</li>
        <li><code>transition: all</code> 금지 — 무엇이 움직이는지 적습니다.</li>
        <li>정의되지 않은 <code>var(--x)</code> 금지.</li>
        <li>
          1080×1350 카드 아트보드(<code>CardArtboard.astro</code>)는 좌표계가
          달라 이 스케일에서 면제됩니다.
        </li>
      </ul>
      <p class="ds-note">
        세 가지 모두 <code>src/lib/__tests__/design-tokens.test.ts</code>가
        검사합니다. 어기면 테스트가 깨집니다.
      </p>
    </main>
  </body>
</html>

<style>
  .ds {
    max-width: var(--wide);
    margin: 0 auto;
    padding: var(--s-6) var(--s-4) var(--s-7);
  }
  .ds-lead,
  .ds-note {
    color: var(--muted);
    font-size: var(--t-sm);
    line-height: 1.6;
  }
  .ds h2 {
    margin-top: var(--s-6);
  }
  code {
    font-size: var(--t-xs);
    color: var(--muted);
  }

  .ds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--s-3);
  }
  .ds-swatch {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
  }
  .ds-chip {
    width: 28px;
    height: 28px;
    border-radius: var(--r-sm);
    border: 1px solid var(--rule);
    flex: 0 0 auto;
  }
  .ds-use {
    font-size: var(--t-xs);
    color: var(--muted);
    margin-left: auto;
  }

  .ds-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    align-items: flex-end;
  }
  .ds-row-baseline {
    align-items: flex-end;
  }
  .ds-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-1);
  }
  .ds-box {
    width: 64px;
    height: 64px;
    background: var(--surface-2);
    border: 1px solid var(--rule);
  }
  .ds-box-plain {
    background: var(--surface);
    border: 0;
    border-radius: var(--r-md);
  }
  .ds-space {
    background: var(--brand);
    display: block;
  }

  .ds-list {
    list-style: none;
    padding: 0;
  }
  .ds-list li {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--rule);
  }
  .ds-list code {
    margin-left: auto;
  }

  .ds-rules {
    line-height: 1.8;
  }
</style>
