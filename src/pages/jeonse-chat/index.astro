---
/**
 * HUG 전세보증 AI와 대화하기 — 전체 화면 채팅(2026-11-08).
 *
 * 글 페이지(체크리스트·보증 계산기)의 입구(HugChatEntry)에서 들어온다. ?s=house 처럼 단계를 넘기면 그 단계부터 시작한다.
 * 대화형 도구라 검색 색인은 하지 않는다(noindex + 사이트맵 제외) — 검색은 글 페이지가 받는다. 광고 없음.
 */
import BaseHead from "../../components/BaseHead.astro";
import ClarityHead from "../../components/ClarityHead.astro";
import GtagHead from "../../components/GtagHead.astro";
import InstallApp from "../../components/InstallApp.astro";
import HugChat from "../../components/HugChat.astro";
import "../../styles/global.css";

const title = "전세 계약 날짜로 할 일 뽑기 — JU포켓 전세 도우미(비공식)";
const description = "계약일과 잔금일만 넣으면 전입신고, 대출·보증 신청 마감 같은 할 일이 날짜순으로 나와요. 로그인 없이 써요. HUG가 아닌 JU포켓이 만든 비공식 안내예요.";
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex, follow" />
    <ClarityHead />
    <GtagHead />
  </head>
  <body class="hc-page">
    <HugChat />
    <InstallApp />
  </body>
</html>

<style is:global>
  body.hc-page {
    margin: 0;
    background: var(--bg);
  }
</style>
