---
/**
 * 時間戳轉換器 — 홍콩판 유닉스 타임스탬프 변환(/zh-hk/tools/unix-time/). 한국어판 /tools/unix-time/ 와
 * 계산(lib/unix-time.ts)·스크립트(scripts/unix-time.ts 의 ZH_HANT 사전 — 홍콩 회차가 main 잠금 안에서 넣음, 대만판도 쓸 수 있게 중립 서면어)를
 * 같이 쓰고, 문장은 홍콩 書面語로 새로 썼다(번역 아님, 대만판 문장도 옮기지 않음). 날짜 표기는
 * <html lang="zh-Hant-HK"> 의 Intl('2026年10月19日週一'). 조사표 홍콩 칸 '같음'(POSIX 4.19). 공유 파일은 scripts/unix-time.ts 의 ZH_HANT 사전 하나만 더함.
 *
 * 소제목은 홍콩 구글 자동완성에서 왔다(keywords/hk-unix-time-2026-10-21.csv, hl zh-HK · gl hk):
 *   時間戳轉換器·線上 timestamp 轉換·時間 戳 在線 轉換 / epoch time hk·epoch 是什麼時間 / timestamp 轉換 毫秒 /
 *   utc timestamp 轉換 / timestamp 轉換 公式·excel / timestamp 轉換 python·java·sql·linux
 * 시간대는 UTC 와 '裝置時區'만 — 香港時間 오프셋 숫자는 허용 출처 원문으로 이번에 확인하지 않아 쓰지 않는다.
 * 본문 예시 숫자는 전부 아래 frontmatter 에서 lib 함수로 계산한다.
 */
import BaseHead from "../../../../components/BaseHead.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import ClarityHead from "../../../../components/ClarityHead.astro";
import GtagHead from "../../../../components/GtagHead.astro";
import TrackLinks from "../../../../components/TrackLinks.astro";
import AdSenseHead from "../../../../components/AdSenseHead.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import "../../../../styles/global.css";
import { INT32_MAX, toParts, enText, isoText, secondsText, dateValue, timeValue } from "../../../../lib/unix-time";

const LANG = "zh-Hant-HK";
const title = "時間戳轉換器（香港）— Unix Timestamp 轉日期時間、epoch time 線上轉換";
const description =
  "香港適用的線上 timestamp 轉換：輸入10位數秒或13位數毫秒，即時換算成 UTC 或你裝置時區（香港時間）的日期時間，亦可把日期轉回 epoch time。";

/** 처음 보이는 예 — 2026-10-19 03:34:56 UTC */
const BASE_MS = 1_792_380_896_000;
const p0 = toParts(BASE_MS, 0);
const BASE_S = secondsText(BASE_MS);
const zero = enText(toParts(0, 0), LANG);
const minus1 = enText(toParts(-1000, 0), LANG);
const y2038 = enText(toParts(INT32_MAX * 1000, 0), LANG);
const wrap = enText(toParts(-(INT32_MAX + 1) * 1000, 0), LANG);
const num = (v: number) => v.toLocaleString(LANG);
---

<html lang="zh-Hant-HK">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>時間戳轉換器：Unix Timestamp 與日期時間互換</h1>
      <p>
        系統日誌、資料庫欄位或 API 回傳的資料裏，常見到 {BASE_S} 這類一長串數字。把它貼到下面，就會顯示對應的日期和時間；
        反過來輸入日期時間，也會得出 Unix timestamp。改動任何一邊，另一邊即時跟着更新，可選用 UTC 或你裝置所設定的時區。
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="zone">時區</label>
          <select id="zone" data-seg>
            <option value="utc" selected>UTC</option>
            <option value="device">裝置時區</option>
          </select>
          <p class="hint" id="zone-hint">日期欄和結果按這個時區顯示，時間戳本身不會改變。</p>
        </div>

        <div class="calc-input-wrap">
          <label for="ts">Unix 時間戳</label>
          <input type="text" id="ts" inputmode="decimal" autocomplete="off" spellcheck="false" value={BASE_S} placeholder="例如 1704067200" />
          <p class="hint" id="ts-hint">10位數當作秒，13位數當作毫秒。</p>
        </div>
        <div class="calc-input-wrap">
          <label for="unit">單位</label>
          <select id="unit" data-seg>
            <option value="auto" selected>自動</option>
            <option value="s">秒</option>
            <option value="ms">毫秒</option>
          </select>
        </div>

        <div class="calc-input-wrap">
          <label for="date">日期</label>
          <input type="date" id="date" value={dateValue(p0)} min="1900-01-01" max="9999-12-30" />
        </div>
        <div class="calc-input-wrap">
          <label for="time">時間（24小時制，時:分:秒）</label>
          <input type="time" id="time" step="1" value={timeValue(p0)} />
        </div>
        <div class="calc-input-wrap">
          <label for="msec">毫秒（0–999）</label>
          <input type="number" id="msec" inputmode="numeric" min="0" max="999" step="1" value="0" />
        </div>

        <div class="actions">
          <button id="btn-now" type="button" class="secondary">現在</button>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">UTC</p>
          <p class="big" id="hero-value">{enText(p0, LANG)}</p>
          <p class="hint" id="hero-sub"></p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          <div class="stat-chip">
            <span class="label">秒（s）</span>
            <span class="value mono" id="v-sec">{BASE_S}</span>
          </div>
          <div class="stat-chip">
            <span class="label">毫秒（ms）</span>
            <span class="value mono" id="v-ms">{BASE_MS}</span>
          </div>
          <div class="stat-chip">
            <span class="label">ISO 8601（UTC）</span>
            <span class="value mono" id="v-iso">{isoText(BASE_MS, 0)}</span>
          </div>
          <div class="stat-chip">
            <span class="label">ISO 8601（所選時區）</span>
            <span class="value mono" id="v-iso-local">{isoText(BASE_MS, 0)}</span>
          </div>
          <div class="stat-chip">
            <span class="label">距離現在</span>
            <span class="value" id="v-rel">—</span>
          </div>
        </div>
        <p class="hint" id="note"></p>
        <p class="meta" id="now-line">現在：—</p>

        <div class="actions">
          <button id="btn-download" type="button">儲存為圖片</button>
          <button id="btn-share" type="button" class="secondary">分享</button>
        </div>
      </div>

      <h2>epoch time 是甚麼時間？</h2>
      <p>
        Unix 時間戳（又叫 epoch time）是由 <strong>1970年1月1日 00:00:00 UTC</strong> 起累計的秒數。POSIX 標準
        （IEEE Std 1003.1）把每一天定為剛好 {num(86400)} 秒，不計閏秒。所以 0 就是 UTC {zero}，
        −1,000 毫秒就是 UTC {minus1}。
      </p>

      <h2>線上 timestamp 轉換：現在的時間戳</h2>
      <p>
        轉換器下方的「現在」一行每秒更新一次，同時列出以秒和毫秒計的現在時間戳。按 <strong>現在</strong>，就會把這一刻填入轉換器。
        兩個數值都取自你裝置的時鐘，裝置時間不準，結果也會跟着不準。
      </p>

      <h2>timestamp 轉換：秒定毫秒？</h2>
      <ul>
        <li>
          <strong>10位數，例如 {BASE_S}</strong> — 秒。由2001年9月到2286年11月的時間戳都是10位數。
        </li>
        <li>
          <strong>13位數，例如 {BASE_MS}</strong> — 毫秒。JavaScript 的 <code>Date.now()</code> 和 Java 的
          {" "}<code>System.currentTimeMillis()</code> 都是這種。除以 {num(1000)} 就是秒。
        </li>
        <li>
          <strong>「自動」怎樣判斷</strong> — 有小數點的當作秒；整數在11位數或以下當作秒，12位數或以上當作毫秒。
          逗號和空格會略去。如果判斷錯了，請自己選單位。
        </li>
      </ul>

      <h2>UTC timestamp 轉換與香港時間</h2>
      <p>
        時間戳本身沒有時區：同一個數字，在香港、倫敦或紐約都是同一個時刻，只是在當地時鐘上讀出來不同。選 <strong>裝置時區</strong>，
        轉換器就按你手機或電腦設定的時區顯示（裝置設為香港，就是香港時間），並在結果旁列出與 UTC 相差多少。想看其他地方的時間，
        可先把裝置時區改成那個地方再回來。夏令時間等規則由裝置的時區設定處理，同一個城市在不同日子的時差可能不同。
      </p>

      <h2>timestamp 轉換公式（Excel、Google 試算表）</h2>
      <p>
        試算表以「日」為單位記日期，一日等於 1。所以把秒數除以 {num(86400)}，再加上 1970年1月1日即可。假設 A1 是以秒計的時間戳：
      </p>
      <ul>
        <li>UTC 日期時間：<code>=A1/86400+DATE(1970,1,1)</code></li>
        <li>13位數毫秒：<code>=A1/86400000+DATE(1970,1,1)</code></li>
        <li>轉成本地時間：<code>=A1/86400+DATE(1970,1,1)+(時差/24)</code>，時差是轉換器在該日期顯示與 UTC 相差的小時數（連正負號）</li>
        <li>由 UTC 日期時間轉回時間戳：<code>=(A1-DATE(1970,1,1))*86400</code></li>
      </ul>
      <p>
        如果儲存格只顯示一個長小數，把格式設為 <code>yyyy-mm-dd hh:mm:ss</code> 一類的日期時間格式便可。Google 試算表用同樣的公式。
      </p>

      <h2>timestamp 轉換：Python、Java、SQL、Linux</h2>
      <ul>
        <li><strong>Python</strong>：<code>datetime.fromtimestamp({BASE_S}, tz=timezone.utc)</code>（先 <code>from datetime import datetime, timezone</code>）</li>
        <li><strong>pandas</strong>：<code>pd.to_datetime({BASE_S}, unit="s")</code>，毫秒用 <code>unit="ms"</code></li>
        <li><strong>Java</strong>：<code>Instant.ofEpochSecond({BASE_S}L)</code>，毫秒用 <code>Instant.ofEpochMilli({BASE_MS}L)</code></li>
        <li><strong>JavaScript</strong>：<code>new Date({BASE_S} * 1000)</code> — 秒要先乘 {num(1000)}</li>
        <li><strong>MySQL</strong>：<code>SELECT FROM_UNIXTIME({BASE_S});</code></li>
        <li><strong>PostgreSQL</strong>：<code>SELECT to_timestamp({BASE_S});</code></li>
        <li><strong>Linux / macOS</strong>：<code>date +%s</code> 顯示現在的時間戳；GNU <code>date -d @{BASE_S}</code> 把時間戳轉成日期</li>
      </ul>
      <p>想核對結果，把同一個數字貼到上面的轉換器比較即可。</p>

      <h2>2038年問題</h2>
      <p>
        有正負號的32位元整數最大是 2,147,483,647，作為 Unix 時間戳就是 UTC {y2038}。再多一秒，仍用32位元整數記時間的軟件就會溢位成負數，
        讀成 UTC {wrap}。輸入的時間超過這一刻時，轉換器會在結果下方提示。
      </p>

      <details>
        <summary>1970年以前的日期可以轉換嗎？</summary>
        <p>
          可以，會得出負數。−1 是 epoch 前一秒，即 UTC 1969年12月31日最後一秒。POSIX 只寫明1970年起的公式，但這個轉換器和大部分程式語言一樣，
          以每日 {num(86400)} 秒向前推算。可轉換範圍是1900年1月1日至9999年。
        </p>
      </details>

      <details>
        <summary>小數、微秒、納秒可以嗎？</summary>
        <p>
          有小數點的數值（例如 1792380896.789）會當作秒，最多到小數後三位（毫秒）。微秒（16位數）和納秒（19位數）的時間戳不接受，
          請先除以 {num(1000)} 或 {num(1000000)} 變成毫秒。
        </p>
      </details>

      <details>
        <summary>為甚麼結果差了幾個鐘頭？</summary>
        <p>
          通常是 UTC 和本地時間搞混了：想看香港時間卻按 UTC 讀，或者相反。在 <strong>UTC</strong> 和 <strong>裝置時區</strong>
          之間切換比較一下。如果年份變成1970年或很遠的將來，就是單位差了 {num(1000)} 倍，請自己選秒或毫秒。
        </p>
      </details>

      <p>
        想計日數而不是秒數？可用 <a href="/zh-hk/tools/date-diff/">日數計算機</a>，或用 <a href="/zh-hk/tools/dday/">倒數日子計算器</a> 看某個日子還有幾多日。
      </p>

      <p>
        資料來源：<a href="https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap04.html" rel="noopener">The Open Group Base Specifications Issue 8（IEEE Std 1003.1-2024）4.19 Seconds Since the Epoch</a>（2026年10月21日查閱）
      </p>

      <AdSlot label="unix-time-result-zh-hk" />
    </main>
    <SiteFooter />
    <style>
      .mono { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
      #hero-value { overflow-wrap: anywhere; }
    </style>
    <script src="../../../../scripts/unix-time.ts"></script>
    <TrackLinks />
    <script src="../../../../scripts/calc-ui.ts"></script>
  </body>
</html>
