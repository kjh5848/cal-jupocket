---
/**
 * 홈 — 블로그형 2단 레이아웃.
 *
 * 히어로 → 인기 계산기 카드 → (본문: 주제별 글 카드) + (사이드바: 새 글·
 * 계산기 CTA). 계산기·글·색·아이콘은 전부 data/clusters.ts 한 곳에서
 * 가져오므로, 글을 추가하면 홈도 자동으로 갱신된다.
 */
import BaseHead from "../components/BaseHead.astro";
import AdSlot from "../components/AdSlot.astro";
import ClarityHead from "../components/ClarityHead.astro";
import GtagHead from "../components/GtagHead.astro";
import TrackLinks from "../components/TrackLinks.astro";
import AdSenseHead from "../components/AdSenseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools, toolCount } from "../data/tools";
import { TOOL_TYPES } from "../data/tool-types";
import { clusters, clusterColor, recent, linkByHref, displayTitle } from "../data/clusters";
import { icons } from "../data/icons";
import { liveSocials } from "../data/social";
import "../styles/global.css";

const title = "주포켓 — 세금·급여부터 날짜·사진까지, 필요한 도구 모음";
const description =
  "세금·급여 계산기부터 날짜·사진·문서 도구까지 주포켓에 담았습니다. 3.3% 원천징수·실수령액·부가세·상속세를 법 원문 기준으로 바로 계산하고, 얼마 내는지·아끼는 법까지 정리했습니다.";

const count = toolCount();
/** 자주 찾는 말 — 검색량 순(docs/keyword-research.md v54·v39) */
const QUICK = [
  { label: "실수령액", href: "/guide/take-home-calculator/" },
  { label: "3.3% 원천징수", href: "/freelancer-33/" },
  { label: "부가세", href: "/vat/" },
  { label: "상속세", href: "/inheritance/" },
  { label: "노령연금", href: "/guide/old-age-pension-age/" },
];

const sections = clusters.map((c) => ({
  id: c.id,
  title: c.title,
  color: clusterColor[c.id],
  guides: c.links.filter((l) => l.kind === "guide"),
}));

const recentCards = recent
  .map((h) => linkByHref(h))
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .slice(0, 5);

/**
 * 홈에만 붙이는 WebSite + Organization.
 *
 * 계산기 페이지마다 SoftwareApplication 을 붙이고 싶어지지만, 평점도
 * 가격도 없는 앱 마크업은 검색결과에 아무것도 만들지 않는다. 읽히지 않을
 * 구조화 데이터는 관리 비용만 남는다.
 *
 * 여기 두 개는 다르다 — 사이트 이름과 발행 주체를 기계가 확정하는 자리라,
 * 검색결과의 사이트명 표기와 지식 패널이 이걸 본다.
 */
const siteUrl = Astro.site!.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "주포켓",
    alternateName: "jupocket",
    url: `${siteUrl}/`,
    inLanguage: "ko",
    description,
    publisher: { "@id": `${siteUrl}/#org` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#org`,
    name: "주포켓",
    url: `${siteUrl}/`,
    logo: `${siteUrl}/icon-512.png`,
    sameAs: [
      "https://www.instagram.com/jupocket.money/",
      "https://www.threads.com/@jupocket.money",
    ],
  },
];
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main class="home">
      <section class="home-hero">
        <div class="home-hero-inner">
          <h1><span class="hero-brand">주포켓</span> 뭐가 필요하세요?</h1>
          <p class="hero-lede">세금·급여 계산부터 날짜·사진·문서까지, 담긴 도구에서 바로 찾아 쓰세요.</p>
          <div class="hero-find">
            <form class="hero-search" role="search" onsubmit="return false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
              <input id="tool-q" type="search" placeholder="실수령액, 퇴직금, 3.3%…" aria-label="도구 찾기" autocomplete="off" aria-controls="tool-pop" aria-expanded="false" />
              <kbd aria-hidden="true">/</kbd>
            </form>
            <div id="tool-pop" class="search-pop" role="listbox" aria-label="찾은 도구" hidden></div>
          </div>
          <nav class="hero-quick" aria-label="자주 찾는 도구">
            <span>자주 찾는</span>
            {QUICK.map((q) => <a class="quick" href={q.href}>{q.label}</a>)}
          </nav>
          <p class="hero-count">도구 <b>{count.live}</b>개 담김 · <b>{count.total}</b>개 채우는 중</p>
          {/*
            인스타·스레드 프로필 링크로 들어온 사람은 "N번 글"을 찾으러
            온다. 번호표는 /link/ 에만 있어서 히어로에서 한 번에 갈 수 있게 둔다.
          */}
          <p class="hero-hub">
            <a href="/link/">인스타에서 본 번호 찾기 →</a>
          </p>
        </div>
      </section>

      <section id="tools" aria-labelledby="tools-h">
        <h2 id="tools-h" class="home-h">도구 도감</h2>
        <div class="dex-progress" data-dex-progress hidden></div>
        <div class="dex-types" role="group" aria-label="분류로 걸러 보기">
          {TOOL_TYPES.map((t) => <button type="button" data-type={t.key} style={`--cm:${t.color}`} aria-pressed="false">{t.label}</button>)}
        </div>
        <div class="tool-grid">
          {tools.map((tool) => <ToolCard tool={tool} />)}
        </div>
      </section>

      <div class="home-main">
        <div class="home-articles" id="reads">
          <h2 class="home-h">주제별 읽을거리</h2>
          {
            sections.map((s) => (
              <section class="cluster-block" aria-label={s.title}>
                <p
                  class="cluster-heading"
                  style={`--cm:${s.color.mark};--ci:${s.color.ink};--cb:${s.color.bg}`}
                >
                  {s.title}
                </p>
                <div class="post-grid">
                  {s.guides.map((g) => (
                    <a
                      class="post-card"
                      href={g.href}
                      style={`--cm:${s.color.mark};--cb:${s.color.bg};--ci:${s.color.ink}`}
                    >
                      <span class="post-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[g.icon]} />
                      </span>
                      <span class="post-title">{displayTitle(g)}</span>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <aside class="home-aside">
          <div class="aside-box">
            <p class="aside-title">새로 올라온 글</p>
            <ul class="recent-list">
              {
                recentCards.map(({ link, color }) => (
                  <li>
                    <a href={link.href} style={`--cm:${color.mark}`}>
                      <span class="recent-dot" aria-hidden="true" />
                      {displayTitle(link)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="aside-cta">
            <p class="aside-cta-title">계산기부터 써보세요</p>
            <p class="aside-cta-text">
              계약금액을 넣으면 3.3% 실수령액이 바로 나옵니다.
            </p>
            <a class="btn" href="/freelancer-33/">3.3% 계산기 열기</a>
          </div>

          <div class="aside-box">
            <p class="aside-title">카드뉴스</p>
            <p class="aside-social-text">
              세금 한 편을 카드 몇 장으로 정리합니다.
              {
                liveSocials.length > 0 && (
                  <>
                    새 카드는{" "}
                    {liveSocials.map((s) => (
                      <a href={s.url} rel="me noopener" target="_blank">
                        {s.label} {s.handle}
                      </a>
                    ))}
                    에 먼저 올라옵니다.
                  </>
                )
              }
            </p>
            <a class="aside-social-link" href="/cards/">카드뉴스 모아보기 →</a>
          </div>
        </aside>
      </div>

      <AdSlot label="home-bottom" />
    </main>
    <SiteFooter />
      <TrackLinks />
  </body>
</html>
