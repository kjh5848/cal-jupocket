---
/**
 * 홈 — 블로그형 2단 레이아웃.
 *
 * 히어로 → 인기 계산기 카드 → (본문: 주제별 글 카드) + (사이드바: 새 글·
 * 계산기 CTA). 계산기·글·색·아이콘은 전부 data/clusters.ts 한 곳에서
 * 가져오므로, 글을 추가하면 홈도 자동으로 갱신된다.
 */
import { organization } from "../data/org";
import BaseHead from "../components/BaseHead.astro";
import AdSlot from "../components/AdSlot.astro";
import ClarityHead from "../components/ClarityHead.astro";
import GtagHead from "../components/GtagHead.astro";
import TrackLinks from "../components/TrackLinks.astro";
import AdSenseHead from "../components/AdSenseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ToolCard from "../components/ToolCard.astro";
import TypeIcon from "../components/TypeIcon.astro";
import { tools, toolCount } from "../data/tools";
import { TOOL_TYPES, typeInfo } from "../data/tool-types";
import { clusters, clusterColor, recent, linkByHref, displayTitle } from "../data/clusters";
import { icons } from "../data/icons";
import { liveSocials } from "../data/social";
import { homeEntries } from "../data/home-entries";
import "../styles/global.css";

const title = "주포켓 — 세금·급여부터 날짜·사진까지, 필요한 도구 모음";
const description =
  "세금·급여 계산기부터 날짜·사진·문서 도구까지 주포켓에 담았습니다. 3.3% 원천징수·실수령액·부가세·상속세를 법 원문 기준으로 바로 계산하고, 얼마 내는지·아끼는 법까지 정리했습니다.";

const count = toolCount();
/** 검색 스크립트가 읽는 도구 목록 — 필요한 칸만(번들에 클러스터 전체를 넣지 않는다) */
const toolsData = JSON.stringify(
  tools.map((t) => ({ no: t.no, href: t.href, name: t.name, blurb: t.blurb, type: t.type, keywords: t.keywords, status: t.status, label: typeInfo(t.type).label, color: typeInfo(t.type).color })),
);
/** 자주 찾는 말 — 검색량 순(docs/keyword-research.md v54·v39) */
const QUICK = [
  { label: "실수령액", href: "/guide/take-home-calculator/" },
  { label: "3.3% 원천징수", href: "/freelancer-33/" },
  { label: "부가세", href: "/vat/" },
  { label: "상속세", href: "/inheritance/" },
  { label: "노령연금", href: "/guide/old-age-pension-age/" },
];

// 범용 묶음(unit 등)은 글이 없을 수 있다 — 빈 제목만 남지 않게 글 0개 묶음은 건너뛴다
const sections = clusters
  .map((c) => ({
    id: c.id,
    title: c.title,
    color: clusterColor[c.id],
    guides: c.links.filter((l) => l.kind === "guide"),
  }))
  .filter((s) => s.guides.length > 0);

const recentCards = recent
  .map((h) => linkByHref(h))
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .slice(0, 5);

/**
 * 홈에만 붙이는 WebSite + Organization.
 *
 * 계산기 페이지마다 SoftwareApplication 을 붙이고 싶어지지만, 평점도
 * 가격도 없는 앱 마크업은 검색결과에 아무것도 만들지 않는다. 읽히지 않을
 * 구조화 데이터는 관리 비용만 남는다.
 *
 * 여기 두 개는 다르다 — 사이트 이름과 발행 주체를 기계가 확정하는 자리라,
 * 검색결과의 사이트명 표기와 지식 패널이 이걸 본다.
 */
const siteUrl = Astro.site!.href.replace(/\/$/, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "주포켓",
    alternateName: "jupocket",
    url: `${siteUrl}/`,
    inLanguage: "ko",
    description,
    publisher: { "@id": `${siteUrl}/#org` },
  },
  { "@context": "https://schema.org", ...organization(siteUrl) },
];
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main class="home">
      <section class="home-hero">
        <div class="home-hero-inner">
          <h1><span class="hero-brand">주포켓</span> 뭐가 필요하세요?</h1>
          <p class="hero-lede">세금·급여 계산부터 날짜·사진·문서까지, 담긴 도구에서 바로 찾아 쓰세요.</p>
          <div class="hero-find">
            <form class="hero-search" role="search" onsubmit="return false">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
              <input id="tool-q" type="search" placeholder="실수령액, 퇴직금, 3.3%…" aria-label="도구 찾기" autocomplete="off" aria-controls="tool-pop" aria-expanded="false" />
              <kbd aria-hidden="true">/</kbd>
            </form>
            <div id="tool-pop" class="search-pop" role="listbox" aria-label="찾은 도구" hidden></div>
          </div>
          <script type="application/json" id="tools-data" set:html={toolsData} />
          <script src="../scripts/tool-search.ts"></script>
          <nav class="hero-quick" aria-label="자주 찾는 도구">
            <span>자주 찾는</span>
            {QUICK.map((q) => <a class="quick" href={q.href}>{q.label}</a>)}
          </nav>
          <p class="hero-count">도구 <b>{count.live}</b>개 담김 · <b>{count.total}</b>개 채우는 중</p>
          {/*
            인스타·스레드 프로필 링크로 들어온 사람은 "N번 글"을 찾으러
            온다. 번호표는 /link/ 에만 있어서 히어로에서 한 번에 갈 수 있게 둔다.
          */}
          <p class="hero-hub">
            <a href="/link/">스레드에서 본 번호 찾기 →</a>
          </p>
        </div>
      </section>

      {/*
        고민 입구(2026-11-07) — 첫 화면에서 "무엇이 고민이세요?"로 시작해 질문(글)이나 계산기로 바로 넘긴다.
        설계: docs/superpowers/specs/2026-11-07-cta-redesign-design.md 4단계
      */}
      <section class="home-entries" aria-labelledby="entries-h">
        <h2 id="entries-h" class="home-h">무엇이 고민이세요?</h2>
        <div class="entry-grid">
          {homeEntries.map((e) => (
            <div class="entry-card" data-entry={e.key}>
              <p class="entry-title">
                <span class="entry-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[e.icon]} /></span>
                {e.title}
              </p>
              <ul class="entry-qs">
                {e.questions.map((q) => <li><a href={q.href}>{q.q}</a></li>)}
              </ul>
              <a class="entry-calc" href={e.calc.href}>{e.calc.label} 열기 →</a>
            </div>
          ))}
        </div>
      </section>

      <section id="tools" aria-labelledby="tools-h">
        <h2 id="tools-h" class="home-h">전체 계산기·도구</h2>
        <div class="dex-types" role="group" aria-label="분류로 걸러 보기">
          {TOOL_TYPES.filter((t) => tools.some((x) => x.type === t.key && x.status === "live")).map((t) => <button type="button" data-type={t.key} data-label={t.label} style={`--cm:${t.color}`} aria-pressed="false"><TypeIcon type={t.key} size={20} />{t.label}</button>)}
        </div>
        {/* 한 줄 목록 — 곧 담길 도구(점선 칸)는 홈에서 뺐다. 처음 12개만, 나머지는 '전체 보기' */}
        <div class="tool-grid tool-list" data-first="12">
          {tools.filter((tool) => tool.status === "live").map((tool) => <ToolCard tool={tool} compact />)}
        </div>
        <button type="button" class="tools-more" data-tools-more aria-expanded="false">전체 {tools.filter((t) => t.status === "live").length}개 보기</button>
        <script src="../scripts/dex.ts"></script>
      </section>

      <div class="home-main">
        <div class="home-articles" id="reads">
          <h2 class="home-h">주제별 읽을거리</h2>
          {
            sections.map((s) => (
              <section class="cluster-block" aria-label={s.title}>
                <p
                  class="cluster-heading"
                  style={`--cm:${s.color.mark};--ci:${s.color.ink};--cb:${s.color.bg}`}
                >
                  {s.title}
                </p>
                {/* 주제마다 4편만 펼치고 나머지는 접는다(2026-11-07) — 303편 카드가 휴대폰 28화면이었다.
                    접힌 글도 링크는 HTML 에 남겨 둔다(구글이 찾아가는 길) */}
                <ul class="post-list">
                  {s.guides.slice(0, 4).map((g) => <li><a href={g.href}>{displayTitle(g)}</a></li>)}
                </ul>
                {s.guides.length > 4 && (
                  <details class="post-more">
                    <summary>{s.title} 글 {s.guides.length - 4}편 더 보기</summary>
                    <ul class="post-list">
                      {s.guides.slice(4).map((g) => <li><a href={g.href}>{displayTitle(g)}</a></li>)}
                    </ul>
                  </details>
                )}
              </section>
            ))
          }
        </div>

        <aside class="home-aside">
          <div class="aside-box">
            <p class="aside-title">새로 올라온 글</p>
            <ul class="recent-list">
              {
                recentCards.map(({ link, color }) => (
                  <li>
                    <a href={link.href} style={`--cm:${color.mark}`}>
                      <span class="recent-dot" aria-hidden="true" />
                      {displayTitle(link)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="aside-cta">
            <p class="aside-cta-title">계산기부터 써보세요</p>
            <p class="aside-cta-text">
              계약금액을 넣으면 3.3% 실수령액이 바로 나옵니다.
            </p>
            <a class="btn" href="/freelancer-33/">3.3% 계산기 열기</a>
          </div>
        </aside>
      </div>

      <AdSlot label="home-bottom" />
    </main>
    <SiteFooter />
      <TrackLinks />
  </body>
</html>
