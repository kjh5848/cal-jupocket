---
/**
 * 홈 — 블로그형 2단 레이아웃.
 *
 * 히어로 → 인기 계산기 카드 → (본문: 주제별 글 카드) + (사이드바: 새 글·
 * 계산기 CTA). 계산기·글·색·아이콘은 전부 data/clusters.ts 한 곳에서
 * 가져오므로, 글을 추가하면 홈도 자동으로 갱신된다.
 */
import BaseHead from "../components/BaseHead.astro";
import ClarityHead from "../components/ClarityHead.astro";
import AdSenseHead from "../components/AdSenseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { clusters, clusterColor, recent, linkByHref } from "../data/clusters";
import { icons } from "../data/icons";
import "../styles/global.css";

const title = "주포켓 — 세금 계산기 (프리랜서·자영업자·직장인)";
const description =
  "직장인·사장님·자영업자·프리랜서 누구나 쓰는 무료 세금 계산기. 3.3% 원천징수·부가세·국민연금 보험료를 바로 계산하고, 얼마 내는지·아끼는 법까지 정리했습니다.";

const calcCards = clusters.flatMap((c) =>
  c.links
    .filter((l) => l.kind === "calc")
    .map((l) => ({ l, color: clusterColor[c.id] })),
);

const sections = clusters.map((c) => ({
  id: c.id,
  title: c.title,
  color: clusterColor[c.id],
  guides: c.links.filter((l) => l.kind === "guide"),
}));

const recentCards = recent
  .map((h) => linkByHref(h))
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .slice(0, 5);
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <AdSenseHead />
  </head>
  <body>
    <SiteHeader />
    <main class="home">
      <section class="home-hero">
        <div class="home-hero-inner">
          <h1>복잡한 세금, 계산부터 판단까지</h1>
          <p>
            3.3% 원천징수·부가세·국민연금 보험료를 30초에 계산하고, 얼마 내는지·
            아끼는 법까지 정리했어요. 직장인·사장님·자영업자 누구나.
          </p>
          <p class="actions">
            <a class="btn" href="#tools">계산기 바로가기</a>
          </p>
        </div>
      </section>

      <section id="tools" aria-labelledby="tools-h">
        <h2 id="tools-h" class="home-h">계산기</h2>
        <div class="tool-grid">
          {
            calcCards.map(({ l, color }) => (
              <a
                class="tool-card"
                href={l.href}
                style={`--cm:${color.mark};--cb:${color.bg};--ci:${color.ink}`}
              >
                <span class="tool-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[l.icon]} />
                </span>
                <span class="tool-body">
                  <span class="tool-title">{l.title}</span>
                  <span class="tool-blurb">{l.blurb}</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="home-main">
        <div class="home-articles">
          <h2 class="home-h">주제별 읽을거리</h2>
          {
            sections.map((s) => (
              <section class="cluster-block" aria-label={s.title}>
                <p
                  class="cluster-heading"
                  style={`--cm:${s.color.mark};--ci:${s.color.ink};--cb:${s.color.bg}`}
                >
                  {s.title}
                </p>
                <div class="post-grid">
                  {s.guides.map((g) => (
                    <a
                      class="post-card"
                      href={g.href}
                      style={`--cm:${s.color.mark};--cb:${s.color.bg};--ci:${s.color.ink}`}
                    >
                      <span class="post-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[g.icon]} />
                      </span>
                      <span class="post-title">{g.title}</span>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <aside class="home-aside">
          <div class="aside-box">
            <p class="aside-title">새로 올라온 글</p>
            <ul class="recent-list">
              {
                recentCards.map(({ link, color }) => (
                  <li>
                    <a href={link.href} style={`--cm:${color.mark}`}>
                      <span class="recent-dot" aria-hidden="true" />
                      {link.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="aside-cta">
            <p class="aside-cta-title">계산기부터 써보세요</p>
            <p class="aside-cta-text">
              계약금액을 넣으면 3.3% 실수령액이 바로 나옵니다.
            </p>
            <a class="btn" href="/freelancer-33/">3.3% 계산기 열기</a>
          </div>
        </aside>
      </div>

      <div class="ad-slot" data-ad="home-bottom"></div>
    </main>
    <SiteFooter />
  </body>
</html>
