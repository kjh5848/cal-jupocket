---
/**
 * 환갑·칠순 계산기 — 날짜·시간 묶음의 도구(/tools/milestone-age/). 계산은 lib/milestone-age.ts.
 *
 * 질문 하나: 이 생년월일이면 환갑·칠순·팔순이 언제이고, 며칠 남았나.
 * 이름과 나이는 표준국어대사전 뜻풀이(rates/milestone-age-2026.json), 만 N세가 되는 날은 만 나이 계산기와 같은 셈
 * (lib/age.ts). roberin #102 는 입력·결과 항목만 대조했다(docs/calc-benchmark.md).
 * 첫 화면 숫자는 예시로 빌드 때 계산하고, 스크립트가 열린 날 오늘로 바꿔 다시 센다.
 */
import BaseHead from "../../../components/BaseHead.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import GtagHead from "../../../components/GtagHead.astro";
import TrackLinks from "../../../components/TrackLinks.astro";
import AdSenseHead from "../../../components/AdSenseHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/global.css";
import { toDay, label, dday } from "../../../lib/date-calc";
import { age } from "../../../lib/age";
import { milestones, nextMilestone } from "../../../lib/milestone-age";

const title = "환갑·칠순 계산기 — 환갑, 칠순, 팔순은 언제? 날짜와 D-day";
const description =
  "생년월일을 넣으면 환갑·진갑·칠순·희수·팔순·미수·구순·백수가 언제인지 날짜·요일과 D-day로 보여 줍니다. 만 나이 기준 날짜와 세는 나이로 지내는 해를 함께 봅니다.";

const BIRTH = "1966-10-19";
const BASE = "2026-10-19";
const b0 = toDay(BIRTH)!;
const t0 = toDay(BASE)!;
const list0 = milestones(b0, t0)!;
const next0 = nextMilestone(list0)!;
const age0 = age(b0, t0)!;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>환갑·칠순 계산기</h1>
      <p>
        생년월일을 넣으면 환갑·칠순·팔순 같은 기념 나이가 언제인지, 오늘부터 며칠 남았는지 셉니다. 만 나이로 그 나이가
        되는 날과, 세는 나이로 지내는 집이라면 어느 해인지를 함께 보여 드립니다.
      </p>

      <div class="calc-card">
        <div class="calc-input-wrap">
          <label for="birth">생년월일 (양력)</label>
          <input type="date" id="birth" value={BIRTH} min="1900-01-01" max="2100-12-31" />
        </div>
        <div class="calc-input-wrap">
          <label for="base">기준일 (보통 오늘)</label>
          <input type="date" id="base" value={BASE} min="1900-01-01" max="2100-12-31" />
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">다가오는 기념 나이 — {next0.name}({next0.hanja})</p>
          <p class="big" id="hero-value">{dday(next0.day, t0)}</p>
          <p class="hint" id="hero-sub">{label(next0.day)} · 만 {next0.n}세가 되는 날</p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          <div class="stat-chip">
            <span class="label">지금 만 나이</span>
            <span class="value" id="v-age">{age0.years}세</span>
          </div>
          <div class="stat-chip">
            <span class="label">세는 나이 (관습)</span>
            <span class="value" id="v-kage">{age0.koreanAge}세</span>
          </div>
          <div class="stat-chip">
            <span class="label">환갑 해</span>
            <span class="value" id="v-hwangap">{list0[0].year}년</span>
          </div>
        </div>

        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>이름</th><th>만 나이로 되는 날</th><th>기준일에서</th><th>세는 나이로 지내면</th></tr>
            </thead>
            <tbody id="rows">
              {list0.map((m) => (
                <tr class={m.daysLeft < 0 ? "ms-past" : undefined}>
                  <th scope="row">{m.name} <span class="meta">{m.hanja} · {m.yearDefined ? `${m.n}돌` : `${m.n}세`}</span></th>
                  <td>{label(m.day)}</td>
                  <td>{dday(m.day, t0)}</td>
                  <td>{m.yearDefined ? `${m.countingYear}년 (같은 해)` : `${m.countingYear}년`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="hint" id="note">지난 기념 나이는 흐리게 보입니다. 날짜는 모두 양력입니다.</p>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <h2>이렇게 셉니다</h2>
      <ul>
        <li>
          <strong>환갑은 태어난 해에 60을 더한 해</strong> — 국어사전 뜻풀이가 '태어난 지 60돌이 되는 해'입니다. 그해
          생일에 만 60세가 되고, 세는 나이로는 그해 내내 61세라 어느 쪽으로 세도 같은 해입니다. 진갑은 그 이듬해입니다.
        </li>
        <li>
          <strong>칠순·팔순은 두 해 중 하나</strong> — 사전은 칠순을 '일흔 살', 팔순을 '여든 살'이라고만 적어서 만 나이인지
          세는 나이인지 정하지 않습니다. 만 70세 생일로 지내면 태어난 해 + 70, 세는 나이 70세로 지내면 태어난 해 + 69년입니다.
          표에는 두 해를 다 적었습니다. 어느 해에 잔치를 할지는 집안에서 정하면 됩니다.
        </li>
        <li>
          <strong>만 나이로 되는 날은 생일</strong> — 만 나이 계산기와 같은 셈으로, 그 나이 번째 생일에 한 살 더해집니다.
          2월 29일생은 평년이면 2월 28일로 나이가 다 차서 3월 1일에 한 살 더해집니다(민법 제160조 ③).
        </li>
        <li>
          <strong>음력 생일은 넣지 않습니다</strong> — 음력을 양력으로 바꾸는 표를 아직 원문으로 확인하지 못했습니다.
          음력 생일로 지내면 그해 달력에서 음력 날짜를 따로 찾아 주세요.
        </li>
      </ul>

      <details>
        <summary>환갑은 만 60세인가요, 61세인가요?</summary>
        <p>
          둘 다 맞는 말입니다. 환갑은 태어난 지 60년이 되는 해라 그해 생일에 만 60세가 되고, 예전 셈(세는 나이)으로는
          그해가 61세입니다. 1966년생이면 2026년이 환갑, 2027년이 진갑입니다.
        </p>
      </details>

      <details>
        <summary>칠순은 몇 년생이 언제 하나요?</summary>
        <p>
          만 나이로는 태어난 해에 70을 더한 해 생일입니다 — 1956년생이면 2026년. 세는 나이 70세로 지내는 집은 한 해
          앞선 2025년에 합니다. 2023년부터 법과 행정은 만 나이로 통일됐지만, 잔치 나이는 집안 관습을 따르는 경우가 많습니다.
        </p>
      </details>

      <details>
        <summary>희수·미수·백수는 몇 살인가요?</summary>
        <p>
          희수(喜壽)는 일흔일곱 살, 미수(米壽)는 여든여덟 살, 백수(白壽)는 아흔아홉 살입니다. 망팔·망구·망백은 각각 여든·아흔·백을
          바라보는 일흔한·여든한·아흔한 살입니다. 모두 표준국어대사전 뜻풀이를 따랐습니다.
        </p>
      </details>

      <p>
        지금 만 나이와 다음 생일은 <a href="/tools/age/">만 나이 계산기</a>, 생일까지 남은 날은
        <a href="/tools/birthday-dday/">생일 디데이</a>, 특정한 날까지 남은 날은 <a href="/tools/dday/">디데이 계산기</a>가 셉니다.
      </p>

      <AdSlot label="milestone-age-result" />
    </main>
    <SiteFooter />
    <style>
      tr.ms-past { opacity: 0.55; }
      tr th .meta { font-weight: 400; white-space: nowrap; }
    </style>
    <script src="../../../scripts/milestone-age.ts"></script>
    <TrackLinks />
    <script src="../../../scripts/calc-ui.ts"></script>
  </body>
</html>
