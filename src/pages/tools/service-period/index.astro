---
/**
 * 근속 기간 계산기 — 날짜·시간 묶음(/tools/service-period/). 계산은 lib/service-period.ts.
 *
 * 입사일 · 마지막 근무일(또는 퇴직일) → 몇 년 몇 개월 며칠 · 재직일수 · 1년 이상인지 · 다음 만 N년.
 * 년·월·일은 민법 제160조(만 나이 계산기와 같은 셈), 재직일수·퇴직일은 고용노동부 퇴직금 계산과 같은 셈.
 * 원문은 rates/service-period-2026.json. roberin #93 은 입력·결과 항목만 대조했다(docs/calc-benchmark.md).
 * 첫 화면 숫자는 빌드 때 고정 예시로 계산하고, 스크립트가 종료일을 오늘로 바꾼다.
 * 동의어는 네이버 자동완성(keywords/ac-service-period-2026-10-19.csv).
 */
import BaseHead from "../../../components/BaseHead.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import GtagHead from "../../../components/GtagHead.astro";
import TrackLinks from "../../../components/TrackLinks.astro";
import AdSenseHead from "../../../components/AdSenseHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/global.css";
import rates from "../../../rates/service-period-2026.json";
import { servicePeriodOf, periodText } from "../../../lib/service-period";
import { label } from "../../../lib/date-calc";

const title = "근속 기간 계산기 — 입사일부터 몇 년 몇 개월 며칠";
const description =
  "입사일과 마지막 근무일을 넣으면 근속 기간이 몇 년 몇 개월 며칠인지, 재직일수·다 찬 개월 수·근속연수와 1년 이상인지를 계산합니다. 민법 기간 계산(말일 규칙)과 고용노동부 퇴직금 계산의 재직일수 셈을 따릅니다.";

/** 첫 화면 예시 — 2020-03-15 입사, 2026-10-18 마지막 근무 */
const P0 = servicePeriodOf("2020-03-15", "2026-10-18")!;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>근속 기간 계산기</h1>
      <p>
        입사일과 마지막으로 일한 날을 넣으면 몇 년 몇 개월 며칠 다녔는지 나옵니다. 지금 다니는 회사라면 종료일을 오늘로
        두면 됩니다. 넣는 대로 바로 바뀝니다.
      </p>

      <div class="calc-card">
        <div class="calc-input-wrap">
          <label for="sp-start">입사일</label>
          <input type="date" id="sp-start" value="2020-03-15" min="1900-01-01" max="9999-12-30" />
        </div>
        <div class="calc-input-wrap">
          <label for="sp-end">종료일</label>
          <input type="date" id="sp-end" value="2026-10-18" min="1900-01-01" max="9999-12-30" />
        </div>
        <div class="calc-input-wrap">
          <label for="sp-kind">종료일은</label>
          <select id="sp-kind" data-seg>
            <option value="last" selected>마지막 근무일</option>
            <option value="retire">퇴직일 (다음 날)</option>
          </select>
        </div>

        <div class="actions">
          <button id="sp-today" type="button" class="secondary">종료일을 오늘로</button>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="sp-hero">
          <p class="label" id="sp-label">근속 기간</p>
          <p class="big" id="sp-hero">{periodText(P0)}</p>
          <p class="hint" id="sp-sub">{label(P0.start)} 입사 → {label(P0.last)}까지 근무 · 퇴직일 {label(P0.retire)}</p>
        </div>

        <div class="stat-row" data-receipt>
          <div class="stat-chip">
            <span class="label">재직일수</span>
            <span class="value" id="sp-days">{P0.serviceDays.toLocaleString("ko-KR")}일</span>
          </div>
          <div class="stat-chip">
            <span class="label">다 찬 개월</span>
            <span class="value" id="sp-months">{P0.totalMonths.toLocaleString("ko-KR")}개월</span>
          </div>
          <div class="stat-chip">
            <span class="label">주</span>
            <span class="value" id="sp-weeks">{P0.weeks.toLocaleString("ko-KR")}주 {P0.weekRest}일</span>
          </div>
          <div class="stat-chip">
            <span class="label">근속연수 (재직일수 ÷ 365)</span>
            <span class="value" id="sp-yd">{P0.yearsDecimal.toFixed(2)}년</span>
          </div>
        </div>
        <p class="hint" id="sp-one">계속근로 1년 이상입니다. 퇴직금은 4주 평균 주 15시간 이상 일했다면 받는 대상입니다.</p>
        <p class="hint" id="sp-next">만 {P0.nextYears}년은 {label(P0.nextLastDay)}까지 일하면 찹니다.</p>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <h2>이렇게 계산합니다</h2>
      <ul>
        <li>
          <strong>입사일을 첫날로 셉니다.</strong> 하루의 0시부터 시작하는 기간은 첫날을 넣어 센다는 민법 제157조 단서를
          따릅니다. 입사 당일 그만두면 1일입니다.
        </li>
        <li>
          <strong>1년·1개월은 달력으로 셉니다.</strong> 3월 15일 입사라면 다음 해 3월 14일까지 일했을 때 1년이 찹니다(민법
          제160조 ②). 그 달에 같은 날이 없으면 그 달 말일까지 일하면 찹니다(③). 1월 31일 입사는 2월 말일까지 일하면
          1개월이고, 2월 29일 입사는 다음 해 2월 28일까지 일하면 1년입니다.
        </li>
        <li>
          <strong>퇴직일은 마지막 근무일 다음 날입니다.</strong> 고용노동부 퇴직금 계산이 이렇게 정합니다. 사직서에 적은
          날이 마지막으로 일한 날이면 '마지막 근무일', 그다음 날이면 '퇴직일'을 고르세요.
        </li>
        <li>
          <strong>재직일수</strong>는 입사일부터 마지막 근무일까지 양 끝을 넣은 날수입니다. <strong>근속연수</strong>는
          재직일수 ÷ 365 로, 퇴직금 계산(1일 평균임금 × 30일 × 재직일수 ÷ 365)에 들어가는 값입니다. 소수 셋째 자리부터
          버립니다.
        </li>
      </ul>

      <details>
        <summary>육아휴직 기간도 근속기간에 들어가나요?</summary>
        <p>
          들어갑니다. 남녀고용평등과 일·가정 양립 지원에 관한 법률 제19조 ④가 육아휴직 기간을 근속기간에 포함한다고
          정합니다. 이 계산기는 입사일부터 마지막 근무일까지를 그대로 세므로 육아휴직 기간을 따로 빼지 않습니다. 다른
          휴직은 사유에 따라 따져 봐야 해서 이 계산기가 판단하지 않습니다.
        </p>
      </details>

      <details>
        <summary>날짜 계산기와 개월 수가 다르게 나와요</summary>
        <p>
          말일에 입사한 경우에 그럴 수 있습니다. <a href="/tools/date-diff/">날짜 계산기</a>는 없는 날을 그 달 말일로
          당겨서 세고, 이 계산기는 민법 제160조 ③대로 그 달 말일까지 일해야 한 달이 찬 것으로 셉니다. 근속 기간은 이
          계산기의 셈을 쓰세요. <a href="/tools/age/">만 나이 계산기</a>와 같은 셈입니다.
        </p>
      </details>

      <details>
        <summary>퇴직소득세의 근속연수와 같은가요?</summary>
        <p>
          아닙니다. 세금을 계산할 때 쓰는 근속연수는 세법 기준이라 따로 셉니다.
          <a href="/guide/severance-tax-calculator/">퇴직소득세 계산기</a>에서 확인하세요.
        </p>
      </details>

      <p>
        근속 기간을 알았다면 <a href="/guide/severance-pay-calculator/">퇴직금 계산기</a>로 받을 돈을,
        <a href="/guide/annual-leave-calculator/">연차 계산기</a>로 생기는 연차를 확인할 수 있습니다.
      </p>

      <p class="hint">
        근거:
        {rates.sources.map((s, i) => (
          <>
            {i > 0 && " · "}
            <a href={s.url} rel="noopener" target="_blank">{s.name.split(" — ")[0].split("(")[0]}</a>
          </>
        ))}
        (확인 {rates.verifiedOn})
      </p>

      <AdSlot label="service-period-result" />
    </main>
    <SiteFooter />
    <style>
      #sp-hero { overflow-wrap: anywhere; }
    </style>
    <script src="../../../scripts/service-period.ts"></script>
    <TrackLinks />
    <script src="../../../scripts/calc-ui.ts"></script>
  </body>
</html>
