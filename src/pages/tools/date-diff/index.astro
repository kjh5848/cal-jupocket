---
/**
 * 날짜 계산기 — 두 번째 범용 도구(/tools/, 날짜·시간 묶음). 계산은 lib/date-calc.ts.
 *
 * 두 질문: ① 두 날짜 사이가 며칠·몇 개월인가(평일·업무일 포함) ② 기준일에서 며칠·몇 주·몇 개월 뒤(앞)는 언제인가.
 * 업무일은 관공서 공휴일 목록(rates/kr-holidays-2026.json — 규정 2026. 4. 30. 개정, 천문연구원 음력)으로 뺀다.
 * roberin #76 은 입력·결과 항목만 대조했다(docs/calc-benchmark.md). 첫 화면 숫자는 빌드 때 lib 로 계산한다.
 */
import BaseHead from "../../../components/BaseHead.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import GtagHead from "../../../components/GtagHead.astro";
import TrackLinks from "../../../components/TrackLinks.astro";
import AdSenseHead from "../../../components/AdSenseHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/global.css";
import holidays from "../../../rates/kr-holidays-2026.json";
import { toDay, span, spanText, label } from "../../../lib/date-calc";

const title = "날짜 계산기 — 두 날짜 사이 며칠·며칠 뒤·업무일";
const description =
  "두 날짜 사이가 며칠·몇 개월인지, 오늘부터 100일 뒤가 언제인지 바로 계산합니다. 주말과 2026~2027년 관공서 공휴일(대체공휴일 포함)을 뺀 업무일도 셉니다.";

const START = "2026-10-19";
const END = "2026-12-31";
const s0 = span(toDay(START)!, toDay(END)!, false);
const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split("-").map(Number);
  return `${y}. ${m}. ${d}.`;
};
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>날짜 계산기</h1>
      <p>
        두 날짜 사이 기간을 셀지, 한 날짜에서 앞뒤로 옮길지 먼저 고르세요. 날짜를 바꾸면 결과가
        바로 바뀝니다.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="mode">계산할 것</label>
          <select id="mode" data-seg>
            <option value="span" selected>두 날짜 사이</option>
            <option value="shift">며칠 뒤·앞</option>
          </select>
        </div>

        <div id="span-fields">
          <div class="calc-input-wrap">
            <label for="start">시작일</label>
            <input type="date" id="start" value={START} />
          </div>
          <div class="calc-input-wrap">
            <label for="end">종료일</label>
            <input type="date" id="end" value={END} />
          </div>
          <div class="calc-input-wrap toggle-row">
            <label for="inclusive">시작일과 종료일을 모두 센다 (종료일 포함)</label>
            <input type="checkbox" id="inclusive" />
          </div>
        </div>

        <div id="shift-fields" hidden>
          <div class="calc-input-wrap">
            <label for="base">기준일</label>
            <input type="date" id="base" value={START} />
          </div>
          <div class="calc-input-wrap">
            <label for="amount">얼마나</label>
            <input type="number" inputmode="numeric" id="amount" value="100" min="0" max="36500" data-step />
            <select id="unit" aria-label="단위">
              <option value="day" selected>일</option>
              <option value="week">주</option>
              <option value="month">개월</option>
              <option value="year">년</option>
            </select>
          </div>
          <div class="calc-input-wrap">
            <label for="dir">방향</label>
            <select id="dir" data-seg>
              <option value="after" selected>뒤 (미래)</option>
              <option value="before">앞 (과거)</option>
            </select>
          </div>
          <div class="calc-input-wrap toggle-row" id="biz-wrap">
            <label for="biz">업무일로 센다 (토·일·공휴일 건너뜀)</label>
            <input type="checkbox" id="biz" />
          </div>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">두 날짜 사이</p>
          <p class="big" id="hero-value">{s0.days}일</p>
          <p class="hint" id="hero-sub">{spanText(s0)} · {s0.weeks}주 {s0.weekRest}일 · {s0.hours.toLocaleString("ko-KR")}시간</p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          <div class="stat-chip">
            <span class="label" id="l1">평일 (토·일 뺌)</span>
            <span class="value" id="v1">{s0.weekdays}일</span>
          </div>
          <div class="stat-chip">
            <span class="label" id="l2">업무일 (공휴일도 뺌)</span>
            <span class="value" id="v2">{s0.businessDays}일</span>
          </div>
          <div class="stat-chip">
            <span class="label" id="l3">기간</span>
            <span class="value" id="v3">{label(s0.from)} → {label(s0.to)}</span>
          </div>
        </div>
        <p class="hint" id="note"></p>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <h2>며칠인지 셀 때 헷갈리는 것</h2>
      <ul>
        <li>
          <strong>종료일 포함</strong> — 기본은 두 날짜의 간격(종료일 − 시작일)입니다. 10월 1일에
          시작해 10월 3일에 끝나는 일정을 '3일 동안'으로 세려면 종료일 포함을 켜세요. 켜면 개월 수도
          종료일 다음 날까지로 셉니다(1월 1일 ~ 12월 31일 = 1년).
        </li>
        <li>
          <strong>개월 수</strong> — 시작일에서 한 달씩 넘기며 셉니다. 1월 31일의 한 달 뒤처럼 그 달에
          없는 날이면 그 달 말일(2월 28일)로 맞춥니다.
        </li>
        <li>
          <strong>업무일로 며칠 뒤</strong> — 기준일 당일은 세지 않고 다음 업무일부터 1일로 셉니다.
          금요일 기준 업무일 1일 뒤는 다음 주 월요일(공휴일이면 그다음 업무일)입니다.
        </li>
      </ul>

      <h2>업무일에서 빼는 공휴일</h2>
      <p>
        「관공서의 공휴일에 관한 규정」을 따릅니다. 2026년 4월 30일 개정으로 <strong>노동절(5월 1일)</strong>이
        2026년 5월 1일부터, <strong>제헌절(7월 17일)</strong>이 2026년 5월 11일부터 공휴일이 됐습니다. 대체공휴일은
        국경일·어린이날·노동절·부처님 오신 날·성탄절이 토·일과 겹칠 때, 설·추석 연휴는 일요일과 겹칠 때만
        생깁니다. 1월 1일과 현충일은 대체공휴일이 없습니다. 음력 날짜는 한국천문연구원 자료로 맞췄습니다.
      </p>
      <details>
        <summary>2026~2027년 공휴일 목록 ({holidays.holidays.length}일)</summary>
        <ul>
          {holidays.holidays.map((h) => <li>{fmtDate(h.date)} {h.name}</li>)}
        </ul>
      </details>

      <details>
        <summary>회사 휴무일과 다를 수 있나요?</summary>
        <p>
          이 목록은 관공서 공휴일입니다. 회사가 실제로 쉬는 날은 사업장 규모·취업규칙에 따라 다를 수
          있고, 회사 창립기념일이나 정부가 따로 지정하는 임시공휴일은 들어 있지 않습니다.
          임시공휴일이 정해지면 목록에 더합니다(확인일 {holidays.verifiedOn}).
        </p>
      </details>

      <details>
        <summary>2028년 이후 날짜는 업무일이 왜 안 나오나요?</summary>
        <p>
          설·추석·부처님 오신 날은 음력이라 해마다 날짜가 바뀌고, 대체공휴일 규칙도 개정될 수
          있어서 원문으로 확인한 {holidays.range.from.slice(0, 4)}~{holidays.range.to.slice(0, 4)}년만
          계산합니다. 범위 밖이면 평일(토·일만 뺀 날) 수까지만 보여 줍니다.
        </p>
      </details>

      <p>
        연차가 며칠 생기는지는 <a href="/guide/annual-leave-calculator/">연차 계산기</a>, 퇴직금
        근속 기간은 <a href="/guide/severance-pay-calculator/">퇴직금 계산기</a>가 따로 셉니다.
      </p>

      <AdSlot label="date-diff-result" />
    </main>
    <SiteFooter />
    <script src="../../../scripts/date-diff.ts"></script>
    <TrackLinks />
    <script src="../../../scripts/calc-ui.ts"></script>
  </body>
</html>
