---
/**
 * 올해 남은 날 — 날짜·시간 묶음의 도구(/tools/year-left/). 계산은 lib/year-left.ts.
 *
 * 질문 하나: 올해가 며칠 남았고, 오늘이 몇 번째 날이며, 몇 % 지났나.
 * 윤년·연중 일수는 날짜 요일 계산기와 같은 셈(rates/date-day-2026.json), 공휴일은 관공서 공휴일 목록
 * (rates/kr-holidays-2026.json). roberin #84 는 입력·결과 항목만 대조했다(docs/calc-benchmark.md).
 * 첫 화면 숫자는 예시로 빌드 때 계산하고, 스크립트가 열린 날 오늘로 바꿔 다시 센다.
 */
import BaseHead from "../../../components/BaseHead.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import GtagHead from "../../../components/GtagHead.astro";
import TrackLinks from "../../../components/TrackLinks.astro";
import AdSenseHead from "../../../components/AdSenseHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/global.css";
import { toDay, label, dday, durationText } from "../../../lib/date-calc";
import { yearLeft, monthFirsts, pctText } from "../../../lib/year-left";

const title = "올해 남은 날 — 올해 며칠 남았나, 몇 번째 날, 몇 % 지났나";
const description =
  "오늘 기준으로 올해가 며칠 남았는지(오늘 제외·포함), 오늘이 몇 번째 날인지, 올해가 몇 % 지났는지 바로 나옵니다. 남은 주말·평일과 공휴일을 뺀 업무일, 100일·50일 남은 날도 함께 봅니다.";

const BASE = "2026-10-19";
const t0 = toDay(BASE)!;
const r0 = yearLeft(t0);
const firsts0 = monthFirsts(r0.year);
const fmt = (n: number) => n.toLocaleString("ko-KR");
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>올해 남은 날</h1>
      <p>
        오늘 기준으로 올해가 며칠 남았는지, 오늘이 올해 몇 번째 날인지, 올해가 몇 % 지났는지 셉니다. 다른 날짜를
        넣으면 그날 기준으로 다시 셉니다.
      </p>

      <div class="calc-card">
        <div class="calc-input-wrap">
          <label for="base">기준일 (보통 오늘)</label>
          <input type="date" id="base" value={BASE} min="1900-01-01" max="2100-12-31" />
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">{r0.year}년 남은 날 (오늘 제외)</p>
          <p class="big" id="hero-value">{fmt(r0.daysLeft)}일</p>
          <p class="hint" id="hero-sub">오늘 포함 {fmt(r0.daysLeftIncl)}일 · 오늘은 {r0.dayOfYear}번째 날 / {r0.daysInYear}일</p>
        </div>

        <div class="calc-input-wrap">
          <p class="label">올해 진행률</p>
          <div class="yl-bar" role="progressbar" aria-labelledby="bar-text" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.floor(r0.progress)} id="bar" data-bar>
            <i style={`width:${r0.progress.toFixed(2)}%`} id="bar-fill"></i>
          </div>
          <p class="hint" id="bar-text">1월 1일 0시부터 {pctText(r0.progress)} 지남</p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          <div class="stat-chip">
            <span class="label">새해 0시까지</span>
            <span class="value" id="v-newyear">{durationText(r0.secondsToNewYear)}</span>
          </div>
          <div class="stat-chip">
            <span class="label">남은 주</span>
            <span class="value" id="v-weeks">{r0.weeks}주 {r0.weekRest}일</span>
          </div>
          <div class="stat-chip">
            <span class="label">이번 달 끝까지</span>
            <span class="value" id="v-month">{r0.monthLeft}일</span>
          </div>
          <div class="stat-chip">
            <span class="label">이번 분기 끝까지</span>
            <span class="value" id="v-quarter">{r0.quarterLeft}일 ({r0.quarter}분기)</span>
          </div>
          <div class="stat-chip">
            <span class="label">남은 토요일 · 일요일</span>
            <span class="value" id="v-weekend">토 {r0.saturdays} · 일 {r0.sundays}</span>
          </div>
          <div class="stat-chip">
            <span class="label">남은 평일</span>
            <span class="value" id="v-weekdays">{r0.weekdays}일</span>
          </div>
          <div class="stat-chip">
            <span class="label">남은 업무일 (공휴일 뺌)</span>
            <span class="value" id="v-business">{r0.businessDays === null ? "—" : `${r0.businessDays}일`}</span>
          </div>
        </div>
        <p class="hint" id="note">남은 토·일·평일·업무일은 내일부터 12월 31일까지 셉니다.</p>

        <details open>
          <summary>연말까지 N일 남은 날</summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>남은 날</th><th>날짜</th><th>기준일에서</th></tr></thead>
              <tbody id="ms-rows">
                {r0.milestones.map((m) => (
                  <tr><th scope="row">{m.left}일 남은 날</th><td>{label(m.day)}</td><td>{dday(m.day, t0)}</td></tr>
                ))}
                <tr><th scope="row">마지막 날</th><td>{label(r0.lastDay)}</td><td>{dday(r0.lastDay, t0)}</td></tr>
              </tbody>
            </table>
          </div>
        </details>

        <details>
          <summary>남은 공휴일</summary>
          <ul id="hol-list">
            {r0.holidays!.map((h) => <li>{label(h.day)} {h.name}</li>)}
          </ul>
          <p class="meta" id="hol-note">관공서 공휴일 목록(2026~2027년) 기준입니다.</p>
        </details>

        <details>
          <summary>매월 1일 기준 남은 날</summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>날짜</th><th>몇 번째 날</th><th>남은 날 (그날 제외)</th></tr></thead>
              <tbody id="mf-rows">
                {firsts0.map((f) => (
                  <tr><th scope="row">{label(f.day)}</th><td>{f.dayOfYear}번째</td><td>{fmt(f.daysLeft)}일</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <h2>이렇게 셉니다</h2>
      <ul>
        <li>
          <strong>남은 날은 오늘을 빼고</strong> — 그해 날 수(평년 365일, 윤년 366일)에서 오늘이 몇 번째 날인지를
          뺍니다. 내일부터 12월 31일까지의 날 수와 같습니다. 오늘까지 하루로 치면 하나 더한 '오늘 포함'이 됩니다.
          12월 31일에는 남은 날 0일, 오늘 포함 1일입니다.
        </li>
        <li>
          <strong>진행률은 시간으로</strong> — 1월 1일 0시부터 지금까지 흐른 시간을 그해 전체 시간으로 나눕니다.
          소수 첫째 자리에서 버려서 12월 31일 밤에도 100%가 되지 않고, 새해 0시에 0%로 돌아갑니다. 기준일을 오늘이
          아닌 날로 바꾸면 그날 0시를 기준으로 셉니다.
        </li>
        <li>
          <strong>업무일은 공휴일까지 뺍니다</strong> — 남은 평일에서 평일에 낀 관공서 공휴일(대체공휴일 포함)을
          뺐습니다. 공휴일 목록이 있는 2026~2027년만 나오고, 회사 창립기념일·연차 같은 개인 일정은 빼지 않습니다.
        </li>
        <li>
          <strong>윤년은 저절로</strong> — 4로 나눠지면 윤년, 100으로 나눠지면 평년, 400으로 나눠지면 다시 윤년입니다.
          2028년은 366일이라 12월 31일이 366번째 날입니다.
        </li>
      </ul>

      <details>
        <summary>'올해 며칠 남았나'는 오늘을 넣고 세나요, 빼고 세나요?</summary>
        <p>
          보통은 빼고 셉니다 — 오늘은 이미 쓰고 있는 날이라서입니다. 마감까지 일할 날을 셀 때도 오늘을 빼는 편이
          맞습니다. 달력에 남은 칸을 세듯 오늘까지 넣고 싶으면 '오늘 포함' 값을 보면 됩니다. 두 값은 항상 하루 차이입니다.
        </p>
      </details>

      <details>
        <summary>100일 남은 날은 언제인가요?</summary>
        <p>
          12월 31일에서 100일을 거꾸로 센 날입니다. 그날 기준으로 남은 날(오늘 제외)이 정확히 100일입니다. 연말에서
          세기 때문에 윤년이어도 날짜가 같아서 해마다 9월 22일입니다. 50일 남은 날은 11월 11일, 30일 남은 날은 12월 1일입니다.
        </p>
      </details>

      <details>
        <summary>해외에서 열면 결과가 달라지나요?</summary>
        <p>
          '오늘'과 '지금 시각'은 이 기기의 날짜·시간대를 따릅니다. 한국이 12월 31일 밤이어도 시차가 있는 곳에서는 아직
          12월 30일일 수 있어 하루 차이가 날 수 있습니다. 기준일을 직접 넣으면 시간대와 상관없이 그 날짜로 셉니다.
        </p>
      </details>

      <p>
        어떤 날짜가 올해 몇 번째 날·몇째 주인지는 <a href="/tools/date-day/">날짜 요일 계산기</a>, 특정한 날까지 남은
        날은 <a href="/tools/dday/">디데이 계산기</a>, 두 날짜 사이 기간은 <a href="/tools/date-diff/">날짜 계산기</a>가 셉니다.
      </p>

      <AdSlot label="year-left-result" />
    </main>
    <SiteFooter />
    <style>
      .yl-bar { height: 10px; border-radius: var(--r-pill); background: var(--surface-2); overflow: hidden; margin: 6px 0 4px; }
      .yl-bar i { display: block; height: 100%; border-radius: var(--r-pill); background: linear-gradient(90deg, #3f8ff0, #1f9c8e); transition: width 0.3s ease; }
    </style>
    <script src="../../../scripts/year-left.ts"></script>
    <TrackLinks />
    <script src="../../../scripts/calc-ui.ts"></script>
  </body>
</html>
