---
/**
 * 적립식 복리 계산기 — 범용 도구(/tools/). 처음 원금 + 매달 적립을 예상 연 수익률로 월마다 불린다.
 *
 * 은행 적금(약관 이자)은 /guide/installment-savings-calculator/ 가 하고, 이 페이지는 수익률·세율·물가를
 * 사용자가 정하는 투영이다. 세율 기본값만 rates(이자·배당 원천징수 15.4%)에서 온다. 계산은 lib/compound.ts.
 * roberin #41 은 입력·결과 항목만 대조했다(docs/calc-benchmark.md) — 일 단위 적립은 뺐다.
 */
import BaseHead from "../../../components/BaseHead.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import GtagHead from "../../../components/GtagHead.astro";
import TrackLinks from "../../../components/TrackLinks.astro";
import AdSenseHead from "../../../components/AdSenseHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { compound, won as round, DEFAULT_TAX_PCT, dailyCompound, daysToMultiple } from "../../../lib/compound";
import { formatWon } from "../../../lib/money";
import "../../../styles/global.css";

const title = "적립식 복리 계산기 — 원금·매달 적립·수익률로 몇 년 뒤 금액";
const description =
  "처음 넣은 돈과 매달 넣는 돈을 연 수익률로 월복리로 굴리면 몇 년 뒤 얼마가 되는지 계산합니다. 넣은 돈과 불어난 돈, 세후 금액, 물가를 뺀 오늘 가치, 목표 도달 시점과 연도별 표까지.";

const ex = compound({ principal: 10_000_000, monthly: 300_000, ratePct: 5, months: 120, timing: "start", taxPct: DEFAULT_TAX_PCT, inflationPct: 0 });
const w = (x: number) => formatWon(round(x));
// '하루 1% 복리' 질문 표 — 100만원을 매일 같은 비율로 불린 이론값(적립·세금 없음)
const dailyRates = [0.1, 0.5, 1, 2, 3];
const dailyDays = [30, 100, 365];
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>적립식 복리 계산기</h1>
      <p>
        처음 넣는 돈과 매달 넣을 돈, 기대하는 연 수익률을 넣으면 그 돈이 매달 불어나 몇 년 뒤 얼마가
        되는지 보여 줍니다. 수익률·세율·물가는 모두 가정값입니다 — 실제 상품의 약정 이자는
        <a href="/guide/installment-savings-calculator/">적금 이자 계산기</a>와
        <a href="/guide/deposit-interest-calculator/">예금 이자 계산기</a>가 따로 계산합니다.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="cp-principal">처음 넣는 돈</label>
          <input type="text" inputmode="numeric" id="cp-principal" value="10,000,000" data-won autocomplete="off" />
          <span class="unit">원</span>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-monthly">매달 넣는 돈</label>
          <input type="text" inputmode="numeric" id="cp-monthly" value="300,000" data-won autocomplete="off" />
          <span class="unit">원</span>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-rate">예상 연 수익률</label>
          <input type="number" id="cp-rate" value="5" min="-50" max="100" step="0.1" inputmode="decimal" />
          <span class="unit">%</span>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-period">기간</label>
          <input type="number" id="cp-period" value="10" min="1" max="600" step="1" data-step />
          <select id="cp-unit" aria-label="기간 단위">
            <option value="years" selected>년</option>
            <option value="months">개월</option>
          </select>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-timing">넣는 때</label>
          <select id="cp-timing" data-seg>
            <option value="start" selected>매달 초 (넣은 달부터 붙음)</option>
            <option value="end">매달 말 (다음 달부터 붙음)</option>
          </select>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-tax">수익에 매길 세율</label>
          <input type="number" id="cp-tax" value={DEFAULT_TAX_PCT} min="0" max="100" step="0.1" inputmode="decimal" />
          <span class="unit">%</span>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-infl">연 물가 상승률</label>
          <input type="number" id="cp-infl" value="0" min="-20" max="50" step="0.1" inputmode="decimal" />
          <span class="unit">%</span>
        </div>
        <div class="calc-input-wrap">
          <label for="cp-goal">목표 금액 (선택)</label>
          <input type="text" inputmode="numeric" id="cp-goal" value="" placeholder="예: 50,000,000" data-won autocomplete="off" />
          <span class="unit">원</span>
        </div>

        <div
          class="result-hero"
          aria-live="polite"
          aria-atomic="true"
          data-bar="cp-paid|cp-gain2"
          data-bar-labels="넣은 돈|불어난 돈"
          data-dock="cp-hero"
        >
          <p class="label">기간 끝 잔액 (세전)</p>
          <p class="big" id="cp-hero">{w(ex.balance)}</p>
          <p class="meta" id="cp-note">120개월 · 월 이율 0.4167% · 매달 초 적립</p>
        </div>
        <div class="stat-row" data-receipt>
          <div class="stat-chip"><span class="label">넣은 돈</span><span class="value" id="cp-paid">{w(ex.paid)}</span></div>
          <div class="stat-chip"><span class="label">불어난 돈</span><span class="value" id="cp-gain2">{w(ex.gain)}</span></div>
          <div class="stat-chip"><span class="label">세금 (가정)</span><span class="value" id="cp-tax-v">−{w(ex.tax)}</span></div>
          <div class="stat-chip"><span class="label">세후 금액</span><span class="value" id="cp-after">{w(ex.afterTax)}</span></div>
          <div class="stat-chip"><span class="label">오늘 돈 가치</span><span class="value" id="cp-real">{w(ex.real)}</span></div>
          <div class="stat-chip"><span class="label">목표 도달</span><span class="value" id="cp-goal-v">목표 없음</span></div>
        </div>

        <details>
          <summary>해마다 넣은 돈·불어난 돈·잔액</summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>기간</th><th>그 해 넣은 돈</th><th>그 해 불어난 돈</th><th>잔액</th></tr></thead>
              <tbody id="cp-rows">
                {ex.years.map((y) => <tr><th scope="row">{y.year}년째</th><td>{w(y.paid)}</td><td>{w(y.gain)}</td><td>{w(y.balance)}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="meta">처음 넣은 돈은 '그 해 넣은 돈'에 넣지 않고 잔액에만 들어갑니다.</p>
        </details>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <h2>어떻게 계산하나</h2>
      <ul>
        <li><strong>월 이율</strong> — 연 수익률 ÷ 12. 연 5%면 매달 0.4167%씩 붙는다고 봅니다.</li>
        <li><strong>매달 초 적립</strong> — 이번 달 넣은 돈까지 합친 잔액에 그달 수익이 붙습니다: (잔액 + 적립) × (1 + 월 이율).</li>
        <li><strong>매달 말 적립</strong> — 수익이 먼저 붙고 그다음에 넣습니다: 잔액 × (1 + 월 이율) + 적립. 마지막 달 적립금은 불지 않아 조금 적습니다.</li>
        <li><strong>세금</strong> — (잔액 − 넣은 돈)이 플러스일 때만 그 수익에 세율을 한 번 곱합니다. 손실이면 0원입니다.</li>
        <li><strong>오늘 돈 가치</strong> — 세후 금액 ÷ (1 + 연 물가 상승률)<sup>년수</sup>. 10년 뒤 6천만원이 지금 돈으로 얼마어치인지 보는 값입니다.</li>
      </ul>

      <details>
        <summary>세율 15.4%는 어디서 나온 숫자인가요?</summary>
        <p>
          예금 이자와 배당에 떼는 원천징수 세율입니다 — 소득세 14%(소득세법 제129조 제1항)와 그 10%인
          지방소득세 1.4%(지방세법 제103조의13). 주식을 팔아 남긴 차익은 대부분 이 세금이 없고, 연금저축·ISA
          같은 계좌는 세율이 다릅니다. 굴리는 상품에 맞게 0%나 다른 숫자로 바꿔 넣으세요.
        </p>
      </details>

      <details>
        <summary>적금 이자 계산기와 결과가 왜 다른가요?</summary>
        <p>
          적금은 약관에 정한 이율로 단리나 월복리 이자를 받고, 세금도 법에 따라 10원 미만을 버리며 뗍니다. 이
          계산기는 기대 수익률로 굴려 보는 어림이라 원 단위로만 반올림합니다. 처음 넣는 돈을 0원, 매달 초 적립,
          세율 0%로 두면 적금 계산기의 월복리 세전 이자와 같은 값이 나옵니다(원 미만 끝수만 다름).
        </p>
      </details>

      <details>
        <summary>목표 금액까지 몇 년 걸리는지도 볼 수 있나요?</summary>
        <p>
          목표 금액 칸에 넣으면 잔액이 처음 그 금액을 넘는 달을 보여 줍니다. 고른 기간 안에 못 닿으면 같은 적립액·수익률로
          계속 넣었을 때 몇 년 몇 개월째 닿는지를 '기간 밖'으로 따로 적습니다(100년 안에서만 찾음). 예를 들어 100만원으로
          시작해 매달 초 50만원씩, 연 8%로 굴리면 5천만원에는 75개월째(6년 3개월째) 닿고, 그달 잔액은 50,418,068원입니다.
          잔액·세금·연도별 표는 고른 기간까지만 계산합니다.
        </p>
      </details>

      <details>
        <summary>매달 넣지 않고 한 번에 넣은 돈만 굴리면요? 월 수익률로 알고 있으면요?</summary>
        <p>
          매달 넣는 돈을 0원으로 두면 거치식 단순 복리, 곧 원금 × (1 + 월 수익률)<sup>개월</sup>이 됩니다. 이 계산기는
          연 수익률을 12로 나눠 매달 붙이므로, '월 1%'처럼 월 수익률로 알고 있다면 연 수익률 칸에 12배(12%)를 넣으면
          같은 값이 나옵니다. 예를 들어 100만원을 월 1%로 12개월 굴리면 세전 1,126,825원(이익 126,825원), 500만원을
          월 0.8%로 36개월 굴리면 6,661,149원입니다. 하루 단위로 불리는 경우는 아래 '하루 1% 복리' 질문에 표로 적었습니다.
        </p>
      </details>

      <details>
        <summary>하루 1% 복리면 1년 뒤 얼마인가요? (일복리)</summary>
        <p>
          원금 하나를 매일 같은 비율로 불리면 마지막 금액은 원금 × (1 + 하루 수익률)<sup>일수</sup>입니다. 100만원을 하루 1%씩
          365일 불리면 {w(dailyCompound(1_000_000, 1, 365).balance)}, 약 {dailyCompound(1_000_000, 1, 365).multiple.toFixed(1)}배가
          되고 2배에는 {daysToMultiple(1, 2)}일째, 10배에는 {daysToMultiple(1, 10)}일째 닿습니다. 아래는 적립·세금 없이 100만원으로 계산한 이론값입니다.
        </p>
        <div class="table-scroll">
          <table>
            <thead><tr><th>하루 수익률</th>{dailyDays.map((d) => <th>{d}일 뒤</th>)}<th>2배 되는 날</th><th>1년으로 치면</th></tr></thead>
            <tbody>
              {dailyRates.map((r) => (
                <tr>
                  <th scope="row">{r}%</th>
                  {dailyDays.map((d) => <td>{w(dailyCompound(1_000_000, r, d).balance)}</td>)}
                  <td>{daysToMultiple(r, 2)}일째</td>
                  <td>{Math.round(dailyCompound(1, r, 0).annualPct).toLocaleString("ko-KR")}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          하루 0.1%만 돼도 1년으로 치면 {Math.round(dailyCompound(1, 0.1, 0).annualPct)}%가 넘습니다 — 매일 같은 수익률이 1년 내내 이어지는
          투자는 사실상 없어서, 이 표는 복리가 얼마나 빨리 커지는지 보는 계산일 뿐 기대할 수 있는 수익이 아닙니다. 위 계산기는 연
          수익률을 12로 나눠 매달 붙이는 월 단위라, 같은 연 수익률이면 하루 단위보다 아주 조금 적게 나옵니다. 날마다 이자가 붙는 파킹통장의 실제 이자는
          <a href="/guide/parking-account-interest-calculator/">파킹통장 이자 계산기</a>가 날짜별 잔액·금리로 따로 계산합니다.
        </p>
      </details>

      <details>
        <summary>수익률이 0%거나 마이너스면요?</summary>
        <p>
          0%면 넣은 돈이 그대로 남습니다. 마이너스 수익률도 넣을 수 있고, 이때 '불어난 돈'은 마이너스로 나오고
          세금은 매기지 않습니다. 실제 투자 수익률은 해마다 오르내려서 같은 평균이어도 결과가 달라집니다.
        </p>
      </details>

      <AdSlot label="compound-result" />
    </main>
    <SiteFooter />
    <script src="../../../scripts/compound.ts"></script>
    <TrackLinks />
    <script src="../../../scripts/calc-ui.ts"></script>
  </body>
</html>
