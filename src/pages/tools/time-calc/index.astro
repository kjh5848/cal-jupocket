---
/**
 * 시간 계산기 — 날짜·시간 묶음(/tools/time-calc/). 계산은 lib/time-calc.ts.
 *
 * 질문 둘: ① 이 시각에서 몇 시간 뒤(앞)는 언제인가 ② 두 시각 사이는 몇 시간인가.
 * 서머타임 없는 벽시계 산술(한국 표준시 UTC+9 고정과 같은 셈 — rates/unix-time-2026.json 의 표준시법).
 * 법 숫자가 없어 새 rates 는 없다. roberin #82 는 입력·결과 항목만 대조했다(docs/calc-benchmark.md).
 * 첫 화면 숫자는 빌드 때 고정 예시로 계산한다. 동의어는 네이버 자동완성(keywords/ac-time-calc-2026-10-19.csv).
 */
import BaseHead from "../../../components/BaseHead.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import GtagHead from "../../../components/GtagHead.astro";
import TrackLinks from "../../../components/TrackLinks.astro";
import AdSenseHead from "../../../components/AdSenseHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/global.css";
import { parseAt, shiftAt, atText, ampmText, dayShiftText, splitText, between, hoursText } from "../../../lib/time-calc";

const title = "시간 계산기 — 몇 시간 뒤 · 두 시각 사이 몇 시간";
const description =
  "시작 날짜·시각에 일·시간·분을 더하거나 빼면 끝나는 날짜·요일·시각이 나오고, 두 날짜·시각을 넣으면 사이가 몇 시간 몇 분인지 총 시간·총 분으로 계산합니다. 자정·월말·윤년을 넘겨도 맞게 셉니다.";

/** 첫 화면 예시 — 2026-10-19 09:30 + 2시간 45분, 09:00 ~ 18:00 */
const S0 = parseAt("2026-10-19", "09:30")!;
const E0 = shiftAt(S0, 165, 1)!;
const B0 = between(parseAt("2026-10-19", "09:00")!, parseAt("2026-10-19", "18:00")!);
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>시간 계산기</h1>
      <p>
        출발·시작 시각에 걸리는 시간을 더하면 끝나는 날짜와 시각이 나옵니다. 거꾸로 빼면 언제 시작해야 하는지가 나옵니다.
        아래 칸에서는 두 시각 사이가 몇 시간인지 셉니다. 넣는 대로 바로 바뀝니다.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="a-op">계산</label>
          <select id="a-op" data-seg>
            <option value="1" selected>더하기 (몇 시간 뒤)</option>
            <option value="-1">빼기 (몇 시간 전)</option>
          </select>
        </div>
        <div class="calc-input-wrap">
          <label for="a-date">시작 날짜</label>
          <input type="date" id="a-date" value="2026-10-19" min="1900-01-01" max="9999-12-30" />
        </div>
        <div class="calc-input-wrap">
          <label for="a-time">시작 시각</label>
          <input type="time" id="a-time" value="09:30" />
        </div>
        <div class="calc-input-wrap">
          <label for="a-d">일</label>
          <input type="number" id="a-d" inputmode="numeric" min="0" step="1" value="0" data-step />
        </div>
        <div class="calc-input-wrap">
          <label for="a-h">시간</label>
          <input type="number" id="a-h" inputmode="numeric" min="0" step="1" value="2" data-step />
        </div>
        <div class="calc-input-wrap">
          <label for="a-m">분</label>
          <input type="number" id="a-m" inputmode="numeric" min="0" step="1" value="45" data-step />
        </div>

        <div class="actions">
          <button id="a-now" type="button" class="secondary">지금 시각으로</button>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="a-hero">
          <p class="label" id="a-label">2시간 45분 뒤</p>
          <p class="big" id="a-hero">{atText(E0)}</p>
          <p class="hint" id="a-sub">{ampmText(E0)} · {dayShiftText(S0, E0)}</p>
        </div>

        <div class="stat-row" data-receipt>
          <div class="stat-chip">
            <span class="label">시작</span>
            <span class="value" id="a-from">{atText(S0)}</span>
          </div>
          <div class="stat-chip">
            <span class="label">더한 기간</span>
            <span class="value" id="a-span">{splitText(165)}</span>
          </div>
          <div class="stat-chip">
            <span class="label">총 시간</span>
            <span class="value" id="a-hours">{hoursText(165)}시간</span>
          </div>
          <div class="stat-chip">
            <span class="label">총 분</span>
            <span class="value" id="a-mins">165분</span>
          </div>
        </div>
        <p class="hint" id="a-note"></p>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <h2 id="between">두 시각 사이 몇 시간</h2>
      <p>
        시작과 끝 날짜·시각을 넣으면 사이가 며칠 몇 시간 몇 분인지, 모두 몇 시간·몇 분인지 나옵니다. 밤을 넘기면 끝
        날짜를 다음 날로 바꾸세요.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="b-sdate">시작 날짜</label>
          <input type="date" id="b-sdate" value="2026-10-19" min="1900-01-01" max="9999-12-30" />
        </div>
        <div class="calc-input-wrap">
          <label for="b-stime">시작 시각</label>
          <input type="time" id="b-stime" value="09:00" />
        </div>
        <div class="calc-input-wrap">
          <label for="b-edate">끝 날짜</label>
          <input type="date" id="b-edate" value="2026-10-19" min="1900-01-01" max="9999-12-30" />
        </div>
        <div class="calc-input-wrap">
          <label for="b-etime">끝 시각</label>
          <input type="time" id="b-etime" value="18:00" />
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true">
          <p class="label" id="b-label">사이</p>
          <p class="big" id="b-hero">{splitText(B0.total)}</p>
          <p class="hint" id="b-sub">시작부터 끝까지</p>
        </div>

        <div class="stat-row" data-receipt>
          <div class="stat-chip">
            <span class="label">총 시간</span>
            <span class="value" id="b-hours">{hoursText(B0.total)}시간</span>
          </div>
          <div class="stat-chip">
            <span class="label">총 분</span>
            <span class="value" id="b-mins">{B0.total.toLocaleString("ko-KR")}분</span>
          </div>
          <div class="stat-chip">
            <span class="label">시:분</span>
            <span class="value" id="b-hm">{Math.floor(B0.total / 60)}:{String(B0.total % 60).padStart(2, "0")}</span>
          </div>
        </div>
        <p class="hint" id="b-note"></p>
      </div>

      <h2>이렇게 계산합니다</h2>
      <ul>
        <li>
          <strong>하루 = 24시간 = 1,440분</strong>으로 날짜와 시각을 분 하나로 바꿔 더하고 뺍니다. 그래서 자정·월말·연말을
          넘겨도, 2월 29일이 있는 해도 날짜가 맞게 넘어갑니다.
        </li>
        <li>
          <strong>넘친 값도 그대로</strong> — 30시간 90분을 넣으면 1일 7시간 30분으로 셉니다. 기간 칸은 0 이상의 정수만
          받습니다. 1시간 30분은 시간 1, 분 30 으로 넣으세요.
        </li>
        <li>
          <strong>몇 시간 전은 '빼기'</strong> — 도착 시각에서 걸리는 시간을 빼면 출발해야 하는 시각이 나옵니다.
        </li>
        <li>
          <strong>총 시간</strong>은 총 분 ÷ 60 을 소수 둘째 자리에서 반올림한 값입니다. 7시간 45분 = 7.75시간.
        </li>
      </ul>

      <details>
        <summary>서머타임(일광절약시간)은 반영되나요?</summary>
        <p>
          아니요. 한국 시각처럼 서머타임이 없는 시계로 셉니다. 지금 한국 표준시는 표준시에 관한 법률이 정한 동경
          135도 기준(UTC+9)이고 서머타임을 쓰지 않습니다. 서머타임을 쓰는 나라에서 시계를 바꾸는 날을 넘기면 실제
          흐른 시간과 1시간 차이가 날 수 있습니다.
        </p>
      </details>

      <details>
        <summary>초 단위도 되나요?</summary>
        <p>
          분까지 셉니다. 초가 필요하면 <a href="/tools/unix-time/">유닉스 타임스탬프 변환기</a>에서 두 시각을 숫자로
          바꿔 빼면 초 차이가 나옵니다.
        </p>
      </details>

      <p>
        며칠 뒤·두 날짜 사이 날수는 <a href="/tools/date-diff/">날짜 계산기</a>, 목표일까지 남은 시간은
        <a href="/tools/dday/">디데이 계산기</a>, 어떤 날짜가 무슨 요일인지는 <a href="/tools/date-day/">날짜 요일 계산기</a>가 셉니다.
      </p>

      <AdSlot label="time-calc-result" />
    </main>
    <SiteFooter />
    <style>
      #a-hero, #b-hero { overflow-wrap: anywhere; }
    </style>
    <script src="../../../scripts/time-calc.ts"></script>
    <TrackLinks />
    <script src="../../../scripts/calc-ui.ts"></script>
  </body>
</html>
