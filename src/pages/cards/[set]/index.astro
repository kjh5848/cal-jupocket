---
/**
 * 카드 세트 한 벌 — 발행한 카드를 순서대로 보여준다.
 *
 * 아트보드를 다시 렌더하지 않고 이미 뽑아둔 발행본 JPEG 를 쓴다. 갤러리가
 * 보여줘야 하는 것은 "지금 디자인"이 아니라 "실제로 나간 그림"이다.
 *
 * 아직 이미지를 뽑지 않은 세트는 아트보드를 축소해 보여준다 — 발행 전
 * 미리보기 용도로 그대로 쓸모가 있다. 발행용 이미지는 /cards/<set>/<n>/ 을
 * 1080×1350 뷰포트로 찍어서 뽑는다.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import BaseHead from "../../../components/BaseHead.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import CardArtboard from "../../../components/CardArtboard.astro";
import CardCarousel from "../../../components/CardCarousel.astro";
import { cardSets } from "../../../data/cards";
import { clusterColor } from "../../../data/clusters";
import { liveSocials } from "../../../data/social";
import "../../../styles/global.css";

export function getStaticPaths() {
  return cardSets.map((set) => ({ params: { set: set.slug }, props: { set } }));
}

const { set } = Astro.props;

const publicDir = new URL("../../../../public/", import.meta.url);
const shots = set.cards
  .map((_, i) => i + 1)
  .filter((n) =>
    existsSync(fileURLToPath(new URL(`cards/${set.slug}/${n}.jpg`, publicDir))),
  );

const first = set.cards[0];
const heading =
  first.kind === "list" || first.kind === "note" ? first.title : set.slug;
const title = `${heading} — 카드뉴스 | 주포켓`;
const description = `${heading}. 국세청·국민연금공단 원문을 확인한 숫자로 정리한 카드뉴스입니다.`;
const accent = clusterColor[set.cluster]?.mark ?? "#0b5cad";
const SCALE = 0.26;
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main class="cardset">
      <p class="cardset-kicker"><a href="/cards/">카드뉴스</a></p>
      <h1>{heading}</h1>

      {
        shots.length > 0 ? (
          <CardCarousel slug={set.slug} shots={shots} label={heading} />
        ) : (
          <div class="cardset-preview">
            {set.cards.map((card) => (
              <div class="cardset-slot">
                <CardArtboard card={card} cluster={set.cluster} />
              </div>
            ))}
          </div>
        )
      }

      <p class="cardset-cta">
        <a class="btn" href={set.link} style={`--cm:${accent}`}>
          글로 자세히 읽기
        </a>
      </p>

      {
        liveSocials.length > 0 && (
          <p class="cardset-follow">
            새 카드는{" "}
            {liveSocials.map((s) => (
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label} {s.handle}
              </a>
            ))}
            에 먼저 올라옵니다.
          </p>
        )
      }
    </main>
    <SiteFooter />
  </body>
</html>

<style define:vars={{ scale: SCALE, w: `${1080 * SCALE}px`, h: `${1350 * SCALE}px` }}>
  .cardset {
    max-width: var(--wide);
  }
  .cardset-kicker {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--muted);
  }

  .cardset :global(.carousel) {
    margin-top: var(--s-4);
  }
  .cardset-preview {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
  .cardset-slot {
    width: var(--w);
    height: var(--h);
    overflow: hidden;
  }
  .cardset-slot > :global(.artboard) {
    transform: scale(var(--scale));
    transform-origin: top left;
  }

  .cardset-cta {
    margin-top: var(--s-5);
  }
  .cardset-follow {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .cardset-follow a {
    font-weight: 700;
  }
</style>
