---
/**
 * 카드 세트 한 벌 — 발행한 카드를 순서대로 보여준다.
 *
 * 아트보드를 다시 렌더하지 않고 이미 뽑아둔 발행본 JPEG 를 쓴다. 갤러리가
 * 보여줘야 하는 것은 "지금 디자인"이 아니라 "실제로 나간 그림"이다.
 *
 * 아직 이미지를 뽑지 않은 세트는 아트보드를 축소해 보여준다 — 발행 전
 * 미리보기 용도로 그대로 쓸모가 있다. 발행용 이미지는 /cards/<set>/<n>/ 을
 * 1080×1350 뷰포트로 찍어서 뽑는다.
 */
import BaseHead from "../../../components/BaseHead.astro";
import ClarityHead from "../../../components/ClarityHead.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import CardArtboard from "../../../components/CardArtboard.astro";
import CardCarousel from "../../../components/CardCarousel.astro";
import { publishedShots } from "../../../lib/published-cards";
import { cardSets } from "../../../data/cards";
import { clusterColor } from "../../../data/clusters";
import { liveSocials } from "../../../data/social";
import { altText, transcript, setSummary, cardTitle } from "../../../lib/card-text";
import "../../../styles/global.css";

export function getStaticPaths() {
  return cardSets.map((set) => ({ params: { set: set.slug }, props: { set } }));
}

const { set } = Astro.props;

const shots = publishedShots(set.slug, set.cards.length);

const first = set.cards[0];
const heading =
  first.kind === "list" || first.kind === "note" ? cardTitle(first) : set.slug;
const title = `${heading} — 카드뉴스 | 주포켓`;
// 카드 내용에서 뽑는다. "카드뉴스입니다" 같은 빈 문장은 검색결과에서
// 아무것도 말해주지 않는다.
const summary = setSummary(set);
const description = summary
  ? `${summary} — 국세청·국민연금공단 원문을 확인한 숫자입니다.`
  : `${heading}. 국세청·국민연금공단 원문을 확인한 숫자로 정리한 카드뉴스입니다.`;
const accent = clusterColor[set.cluster]?.mark ?? "#0b5cad";
const SCALE = 0.26;

const alts = shots.map((n) => altText(set.cards[n - 1], n - 1, shots.length));
const cardText = transcript(set);
const siteUrl = Astro.site!.href.replace(/\/$/, "");

/**
 * 카드 낱장을 ImageObject 로 세운다. 그림이 곧 내용인 페이지라
 * 캡션·설명을 붙여두지 않으면 검색·AI 쪽에서 읽을 게 없다.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: heading,
  description,
  inLanguage: "ko",
  url: `${siteUrl}/cards/${set.slug}/`,
  isPartOf: { "@type": "WebSite", name: "주포켓", url: siteUrl },
  mainEntityOfPage: set.link,
  publisher: { "@type": "Organization", name: "주포켓", url: siteUrl },
  associatedMedia: shots.map((n, i) => ({
    "@type": "ImageObject",
    position: i + 1,
    contentUrl: `${siteUrl}/cards/${set.slug}/${n}.jpg`,
    caption: alts[i],
    description: [cardText[n - 1].title, ...cardText[n - 1].points].join(" "),
    width: 1080,
    height: 1350,
    encodingFormat: "image/jpeg",
  })),
};
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main class="cardset">
      <p class="cardset-kicker"><a href="/cards/">카드뉴스</a></p>
      <h1>{heading}</h1>

      {
        shots.length > 0 ? (
          <CardCarousel slug={set.slug} shots={shots} label={heading} alts={alts} />
        ) : (
          <div class="cardset-preview">
            {set.cards.map((card) => (
              <div class="cardset-slot">
                <CardArtboard card={card} cluster={set.cluster} />
              </div>
            ))}
          </div>
        )
      }

      <section class="cardset-text" aria-labelledby="cardset-text-h">
        <h2 id="cardset-text-h">카드 내용</h2>
        <p class="cardset-text-lead">
          그림으로 읽기 어려우신 분들을 위해 카드에 적힌 내용을 그대로
          옮겨 둡니다.
        </p>
        <ol class="cardset-cards">
          {
            cardText.map((c) => (
              <li>
                <h3>{c.title}</h3>
                <ul>
                  {c.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
                {c.footnote && <p class="cardset-foot">{c.footnote}</p>}
              </li>
            ))
          }
        </ol>
      </section>

      <p class="cardset-cta">
        <a class="btn" href={set.link} style={`--cm:${accent}`}>
          글로 자세히 읽기
        </a>
      </p>

      {
        liveSocials.length > 0 && (
          <p class="cardset-follow">
            새 카드는{" "}
            {liveSocials.map((s) => (
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label} {s.handle}
              </a>
            ))}
            에 먼저 올라옵니다.
          </p>
        )
      }
    </main>
    <SiteFooter />
  </body>
</html>

<style define:vars={{ scale: SCALE, w: `${1080 * SCALE}px`, h: `${1350 * SCALE}px` }}>
  .cardset {
    max-width: var(--wide);
  }
  .cardset-kicker {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--muted);
  }

  .cardset :global(.carousel) {
    margin-top: var(--s-4);
  }
  .cardset-preview {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
  .cardset-slot {
    width: var(--w);
    height: var(--h);
    overflow: hidden;
  }
  .cardset-slot > :global(.artboard) {
    transform: scale(var(--scale));
    transform-origin: top left;
  }

  .cardset-text {
    margin-top: var(--s-6);
    max-width: var(--measure);
  }
  .cardset-text h2 {
    font-size: var(--t-lg);
  }
  .cardset-text-lead {
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .cardset-cards {
    margin: var(--s-4) 0 0;
    padding-left: var(--s-5);
  }
  .cardset-cards > li + li {
    margin-top: var(--s-5);
  }
  .cardset-cards h3 {
    margin: 0 0 var(--s-2);
    font-size: var(--t-md);
  }
  .cardset-cards ul {
    margin: 0;
    padding-left: var(--s-4);
  }
  .cardset-cards ul li + li {
    margin-top: var(--s-1);
  }
  .cardset-foot {
    margin: var(--s-2) 0 0;
    font-size: var(--t-xs);
    color: var(--muted);
  }

  .cardset-cta {
    margin-top: var(--s-5);
  }
  .cardset-follow {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .cardset-follow a {
    font-weight: 700;
  }
</style>
