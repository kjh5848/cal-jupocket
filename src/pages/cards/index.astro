---
/**
 * 카드뉴스 갤러리 — 인스타·스레드에 올린 카드를 사이트에서도 본다.
 *
 * 이미 뽑아둔 발행본 JPEG(public/cards/<slug>/<n>.jpg)를 그대로 쓴다.
 * 아트보드를 다시 렌더하지 않는 이유는, 갤러리가 보여줘야 하는 것이
 * "지금 디자인"이 아니라 "실제로 나간 그림"이기 때문이다.
 *
 * 아직 이미지를 뽑지 않은 세트는 목록에서 뺀다 — 깨진 이미지가 나가는 것보다
 * 없는 편이 낫다.
 */
import BaseHead from "../../components/BaseHead.astro";
import ClarityHead from "../../components/ClarityHead.astro";
import GtagHead from "../../components/GtagHead.astro";
import TrackLinks from "../../components/TrackLinks.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { cardSets } from "../../data/cards";
import { publishedShots } from "../../lib/published-cards";
import { altText, setHeading } from "../../lib/card-text";

/**
 * 카드 세트가 가리키는 글의 제목.
 *
 * 링크 텍스트가 "자세히 읽기" 뿐이면 그 링크가 어디로 가는지 기계도
 * 스크린리더도 알 수 없다 — 같은 문구가 페이지에 네 번 나온다.
 * 가이드가 말하는 "페이지 내용을 명확히 설명하는 앵커 텍스트"가 이것이다.
 */
function articleTitle(link: string): string | null {
  const path = link.startsWith("http") ? new URL(link).pathname : link;
  const found = linkByHref(path);
  return found ? displayTitle(found.link) : null;
}
import { clusterColor, linkByHref, displayTitle } from "../../data/clusters";
import { liveSocials } from "../../data/social";
import "../../styles/global.css";

const title = "카드뉴스 — 주포켓";
const description =
  "세금 계산기 주포켓이 인스타그램·스레드에 올린 카드뉴스 모음. 국민연금 보험료, 부가세 신고 일정 등을 한 장씩 정리했습니다.";

const sets = cardSets
  .map((s) => ({ set: s, shots: publishedShots(s.slug, s.cards.length) }))
  .filter((x) => x.shots.length > 0);
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main class="gallery">
      <h1>카드뉴스</h1>
      <p class="gallery-lead">
        인스타그램·스레드에 올린 카드를 여기서도 볼 수 있습니다. 숫자는 전부
        국세청·국민연금공단 원문을 확인해 씁니다.
      </p>

      {
        sets.map(({ set, shots }) => (
          <section class="gallery-set" aria-labelledby={`set-${set.slug}`}>
            <div class="gallery-head">
              <h2 id={`set-${set.slug}`}>
                <a href={`/cards/${set.slug}/`}>{setHeading(set)}</a>
              </h2>
              <a
                class="gallery-more"
                href={set.link}
                style={`--cm:${clusterColor[set.cluster]?.mark}`}
              >
                {articleTitle(set.link) ?? "글로 읽기"}
              </a>
            </div>
            <ul class="gallery-strip">
              {shots.map((n) => (
                <li>
                  <a href={`/cards/${set.slug}/`} aria-label={`카드 ${n} — 전체 보기`}>
                    <img
                      src={`/cards/${set.slug}/${n}.jpg`}
                      alt={altText(set.cards[n - 1], n - 1, shots.length)}
                      width="1080"
                      height="1350"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        liveSocials.length > 0 && (
          <p class="gallery-follow">
            새 카드는 {liveSocials.map((s) => (
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label} {s.handle}
              </a>
            ))}
            에 먼저 올라옵니다.
          </p>
        )
      }
    </main>
    <SiteFooter />
      <TrackLinks />
  </body>
</html>

<style>
  .gallery {
    max-width: var(--wide);
  }
  .gallery-lead {
    color: var(--muted);
    max-width: var(--measure);
  }

  .gallery-set {
    margin-top: var(--s-6);
  }
  .gallery-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .gallery-head h2 {
    margin: 0;
    border: 0;
    padding: 0;
    font-size: var(--t-xl);
  }
  .gallery-more {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--cm);
    white-space: nowrap;
  }

  .gallery-strip {
    list-style: none;
    display: grid;
    /* 카드는 4:5 세로라 좁은 화면에서 두 장, 넓으면 네 장까지 간다. */
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--s-3);
    margin: var(--s-3) 0 0;
    padding: 0;
  }
  .gallery-strip a {
    display: block;
  }
  .gallery-strip img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-md);
    border: 1px solid var(--img-outline);
    background: var(--surface);
  }

  .gallery-follow {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .gallery-follow a {
    font-weight: 700;
  }
</style>
