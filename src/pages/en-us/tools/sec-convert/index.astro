---
/**
 * Seconds to Minutes Converter — 미국 영어판 일곱 번째 도구(초·분·시간 변환). 한국어판 /tools/sec-convert/ 와
 * 계산(lib/sec-convert.ts)·스크립트(scripts/sec-convert.ts 의 EN 사전)를 같이 쓰고, 문장은 영어로 새로 썼다(번역 아님).
 * 조사표 미국 칸 '같음'(#91, SI 브로슈어 표 8) · #88 '시간 → 분/초'(#parts)도 같은 페이지.
 *
 * 소제목은 미국 구글 자동완성에서 왔다(keywords/us-sec-convert-2026-10-21.csv):
 *   seconds to minutes formula·calculator / minutes to hours decimal·chart·payroll /
 *   convert seconds to hours minutes seconds formula·to days / milliseconds to seconds formula·to minutes /
 *   … excel formula·google sheets / … python·javascript / seconds to … weeks to months to years(→ 안 넣는 이유)
 * 단위 값은 SI 브로슈어 표 8(1 min = 60 s, 1 h = 3600 s, 1 d = 86 400 s, rates/sec-convert-2026.json)뿐 — 법 숫자 없음.
 * 급여 시간 반올림(FLSA·29 CFR) 규칙은 원문을 열지 않아 쓰지 않는다. 본문 예시 숫자는 전부 frontmatter 에서 lib 함수로 계산한다.
 */
import BaseHead from "../../../../components/BaseHead.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import ClarityHead from "../../../../components/ClarityHead.astro";
import GtagHead from "../../../../components/GtagHead.astro";
import TrackLinks from "../../../../components/TrackLinks.astro";
import AdSenseHead from "../../../../components/AdSenseHead.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import "../../../../styles/global.css";
import {
  toNanos,
  partsToNanos,
  convertAll,
  readableEn,
  withUnitEn,
  clock,
  minSec,
  UNITS,
  UNIT_NAME_EN,
} from "../../../../lib/sec-convert";

const title = "Seconds to Minutes Converter — Seconds, Minutes, Hours, Days and Milliseconds";
const description =
  "Convert seconds to minutes, minutes to hours, or milliseconds to seconds, and see hours, minutes and seconds at once. Plus a decimal hours chart and Excel formulas.";

const EX = "3725";
const n0 = toNanos(EX, "s")!;
const all0 = convertAll(n0);
const p0 = partsToNanos("", "1", "30", "")!;
const pAll0 = convertAll(p0);
const pMs0 = minSec(p0);

/** 본문 예시 — 10,000초, 1일, 1.5분, 90,000밀리초 */
const T1 = toNanos("10000", "s")!;
const T1all = convertAll(T1);
const D1 = convertAll(toNanos("1", "d")!);
const M15 = convertAll(toNanos("1.5", "min")!);
const MS90 = toNanos("90000", "ms")!;
const MS90all = convertAll(MS90);
const MS1 = convertAll(toNanos("1", "ms")!);
const BIG = toNanos("1000000", "s")!;
const MIN_WRAP = toNanos("1440.25", "min")!;
---

<html lang="en-US">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>Seconds to Minutes Converter (and Hours, Days, Milliseconds)</h1>
      <p>
        Type a number and pick its unit. You get the same length of time in milliseconds, seconds, minutes, hours and days,
        plus a plain "X hours Y minutes Z seconds" reading and an h:mm:ss clock. It uses 1 minute = 60 seconds, 1 hour = 3,600
        seconds and 1 day = 86,400 seconds, and the results update as you type.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="val">Amount</label>
          <input type="text" id="val" inputmode="decimal" autocomplete="off" value={EX} placeholder="e.g. 3725" />
        </div>
        <div class="calc-input-wrap">
          <label for="unit">Unit</label>
          <select id="unit" data-seg>
            {UNITS.map((u) => <option value={u} selected={u === "s"}>{UNIT_NAME_EN[u]}</option>)}
          </select>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">{withUnitEn(all0.s, "s")} is</p>
          <p class="big" id="hero-value">{readableEn(n0)}</p>
          <p class="hint" id="hero-sub">{withUnitEn(all0.min, "min")} · h:mm:ss {clock(n0)}</p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          {UNITS.map((u) => (
            <div class="stat-chip">
              <span class="label">{UNIT_NAME_EN[u]}</span>
              <span class="value" id={`v-${u}`}>{all0[u]}</span>
            </div>
          ))}
        </div>
        <p class="hint" id="err" role="alert"></p>

        <div class="actions">
          <button id="btn-download" type="button">Save as PNG</button>
          <button id="btn-share" type="button" class="secondary">Share</button>
        </div>
      </div>

      <h2 id="parts">Hours, minutes and seconds → total seconds</h2>
      <div class="calc-card" data-two>
        <div class="sc-parts">
          <div class="calc-input-wrap">
            <label for="p-d">Days</label>
            <input type="text" id="p-d" inputmode="decimal" autocomplete="off" placeholder="0" />
          </div>
          <div class="calc-input-wrap">
            <label for="p-h">Hours</label>
            <input type="text" id="p-h" inputmode="decimal" autocomplete="off" value="1" placeholder="0" />
          </div>
          <div class="calc-input-wrap">
            <label for="p-m">Minutes</label>
            <input type="text" id="p-m" inputmode="decimal" autocomplete="off" value="30" placeholder="0" />
          </div>
          <div class="calc-input-wrap">
            <label for="p-s">Seconds</label>
            <input type="text" id="p-s" inputmode="decimal" autocomplete="off" placeholder="0" />
          </div>
        </div>
        <div class="result-hero" aria-live="polite" aria-atomic="true">
          <p class="label">Total</p>
          <p class="big" id="p-value">{withUnitEn(pAll0.s, "s")}</p>
          <p class="hint" id="p-sub">
            {withUnitEn(pAll0.min, "min")}{pMs0.seconds === "0" ? "" : ` (${pMs0.minutes.toLocaleString("en-US")} min ${pMs0.seconds} sec)`} · {withUnitEn(pAll0.h, "h")} · {readableEn(p0)}
          </p>
        </div>
        <p class="hint" id="p-err" role="alert"></p>
      </div>

      <h2>Seconds to minutes formula</h2>
      <p>
        Divide by 60: minutes = seconds ÷ 60. So 3,725 seconds ÷ 60 = {all0.min} minutes. Going the other way, multiply by 60
        ({M15.min} minutes × 60 = {M15.s} seconds).
      </p>
      <p>
        Watch the decimal. 1.5 minutes is <strong>1 minute 30 seconds</strong>, not 1 minute 50 seconds — the part after the point is
        a fraction of a minute, so multiply it by 60 to get seconds (0.25 min = 15 sec, 0.1 min = 6 sec).
      </p>

      <h2>Minutes to hours: decimal hours chart</h2>
      <p>
        Minutes ÷ 60 = hours, and hours ÷ 24 = days. Timesheets and payroll apps often want hours as a decimal, so here are the
        common ones. Decimals are rounded to six places.
      </p>
      <table>
        <thead>
          <tr><th>Minutes</th><th>Decimal hours</th><th>Hours and minutes</th></tr>
        </thead>
        <tbody>
          {["5", "10", "15", "20", "30", "40", "45", "50", "90", "100", "480", "1440"].map((m) => {
            const n = toNanos(m, "min")!;
            return (
              <tr>
                <td>{Number(m).toLocaleString("en-US")}</td>
                <td>{convertAll(n).h}</td>
                <td>{readableEn(n)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p>
        To turn decimal hours back into minutes, multiply the decimal part by 60: 7.75 hours = 7 hours + 0.75 × 60 = 7 hours 45
        minutes.
      </p>

      <h2>How to convert seconds to hours, minutes and seconds</h2>
      <p>Divide by the biggest unit first and carry the remainder down. For 10,000 seconds:</p>
      <ol>
        <li>10,000 ÷ 3,600 = 2, remainder 2,800 → 2 hours</li>
        <li>2,800 ÷ 60 = 46, remainder 40 → 46 minutes</li>
        <li>40 seconds left → <strong>{readableEn(T1)}</strong> (h:mm:ss {clock(T1)}, or {withUnitEn(T1all.h, "h")})</li>
      </ol>
      <p>
        For days, start with 86,400 (one day = 24 hours = {D1.min} minutes = {D1.s} seconds). One million seconds is
        {" "}{readableEn(BIG)}. The h:mm:ss clock keeps counting hours past 24 instead of rolling into days, so 1,440.25 minutes
        shows as {clock(MIN_WRAP)}.
      </p>

      <h2>Milliseconds to seconds</h2>
      <p>
        Milliseconds ÷ 1,000 = seconds, and milliseconds ÷ 60,000 = minutes. A timer or log value of 90,000 ms is {MS90all.s}
        {" "}seconds, or {readableEn(MS90)}. Pick "Milliseconds" as the unit to convert one. Results show up to six decimal places,
        so 1 ms is {MS1.s} seconds and rounds to {MS1.min} minutes.
      </p>

      <h2>Excel and Google Sheets formulas</h2>
      <ul>
        <li><strong>Seconds → minutes</strong>: <code>=A1/60</code>; <strong>seconds → hours</strong>: <code>=A1/3600</code> (seconds in A1)</li>
        <li><strong>Minutes → hours</strong>: <code>=A1/60</code>; <strong>hours → minutes</strong>: <code>=A1*60</code></li>
        <li>
          <strong>Show as hours:minutes:seconds</strong>: enter <code>=A1/86400</code> and give the cell the custom number format
          {" "}<code>[h]:mm:ss</code>. Spreadsheets store time as a fraction of a day, which is why you divide by 86,400.
        </li>
        <li>
          <strong>Over 24 hours</strong>: plain <code>h:mm:ss</code> wraps back to 0 after 24 hours. The square brackets in
          {" "}<code>[h]</code> keep the hours counting. In Google Sheets you can also use Format → Number → Duration.
        </li>
      </ul>

      <h2>In Python and JavaScript</h2>
      <p>Integer division and remainder do the same steps as above.</p>
      <pre><code>{`# Python
h, rem = divmod(seconds, 3600)
m, s = divmod(rem, 60)

// JavaScript
const h = Math.floor(seconds / 3600);
const m = Math.floor((seconds % 3600) / 60);
const s = seconds % 60;`}</code></pre>
      <p>
        For milliseconds, divide by 1,000 first. Floating-point math can leave tails like 66.00000000000001 (1.1 × 60); this
        converter works in whole nanoseconds internally so it does not.
      </p>

      <details>
        <summary>Can it convert seconds to weeks, months or years?</summary>
        <p>
          It stops at days on purpose. A month is 28 to 31 days and a year is 365 or 366 days, so neither has one fixed number of
          seconds. To count calendar time between two dates, use the <a href="/en-us/tools/date-diff/">date calculator</a>.
        </p>
      </details>

      <details>
        <summary>Where do 60 seconds and 3,600 seconds come from?</summary>
        <p>
          The minute, hour and day are listed in Table 8 of the SI Brochure from the International Bureau of Weights and Measures
          (BIPM) as units accepted for use with the SI: 1 min = 60 s, 1 h = 60 min = 3,600 s, and 1 d = 24 h = 86,400 s.
        </p>
      </details>

      <details>
        <summary>Is a day ever 86,401 seconds?</summary>
        <p>
          On a day when a leap second is added to Coordinated Universal Time (UTC), that day is one second longer. When you
          convert a length of time, though, 1 day = 86,400 seconds is a fixed value, so this converter always uses 86,400.
        </p>
      </details>

      <details>
        <summary>Can I type commas, like 1,440.25?</summary>
        <p>
          Yes. Commas and spaces are ignored, and decimals are read to six places. Negative numbers are not accepted, since a length
          of time cannot be below zero.
        </p>
      </details>

      <details>
        <summary>Does it convert degrees, minutes and seconds (latitude and longitude)?</summary>
        <p>
          No. The minutes and seconds of an angle (1 degree = 60 minutes = 3,600 seconds) share the names but are a different unit.
          This converter only handles lengths of time.
        </p>
      </details>

      <p>
        To turn an epoch number in seconds or milliseconds into a date, use the <a href="/en-us/tools/unix-time/">Unix timestamp
        converter</a>. For how many days until a date, try the <a href="/en-us/tools/dday/">days until countdown</a>.
      </p>

      <p>
        Source: <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener">BIPM, The International System of Units (SI
        Brochure), Table 8: Non-SI units accepted for use with the SI</a> (checked October 20, 2026)
      </p>

      <AdSlot label="sec-convert-result-en-us" />
    </main>
    <SiteFooter />
    <style>
      .sc-parts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 10px; }
      @media (max-width: 560px) { .sc-parts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      pre { overflow-x: auto; }
    </style>
    <script src="../../../../scripts/sec-convert.ts"></script>
    <TrackLinks />
    <script src="../../../../scripts/calc-ui.ts"></script>
  </body>
</html>
