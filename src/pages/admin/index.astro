---
/**
 * 관리자 화면 — 전세 도우미를 누가 얼마나 쓰는지, 무엇을 묻는지 본다.
 * 구조·순서·문구는 docs/design/admin-ux.md 를 따른다(2026-11-21 다시 그림).
 *
 * 이 페이지 자체에는 아무 숫자도 없다. 열쇠(ADMIN_KEY)를 넣으면 api.jupocket.com/admin/stats 에서
 * 받아 와 그린다. 열쇠는 이 브라우저(localStorage)에만 둔다.
 *
 * 내부용이라 noindex + 사이트맵 제외 + robots.txt Disallow.
 * 질문 문장은 사용자가 적은 글이라 textContent 로만 넣는다(innerHTML 금지).
 *
 * 버튼 키의 이름표는 사용자 화면이 실제로 쓰는 문구를 빌드 때 가져온다(아래 labels).
 * 도우미 문구를 고치면 이 화면도 따라 바뀐다.
 */
import BaseHead from "../../components/BaseHead.astro";
import "../../styles/global.css";
import { GUIDES, CONTACT } from "../../lib/jeonse-guide";
import { ANSWERS } from "../../lib/hug-answers";

const title = "관리자 — JU포켓";
const description = "전세 도우미 사용 현황과 사용자가 적은 질문.";

const labels = {
  // 상황 안내(hug_guide)의 키 → 사용자가 고르는 말. GUIDES 는 HOUSE_GUIDES 를 이미 품고 있다.
  guides: Object.fromEntries([...GUIDES, CONTACT].map((g) => [g.id, g.ask])),
  // 준비한 답(질문의 query_json.id) → 그 답의 첫 질문 문장
  answers: Object.fromEntries(ANSWERS.map((a) => [a.id, a.q[0]])),
};
// JSON 을 <script> 안에 넣을 때 "<" 를 풀어 써서 태그가 닫히지 않게 한다
const labelsJson = JSON.stringify(labels).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main class="adm">
      <header class="adm-top">
        <h1>전세 도우미 사용 현황</h1>
        <p class="adm-sub" id="adm-sub">운영자만 보는 화면이에요. 열쇠를 넣으면 전세 도우미를 몇 명이 열었고 무엇을 물었는지 보여 줘요.</p>
        <div class="adm-acts" id="adm-acts" hidden>
          <button type="button" id="adm-reload">다시 불러오기</button>
          <button type="button" id="adm-out">이 기기에서 나가기</button>
        </div>
      </header>

      <form class="adm-key" id="adm-key">
        <label for="adm-k">관리자 열쇠</label>
        <div class="adm-key-row">
          <input id="adm-k" type="password" autocomplete="off" placeholder="열쇠를 붙여 넣어 주세요" aria-describedby="adm-key-note" />
          <button type="submit" class="is-main">열기</button>
        </div>
        <p class="adm-note" id="adm-key-note">열쇠는 이 기기에만 저장돼요. 남의 기기에서는 다 본 뒤 꼭 나가기를 눌러 주세요.</p>
      </form>

      <div class="adm-err" id="adm-err" role="alert" hidden>
        <p id="adm-err-text"></p>
        <button type="button" id="adm-retry">다시 불러오기</button>
      </div>

      <div class="adm-wait" id="adm-wait" hidden>
        <p class="adm-note" role="status">숫자를 받아 오는 중이에요…</p>
        <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
      </div>

      <section class="adm-empty" id="adm-empty" hidden>
        <p class="adm-lead" id="adm-empty-lead"></p>
        <p id="adm-empty-how"></p>
        <div class="adm-acts">
          <a class="adm-btn is-main" href="/jeonse-chat/">전세 도우미 열기</a>
          <button type="button" id="adm-empty-reload">다시 불러오기</button>
        </div>
      </section>

      <div class="adm-body" id="adm-body" hidden>
        <!-- 구역 1 — 사람이 오긴 했나. 제목 없이 문장이 제목 노릇을 한다 -->
        <section aria-labelledby="adm-lead">
          <p class="adm-lead" id="adm-lead"></p>
          <ul class="adm-stats" id="adm-stats"></ul>
          <div id="adm-spark-wrap" hidden>
            <p class="adm-note" id="adm-spark-read"></p>
            <div class="adm-spark" id="adm-spark"></div>
          </div>
          <p class="adm-note" id="adm-today"></p>
        </section>

        <!-- 구역 2 — 무엇을 물었나(주인공) -->
        <section aria-labelledby="adm-q-h">
          <h2 id="adm-q-h">글로 적은 질문 <small id="adm-q-count"></small></h2>
          <p class="adm-note" id="adm-q-cap" hidden>최근 300건까지만 보여요. 더 오래된 질문은 월요일 정리에 있어요.</p>
          <div class="adm-filter" id="adm-filter" role="group" aria-label="질문 걸러내기"></div>
          <p class="adm-warn" id="adm-warn">사용자가 직접 쓴 글이에요. 이름·전화번호가 섞여 있을 수 있으니 캡처하거나 밖으로 옮기지 마세요.</p>
          <p id="adm-q-none" hidden></p>
          <ul class="adm-qs" id="adm-qs"></ul>
          <div><button type="button" id="adm-q-more" hidden>20건 더 보기</button></div>
        </section>

        <!-- 구역 3 — 무엇을 눌렀나 -->
        <section aria-labelledby="adm-k-h">
          <h2 id="adm-k-h">무엇을 눌렀나 <small>최근 60일 합계</small></h2>
          <p id="adm-k-none" hidden>아직 아무도 버튼을 누르지 않았어요.</p>
          <div id="adm-k-body">
            <h3>어떤 상황으로 들어왔나</h3>
            <div id="adm-k-stage"></div>
            <h3>어떤 안내를 봤나</h3>
            <div id="adm-k-guide"></div>
            <h3>끝까지 한 일</h3>
            <ul class="adm-rows" id="adm-k-done"></ul>
            <details class="adm-gap">
              <summary>그 밖의 기록 보기</summary>
              <div class="adm-fold" id="adm-k-etc"></div>
            </details>
          </div>
        </section>

        <!-- 구역 4 — 날짜별(접힘) -->
        <details>
          <summary>날짜별로 보기</summary>
          <div class="adm-fold">
            <table id="adm-days" aria-label="날짜별 연 사람, 쓴 사람, 글 질문"></table>
            <div><button type="button" id="adm-days-more" hidden>더 보기</button></div>
          </div>
        </details>

        <!-- 구역 5 — 꼬리 -->
        <footer class="adm-tail">
          <p id="adm-push"></p>
          <details>
            <summary>숫자를 어떻게 세나요</summary>
            <ul class="adm-fold adm-how">
              <li>연 사람: 전세 도우미 화면을 연 사람이에요. 하루에 한 번만 세요. 같은 사람이 다음 날 또 오면 다시 1을 세요. 그래서 7일 숫자는 "7일 동안 온 서로 다른 사람 수"보다 클 수 있어요.</li>
              <li>쓴 사람: 연 사람 가운데 버튼을 누르거나 글을 보낸 사람이에요.</li>
              <li>누구인지는 저장하지 않아요. 같은 날 같은 사람인지만 가려내고, 그 표시는 다음 날 지워요.</li>
              <li>이 브라우저에서 연 것은 세지 않아요. 이 화면을 한 번 연 브라우저는 나간 뒤에도 빼고 세요.</li>
            </ul>
          </details>
          <p class="adm-note">매주 월요일에 질문을 묶어 정리한 글이 따로 나와요.</p>
        </footer>
      </div>
    </main>

    <script type="application/json" id="adm-labels" set:html={labelsJson} />

    <style is:global>
      /* 위계: 구역 1의 숫자 3개가 가장 크고, 그다음 문장, 그다음 질문 원문. 나머지는 본문 크기 이하.
         상자(테두리·배경)는 접힌 것과 경고에만 쓴다. 구역은 h2 위의 줄 하나로 나눈다. */
      .adm { display: grid; gap: var(--s-5); font-variant-numeric: tabular-nums; }
      .adm [hidden] { display: none !important; }
      .adm > *, .adm-body > *, .adm section > * { min-width: 0; }
      .adm p { margin: 0; }
      .adm h1 { font-size: var(--t-xl); margin: 0; text-wrap: balance; }
      .adm h2 { font-size: var(--t-lg); margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-2); }
      .adm h2 small { font-size: var(--t-sm); font-weight: 400; color: var(--muted); }
      .adm h3 { font-size: var(--t-md); margin: var(--s-5) 0 var(--s-1); }
      .adm-body, .adm section, .adm-top, .adm-tail, .adm-key, .adm-err, .adm-wait { display: grid; gap: var(--s-3); }
      .adm-body { gap: var(--s-6); }
      .adm-sub, .adm-note { color: var(--muted); font-size: var(--t-sm); line-height: 1.55; }
      .adm :is(summary, a, [tabindex]):focus-visible { outline: 3px solid var(--link); outline-offset: 2px; }

      /* 버튼 — 조용한 꼴이 기본, 화면에서 하나만 채운다. 손가락 크기(44px) */
      .adm :is(button, .adm-btn) {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 2.75rem; padding: 0 var(--s-4);
        border: 1px solid var(--rule); border-radius: var(--r-sm);
        background: transparent; color: var(--text);
        font-size: var(--t-sm); font-weight: 600; text-decoration: none;
        transition-property: transform, background-color;
        transition-duration: 150ms;
      }
      .adm :is(button, .adm-btn):hover { filter: none; background: var(--surface-2); }
      .adm :is(button, .adm-btn).is-main { background: var(--brand); border-color: var(--brand); color: var(--bg); }
      .adm :is(button, .adm-btn).is-main:hover { background: var(--brand); filter: brightness(1.08); }
      .adm button[aria-disabled="true"] { opacity: 0.6; cursor: default; }
      .adm-acts { display: flex; flex-wrap: wrap; gap: var(--s-2); }

      /* 열쇠 */
      .adm-key label { font-size: var(--t-sm); font-weight: 600; }
      .adm-key-row { display: flex; flex-wrap: wrap; gap: var(--s-2); }
      .adm-key input {
        flex: 1 1 12rem; min-width: 0; min-height: 2.75rem; padding: 0 var(--s-3);
        border: 1px solid var(--rule); border-radius: var(--r-sm);
        background: var(--surface); color: var(--text); font: inherit;
      }
      .adm-key input:focus-visible { outline: 3px solid var(--link); outline-offset: 2px; }
      .adm-err { justify-items: start; font-weight: 600; }

      /* 불러오는 중 — 0을 먼저 그리지 않고 자리만 잡는다 */
      .adm-wait i { display: block; height: 3.25rem; background: var(--surface-2); border-radius: var(--r-sm); }
      .adm-wait i:last-child { height: 8rem; }

      /* 구역 1 */
      .adm-lead { font-size: var(--t-lg); font-weight: 600; line-height: 1.5; text-wrap: pretty; }
      .adm-stats { list-style: none; margin: 0; padding: 0; display: grid; }
      .adm-stat {
        display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;
        gap: 0 var(--s-4); padding: var(--s-3) 0; border-top: 1px solid var(--rule);
      }
      .adm-stat:last-child { border-bottom: 1px solid var(--rule); }
      .adm-stat-n { font-size: var(--t-2xl); font-weight: 700; line-height: 1.1; text-align: right; }
      .adm-stat-name { font-weight: 600; }
      .adm-stat-per { color: var(--muted); font-size: var(--t-sm); }
      .adm-stat-t { line-height: 1.5; }
      @media (min-width: 40rem) {
        .adm-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); padding: var(--s-4) 0; border-block: 1px solid var(--rule); }
        .adm-stat, .adm-stat:last-child { grid-template-columns: minmax(0, 1fr); align-content: start; gap: var(--s-2); padding: 0; border: 0; }
        .adm-stat-n { grid-row: 1; text-align: left; }
        .adm-stat-t { grid-row: 2; }
      }
      /* 날짜별 작은 막대 — 기록이 쌓인 뒤에만 나온다. 연 사람 한 줄, 14칸, 축 하나 */
      .adm-spark { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: 2px; height: 3rem; border-bottom: 1px solid var(--rule); }
      .adm-spark > div { display: flex; align-items: flex-end; cursor: default; }
      .adm-spark i { display: block; width: 100%; min-height: 1px; background: var(--chart-base); border-radius: var(--r-xs); }

      /* 구역 2 — 질문 원문이 꼬리표·날짜보다 크다 */
      .adm-filter { display: flex; flex-wrap: wrap; gap: var(--s-2); }
      .adm-filter button { border-radius: var(--r-pill); padding: 0 var(--s-3); font-weight: 500; }
      .adm-filter button[aria-pressed="true"] { background: var(--brand-wash); border-color: var(--brand); font-weight: 700; }
      .adm-warn { background: var(--surface-2); border-radius: var(--r-sm); padding: var(--s-3) var(--s-4); font-size: var(--t-md); font-weight: 500; line-height: 1.6; }
      .adm-qs { list-style: none; margin: 0; padding: 0; }
      .adm-q { display: grid; gap: var(--s-1); padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
      .adm-q-text { font-size: var(--t-md); line-height: 1.6; overflow-wrap: anywhere; white-space: pre-wrap; }
      .adm-q-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-2); color: var(--muted); font-size: var(--t-sm); }
      .adm-tag.is-fix { color: var(--text); font-weight: 700; border: 1px solid var(--text); border-radius: var(--r-pill); padding: 0 var(--s-2); }
      .adm-q-ans { color: var(--muted); font-size: var(--t-sm); overflow-wrap: anywhere; }

      /* 구역 3 — 이름 + 횟수 + 가는 막대 하나. 숫자는 본문 크기 */
      .adm-rows { list-style: none; margin: 0; padding: 0; }
      .adm-rows li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--s-1) var(--s-4); padding: var(--s-2) 0; }
      .adm-row-name { overflow-wrap: anywhere; line-height: 1.5; }
      .adm-row-n { text-align: right; white-space: nowrap; }
      .adm-row-n small { font-size: var(--t-xs); color: var(--muted); margin-left: 1px; }
      .adm-zero { color: var(--muted); }
      .adm-bar { grid-column: 1 / -1; height: 4px; }
      .adm-bar i { display: block; height: 100%; background: var(--chart-base); border-radius: var(--r-xs); }
      .adm-gap { margin-top: var(--s-5); }
      .adm-fold h4 { font-size: var(--t-sm); color: var(--muted); font-weight: 600; margin: var(--s-4) 0 0; }
      .adm-fold h4:first-child { margin-top: 0; }

      /* 접힌 것 — 접혀 있음이 보이게 상자로 두고, 줄 전체가 눌린다 */
      .adm details { margin: 0; padding: 0; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--surface); }
      .adm summary { display: list-item; min-height: 2.75rem; padding: var(--s-3) var(--s-4); font-size: var(--t-md); border-radius: var(--r-md); }
      .adm details[open] > summary { margin-bottom: 0; border-bottom: 1px solid var(--rule); }
      .adm-fold { padding: var(--s-3) var(--s-4) var(--s-4); display: grid; gap: var(--s-2); }
      .adm-how { margin: 0; padding-left: calc(var(--s-4) + 1.1rem); font-size: var(--t-sm); line-height: 1.65; }

      /* 구역 4 — 열 4개, 세로선 없음, 가로로 밀리지 않는다 */
      .adm table { border-collapse: collapse; width: 100%; font-size: var(--t-sm); }
      .adm th, .adm td { padding: var(--s-2) 0 var(--s-2) var(--s-2); border-bottom: 1px solid var(--rule); text-align: right; font-weight: 400; }
      .adm th:first-child { text-align: left; padding-left: 0; white-space: nowrap; }
      .adm thead th { color: var(--muted); font-weight: 600; }
      .adm tbody tr:last-child :is(th, td) { border-bottom: 0; }

      @media (prefers-reduced-motion: reduce) {
        .adm :is(button, .adm-btn) { transition-property: none; }
      }
    </style>

    <script>
      import { PUSH_API } from "../../data/push";

      interface Day { day: string; users: number; active: number; events: Record<string, number> }
      interface Q { asked_on: string; page: string; kind: string; question: string; query_json: string }
      interface Stats {
        ok: boolean; today: string; from: string;
        since?: string | null;
        days: Day[];
        keys: Record<string, Record<string, number>>;
        questions: Q[];
        counts?: Record<string, number>;
        push?: { subs: number; pending: number };
      }
      type Counted = { name: string; n: number };

      const KEY = "jp-admin-key";
      /** 이 값이 있으면 전세 도우미가 집계 신호를 보내지 않는다(운영자 본인 빼기). 나가도 지우지 않는다 */
      const SELF = "jp-admin-self";
      /** 서버가 since 를 아직 안 줄 때 쓰는 집계 시작일 */
      const SINCE_FALLBACK = "2026-11-21";
      const PAGE = 20;
      const DAYS_FIRST = 14;
      const CAP = 300;

      const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
      const NAMES = JSON.parse($("adm-labels").textContent || "{}") as { guides: Record<string, string>; answers: Record<string, string> };

      /* ── 이름표 ─────────────────────────────────────────────
         상황 안내·준비한 답은 빌드 때 원본에서 가져온다(NAMES). 아래는 원본이 export 되지 않은 것들이다. */

      // 첫 갈래 — 원본: src/scripts/hug-chat.ts 의 STAGES[].label (export 되지 않아 여기 둔다. 그쪽을 고치면 여기도 고친다)
      const STAGE: Record<string, string> = {
        house: "집 보는 중이에요",
        contract: "계약했어요(날짜가 정해졌어요)",
        calc: "보증 가입 되는지·보증료 계산",
        living: "이미 살고 있어요",
        trouble: "집주인과 문제가 생겼어요",
      };
      // 수준 확인 문항 — 원본: hug-chat.ts 의 QUIZ. 질문 문장이 길어 짧은 이름을 쓴다(설계서 5-2)
      const QUIZ: Record<string, string> = {
        hug: "HUG가 어떤 곳인지",
        guarantee: "전세보증금반환보증",
        rights: "전입신고·확정일자·대항력",
        registry: "등기부의 근저당",
      };
      const LEVEL: Record<string, string> = { new: "처음이에요", some: "조금 알아요", ready: "잘 알아요" };
      // 원본: hug-chat.ts 의 거절 사유 버튼 문구
      const REFUSAL: Record<string, string> = { none: "없어요(확인했어요)", yes: "하나라도 있어요", unknown: "아직 몰라요" };
      // 원본: hug-chat.ts 의 이어하기 버튼 문구
      const RESUME: Record<string, string> = { yes: "이어서 하기", no: "처음부터 새로" };
      // 키 없이 횟수만 오는 것
      const SINGLE: Record<string, string> = {
        hug_term: "용어 풀이",
        hug_chat_send: "AI에게 글 보내기",
        hug_chat_error: "AI 답 받기 실패",
        hug_chat_reset: "새 대화",
      };
      /** 이 화면이 어딘가에서 쓰거나, 일부러 안 쓰는(hug_chat_answer — 구역 2가 대신한다) 이벤트 */
      const KNOWN = new Set([
        "hug_open", "hug_chat_stage", "hug_guide", "hug_plan_done", "hug_chat_calc", "hug_chat_answer",
        "hug_quiz_unknown", "hug_quiz_done", "hug_refusal", "hug_resume", ...Object.keys(SINGLE),
      ]);

      const KIND: Record<string, string> = {
        "hug-bank": "준비한 답",
        "hug-ok": "자료로 답함",
        "hug-check": "계산해 줌",
        "hug-nocite": "근거 없이 답함",
        "hug-fallback": "답 못 함",
      };
      const FIX = ["hug-fallback", "hug-nocite"];
      const DONE = ["hug-bank", "hug-ok", "hug-check"];
      type Filter = "fix" | "done" | "all";

      /* ── 작은 도구 ─────────────────────────────────────────── */

      const el = (tag: string, text?: string | number, cls?: string) => {
        const e = document.createElement(tag);
        if (text !== undefined) e.textContent = String(text);
        if (cls) e.className = cls;
        return e;
      };
      const num = (n: number) => n.toLocaleString("ko-KR");
      const ms = (day: string) => Date.parse(`${day}T00:00:00Z`);
      const addDays = (day: string, n: number) => new Date(ms(day) + n * 86_400_000).toISOString().slice(0, 10);
      /** "11월 21일" */
      const md = (day: string) => `${Number(day.slice(5, 7))}월 ${Number(day.slice(8, 10))}일`;
      const ymd = (day: string) => `${Number(day.slice(0, 4))}년 ${md(day)}`;
      const WEEK = ["일", "월", "화", "수", "목", "금", "토"];
      const week = (day: string) => WEEK[new Date(ms(day)).getUTCDay()];
      const total = (m: Record<string, number> | undefined) => Object.values(m ?? {}).reduce((t, n) => t + n, 0);

      /**
       * 보이기 전에 가린다 — 이메일, 주민등록번호 꼴, 휴대전화 번호 꼴. 금액과 날짜는 가리지 않는다.
       * 이름과 주소는 기계로 못 가린다(그래서 목록 위에 경고가 있다).
       */
      const mask = (t: string) =>
        t
          .replace(/[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/g, "●●●")
          .replace(/(?<!\d)\d{6}\s*-?\s*[1-4]\d{6}(?!\d)/g, "●●●")
          .replace(/(?<!\d)01[016789][\s.-]?\d{3,4}[\s.-]?\d{4}(?!\d)/g, "●●●");

      /** 이름표를 붙인다. 이름표에 없는 키는 영문 그대로 내보내지 않고 횟수만 따로 합친다 */
      function named(m: Record<string, number> | undefined, names: Record<string, string>, keepZero = false) {
        const items: Counted[] = [];
        let unknown = 0;
        for (const [k, n] of Object.entries(m ?? {})) if (!(k in names)) unknown += n;
        for (const [k, name] of Object.entries(names)) {
          const n = m?.[k] ?? 0;
          if (n > 0 || keepZero) items.push({ name, n });
        }
        items.sort((a, b) => b.n - a.n);
        return { items, unknown };
      }

      /** 이름 + 횟수 + (값이 1 이상인 줄이 3개 이상일 때만) 가장 큰 값 대비 가로 막대 */
      function rows(items: Counted[], limit = Infinity) {
        const ul = el("ul", undefined, "adm-rows");
        const max = Math.max(0, ...items.map((i) => i.n));
        const bars = items.filter((i) => i.n >= 1).length >= 3;
        items.forEach((it, i) => {
          const li = el("li");
          if (i >= limit) li.hidden = true;
          const n = el("span", undefined, "adm-row-n");
          if (it.n > 0) n.append(num(it.n), el("small", "번"));
          else {
            n.textContent = "아직 0";
            n.classList.add("adm-zero");
          }
          li.append(el("span", it.name, "adm-row-name"), n);
          if (bars) {
            const bar = el("span", undefined, "adm-bar");
            bar.setAttribute("aria-hidden", "true");
            const fill = el("i");
            fill.style.width = `${max ? (it.n / max) * 100 : 0}%`;
            bar.append(fill);
            li.append(bar);
          }
          ul.append(li);
        });
        return ul;
      }
      const unknownNote = (n: number, what = "항목") => el("p", `이름이 아직 없는 ${what} ${num(n)}번`, "adm-note");

      /* ── 구역 1 — 사람이 오긴 했나 ─────────────────────────── */

      function drawPeople(s: Stats, qs: Q[], since: string) {
        const by = new Map(s.days.map((d) => [d.day, d]));
        const qByDay = new Map<string, number>();
        for (const q of qs) qByDay.set(q.asked_on, (qByDay.get(q.asked_on) ?? 0) + 1);
        // 오늘에서 a일 전 ~ b일 전까지의 합
        const win = (a: number, b: number) => {
          let users = 0, active = 0, asked = 0;
          for (let i = a; i <= b; i++) {
            const day = addDays(s.today, -i);
            users += by.get(day)?.users ?? 0;
            active += by.get(day)?.active ?? 0;
            asked += qByDay.get(day) ?? 0;
          }
          return { users, active, asked };
        };
        const cur = win(0, 6);
        const prev = win(7, 13);
        // 앞 7일이 집계 시작 전에 걸치면 비교를 아예 안 보인다
        const canCompare = addDays(s.today, -14) >= since;

        let lead: string;
        if (cur.users === 0) {
          const last = s.days.filter((d) => d.users > 0).map((d) => d.day).sort().pop();
          lead = "최근 7일 동안은 아무도 열지 않았어요." + (last ? ` 마지막으로 열린 날은 ${md(last)}이에요.` : "");
        } else if (cur.active === 0) {
          lead = `최근 7일 동안 ${num(cur.users)}번 열렸지만, 버튼을 누르거나 글을 보낸 사람은 아직 없어요.`;
        } else {
          lead = `최근 7일 동안 ${num(cur.users)}번 열렸고, 그중 ${num(cur.active)}번은 버튼을 누르거나 글을 보냈어요.`;
        }
        $("adm-lead").textContent = lead;

        const diff = (a: number, b: number) => (a === b ? "앞 7일과 같아요." : `앞 7일보다 ${num(Math.abs(a - b))} ${a > b ? "많아요" : "적어요"}.`);
        const stat = (name: string, n: number, before: number, note: string) => {
          const li = el("li", undefined, "adm-stat");
          const t = el("div", undefined, "adm-stat-t");
          const head = el("p");
          head.append(el("span", name, "adm-stat-name"), el("span", " · 최근 7일", "adm-stat-per"));
          t.append(head, el("p", note + (canCompare ? ` ${diff(n, before)}` : ""), "adm-note"));
          li.append(t, el("b", num(n), "adm-stat-n"));
          return li;
        };
        $("adm-stats").replaceChildren(
          stat("연 사람", cur.users, prev.users, "하루에 한 번씩 세요. 같은 사람이 이틀 오면 2예요."),
          stat("쓴 사람", cur.active, prev.active, "버튼을 누르거나 글을 보낸 사람"),
          stat("글 질문", cur.asked, prev.asked, "전세 도우미에 글로 적어 보낸 질문"),
        );

        const t = by.get(s.today);
        $("adm-today").textContent = `오늘은 연 사람 ${num(t?.users ?? 0)}, 쓴 사람 ${num(t?.active ?? 0)}이에요.`;

        // 숫자가 작을 때는 차트를 그리지 않는다 — 기록 있는 날이 14일을 넘고 7일 합이 20을 넘을 때만
        const wrap = $("adm-spark-wrap");
        wrap.hidden = !(s.days.length > 14 && cur.users > 20);
        if (!wrap.hidden) {
          const read = $("adm-spark-read");
          const idle = "최근 14일 연 사람 · 막대를 누르면 그날 숫자가 보여요";
          read.textContent = idle;
          const days = Array.from({ length: 14 }, (_, i) => addDays(s.today, i - 13));
          const max = Math.max(1, ...days.map((d) => by.get(d)?.users ?? 0));
          $("adm-spark").replaceChildren(
            ...days.map((d) => {
              const n = by.get(d)?.users ?? 0;
              const text = `${md(d)} ${week(d)} · 연 사람 ${num(n)}`;
              const cell = el("div");
              cell.tabIndex = 0;
              cell.setAttribute("role", "img");
              cell.setAttribute("aria-label", text);
              const bar = el("i");
              bar.style.height = `${(n / max) * 100}%`;
              cell.append(bar);
              const show = () => (read.textContent = text);
              cell.addEventListener("pointerenter", show);
              cell.addEventListener("focus", show);
              cell.addEventListener("click", show);
              cell.addEventListener("pointerleave", () => (read.textContent = idle));
              return cell;
            }),
          );
        }
      }

      /* ── 구역 2 — 무엇을 물었나 ─────────────────────────────── */

      const qv = { list: [] as Q[], counts: {} as Record<string, number>, filter: "fix" as Filter, shown: 0, hasButtons: false };
      const inFilter = (kind: string, f: Filter) => (f === "all" ? true : (f === "fix" ? FIX : DONE).includes(kind));
      const groupCount = (f: Filter) => Object.entries(qv.counts).reduce((t, [k, n]) => (inFilter(k, f) ? t + n : t), 0);

      function questionItem(q: Q) {
        const li = el("li", undefined, "adm-q");
        // 사용자가 적은 글 — textContent 로만, 가린 뒤에
        li.append(el("p", mask(String(q.question ?? "")), "adm-q-text"));
        const meta = el("p", undefined, "adm-q-meta");
        const tag = el("span", KIND[q.kind] ?? "이름이 아직 없는 결과", "adm-tag");
        if (FIX.includes(q.kind)) tag.classList.add("is-fix");
        meta.append(el("span", md(q.asked_on)), tag);
        li.append(meta);
        if (q.kind === "hug-bank") {
          let id = "";
          try {
            id = String((JSON.parse(q.query_json || "{}") as { id?: unknown }).id ?? "");
          } catch {
            /* 깨진 값이면 이름 없이 둔다 */
          }
          li.append(el("p", `나간 답: ${NAMES.answers[id] ?? "이름이 아직 없는 답"}`, "adm-q-ans"));
        }
        return li;
      }

      function renderQuestions(reset: boolean) {
        const all = groupCount("all");
        const doneN = groupCount("done");
        const none = $("adm-q-none");
        const ul = $("adm-qs");
        const more = $("adm-q-more");
        const any = all > 0 || qv.list.length > 0;

        $("adm-q-count").textContent = `최근 60일 ${num(all)}건`;
        $("adm-q-cap").hidden = !(qv.list.length >= CAP || all > qv.list.length);
        $("adm-filter").hidden = !any;
        for (const b of $("adm-filter").querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.f === qv.filter));

        const list = qv.list.filter((q) => inFilter(q.kind, qv.filter));
        if (reset) {
          ul.replaceChildren();
          qv.shown = 0;
        }
        const next = list.slice(qv.shown, qv.shown + PAGE);
        ul.append(...next.map(questionItem));
        qv.shown += next.length;
        const left = list.length - qv.shown;
        more.hidden = left <= 0;
        more.textContent = `${Math.min(PAGE, left)}건 더 보기`;

        // 빈 목록을 그냥 두지 않는다 — 왜 비었는지 한 줄
        let why = "";
        if (!any) why = qv.hasButtons ? "아직 글로 물어본 사람이 없어요. 버튼만 누르고 간 거예요. 무엇을 눌렀는지는 아래에 있어요." : "아직 글로 물어본 사람이 없어요.";
        else if (!list.length && qv.filter === "fix") why = doneN > 0 ? `답을 못 한 질문은 없어요. 답한 질문 ${num(doneN)}건은 '답한 질문'에서 볼 수 있어요.` : "답을 못 한 질문은 없어요.";
        else if (!list.length) why = "아직 답한 질문이 없어요.";
        none.textContent = why;
        none.hidden = !why;
        $("adm-warn").hidden = !list.length;
      }

      function drawQuestions(s: Stats, qs: Q[], hasButtons: boolean) {
        // 60일 전체 건수는 서버의 counts 가 맞다(300건 제한과 무관). 없으면 받은 목록으로 센다
        const counts: Record<string, number> = {};
        if (s.counts) {
          for (const [k, n] of Object.entries(s.counts)) if (k.startsWith("hug-")) counts[k] = n;
        } else {
          for (const q of qs) counts[q.kind] = (counts[q.kind] ?? 0) + 1;
        }
        qv.list = qs;
        qv.counts = counts;
        qv.hasButtons = hasButtons;

        const filter = $("adm-filter");
        const labels: [Filter, string][] = [
          ["fix", `손볼 질문 ${num(groupCount("fix"))}`],
          ["done", `답한 질문 ${num(groupCount("done"))}`],
          ["all", `전체 ${num(groupCount("all"))}`],
        ];
        if (!filter.children.length) {
          for (const [f] of labels) {
            const b = el("button") as HTMLButtonElement;
            b.type = "button";
            b.dataset.f = f;
            b.addEventListener("click", () => {
              qv.filter = f;
              renderQuestions(true);
            });
            filter.append(b);
          }
        }
        labels.forEach(([, text], i) => (filter.children[i].textContent = text));
        renderQuestions(true);
      }

      /* ── 구역 3 — 무엇을 눌렀나 ─────────────────────────────── */

      function drawKeys(s: Stats, hasButtons: boolean) {
        $("adm-k-none").hidden = hasButtons;
        $("adm-k-body").hidden = !hasButtons;
        if (!hasButtons) return;
        const keys = s.keys ?? {};
        const ev = (name: string) => s.days.reduce((t, d) => t + (d.events?.[name] ?? 0), 0);

        // 1. 첫 갈래 — 5개가 전부라 0인 갈래도 줄을 남긴다
        const stage = named(keys.hug_chat_stage, STAGE, true);
        $("adm-k-stage").replaceChildren(rows(stage.items), ...(stage.unknown ? [unknownNote(stage.unknown)] : []));

        // 2. 상황 안내 — 많은 순으로 위 5개, 나머지는 [전체 보기]
        const guide = named(keys.hug_guide, NAMES.guides, true);
        const box = $("adm-k-guide");
        const seen = guide.items.filter((i) => i.n > 0).length;
        if (!seen && !guide.unknown) {
          box.replaceChildren(el("p", "아직 0", "adm-zero"));
        } else {
          const limit = Math.min(5, Math.max(seen, 1));
          const ul = rows(guide.items, limit);
          box.replaceChildren(ul, ...(guide.unknown ? [unknownNote(guide.unknown)] : []));
          if (guide.items.length > limit) {
            const more = el("button", "전체 보기") as HTMLButtonElement;
            more.type = "button";
            more.setAttribute("aria-expanded", "false");
            more.addEventListener("click", () => {
              const open = more.getAttribute("aria-expanded") !== "true";
              more.setAttribute("aria-expanded", String(open));
              more.textContent = open ? "접기" : "전체 보기";
              [...ul.children].forEach((li, i) => ((li as HTMLElement).hidden = !open && i >= limit));
            });
            const wrap = el("div");
            wrap.append(more);
            box.append(wrap);
          }
        }

        // 3. 끝까지 한 일 — 숫자가 작으니 비율 없이 두 수만 나란히
        const done = (name: string, start: number, end: number) => {
          const li = el("li");
          const n = el("span", `시작 ${num(start)} → 끝 ${num(end)}`, "adm-row-n");
          n.setAttribute("aria-label", `시작 ${num(start)}, 끝 ${num(end)}`);
          li.append(el("span", name, "adm-row-name"), n);
          return li;
        };
        $("adm-k-done").replaceChildren(
          done("일정 짜기", keys.hug_chat_stage?.contract ?? 0, ev("hug_plan_done")),
          done("보증 계산", keys.hug_chat_stage?.calc ?? 0, ev("hug_chat_calc")),
        );

        // 그 밖의 기록(접힘)
        const etc = $("adm-k-etc");
        etc.replaceChildren();
        const group = (title: string, m: Record<string, number> | undefined, names: Record<string, string>) => {
          const g = named(m, names);
          if (!g.items.length && !g.unknown) return;
          etc.append(el("h4", title), rows(g.items));
          if (g.unknown) etc.append(unknownNote(g.unknown));
        };
        group("수준 확인에서 모른다고 한 용어", keys.hug_quiz_unknown, QUIZ);
        group("수준 확인 결과", keys.hug_quiz_done, LEVEL);
        group("거절 사유 답", keys.hug_refusal, REFUSAL);
        group("이어하기", keys.hug_resume, RESUME);
        // 입구 — 첫 갈래와 같은 이름 + "바로가기로 들어옴". 키가 없으면 주소로 바로 들어온 것
        const doors: Record<string, string> = { "": "주소로 바로 들어옴" };
        for (const [k, name] of Object.entries(STAGE)) doors[k] = `${name} — 바로가기로 들어옴`;
        group("들어온 길", keys.hug_open, doors);
        const singles = Object.entries(SINGLE).map(([k, name]) => ({ name, n: ev(k) })).filter((i) => i.n > 0);
        if (singles.length) etc.append(el("h4", "그 밖의 횟수"), rows(singles));
        // 이름표에 없는 이벤트는 제목으로 쓰지 않고 횟수만 합친다
        const names = new Set([...Object.keys(keys), ...s.days.flatMap((d) => Object.keys(d.events ?? {}))]);
        let nameless = 0;
        for (const n of names) if (!KNOWN.has(n)) nameless += Math.max(ev(n), total(keys[n]));
        if (nameless) etc.append(unknownNote(nameless, "기록"));
        if (!etc.children.length) etc.append(el("p", "아직 기록이 없어요.", "adm-note"));
      }

      /* ── 구역 4 — 날짜별 ───────────────────────────────────── */

      function drawDays(s: Stats, qs: Q[], start: string) {
        const by = new Map(s.days.map((d) => [d.day, d]));
        const qByDay = new Map<string, number>();
        for (const q of qs) qByDay.set(q.asked_on, (qByDay.get(q.asked_on) ?? 0) + 1);
        const table = $("adm-days");
        const more = $("adm-days-more");
        // 기록이 없는 날도 0으로 채워 줄을 만든다(며칠 비었는지 보이게). 최근 날짜 먼저
        const all: string[] = [];
        for (let d = s.today; d >= start && all.length < 62; d = addDays(d, -1)) all.push(d);

        const cell = (n: number) => el("td", num(n), n ? undefined : "adm-zero");
        const paint = (count: number) => {
          const head = el("tr");
          for (const t of ["날짜", "연 사람", "쓴 사람", "글 질문"]) {
            const th = el("th", t);
            th.setAttribute("scope", "col");
            head.append(th);
          }
          const thead = el("thead");
          thead.append(head);
          const body = el("tbody");
          for (const d of all.slice(0, count)) {
            const tr = el("tr");
            const th = el("th", `${md(d)} ${week(d)}`);
            th.setAttribute("scope", "row");
            tr.append(th, cell(by.get(d)?.users ?? 0), cell(by.get(d)?.active ?? 0), cell(qByDay.get(d) ?? 0));
            body.append(tr);
          }
          table.replaceChildren(thead, body);
          more.hidden = count >= all.length;
        };
        more.onclick = () => paint(all.length);
        paint(DAYS_FIRST);
      }

      /* ── 그리기 ─────────────────────────────────────────────── */

      function draw(raw: Stats) {
        const s: Stats = { ...raw, days: raw.days ?? [], keys: raw.keys ?? {}, questions: raw.questions ?? [] };
        // 전세 도우미 질문만(계산기 채팅 것은 뺀다 — 서버가 거르지만 배포 전에도 맞게)
        const qs = s.questions.filter((q) => String(q.kind ?? "").startsWith("hug-"));
        const since = s.since ?? SINCE_FALLBACK;
        const start = since > s.from ? since : s.from;
        range = `${md(start)}부터 오늘까지`;

        const blank = !s.days.length && !qs.length && !total(s.counts);
        $("adm-empty").hidden = !blank;
        $("adm-body").hidden = blank;
        if (blank) {
          $("adm-empty-lead").textContent = `아직 기록이 없어요. 집계는 ${ymd(since)}부터 쌓여요. 누가 전세 도우미를 열면 여기에 바로 나타나요.`;
          $("adm-empty-how").textContent = "제대로 쌓이는지 보려면 다른 기기나 브라우저에서 전세 도우미를 한 번 열고 여기서 다시 불러와 보세요. (이 브라우저에서 연 것은 세지 않아요.)";
          return;
        }

        const pressed = Object.entries(s.keys).some(([name, m]) => name !== "hug_open" && total(m) > 0);
        const fired = s.days.some((d) => Object.entries(d.events ?? {}).some(([name, n]) => name !== "hug_open" && n > 0));
        const hasButtons = pressed || fired;

        drawPeople(s, qs, since);
        drawQuestions(s, qs, hasButtons);
        drawKeys(s, hasButtons);
        drawDays(s, qs, start);
        $("adm-push").textContent = `일정 알림을 켠 기기 ${num(s.push?.subs ?? 0)}대 · 보낼 알림 ${num(s.push?.pending ?? 0)}건 남음`;
      }

      /* ── 받아 오기 ─────────────────────────────────────────── */

      const form = $<HTMLFormElement>("adm-key");
      const input = $<HTMLInputElement>("adm-k");
      const sub = $("adm-sub");
      const acts = $("adm-acts");
      const reload = $("adm-reload");
      const err = $("adm-err");
      const wait = $("adm-wait");
      const INTRO = sub.textContent ?? "";

      let current: string | null = null; // 지금 쓰는 열쇠
      let range = "";
      let fetchedAt = 0; // 숫자를 받아 온 시각(없으면 0)
      let stale = false; // 마지막 시도가 실패해 화면의 숫자가 예전 것일 때
      let busy = false;

      const clock = new Intl.DateTimeFormat("ko-KR", { hour: "numeric", minute: "2-digit", hour12: true });
      function paintSub() {
        if (!fetchedAt) return void (sub.textContent = INTRO);
        const fresh = !stale && Date.now() - fetchedAt < 60_000;
        sub.textContent = `${range} · ${fresh ? "방금 받아 왔어요" : `${clock.format(fetchedAt)}에 받아 온 숫자예요`}`;
      }
      setInterval(paintSub, 30_000);
      document.addEventListener("visibilitychange", paintSub);

      function fail(text: string, retry: boolean) {
        $("adm-err-text").textContent = text;
        $("adm-retry").hidden = !retry;
        err.hidden = false;
      }

      async function load(key: string, from: "form" | "saved" | "again") {
        if (busy) return;
        busy = true;
        err.hidden = true;
        // 다시 불러올 때는 이전 숫자를 그대로 두고 버튼만 바꾼다
        if (fetchedAt) {
          reload.textContent = "받아 오는 중…";
          reload.setAttribute("aria-disabled", "true");
        } else {
          wait.hidden = false;
          $("adm-empty").hidden = true;
        }
        try {
          const res = await fetch(`${PUSH_API}/admin/stats`, { headers: { "X-Admin-Key": key } });
          if (res.status === 403) {
            try {
              localStorage.removeItem(KEY);
            } catch {
              /* 저장소를 못 쓰면 지울 것도 없다 */
            }
            current = null;
            fetchedAt = 0;
            $("adm-body").hidden = true;
            $("adm-empty").hidden = true;
            acts.hidden = true;
            form.hidden = false;
            input.value = "";
            paintSub();
            fail(from === "form" ? "열쇠가 맞지 않아요. 다시 넣어 주세요." : "저장해 둔 열쇠가 더는 맞지 않아요. 새 열쇠를 넣어 주세요.", false);
            input.focus();
            return;
          }
          if (!res.ok) throw new Error("bad");
          const s = (await res.json()) as Stats;
          if (!s.ok) throw new Error("bad");
          try {
            localStorage.setItem(KEY, key);
            localStorage.setItem(SELF, "1"); // 이 브라우저(운영자 본인)는 집계에서 뺀다
          } catch {
            /* 저장소를 못 쓰면 매번 넣는다 */
          }
          current = key;
          fetchedAt = Date.now();
          stale = false;
          form.hidden = true;
          input.value = "";
          acts.hidden = false;
          draw(s);
          paintSub();
        } catch {
          // 열쇠는 지우지 않는다. 이전에 받은 숫자도 지우지 않는다
          current = key;
          stale = true;
          if (from !== "form") acts.hidden = false;
          paintSub();
          fail("숫자를 받아 오지 못했어요. 인터넷이 끊겼거나 서버가 잠깐 멈춘 거예요.", true);
        } finally {
          busy = false;
          wait.hidden = true;
          reload.textContent = "다시 불러오기";
          reload.removeAttribute("aria-disabled");
        }
      }

      const again = () => {
        if (current) load(current, "again");
      };
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const v = input.value.trim();
        if (v) load(v, "form");
        else input.focus();
      });
      reload.addEventListener("click", again);
      $("adm-retry").addEventListener("click", again);
      $("adm-empty-reload").addEventListener("click", again);
      $("adm-out").addEventListener("click", () => {
        // 열쇠만 지운다. 본인 표시(jp-admin-self)는 그대로 둔다
        try {
          localStorage.removeItem(KEY);
        } catch {
          /* 지울 수 없으면 그대로 새로 연다 */
        }
        location.reload();
      });

      let saved: string | null = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {
        /* 저장소를 못 쓰면 매번 넣는다 */
      }
      if (saved) {
        form.hidden = true;
        load(saved, "saved");
      }
    </script>
  </body>
</html>
