---
import BaseHead from "../../components/BaseHead.astro";
import ClarityHead from "../../components/ClarityHead.astro";
import AdSenseHead from "../../components/AdSenseHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import "../../styles/global.css";

const title = "원천징수 계산기 (3.3% / 8.8%)";
const description =
  "사업소득 3.3%와 기타소득 8.8% 원천징수액, 실수령액을 바로 계산합니다. 사업소득은 실수령액으로 계약금액을 역산할 수도 있습니다.";
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <AdSenseHead />
  </head>
  <body>
    <SiteHeader />
    <main>
      <h1>{title}</h1>
      <p>
        지급받는 소득이 사업소득(3.3%)인지 기타소득(8.8%)인지 고른 뒤
        금액을 입력하면 원천징수액과 실수령액을 바로 계산합니다. 사업소득은
        실수령액을 넣어 원래 계약금액을 역산할 수도 있습니다.
      </p>

      <div class="calc-card">
        <div class="segmented" role="group" aria-label="소득 유형">
          <button id="tab-income-business" type="button" aria-pressed="true">
            사업소득 (3.3%)
          </button>
          <button id="tab-income-other" type="button" aria-pressed="false">
            기타소득 (8.8%)
          </button>
        </div>

        <div class="segmented" role="group" aria-label="계산 방식">
          <button id="tab-gross" type="button" aria-pressed="true">
            계약금액으로 계산
          </button>
          <button
            id="tab-net"
            type="button"
            aria-pressed="false"
            title="기타소득은 실수령액 역산을 지원하지 않습니다."
          >
            실수령액으로 역산
          </button>
        </div>

        <div class="calc-input-wrap">
          <label id="input-label" for="amount">계약금액</label>
          <input
            type="text"
            inputmode="numeric"
            id="amount"
            value="1,000,000"
          />
          <span class="unit">원</span>
        </div>

        <div class="amount-presets" role="group" aria-label="금액 빠르게 올리기">
          <button type="button" class="preset-chip" data-add="100000">
            +10만
          </button>
          <button type="button" class="preset-chip" data-add="1000000">
            +100만
          </button>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true">
          <p class="label" id="net-label">실수령액</p>
          <p class="big" id="out-net">967,000원</p>
        </div>

        <div class="stat-row">
          <div class="stat-chip">
            <span class="label">원천징수액</span>
            <span class="value" id="out-withholding">33,000원</span>
          </div>
          <div class="stat-chip">
            <span class="label">적용 세율</span>
            <span class="value" id="out-rate">3.3%</span>
          </div>
        </div>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
          <button id="btn-copy" type="button" class="secondary">결과 복사</button>
        </div>
        <p id="copy-toast" class="meta" style="display:none;">
          결과를 복사했어요.
        </p>
      </div>

      <details>
        <summary>사업소득 3.3%와 기타소득 8.8%는 뭐가 다른가요?</summary>
        <p>
          <strong>사업소득 3.3%</strong>는 소득세 3%와 지방소득세 0.3%(소득세의
          10%)를 더한 값으로, 프리랜서·용역 등 계속·반복적인 사업 활동의
          대가를 지급할 때 원천징수합니다. <strong>기타소득 8.8%</strong>는
          소득세 8%와 지방소득세 0.8%를 더한 값으로, 강연료·원고료·상금처럼
          일시적·비반복적으로 발생하는 소득에 적용합니다. 두 세율 모두 미리
          뗀 세금(예납)이며, 다음 해 5월 종합소득세 신고에서 실제 세액과
          비교해 정산됩니다.
        </p>
      </details>

      <p>
        <a href="/freelancer-33/">프리랜서 3.3% 원천징수 계산기 보기</a>
      </p>

      <div class="ad-slot" data-ad="withholding-result"></div>

      <Disclaimer />
    </main>
    <SiteFooter />
    <script src="../../scripts/withholding.ts"></script>
  </body>
</html>
