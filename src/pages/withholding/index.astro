---
import BaseHead from "../../components/BaseHead.astro";
import AdSlot from "../../components/AdSlot.astro";
import ClarityHead from "../../components/ClarityHead.astro";
import GtagHead from "../../components/GtagHead.astro";
import TrackLinks from "../../components/TrackLinks.astro";
import AdSenseHead from "../../components/AdSenseHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NextReads from "../../components/NextReads.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import { calcPresets } from "../../data/calc-presets";
import { otherIncomeExemptMax } from "../../lib/income-tax-rate";
import "../../styles/global.css";

const title = "원천징수 계산기 (3.3% / 8.8%)";
const description =
  "사업소득 3.3%와 기타소득 8.8% 원천징수액, 실수령액을 바로 계산합니다. 두 소득 모두 실수령액으로 계약금액을 역산할 수 있습니다.";
const PRESETS = JSON.stringify({ business: calcPresets["/withholding/"].business.amounts });
const EXEMPT_MAX = otherIncomeExemptMax().toLocaleString("ko-KR");
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>{title}</h1>
      <p>
        지급받는 소득이 사업소득(3.3%)인지 기타소득(8.8%)인지 고른 뒤
        금액을 입력하면 원천징수액과 실수령액을 바로 계산합니다. 실수령액을
        넣어 원래 계약금액을 역산할 수도 있습니다.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="income-type">소득 구분</label>
          <select id="income-type" data-seg>
            <option value="business" selected>사업소득 (3.3%)</option>
            <option value="other">기타소득 (8.8%)</option>
          </select>
        </div>

        <div class="calc-input-wrap">
          <label for="mode">계산 방식</label>
          <select id="mode" data-seg>
            <option value="gross" selected>계약금액으로 계산</option>
            <option value="net">실수령액으로 역산</option>
          </select>
        </div>

        <div class="calc-input-wrap">
          <label id="input-label" for="amount">계약금액</label>
          <input
            type="text"
            inputmode="numeric"
            id="amount"
            data-won
            data-presets={PRESETS}
            data-presets-by="income-type"
            value="1,000,000"
          />
          <span class="unit">원</span>
        </div>

        <div
          class="result-hero"
          aria-live="polite"
          aria-atomic="true"
          data-bar="out-netv|out-income,out-local"
          data-bar-labels="실수령|원천징수"
          data-dock="out-net"
        >
          <p class="label" id="net-label">실수령액</p>
          <p class="big" id="out-net">967,000원</p>
          <p class="meta" id="out-exempt" hidden>
            기타소득금액(받은 금액의 40%)이 5만원 이하라 세금을 떼지 않습니다 —
            필요경비 60% 소득은 {EXEMPT_MAX}원까지 원천징수 0원(소득세법 제84조 제3호).
          </p>
        </div>

        <div class="stat-row" data-receipt>
          <div class="stat-chip">
            <span class="label">계약금액</span>
            <span class="value" id="out-gross">1,000,000원</span>
          </div>
          <div class="stat-chip">
            <span class="label">실수령액</span>
            <span class="value" id="out-netv">967,000원</span>
          </div>
          <div class="stat-chip" data-group="원천징수액">
            <span class="label" id="income-label">소득세 (3%)</span>
            <span class="value" id="out-income">30,000원</span>
          </div>
          <div class="stat-chip">
            <span class="label" id="local-label">지방소득세 (0.3%)</span>
            <span class="value" id="out-local">3,000원</span>
          </div>
        </div>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <details>
        <summary>사업소득 3.3%와 기타소득 8.8%는 뭐가 다른가요?</summary>
        <p>
          <strong>사업소득 3.3%</strong>는 소득세 3%와 지방소득세 0.3%(소득세의
          10%)를 더한 값으로, 프리랜서·용역 등 계속·반복적인 사업 활동의
          대가를 지급할 때 원천징수합니다. <strong>기타소득 8.8%</strong>는
          소득세 8%와 지방소득세 0.8%를 더한 값으로, 강연료·원고료·상금처럼
          일시적·비반복적으로 발생하는 소득에 적용합니다. 두 세율 모두 미리
          뗀 세금(예납)이며, 다음 해 5월 종합소득세 신고에서 실제 세액과
          비교해 정산됩니다. 8.8%는 필요경비 60%가 인정되는 기타소득(강연료·원고료·인세
          등) 기준이고, 기타소득금액이 건별 5만원 이하이면 과세하지 않아 받은 금액
          {EXEMPT_MAX}원까지는 떼는 세금이 없습니다(소득세법 제84조 제3호). 상금처럼
          필요경비가 80%인 소득은 이 계산과 다릅니다.
        </p>
      </details>

      <p>
        여기 나온 금액은 <strong>떼인 세금이지 낸 세금이 아닙니다.</strong>
        실제 세액은 한 해 소득을 전부 합쳐 다음 해 5월에 정해지고, 미리 뗀
        금액이 그보다 많으면 돌려받고 적으면 더 냅니다. 그 구조는{" "}
        <a href="/guide/33-settlement/">3.3%는 종합소득세에서 정산됩니다</a>에
        정리했습니다. 내가 신고 대상인지부터 확인하려면{" "}
        <a href="/guide/who-must-file/">종합소득세 신고 대상</a>을 보세요.
      </p>

      <p>
        <a href="/freelancer-33/">프리랜서 3.3% 원천징수 계산기 보기</a>
      </p>

      <NextReads path="/withholding/" />


      <AdSlot label="withholding-result" />

      <Disclaimer />
    </main>
    <SiteFooter />
    <script src="../../scripts/withholding.ts"></script>
      <TrackLinks />
    <script src="../../scripts/calc-ui.ts"></script>
  </body>
</html>
