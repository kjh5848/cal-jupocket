---
import BaseHead from "../../components/BaseHead.astro";
import AdSlot from "../../components/AdSlot.astro";
import ClarityHead from "../../components/ClarityHead.astro";
import GtagHead from "../../components/GtagHead.astro";
import TrackLinks from "../../components/TrackLinks.astro";
import AdSenseHead from "../../components/AdSenseHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NextReads from "../../components/NextReads.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import { calcPresets } from "../../data/calc-presets";
import "../../styles/global.css";

const title = "프리랜서 3.3% 원천징수 계산기";
const description =
  "계약금액을 입력하면 3.3% 원천징수액과 실수령액을 바로 계산합니다. 실수령액으로 계약금액을 역산할 수도 있습니다.";
const PRESETS = JSON.stringify({ default: calcPresets["/freelancer-33/"].default.amounts });
---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>{title}</h1>
      <p>
        프리랜서·사업소득 3.3% 원천징수를 계산합니다. 계약금액을 넣으면
        실수령액을, 실수령액을 넣으면 원래 계약금액을 역산합니다.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="mode">계산 방식</label>
          <select id="mode" data-seg>
            <option value="gross" selected>계약금액으로 계산</option>
            <option value="net">실수령액으로 역산</option>
          </select>
        </div>

        <div class="calc-input-wrap">
          <label id="input-label" for="amount">계약금액</label>
          <input
            type="text"
            inputmode="numeric"
            id="amount"
            data-won
            data-presets={PRESETS}
            value="1,000,000"
          />
          <span class="unit">원</span>
        </div>

        <div
          class="result-hero"
          aria-live="polite"
          aria-atomic="true"
          data-bar="out-netv|out-income,out-local"
          data-bar-labels="실수령|원천징수"
          data-dock="out-net"
        >
          <p class="label" id="net-label">실수령액</p>
          <p class="big" id="out-net">967,000원</p>
        </div>

        <div class="stat-row" data-receipt>
          <div class="stat-chip">
            <span class="label">계약금액</span>
            <span class="value" id="out-gross">1,000,000원</span>
          </div>
          <div class="stat-chip">
            <span class="label">실수령액</span>
            <span class="value" id="out-netv">967,000원</span>
          </div>
          <div class="stat-chip" data-group="원천징수액 (3.3%)">
            <span class="label">소득세 (3%)</span>
            <span class="value" id="out-income">30,000원</span>
          </div>
          <div class="stat-chip">
            <span class="label">지방소득세 (0.3%)</span>
            <span class="value" id="out-local">3,000원</span>
          </div>
        </div>

        <div class="callout bridge-card">
          <p>
            <strong>잠깐, 방금 뗀 원천징수액이 세금의 끝이 아니에요.</strong>{" "}
            3.3%는 미리 낸 세금(예납)일 뿐이고, 실제 세액은 다음 해 5월
            종합소득세 신고로 확정돼요.
          </p>
          <p>
            <a href="/guide/33-settlement/"
              >3.3%가 어떻게 정산되는지 보기 →</a
            >
          </p>
        </div>

        <div class="actions">
          <button id="btn-download" type="button">PNG 저장</button>
          <button id="btn-share" type="button" class="secondary">공유</button>
        </div>
      </div>

      <details>
        <summary>3.3%는 정확히 뭔가요?</summary>
        <p>
          사업소득 원천징수 3.3%는 <strong>소득세 3%</strong>와
          <strong>지방소득세 0.3%</strong>(소득세의 10%)를 더한 값입니다.
          이 금액은 미리 뗀 세금(예납)이며, 다음 해 5월 종합소득세 신고에서
          실제 세액과 비교해 정산됩니다.
        </p>
      </details>

      <p>
        <a href="/income-tax-refund/">종합소득세 환급 예상 계산기 보기</a> ·
        <a href="/guide/33-settlement/">3.3%가 내년에 어떻게 정산되는지 보기</a>
      </p>

      <NextReads path="/freelancer-33/" />


      <AdSlot label="freelancer-33-result" />

      <Disclaimer />
    </main>
    <SiteFooter />
    <script src="../../scripts/freelancer-33.ts"></script>
      <TrackLinks />
    <script src="../../scripts/calc-ui.ts"></script>
  </body>
</html>
