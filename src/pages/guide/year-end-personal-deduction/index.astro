---
/**
 * "연말정산 인적공제" — 연말정산 시리즈.
 * 근거: 소득세법 제50조(1명 150만원·요건·한 사람만 공제), 제140조(공제신고서), 제137조 제3항.
 * 부양가족 요건의 자세한 사례는 /guide/family-deduction/ 이 받는다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import y from "../../../rates/year-end-2026.json";
import { won } from "../../../lib/won";

const per = y.calc.basicDeductionPerHead.amount;

const title = "연말정산 인적공제 — 1명당 150만원, 맞벌이면 한 사람만 넣습니다";
const description =
  "연말정산 인적공제는 본인·배우자·부양가족 1명당 150만원을 소득에서 뺍니다. 부양가족은 연 소득금액 100만원 이하(근로소득만 있으면 총급여 500만원 이하)여야 하고, 맞벌이 부부는 같은 가족을 한 사람만 넣을 수 있습니다.";

const ANSWER = `연말정산 인적공제는 본인·배우자·부양가족 1명당 ${won(per)}을 소득에서 뺍니다. 가족은 연 소득금액 100만원 이하(근로소득만 있으면 총급여 500만원 이하)여야 하고, 맞벌이 부부는 같은 가족을 둘 중 한 사람만 넣습니다. 공제신고서를 내야 반영됩니다.`;

const QA = [
  { q: "연말정산 인적공제는 얼마인가요?", a: `기본공제 대상 1명당 연 ${won(per)}을 종합소득금액에서 뺍니다(소득세법 제50조 제1항). 본인, 소득이 없거나 적은 배우자, 요건을 갖춘 부양가족이 대상입니다.` },
  { q: "부모님을 연말정산 인적공제에 넣으려면 조건이 있나요?", a: "생계를 같이하는 60세 이상 직계존속으로서 그해 소득금액 합계가 100만원 이하여야 합니다. 근로소득만 있다면 총급여 500만원 이하까지 됩니다(제50조 제1항 제3호). 장애인이면 나이 제한이 없습니다." },
  { q: "맞벌이 부부는 자녀를 둘 다 인적공제에 넣을 수 있나요?", a: "안 됩니다. 배우자나 부양가족이 다른 거주자의 부양가족에도 해당하면 어느 한 사람의 소득에서만 공제합니다(제50조 제3항). 두 사람이 같은 자녀를 넣으면 한쪽은 빠지게 됩니다." },
  { q: "연말정산 인적공제는 자동으로 들어가나요?", a: "본인 몫만 들어갑니다. 공제신고서를 내지 않으면 기본공제 중 본인에 대한 분과 표준세액공제만 적용되므로(제137조 제3항), 가족을 넣으려면 2월분 급여를 받기 전까지 신고서를 내야 합니다." },
];
---

<GuideLayout title={title} description={description} updated={y.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>
    고향에 따로 사시는 경우, 생일이 지난 경우 같은 사례는{" "}
    <a href="/guide/family-deduction/">인적공제, 부양가족 누구까지 넣을 수 있나</a>에
    정리했습니다.
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    누가 넣는 게 유리한지는 두 사람의 세율 구간에 달려 있습니다. 소득공제는 세율이
    높은 쪽에서 더 크게 줄어듭니다 — <a href="/guide/year-end-income-deduction/">연말정산
    소득공제</a>.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
</GuideLayout>
