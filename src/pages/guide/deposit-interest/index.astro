---
/**
 * "예금 이자 계산" — 예금 이자 시리즈 허브. (예금 이자 계산 방법·계산하는법·1억 예금 이자·정기예금 이자 세금도 이 글)
 * 근거: 소득세법 제129조 제1항 제1호(14%), 지방세법 제103조의13(10%), 국고금 관리법 제47조 ①(10원 미만 버림). 금액은 depositInterest() 가 낸다(rates: deposit-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/deposit-2026.json";
import { depositInterest, INTEREST_RATE, LOCAL_RATIO, THRESHOLD } from "../../../lib/deposit";
import { won, eokwon } from "../../../lib/won";
import { depositSeries as S } from "../../../data/series/deposit";

const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const base = { principal: 100_000_000, ratePct: 3, months: 12, method: "simple", tax: "normal" } as const;
const y3 = depositInterest(base);
const y5 = depositInterest({ ...base, ratePct: 5 });
const m1 = depositInterest({ ...base, months: 1 });
const m6 = depositInterest({ ...base, months: 6 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 deposit-interest-series.test.ts 가 rates 와 대조한다.
const title = "예금 이자 계산 — 원금 × 연 이자율 × 맡긴 개월 ÷ 12, 받을 때 15.4%를 뗍니다";
const description =
  "정기예금 이자는 원금에 연 이자율을 곱하고 맡긴 개월 수만큼 12로 나눠 계산합니다. 만기에 이자를 받을 때 소득세와 지방소득세를 합친 15.4%를 떼고 나머지가 세후 이자입니다. 1억원을 연 3%로 1년 맡긴 예와 계산 순서를 정리했습니다.";

const ANSWER = `예금 이자는 원금 × 연 이자율 × 개월 ÷ 12입니다. 1억원을 연 3%로 12개월 맡기면 세전 이자 ${won(y3.grossInterest)}, 여기서 ${pct(INTEREST_RATE * (1 + LOCAL_RATIO))}(${won(y3.tax)})를 떼고 세후 ${won(y3.netInterest)}을 받습니다.`;

const QA = [
  { q: "예금 이자 계산 방법을 순서대로 알려 주세요.", a: `① 원금 × 연 이자율로 1년치 이자를 구하고 ② 맡긴 개월 수 ÷ 12를 곱합니다 ③ 그 이자의 ${pct(INTEREST_RATE)}가 소득세, 소득세의 10%가 지방소득세이고 각각 10원 미만은 버립니다 ④ 이자에서 두 세금을 뺀 것이 세후 이자입니다. 1억원 3% 6개월이면 세전 ${won(m6.grossInterest)}, 세후 ${won(m6.netInterest)}입니다.` },
  { q: "1억 예금 이자는 얼마인가요?", a: `1년 단리 기준으로 연 3%면 세전 ${won(y3.grossInterest)}·세후 ${won(y3.netInterest)}, 연 5%면 세전 ${won(y5.grossInterest)}·세후 ${won(y5.netInterest)}입니다. 한 달만 맡기면 3%에서 세전 ${won(m1.grossInterest)}, 세후 ${won(m1.netInterest)}입니다.` },
  { q: "예금 이자 세금은 따로 신고해야 하나요?", a: `아닙니다. 은행이 이자를 줄 때 세금을 떼서 대신 냅니다(원천징수, 소득세법 제127조). 다만 한 해 이자와 배당을 합쳐 ${eokwon(THRESHOLD)}을 넘으면 다른 소득과 합쳐 다시 계산하는 금융소득종합과세 대상이 됩니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>이자율이 '연'으로 붙어 있어서 1년보다 짧게 맡기면 그만큼 나눠 받습니다. 은행에 따라 개월 대신 실제 맡긴 날수로 계산하기도 하니 정확한 금액은 상품 설명서의 이자 계산 방법을 보세요. 원금·이율·기간을 넣어 바로 보려면 <a href="/guide/deposit-interest-calculator/">예금 이자 계산기</a>를 쓰세요.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>1억원 · 12개월</th><th>세전 이자</th><th>세금</th><th>세후 이자</th></tr></thead>
      <tbody>
        {[2, 3, 4, 5].map((p) => { const x = depositInterest({ ...base, ratePct: p }); return <tr><th scope="row">연 {p}%</th><td>{won(x.grossInterest)}</td><td>{won(x.tax)}</td><td>{won(x.netInterest)}</td></tr>; })}
      </tbody>
    </table>
  </div>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>세율이 어떻게 정해졌는지는 <a href="/guide/interest-income-tax/">이자소득세</a>, 2천만원을 넘을 때 계산은 <a href="/guide/financial-income-tax/">금융소득종합과세</a>에 있습니다. 같은 이율이라도 월복리 상품이면 이자가 조금 더 붙습니다 — <a href="/guide/deposit-simple-compound/">예금 단리 복리 차이</a>.</p>

  <h2>예금 이자 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
