---
/**
 * "육아휴직 기간" — 육아휴직 시리즈. (육아휴직 기간 1년·1년 6개월·대상 자녀 나이·분할·단기 육아휴직 1~2주·근속 포함·불이익 금지도 이 글)
 * 근거: 남녀고용평등법 제19조(1년, 부모 각 3개월 이상·한부모·장애아동 6개월 추가, 제6항~제8항 단기 육아휴직 2026. 8. 20. 시행), 부칙(법률 제21373호). rates: parental-leave-2026.json
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/parental-leave-2026.json";

const L = r.leave;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 parental-leave-series.test.ts 가 rates 와 대조한다.
const title = "육아휴직 기간 — 1년, 부모가 각각 3개월 이상 쓰면 6개월 더해 1년 6개월입니다";
const description =
  "육아휴직 기간은 자녀 1명당 1년이고, 같은 자녀로 부모가 모두 각각 3개월 이상 쓰거나 한부모·장애아동 부모면 6개월을 더 쓸 수 있습니다. 만 8세 이하 또는 초등학교 2학년 이하 자녀가 대상이고, 2026년 8월 20일부터 방학 등에 1~2주 단기 육아휴직도 생겼습니다.";

const ANSWER = `육아휴직 기간은 ${L.months}개월(1년) 이내입니다(남녀고용평등법 제19조 제2항). 같은 자녀로 부모가 모두 각각 ${L.bothMinMonths}개월 이상 썼거나, 한부모이거나, 장애아동의 부모면 ${L.extraMonths}개월을 더 쓸 수 있습니다. 대상 자녀는 ${L.childAge}입니다(제1항).`;

const QA = [
  { q: "육아휴직은 몇 년 쓸 수 있나요?", a: `자녀 1명당 1년 이내이고, 부모가 모두 같은 자녀로 각각 ${L.bothMinMonths}개월 이상 쓰면 부와 모 각자 ${L.extraMonths}개월을 더해 최대 1년 6개월입니다(제19조 제2항). 한부모와 고용노동부령의 장애아동 부모도 ${L.extraMonths}개월이 더해집니다. 휴직 기간은 근속기간에 들어갑니다(제4항).` },
  { q: "육아휴직 대상 자녀 나이는요?", a: `${L.childAge}의 자녀(입양 자녀 포함)입니다(제19조 제1항). 임신 중인 여성 근로자의 모성 보호를 위한 휴직, 유산·조산 위험이 있는 임신 중 배우자를 돌보려는 남성 근로자의 휴직도 육아휴직으로 허용해야 합니다. 대통령령으로 정하는 경우에만 거부할 수 있습니다.` },
  { q: "1~2주 단기 육아휴직은 무엇인가요?", a: `자녀가 다니는 기관의 휴원·휴교·방학이나 자녀 질병 등 사유가 있으면 1년에 1회, 1주 또는 2주 육아휴직을 신청할 수 있고 회사는 허용해야 합니다(제19조 제6항·제7항, 2026년 8월 20일 시행). 이 기간도 1년 육아휴직 기간에 포함되고, 7일 이상이면 육아휴직급여 대상입니다(고용보험법 제70조).` },
  { q: "육아휴직 후 불이익을 주면 어떻게 되나요?", a: `사업주는 육아휴직을 이유로 해고나 불리한 처우를 할 수 없고, 휴직 기간에는 사업을 계속할 수 없는 경우가 아니면 해고하지 못합니다(제19조 제3항). 휴직이 끝나면 같은 업무나 같은 수준의 임금을 받는 직무로 복귀시켜야 합니다(제4항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>방학처럼 신청이 몰리는 기간에 원하는 시기에 쓰게 하는 것이 사업 운영에 막대한 지장을 주면 회사가 근로자와 협의해 시기를 바꿀 수 있고, 이때 사유와 바꾼 기간을 서면으로 알려야 합니다(제19조 제6항 단서·제8항).</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>받는 돈은 <a href="/guide/parental-leave-pay/">육아휴직급여</a>, 출산 직후 휴가는 <a href="/guide/maternity-leave-pay/">출산휴가급여</a>에 있습니다.</p>
</GuideLayout>
