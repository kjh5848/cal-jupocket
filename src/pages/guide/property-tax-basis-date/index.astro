---
/**
 * "재산세 과세기준일" — 재산세 시리즈. (6월 1일·집 팔 때 누가 내나·매매·공유·상속·신탁도 이 글)
 * 근거: 지방세법 제114조(과세기준일 6월 1일), 제107조(사실상 소유자, 공유 지분, 미신고 시 공부상 소유자, 상속, 신탁 위탁자).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/local-tax-2026.json";
import x from "../../../rates/property-extra-2026.json";

const P = r.propertyTax;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 property-tax-series.test.ts 가 rates 와 대조한다.
const title = "재산세 과세기준일 — 6월 1일에 사실상 소유한 사람이 그해 재산세를 냅니다";
const description =
  "재산세 과세기준일은 매년 6월 1일입니다. 그날 재산을 사실상 소유한 사람이 7월과 9월 고지서를 받고, 6월 2일에 팔아도 그해 재산세는 판 사람 몫입니다. 공유는 지분대로 나누고, 매매 뒤 신고하지 않아 실제 소유자를 알 수 없으면 등기부상 소유자에게 나옵니다.";

const ANSWER = `재산세 과세기준일은 매년 ${P.assessmentDate}입니다(지방세법 제114조). 그날 재산을 사실상 소유한 사람이 그해 재산세를 냅니다(제107조 제1항). 그래서 6월 2일에 팔아도 그해 재산세는 판 사람에게 나오고, 공유재산은 지분대로 나눕니다.`;

const QA = [
  { q: "재산세 과세기준일은 언제인가요?", a: `매년 ${P.assessmentDate}입니다(제114조). 이날 현재의 소유자와 재산 상태로 그해 재산세가 정해지고, 고지서는 그 뒤 7월과 9월에 옵니다. 6월 1일이 지나 산 사람은 그해 재산세를 내지 않고 다음 해부터 냅니다.` },
  { q: "집을 팔면 재산세는 누가 내나요?", a: `과세기준일 현재 '사실상 소유하고 있는 자'가 냅니다(제107조 제1항). 6월 1일에 누가 사실상 소유자였는지가 기준이라 그 전에 소유권이 넘어갔으면 산 사람, 6월 2일 이후 넘어가면 판 사람입니다. 매매로 소유권이 바뀌었는데 신고하지 않아 사실상 소유자를 알 수 없으면 공부상 소유자가 냅니다(제2항 제1호).` },
  { q: "공동명의·상속·신탁 재산은 누가 내나요?", a: `공유재산은 지분만큼 각자 내고 지분 표시가 없으면 균등으로 봅니다. 상속등기를 하지 않고 신고도 하지 않았으면 주된 상속자, 신탁재산은 위탁자가 냅니다(제107조). 주택 건물과 땅 주인이 다르면 시가표준액 비율로 나눕니다.` },
];
---

<GuideLayout title={title} description={description} updated={x.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>매매에서 '사실상 소유'가 언제 넘어간 것으로 보는지(잔금·등기 등)의 판단 기준은 이 글에서 조문 밖이라 다루지 않았습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>종합부동산세도 같은 6월 1일 기준입니다 — <a href="/guide/comprehensive-property-tax/">종부세</a>. 납부는 <a href="/guide/property-tax-payment/">재산세 납부방법</a>에 있습니다.</p>
</GuideLayout>
