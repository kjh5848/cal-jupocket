---
/**
 * "급여명세서 발급" — 급여명세서 시리즈. (급여명세서 발급 시기·방법·전자문서·이메일·조회·알바·일용직·퇴사 후도 이 글)
 * 근거: 근로기준법 제48조 제2항(임금을 지급하는 때, 서면·전자문서), 제42조·시행령 제22조(임금대장 3년 보존), 시행령 별표 1, 별표 7.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/payslip-2026.json";
import { eokwon } from "../../../lib/won";

const F = r.fines;
const L = r.ledger;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 payslip-series.test.ts 가 rates 와 대조한다.
const title = "급여명세서 발급 — 월급을 주는 날 함께, 종이나 전자문서로 줘야 합니다";
const description =
  "급여명세서는 회사가 임금을 지급하는 때에 근로자에게 발급해야 하고, 종이 대신 전자문서로 줘도 됩니다. 아르바이트·일용직도 근로자면 받을 수 있습니다. 회사는 임금대장을 마지막 기재일부터 3년간 보존해야 하므로 지난 내역도 회사에 물어볼 수 있습니다.";

const ANSWER = `급여명세서는 회사가 임금을 지급하는 때에 근로자에게 발급해야 하고(근로기준법 제48조 제2항), 서면 대신 전자문서로 줘도 됩니다. 아르바이트·일용직도 근로자면 해당합니다. 회사는 임금대장을 마지막으로 적은 날부터 ${L.keepYears}년간 보존해야 해서(제42조) 지난 달 내역도 회사에 남아 있습니다.`;

const QA = [
  { q: "급여명세서는 언제 발급해야 하나요?", a: `임금을 지급하는 때입니다(제48조 제2항). 월급이면 월급날, 주급·일당이면 그 임금을 주는 날마다 줍니다. 근로자가 달라고 해야 주는 것이 아니라 사용자가 먼저 교부할 의무입니다. 교부하지 않으면 1차 ${eokwon(F.payslipNotIssued[0])}의 과태료 대상입니다(시행령 별표 7).` },
  { q: "급여명세서를 이메일이나 앱으로 줘도 되나요?", a: `됩니다. 조문이 '서면(「전자문서 및 전자거래 기본법」 제2조 제1호에 따른 전자문서를 포함)'으로 교부하라고 정하고 있어 종이 대신 전자적 형태로 작성·송신한 문서로 줄 수 있습니다(제48조 제2항).` },
  { q: "알바·일용직도 급여명세서를 받나요?", a: `받습니다. 제48조 제2항은 '근로자'에게 교부하라고 정하고 고용 형태로 나누지 않습니다. 상시 4명 이하 사업장에도 제48조가 적용되므로(시행령 별표 1) 편의점·식당 아르바이트도 일당·시급을 받을 때마다 명세서를 받을 수 있습니다.` },
  { q: "지난 급여명세서는 어떻게 조회하나요?", a: `회사에 요청하는 것이 가장 빠릅니다. 사용자는 임금대장에 근로자별 임금을 지급할 때마다 적고(제48조 제1항), 그 임금대장을 마지막으로 써 넣은 날부터 ${L.keepYears}년간 보존해야 합니다(제42조, 시행령 제22조). 퇴사한 뒤 다시 발급해 줄 의무가 따로 정해져 있지는 않습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>문자·메신저로 보낼 때 전자문서로 인정되는 세부 요건은 이 글에서 다루지 않았습니다. 무엇을 적어야 하는지는 <a href="/guide/payslip/">급여명세서</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>임금대장에 무엇을 적는지는 <a href="/guide/wage-ledger/">임금대장</a>에 있습니다. 1년치 근로소득과 뗀 세금을 한 장으로 보려면 <a href="/guide/withholding-receipt/">원천징수영수증</a>을 보세요.</p>
</GuideLayout>
