---
/**
 * "퇴직금 중간정산" — 퇴직금·퇴직연금 시리즈. (사유·조건·요건·주택구입·전세·개인회생·세금·사유 없이·회사 거절도 이 글)
 * 근거: 근로자퇴직급여 보장법 제8조 제2항(사용자는 '할 수 있다', 정산 뒤 계속근로기간 새로), 시행령 제3조(사유·5년 서류 보존),
 * 소득세법 시행령 제43조 제2항(받은 날 퇴직으로 봄), 소득세법 제48조·제55조(퇴직소득세).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/severance-2026.json";
import { severanceTax } from "../../../lib/severance";
import { won } from "../../../lib/won";

const I = r.interim;
const ex = severanceTax(40_000_000, 5);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 severance-series.test.ts 가 rates 와 대조한다.
const title = "퇴직금 중간정산 — 무주택자 주택구입·전세, 6개월 이상 요양 등 법에 적힌 사유일 때만";
const description =
  "퇴직금 중간정산은 무주택자의 주택구입이나 전세금, 6개월 이상 요양 의료비, 5년 내 파산·개인회생, 임금피크제, 근로시간 단축 등 시행령에 적힌 사유가 있을 때 근로자가 요구하면 회사가 해 줄 수 있습니다. 정산하면 근속기간은 그날부터 다시 셉니다.";

const ANSWER = `퇴직금 중간정산은 무주택자의 주택구입·전세금, 6개월 이상 요양, 5년 내 파산·개인회생 등 시행령 제3조에 적힌 사유로 근로자가 요구할 때 회사가 할 수 있습니다(근로자퇴직급여 보장법 제8조 제2항). 정산하면 그 뒤 퇴직금의 계속근로기간은 정산 시점부터 새로 셉니다.`;

const QA = [
  { q: "퇴직금 중간정산 사유는 무엇인가요?", a: `① 무주택자 본인 명의 주택구입 ② 무주택자 전세금·보증금(한 직장 1회) ③ 본인·배우자·부양가족의 6개월 이상 요양 의료비가 연간 임금총액의 12.5% 초과 ④ 5년 내 파산·개인회생 ⑤ 임금피크제 ⑥ 근로시간 1일 1시간·1주 5시간 이상 단축 ⑦ 재난 등입니다(시행령 제3조).` },
  { q: "사유 없이 퇴직금 중간정산을 받을 수 있나요?", a: `없습니다. 법은 '주택구입 등 대통령령으로 정하는 사유'로 근로자가 요구하는 경우에 미리 정산할 수 있다고 정했습니다(제8조 제2항). 사유가 있어도 회사에 의무가 생기는 것은 아니고 '지급할 수 있다'는 규정입니다. 회사는 퇴직 후 5년까지 증명 서류를 보존해야 합니다.` },
  { q: "퇴직금 중간정산도 세금을 떼나요?", a: `뗍니다. 중간정산 사유로 미리 받으면 그 받은 날에 퇴직한 것으로 보아(소득세법 시행령 제43조 제2항) 퇴직소득세를 계산합니다. 근속 5년에 4천만원을 정산받으면 지방소득세 포함 ${won(ex.total)}입니다. 근속연수가 짧게 끊겨 나중에 한 번에 받을 때보다 공제가 불리할 수 있습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ol>{I.reasons.map((x) => <li>{x}</li>)}</ol>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    중간정산 뒤 다시 퇴직할 때의 세법상 근속연수 계산(정산분 합산 여부)은 시행령 세부라 이 글에서 다루지 않았습니다.
    퇴직연금(DC·IRP)에 쌓인 돈을 꺼내는 것은 <a href="/guide/pension-mid-withdrawal/">퇴직연금 중도인출</a>입니다.
  </p>
</GuideLayout>
