---
/**
 * "부동산 취득세" — 취득세 시리즈. (토지·상가·건물·농지·증여·상속·신축 취득세율과 합계도 이 글)
 * 근거: 지방세법 제11조 제1항(4%·3%·3.5%·2.8%·2.3%), 제20조(신고기한), 제151조(지방교육세), 농어촌특별세법 제5조(0.2%).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/local-tax-2026.json";
import x from "../../../rates/acquisition-extra-2026.json";
import { acquisitionTotal } from "../../../lib/acquisition-total";
import { bill, DEADLINE } from "../../../lib/acquisition-tax";
import { won, eokwon } from "../../../lib/won";

const S = r.acquisitionTax.standard;
const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const base = 300_000_000;
const land = acquisitionTotal(base, "land");
const gift = acquisitionTotal(base, "gift");
const inh = acquisitionTotal(base, "inheritance");
const farm = bill({ price: base, cause: "paidFarm" });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 acquisition-series.test.ts 가 rates 와 대조한다.
const title = "부동산 취득세 — 토지·상가는 4%에 교육세·농특세를 더해 4.6%, 증여 3.5%, 상속 2.8%";
const description =
  "부동산 취득세는 주택이 아닌 토지·상가·건물을 사면 4%이고 지방교육세 0.4%와 농어촌특별세 0.2%를 더해 4.6%입니다. 농지는 3%, 증여받으면 3.5%, 상속은 2.8%, 새로 지으면 2.8%입니다. 매매는 60일, 증여는 그 달 말일부터 3개월 안에 신고합니다.";

const ANSWER = `부동산 취득세는 주택이 아닌 토지·상가·건물을 사면 ${pct(S.paidOther)}이고, 지방교육세(4% − 2%) × 20% = 0.4%와 농어촌특별세 0.2%를 더해 4.6%입니다(지방세법 제11조·제151조, 농어촌특별세법 제5조). 농지 매매 ${pct(S.paidFarm)}, 증여 ${pct(S.gift)}, 상속 ${pct(S.inheritanceOther)}입니다.`;

const QA = [
  { q: "토지·상가 취득세는 얼마인가요?", a: `주택이 아닌 부동산을 사는 '그 밖의 원인으로 인한 취득'은 농지 외 ${pct(S.paidOther)}, 농지 ${pct(S.paidFarm)}입니다(제11조 제1항 제7호). ${eokwon(base)} 상가나 토지면 취득세 ${won(land.acq)}, 지방교육세 ${won(land.edu)}, 농어촌특별세 ${won(land.rural ?? 0)}으로 합계 ${won(land.total)}입니다.` },
  { q: "부동산을 증여받으면 취득세가 얼마인가요?", a: `상속 외의 무상취득은 ${pct(S.gift)}입니다(비영리사업자 ${pct(S.giftNonProfit)}). ${eokwon(base)}이면 취득세 ${won(gift.acq)}에 지방교육세 ${won(gift.edu)}, 농특세 ${won(gift.rural ?? 0)}이 붙어 합계 ${won(gift.total)}입니다. 조정대상지역의 일정가액 이상 주택을 증여받으면 12% 중과 대상이 될 수 있습니다(제13조의2 제2항).` },
  { q: "상속받은 부동산 취득세는 얼마인가요?", a: `상속은 농지 ${pct(S.inheritanceFarm)}, 그 밖 ${pct(S.inheritanceOther)}입니다(제11조 제1항 제1호). ${eokwon(base)}이면 취득세 ${won(inh.acq)}, 지방교육세 ${won(inh.edu)}, 농특세 ${won(inh.rural ?? 0)}입니다. 신고는 상속개시일이 속하는 달의 말일부터 ${DEADLINE.inheritanceMonths}개월 안입니다.` },
];
---

<GuideLayout title={title} description={description} updated={x.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>{eokwon(base)}을</th><th>취득세율</th><th>취득세</th><th>지방교육세</th><th>농특세</th><th>합계</th></tr></thead>
    <tbody>
      {[
        { label: "토지·상가·건물 매매", t: land },
        { label: "증여", t: gift },
        { label: "상속(농지 외)", t: inh },
      ].map(({ label, t }) => <tr><th scope="row">{label}</th><td>{pct(t.rate)}</td><td>{won(t.acq)}</td><td>{won(t.edu)}</td><td>{won(t.rural ?? 0)}</td><td>{won(t.total)}</td></tr>)}
    </tbody>
  </table>
  <p>농지 매매는 취득세 {pct(farm.rate)}로 {won(farm.acquisitionTax)}입니다. 상속 농지·자경 농지 감면은 이 글에서 다루지 않았습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    집을 새로 지은 원시취득은 {pct(S.original)}, 공유물 분할은 {pct(S.partition)}입니다. 주택 매매는{" "}
    <a href="/guide/apartment-acquisition-tax/">아파트 취득세</a>, 신고기한 전체는 <a href="/guide/acquisition-tax/">취득세</a>에 있습니다.
  </p>
</GuideLayout>
