---
/**
 * "법인세 중간예납" — 법인세 시리즈. (중간예납 기한·8월·계산 방법·직전 기준·가결산·면제·신설 법인도 이 글)
 * 근거: 법인세법 제63조(6개월 초과 사업연도, 최초 사업연도 제외, 중소기업 50만원 미만 면제, 기간 후 2개월), 제63조의2(두 방법 — 계산식 img alt).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/corporate-tax-2026.json";
import { prepayByPrior, prepayDeadline } from "../../../lib/corporate-tax";
import { shiftToBusinessDay, koDate } from "../../../lib/tax-deadline";
import { won, eokwon } from "../../../lib/won";

const P = r.prepay;
const prior = 30_000_000;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 registration-corporate-series.test.ts 가 rates 와 대조한다.
const title = "법인세 중간예납 — 사업연도 첫 6개월분을 그 뒤 2개월 안에, 12월 결산이면 8월 31일";
const description =
  "법인세 중간예납은 사업연도가 6개월을 넘는 법인이 첫 6개월분을 그 뒤 2개월 안에 미리 내는 것입니다. 12월 결산이면 8월 31일까지이고, 직전 산출세액의 절반이나 6개월 가결산 중 고릅니다. 새 법인의 첫해와 50만원 미만 중소기업은 내지 않습니다.";

const ANSWER = `법인세 중간예납은 사업연도가 6개월을 넘는 법인이 첫 6개월분을 그 기간이 지난 날부터 ${P.months}개월 안에 내는 것입니다(법인세법 제63조). 12월 결산이면 ${koDate(shiftToBusinessDay(prepayDeadline(2026, 1)))}까지이고, 직전 산출세액 기준(× 6 ÷ 직전 월수)이나 6개월 가결산 중 고릅니다(제63조의2).`;

const QA = [
  { q: "법인세 중간예납은 언제 내나요?", a: `중간예납기간은 사업연도 개시일부터 6개월이고, 그 기간이 지난 날부터 ${P.months}개월 이내에 냅니다(제63조 제2항·제3항). 1월 1일에 시작하는 12월 결산 법인은 8월 31일까지입니다. 사업연도가 6개월 이하인 법인은 중간예납이 없습니다.` },
  { q: "법인세 중간예납은 어떻게 계산하나요?", a: `① 직전 기준: (직전 사업연도 확정 산출세액 − 감면 − 원천징수 − 수시부과세액) × 6 ÷ 직전 사업연도 월수 ② 가결산: 6개월을 1사업연도로 보고 계산한 법인세에서 같은 항목을 뺀 금액 중 고릅니다(제63조의2). 직전 산출세액이 ${eokwon(prior)}이면 ①은 ${won(prepayByPrior(prior))}입니다.` },
  { q: "법인세 중간예납을 안 내도 되는 법인은?", a: `합병·분할이 아닌 방법으로 새로 설립된 법인의 최초 사업연도, 직전 사업연도 중소기업으로 직전 기준 계산액이 ${eokwon(P.smeExempt)} 미만인 법인, 사립학교 법인 등은 의무가 없습니다(제63조 제1항). 휴업 등으로 수입이 없으면 징수하지 않습니다(제63조의2 제5항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>
    직전 사업연도 산출세액이 없거나 중간예납기간 끝까지 확정되지 않았으면 가결산 방식으로 계산하고, 기한까지 내지 않으면 직전 기준으로
    계산합니다(제63조의2 제2항). 공시대상기업집단 소속 법인 등은 가결산이 원칙입니다(제1항 단서).
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>개인사업자의 11월 중간예납은 <a href="/guide/income-prepayment/">종합소득세 중간예납</a>에 있습니다.</p>
</GuideLayout>
