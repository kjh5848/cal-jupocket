---
/**
 * "적금 이자 계산" — 적금 이자 시리즈 허브. (적금 이자 계산하는 방법·정기적금 이자계산·적금 만기 계산도 이 글)
 * 근거: 적립식예금약관 제4조 ①(저축금마다 입금일부터 만기일 전날까지), 소득세법 제129조 ① 1호(14%), 지방세법 제103조의13(10%),
 * 국고금 관리법 제47조 ①(10원 미만 버림). 금액은 installmentSavings() 가 낸다(rates: installment-savings-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/installment-savings-2026.json";
import { installmentSavings } from "../../../lib/installment-savings";
import { INTEREST_RATE, LOCAL_RATIO, THRESHOLD } from "../../../lib/deposit";
import { won, eokwon } from "../../../lib/won";
import { installmentSavingsSeries as S } from "../../../data/series/installment-savings";

const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const base = { monthly: 500_000, ratePct: 3.5, months: 12, method: "simple", tax: "normal" } as const;
const ex = installmentSavings(base);
const m24 = installmentSavings({ ...base, months: 24 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 installment-savings-series.test.ts 가 rates 와 대조한다.
const title = "적금 이자 계산 — 매달 넣은 돈마다 남은 개월만큼만 이자가 붙고, 받을 때 15.4%를 뗍니다";
const description =
  "정기적금 이자는 회차마다 넣은 돈에 만기까지 남은 개월만큼 이자를 붙여 더합니다. 첫 달 돈은 기간 전체, 마지막 달 돈은 한 달치만 받아서 같은 이율 예금보다 이자가 적습니다. 만기에 15.4%를 떼고 받는 세후 이자와 계산 순서를 월 50만원 예로 정리했습니다.";

const ANSWER = `적금 이자는 월 납입액 × 연 이자율 ÷ 12 × (1 + 2 + … + 개월 수)입니다. 월 50만원을 연 3.5%로 12개월 넣으면 원금 ${won(ex.principal)}에 세전 이자 ${won(ex.grossInterest)}, ${pct(INTEREST_RATE * (1 + LOCAL_RATIO))}를 떼고 만기에 ${won(ex.maturity)}을 받습니다.`;

const QA = [
  { q: "적금 이자 계산하는 방법을 순서대로 알려 주세요.", a: `① 회차마다 만기까지 남은 개월을 셉니다(12개월 적금이면 첫 달 12, 마지막 달 1) ② 월 납입액 × 연 이자율 ÷ 12 × 남은 개월을 회차마다 구해 더합니다 ③ 그 이자의 ${pct(INTEREST_RATE)}가 소득세, 소득세의 10%가 지방소득세이고 각각 10원 미만은 버립니다.` },
  { q: "월 50만원 적금 만기 금액은 얼마인가요?", a: `연 3.5% 단리로 12개월이면 세전 이자 ${won(ex.grossInterest)}, 세금 ${won(ex.tax)}을 떼고 만기에 ${won(ex.maturity)}입니다. 24개월이면 원금 ${won(m24.principal)}에 세후 이자 ${won(m24.netInterest)}, 만기 ${won(m24.maturity)}입니다.` },
  { q: "적금 이자 세금은 따로 신고해야 하나요?", a: `아닙니다. 은행이 만기에 이자를 줄 때 세금을 떼서 대신 냅니다(원천징수). 다만 한 해 이자와 배당을 합쳐 ${eokwon(THRESHOLD)}을 넘으면 다른 소득과 합쳐 다시 계산하는 금융소득종합과세 대상입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>은행 적립식예금 약관은 "저축금마다 입금일부터 만기일 전날까지의 기간"에 이자를 셈한다고 적습니다. 그래서 1부터 개월 수까지 더한 값(12개월이면 78)을 한 달치 이자에 곱하면 됩니다. 약관은 실제 날수로 세니, 약정일보다 늦게 넣거나 미리 넣으면 금액이 조금 달라집니다. 바로 넣어 보려면 <a href="/guide/installment-savings-calculator/">적금 이자 계산기</a>를 쓰세요.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>월 50만원 · 12개월</th><th>세전 이자</th><th>세금</th><th>만기 수령액</th></tr></thead>
      <tbody>
        {[3, 3.5, 4, 5].map((p) => { const x = installmentSavings({ ...base, ratePct: p }); return <tr><th scope="row">연 {p}%</th><td>{won(x.grossInterest)}</td><td>{won(x.tax)}</td><td>{won(x.maturity)}</td></tr>; })}
      </tbody>
    </table>
  </div>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>세율 근거는 <a href="/guide/interest-income-tax/">이자소득세</a>에 있습니다. 같은 연 이율이라도 적금 이자가 예금보다 적은 이유와 월복리 적금은 <a href="/guide/installment-savings-simple-compound/">적금 단리 복리</a>에, 목돈을 한 번에 맡기는 경우는 <a href="/guide/deposit-interest/">예금 이자 계산</a>에 있습니다.</p>

  <h2>적금 이자 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
