---
/**
 * "재산세" — 재산세 시리즈 허브(35번 글, 같은 주소를 스니펫 구조로 고쳐 썼다). (재산세 부과기준·납부기간·7월·9월·세율·1세대1주택·감면도 이 글)
 * 근거: 지방세법 제107조(6월 1일 사실상 소유자), 제110조·시행령 제109조(공정시장가액비율, 1세대1주택 43~45%), 제111조·제111조의2(세율·특례),
 * 제112조(도시지역분), 제114조·제115조(6월 1일, 7월·9월 반씩), 제151조(지방교육세). rates: local-tax-2026.json, property-extra-2026.json
 * 금액은 손으로 적지 않는다 — bill() 이 낸다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { bill } from "../../../lib/property-tax";
import r from "../../../rates/local-tax-2026.json";
import x from "../../../rates/property-extra-2026.json";
import { won, eokwon } from "../../../lib/won";
import { propertyTaxSeries as S } from "../../../data/series/property-tax";

const P = r.propertyTax;
const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const v = 500_000_000;
const plain = bill({ standardValue: v, kind: "house" });
const one = bill({ standardValue: v, kind: "house", oneHome: true });
const urban = bill({ standardValue: v, kind: "house", oneHome: true, urban: true });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 property-tax-series.test.ts 가 rates 와 대조한다.
const title = "재산세 — 6월 1일 소유자에게, 주택은 7월과 9월에 반씩, 1세대 1주택은 세율과 비율이 낮습니다";
const description =
  "재산세는 6월 1일 현재 집이나 땅을 사실상 가진 사람에게 붙고, 주택은 7월 16~31일과 9월 16~30일에 반씩 냅니다. 과세표준은 공시가격에 공정시장가액비율(주택 60%, 1세대 1주택 43~45%)을 곱한 금액이고, 고지서에는 도시지역분과 지방교육세가 함께 붙습니다.";

const ANSWER = `재산세는 6월 1일 현재 재산을 사실상 소유한 사람에게 붙고(지방세법 제107조·제114조), 주택은 7월 16~31일과 9월 16~30일에 반씩 냅니다(제115조). 과세표준은 시가표준액(공시가격) × 공정시장가액비율(주택 ${pct(P.taxBase.ratios.house)}, 1세대 1주택 43~45%)이고, 도시지역분과 지방교육세가 함께 붙습니다.`;

const QA = [
  { q: "재산세는 누가 언제 내나요?", a: `과세기준일 6월 1일 현재 재산을 사실상 소유한 사람이 냅니다(제107조·제114조). 주택은 한 해 세액의 절반을 7월 16~31일, 나머지를 9월 16~30일에 내고, 건축물은 7월, 토지는 9월입니다(제115조). 주택분이 ${eokwon(P.smallAmountLumpSum)} 이하면 조례에 따라 7월에 한 번에 낼 수 있습니다.` },
  { q: "재산세는 어떻게 계산하나요?", a: `과세표준 = 시가표준액 × 공정시장가액비율(토지·건축물 ${pct(P.taxBase.ratios.landAndBuilding)}, 주택 ${pct(P.taxBase.ratios.house)}, 1세대 1주택 43~45%)에 세율(주택 0.1~0.4%, 1세대 1주택 특례 0.05~0.35%)을 곱합니다. 공시가격 ${eokwon(v)} 주택은 일반 ${won(plain.total)}, 1세대 1주택 ${won(one.total)}입니다(지방교육세 포함).` },
  { q: "재산세 고지서가 계산보다 큰 이유는?", a: `고지서에는 재산세 본세 외에 지방교육세(본세의 20%)와, 지방의회가 정한 도시지역이면 도시지역분(과세표준의 0.14%, 조례로 0.23%까지)이 함께 붙습니다(제112조·제151조). 공시가격 ${eokwon(v)} 1세대 1주택이 도시지역이면 ${won(urban.total)}입니다.` },
  { q: "재산세를 줄이거나 미룰 수 있나요?", a: `1세대 1주택은 공정시장가액비율과 세율 모두 특례가 적용됩니다(시행령 제109조, 제111조의2). 만 60세 이상이거나 5년 이상 보유한 1세대 1주택자는 소득·세액 요건을 갖추면 담보를 제공하고 납부를 유예받을 수 있습니다(제118조의2). 개별 감면(지방세특례제한법)은 이 글에서 다루지 않았습니다.` },
];
---

<GuideLayout title={title} description={description} updated={x.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>무엇</th><th>납기</th></tr></thead>
    <tbody>{P.periods.map((p) => <tr><th scope="row">{p.subject}</th><td>{p.from} ~ {p.to}</td></tr>)}</tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>공시가격 {eokwon(v)} 주택</th><th>과세표준</th><th>본세</th><th>지방교육세</th><th>합계</th></tr></thead>
    <tbody>
      <tr><th scope="row">일반(비율 {pct(plain.ratio)})</th><td>{won(plain.base)}</td><td>{won(plain.propertyTax)}</td><td>{won(plain.educationTax)}</td><td>{won(plain.total)}</td></tr>
      <tr><th scope="row">1세대 1주택(비율 {pct(one.ratio)})</th><td>{won(one.base)}</td><td>{won(one.propertyTax)}</td><td>{won(one.educationTax)}</td><td>{won(one.total)}</td></tr>
    </tbody>
  </table>
  <p>공시가격별 표는 <a href="/guide/property-tax-calc/">재산세 계산</a>, 직접 계산은 <a href="/property-tax/">재산세 계산기</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>{P.burdenCapNote.replace(/\*\*/g, "")}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>재산세 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
