---
/**
 * "일용직 4대보험" — 4대보험 시리즈. (일용직 4대보험 8일·가입기준·공제·계산·건설일용직·쿠팡도 이 글)
 * 근거: 국민연금법 시행령 제2조 제1호(일용·1개월 미만 제외, 1개월 이상 + 월 8일·60시간·고시 소득이면 포함),
 * 국민건강보험법 제6조 제2항 제1호(고용 기간 1개월 미만 일용근로자 제외), 고용보험법 시행령 제3조 제2항(일용근로자 적용),
 * 보험료징수법 제13조·시행령 제12조(0.9%).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/four-insurance-2026.json";
import { won } from "../../../lib/won";

const pct = (v: number) => `${+(v * 100).toFixed(4)}%`;
const ew = r.employment.unemployment * r.employment.workerShare;
const day = 150_000;
const dayEmp = Math.floor(day * ew + 1e-6);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 four-insurance-series.test.ts 가 rates 와 대조한다.
const title = "일용직 4대보험 — 고용보험은 하루만 일해도, 국민연금은 1개월 이상·월 8일 이상부터";
const description =
  "일용직 4대보험은 보험마다 기준이 다릅니다. 고용보험은 일용근로자라면 근로시간과 관계없이 적용되고, 건강보험은 고용 기간 1개월 미만이면 빠지며, 국민연금은 1개월 이상 계속 일하면서 한 달에 8일 이상 또는 60시간 이상 일하면 가입합니다.";

const ANSWER = `일용직 4대보험은 보험마다 기준이 다릅니다. 고용보험은 일용근로자에게 근로시간과 관계없이 적용되고(고용보험법 시행령 제3조), 건강보험은 고용 기간 1개월 미만이면 직장가입에서 빠지며(국민건강보험법 제6조), 국민연금은 1개월 이상 계속 일하면서 월 8일 이상 등이면 가입합니다(국민연금법 시행령 제2조).`;

const QA = [
  { q: "일용직 4대보험 8일 기준은 무엇인가요?", a: `국민연금 기준입니다. 일용근로자나 1개월 미만으로 일하는 사람은 원래 사업장가입자에서 빠지지만, 1개월 이상 계속 일하면서 한 달 근로일수가 8일 이상이거나 근로시간이 60시간 이상이거나 소득이 고시 금액 이상이면 포함됩니다(시행령 제2조 제1호). 건설현장 등은 근로시간 기준이 없습니다.` },
  { q: "일용직도 고용보험에 가입하나요?", a: `가입합니다. 고용보험은 월 60시간·주 15시간 미만을 빼지만, 일용근로자는 그 예외로 법 적용 대상입니다(고용보험법 시행령 제3조 제2항). 근로자 몫 보험료는 일당 × ${pct(ew)}라 일당 15만원이면 하루 ${won(dayEmp)}입니다.` },
  { q: "일용직 건강보험은 어떻게 되나요?", a: `고용 기간이 1개월 미만인 일용근로자는 직장가입자에서 빠집니다(국민건강보험법 제6조 제2항 제1호). 이때는 본인이 지역가입자이거나 가족의 피부양자로 남습니다. 1개월 이상 고용되면 직장가입자가 되어 보수월액 × 3.595%를 냅니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>일용근로자</th><th>가입 기준</th></tr></thead>
    <tbody>
      <tr><th scope="row">고용보험</th><td>일용근로자면 적용(시간 기준 없음)</td></tr>
      <tr><th scope="row">건강보험</th><td>고용 기간 1개월 이상이면 직장가입자</td></tr>
      <tr><th scope="row">국민연금(일반 사업장)</th><td>1개월 이상 계속 + 월 8일 이상 또는 60시간 이상 또는 고시 소득 이상</td></tr>
      <tr><th scope="row">국민연금(건설현장 등 고시 사업장)</th><td>1개월 이상 계속 + 월 8일 이상 또는 고시 소득 이상</td></tr>
      <tr><th scope="row">산재보험</th><td>근로자 부담 없음(사업주 전액)</td></tr>
    </tbody>
  </table>
  <p>'고시 소득' 금액은 보건복지부 고시라 이 글에서 확인하지 않았습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    근로내용확인신고 같은 신고 절차와 기한은 이 글에서 다루지 않았습니다. 단시간 근로자 기준은{" "}
    <a href="/guide/four-insurance-eligibility/">4대보험 가입조건</a>에 있습니다.
  </p>
</GuideLayout>
