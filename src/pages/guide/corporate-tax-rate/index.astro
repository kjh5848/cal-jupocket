---
/**
 * "법인세율" — 법인세 시리즈. (법인세율 2026·인상·구간·누진·부동산임대 법인·계산도 이 글)
 * 근거: 법인세법 제55조 제1항(제1호 10·20·22·25%, 제2호 부동산임대 주업 등 20·22·25% — img alt), 부칙 <법률 제21217호> 제5조, 개정이유.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/corporate-tax-2026.json";
import { corporateTax, corporateTaxBeforeRaise } from "../../../lib/corporate-tax";
import { won, eokwon } from "../../../lib/won";

const pct = (v: number) => `${Math.round(v * 100)}%`;
const B = r.brackets;
const R = r.rentalBrackets;
const label = (rows: typeof B, i: number) => (rows[i].upTo === null ? `${eokwon(rows[i - 1].upTo!)} 초과` : i === 0 ? `${eokwon(rows[i].upTo!)} 이하` : `${eokwon(rows[i - 1].upTo!)} 초과 ${eokwon(rows[i].upTo!)} 이하`);
const bases = [100_000_000, 200_000_000, 500_000_000, 1_000_000_000, 5_000_000_000];
const rows = bases.map((b) => ({ b, now: corporateTax(b), before: corporateTaxBeforeRaise(b) }));

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 registration-corporate-series.test.ts 가 rates 와 대조한다.
const title = "법인세율 — 2억원 이하 10%, 200억원 이하 20%, 3천억원 이하 22%, 초과 25%(2026년 시작 사업연도부터)";
const description =
  "법인세율은 과세표준 2억원 이하 10%, 2억원 초과 200억원 이하 20%, 3천억원 이하 22%, 3천억원 초과 25%입니다. 2026년 1월 1일 이후 시작하는 사업연도부터 각 구간이 1%p 올랐습니다. 부동산임대업이 주업인 소규모 법인 등은 200억원 이하부터 20%입니다.";

const ANSWER = `법인세율은 과세표준 2억원 이하 ${pct(B[0].rate)}, 200억원 이하 ${pct(B[1].rate)}, 3천억원 이하 ${pct(B[2].rate)}, 초과 ${pct(B[3].rate)}입니다(법인세법 제55조 제1항). 2026년 1월 1일 이후 시작하는 사업연도부터 각 구간이 1%p 올랐고(부칙 제5조), 부동산임대업 주업 법인 등은 200억원 이하부터 ${pct(R[0].rate)}입니다.`;

const QA = [
  { q: "2026년 법인세율표는 어떻게 되나요?", a: `2억원 이하 과세표준의 ${pct(B[0].rate)}, 2억원 초과 200억원 이하 2천만원 + 초과분의 ${pct(B[1].rate)}, 200억원 초과 3천억원 이하 39억8천만원 + 초과분의 ${pct(B[2].rate)}, 3천억원 초과 655억8천만원 + 초과분의 ${pct(B[3].rate)}입니다. 초과분에만 그 세율을 곱하는 누진 구조입니다.` },
  { q: "법인세율은 언제 얼마나 올랐나요?", a: `2025년 12월 23일 개정(법률 제21217호)으로 과세표준 구간별 세율을 각각 1퍼센트씩 올렸고, 2026년 1월 1일 이후 시작하는 사업연도의 소득부터 적용합니다(부칙 제5조). 12월 결산 법인은 2026 사업연도분을 2027년 3월에 신고할 때부터 오른 세율로 계산합니다.` },
  { q: "부동산임대업 법인의 법인세율은 다른가요?", a: `부동산임대업을 주된 사업으로 하는 등 제60조의2 제1항 제1호에 해당하는 법인은 2억원 이하 구간이 없어 200억원 이하 ${pct(R[0].rate)}, 3천억원 이하 ${pct(R[1].rate)}, 초과 ${pct(R[2].rate)}입니다(제55조 제1항 제2호). 해당 요건(시행령)은 이 글에서 확인하지 않았습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>과세표준</th><th>일반 법인</th><th>부동산임대 주업 법인 등</th></tr></thead>
    <tbody>
      {B.map((b, i) => <tr><th scope="row">{label(B, i)}</th><td>{pct(b.rate)}</td><td>{i === 0 ? pct(R[0].rate) : pct(b.rate)}</td></tr>)}
    </tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>과세표준</th><th>2026년 시작 사업연도</th><th>인상 전 세율이었다면</th><th>차이</th></tr></thead>
    <tbody>{rows.map(({ b, now, before }) => <tr><th scope="row">{eokwon(b)}</th><td>{won(now)}</td><td>{won(before)}</td><td>{won(now - before)}</td></tr>)}</tbody>
  </table>
  <p>'인상 전'은 개정이유의 '구간별 1퍼센트씩 인상'을 거꾸로 적용한 계산입니다. 지방소득세(법인분)는 이 글에서 계산하지 않았습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>사업연도가 1년 미만이면 과세표준을 12개월로 환산해 세율을 적용하고 다시 월수만큼으로 줄입니다(제55조 제2항). 계산 순서는 <a href="/guide/corporate-tax-base/">법인세 과세표준</a>에 있습니다.</p>
</GuideLayout>
