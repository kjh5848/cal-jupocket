---
/**
 * "세금계산서 발행방법" — 사업자 신고 시리즈 허브. (세금계산서 발행 방법·홈택스·기재사항·발행일·발행 시기도 이 글)
 * 근거: 부가가치세법 제32조 제1항(필요적 기재사항)·제2항·제3항(전자 발급·전송), 제34조(발급시기 — vat-2026.json),
 * 시행령 제68조 제5항(전자적 방법 — 국세청 시스템 등)·제7항(다음 날 전송), 제60조 제2항(가산세 — vat-penalty-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/business-filing-2026.json";
import v from "../../../rates/vat-2026.json";
import vp from "../../../rates/vat-penalty-2026.json";
import { won, eokwon } from "../../../lib/won";
import { businessFilingSeries as S } from "../../../data/series/business-filing";

const T = v.taxInvoice;
const P = vp.taxInvoice;
const pct = (x: number) => `${+(x * 100).toFixed(1)}%`;
const amount = 10_000_000;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 business-filing-series.test.ts 가 rates 와 대조한다.
const title = "세금계산서 발행방법 — 기재사항 네 가지를 적어 공급시기에 발급하고, 전자면 다음 날까지 전송";
const description =
  "세금계산서 발행방법은 공급자·공급받는 자의 등록번호, 공급가액과 부가세, 작성 연월일을 적어 재화나 용역을 공급한 때에 발급하는 것입니다. 전자세금계산서는 홈택스 등 정해진 시스템으로 발급하고 다음 날까지 국세청에 전송합니다. 월 합계 발급은 다음 달 10일까지입니다.";

const ANSWER = `세금계산서는 공급자 등록번호·성명, 공급받는 자 등록번호, 공급가액과 부가가치세액, 작성 연월일을 적어(부가가치세법 제32조 제1항) 재화·용역을 공급한 때에 발급합니다(제34조). 전자세금계산서는 국세청 시스템 등으로 발급하고 발급일 다음 날까지 국세청에 전송합니다.`;

const QA = [
  { q: "세금계산서에는 무엇을 적어야 하나요?", a: `필요적 기재사항은 ① 공급하는 사업자의 등록번호와 성명·명칭 ② 공급받는 자의 등록번호(사업자가 아니면 고유번호나 주민등록번호) ③ 공급가액과 부가가치세액 ④ 작성 연월일입니다(제32조 제1항). 이 중 빠지거나 틀리면 공급가액의 ${pct(P.wrongEntry)} 가산세 대상입니다.` },
  { q: "세금계산서는 어떻게 발행하나요?", a: `전자세금계산서는 국세청장이 구축한 발급 시스템(홈택스), 발급대행 사업자 시스템, ERP, 전자세금계산서 발급이 되는 현금영수증 발급장치 중 하나로 발급합니다(시행령 제68조 제5항). 의무자가 아니면 종이로도 되지만 전자로 발급·전송할 수도 있습니다.` },
  { q: "세금계산서는 언제 발행하나요?", a: `원칙은 재화·용역의 공급시기입니다(제34조 제1항). 거래처별로 한 달 치를 합쳐 말일자로 발급하는 등 정해진 경우에만 다음 달 10일까지 발급할 수 있고(제3항), 공급시기 전에 먼저 발급하는 것도 조건이 맞아야 합니다. 발급시기를 넘기면 ${pct(P.lateIssue)}, 확정신고기한까지도 안 하면 ${pct(P.notIssued)} 가산세입니다.` },
  { q: "전자세금계산서는 발급만 하면 끝인가요?", a: `아닙니다. 발급과 별도로 발급일 다음 날까지 발급명세를 국세청에 전송해야 합니다(제32조 제3항, 시행령 제68조 제7항). 늦게 전송하면 공급가액의 ${pct(P.eTransmitLate)}, 끝내 전송하지 않으면 ${pct(P.eTransmitNone)}입니다. ${eokwon(amount)}짜리면 각각 ${won(Math.round(amount * P.eTransmitLate))}, ${won(Math.round(amount * P.eTransmitNone))}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ol>{T.required.items.map((x) => <li>{x}</li>)}</ol>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>홈택스 화면의 메뉴 순서는 바뀔 수 있어 이 글에서는 법이 정한 발급 경로만 적었습니다. 의무 대상은 <a href="/guide/e-tax-invoice/">전자세금계산서 발행</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    다음 달 10일의 조건은 <a href="/guide/tax-invoice-date/">세금계산서 발행일자</a>, 먼저 발급할 때는{" "}
    <a href="/guide/tax-invoice-early-issue/">세금계산서 발행 후 대금 지급 기한</a>, 잘못 발급했다면{" "}
    <a href="/guide/tax-invoice-cancel/">세금계산서 발행 취소</a>에 있습니다.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>사업자 신고 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
