---
/**
 * "지방소득세" — 지방세 시리즈(42번 글, 같은 주소를 스니펫 구조로 고쳐 썼다). (개인지방소득세·세율·신고·특별징수·3.3%·분납·퇴직도 이 글)
 * 근거: 지방세법 제92조 제1항(표 — 소득세 기본세율의 10분의 1)·제2항(조례 50%)·제4항(퇴직), 제95조 제1항(소득세 신고기한까지 따로)·
 * 제4항(100만원 초과 분납), 제103조의13(원천징수 소득세의 10% 특별징수, 다음 달 10일).
 *
 * "소득세의 10%"라고 쓰지 않는다 — 정확히는 같은 과세표준에 1/10 세율표. 공제·감면이 없으면 결과가 같다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { taxOn, BRACKETS, INSTALLMENT, ORDINANCE, FILING } from "../../../lib/local-income-tax";
import r from "../../../rates/local-tax-2026.json";
import x from "../../../rates/local-extra-2026.json";
import { won, eokwon } from "../../../lib/won";

const pct = (v: number) => `${+(v * 100).toFixed(1)}%`;
const label = (i: number) => (i === 0 ? `${eokwon(BRACKETS[i].upTo!)} 이하` : BRACKETS[i].upTo === null ? `${eokwon(BRACKETS[i - 1].upTo!)} 초과` : `${eokwon(BRACKETS[i - 1].upTo!)} 초과 ${eokwon(BRACKETS[i].upTo!)} 이하`);
const examples = [10_000_000, 30_000_000, 60_000_000, 100_000_000, 200_000_000];

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 local-tax-series.test.ts 가 rates 와 대조한다.
const title = "지방소득세 — 소득세와 같은 과세표준에 0.6~4.5%, 5월엔 따로 신고하고 직장인은 소득세의 10%가 함께 떼입니다";
const description =
  "지방소득세는 소득세와 같은 과세표준에 기본세율의 10분의 1인 0.6~4.5%를 곱하는 지방세입니다. 종합소득세를 신고하면 같은 기한까지 지자체에 따로 신고·납부하고, 직장인과 프리랜서는 소득세를 뗄 때 그 10%가 함께 특별징수됩니다. 100만원을 넘으면 나눠 낼 수 있습니다.";

const ANSWER = `지방소득세는 소득세와 같은 과세표준에 0.6~4.5%(소득세 기본세율의 10분의 1)를 곱하는 지방세입니다(지방세법 제92조). 종합소득세를 신고하면 같은 기한까지 지자체에 따로 신고·납부하고(제95조), 월급·3.3% 소득은 소득세를 뗄 때 그 10%가 함께 특별징수됩니다(제103조의13).`;

const QA = [
  { q: "지방소득세는 언제 어디에 내나요?", a: `종합소득세 확정신고를 하는 사람은 그 신고기한까지 납세지 관할 지방자치단체에 개인지방소득세를 따로 확정신고·납부합니다(제95조 제1항). 그래서 보통 5월 31일이 기한이고 내는 곳이 세무서가 아니라 지자체입니다. 관할이 아닌 지자체에 신고해도 신고의 효력에는 영향이 없습니다.` },
  { q: "지방소득세 세율은 얼마인가요?", a: `과세표준 1,400만원 이하 0.6%부터 10억원 초과 4.5%까지, 소득세 기본세율과 구간이 같고 세율만 10분의 1입니다(제92조 제1항). 지자체는 조례로 표준세율의 ${pct(ORDINANCE.rate)} 범위에서 가감할 수 있습니다(제2항). 공제·감면이 없으면 소득세 산출세액의 10분의 1과 같습니다.` },
  { q: "직장인·프리랜서는 지방소득세를 어떻게 내나요?", a: `원천징수의무자가 소득세를 원천징수할 때 그 소득세의 ${pct(x.localIncome.specialRatio)}를 개인지방소득세로 함께 특별징수하고 다음 달 10일까지 지자체에 냅니다(제103조의13). 월급 명세서의 지방소득세 줄, 3.3% 중 0.3%가 이것입니다.` },
  { q: "지방소득세도 나눠 낼 수 있나요?", a: `납부할 세액이 ${eokwon(INSTALLMENT.over)}을 넘으면 일부를 납부기한이 지난 뒤 ${INSTALLMENT.months}개월 안에 나눠 낼 수 있습니다(제95조 제4항, 2023년 신설). 퇴직소득분은 과세표준에 같은 1/10 세율을 적용해 12로 나누고 근속연수를 곱합니다(제92조 제4항).` },
];
---

<GuideLayout title={title} description={description} updated={x.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>{FILING.note}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>과세표준</th><th>지방소득세율</th><th>구간 시작 세액</th></tr></thead>
    <tbody>{BRACKETS.map((b, i) => <tr><th scope="row">{label(i)}</th><td>{pct(b.rate)}</td><td>{b.base ? won(b.base) : "—"}</td></tr>)}</tbody>
  </table>
  <table>
    <thead><tr><th>과세표준</th><th>지방소득세</th></tr></thead>
    <tbody>{examples.map((b) => <tr><th scope="row">{eokwon(b)}</th><td>{won(taxOn(b))}</td></tr>)}</tbody>
  </table>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    근로소득만 있으면 연말정산으로 지방소득세도 정산됩니다. 다른 소득이 있어 5월에 종합소득세를 신고하면 지방소득세도 함께 정산합니다 —{" "}
    <a href="/guide/withholding-tax/">원천세</a>, <a href="/guide/business-income-tax/">사업소득세</a>.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    퇴직금의 지방소득세는 <a href="/guide/severance-tax-calculator/">퇴직금 세금 계산기</a>, 양도소득분은{" "}
    <a href="/guide/capital-gains-tax/">양도소득세</a>에 있습니다. 법인지방소득세는 다루지 않았습니다. 한 해 일정은{" "}
    <a href="/guide/tax-year/">한 해 동안 내는 세금</a>에 있습니다.
  </p>
</GuideLayout>
