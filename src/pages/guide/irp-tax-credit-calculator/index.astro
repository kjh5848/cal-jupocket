---
/**
 * "irp 세액공제 계산" — IRP 세액공제 시리즈의 계산기.
 * 연금저축·IRP 납입액, 소득 구간, ISA 전환금액, 산출세액을 넣으면 공제액을 낸다.
 * 산출세액을 넣으면 제61조(공제는 세금을 넘지 못한다)까지 반영한다.
 * 계산은 src/lib/pension-credit.ts, 화면은 src/scripts/irp-credit.ts.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import pa from "../../../rates/pension-account-2026.json";
import { won, manwon } from "../../../lib/won";
import { pensionCredit, eligibleAmount, roomToCap } from "../../../lib/pension-credit";
import { calcPresets } from "../../../data/calc-presets";

const ex = pensionCredit({ savings: 6_000_000, irp: 3_000_000 }, true);
const over = eligibleAmount({ savings: 8_000_000, irp: 1_000_000 });
const exRoom = roomToCap({ savings: 6_000_000, irp: 3_000_000 }, true);
const P = calcPresets["/guide/irp-tax-credit-calculator/"];
const PRESETS_SAVINGS = JSON.stringify({ default: P.savings.amounts });
const PRESETS_IRP = JSON.stringify({ default: P.irp.amounts });

const title = "IRP 세액공제 계산 — 넣은 돈 × 12% 또는 15%, 지방소득세까지 계산기";
const description =
  "IRP 세액공제는 공제 대상 금액에 12% 또는 15%를 곱하고 지방소득세 10%를 더해 계산합니다. 연금저축·IRP 납입액과 소득 구간을 넣으면 바로 계산되는 계산기입니다.";

const ANSWER = `IRP 세액공제 = 공제 대상 금액 × 공제율(${pa.creditRatePercentAboveThreshold}% 또는 ${pa.creditRatePercentBelowThreshold}%)이고, 지방소득세 10%가 같이 줄어듭니다. 연금저축 600만원과 IRP 300만원이면 15% 구간에서 ${manwon(ex.withLocal)}입니다.`;

const QA = [
  { q: "IRP 세액공제는 어떻게 계산하나요?", a: `세 단계입니다. 공제 대상 금액을 정하고(연금저축은 ${manwon(pa.savingsOnlyLimit)}까지, 합쳐서 ${manwon(pa.combinedLimit)}까지), 공제율을 곱하고, 그 금액의 10%인 지방소득세를 더합니다.` },
  { q: "IRP 세액공제 계산에서 빠뜨리기 쉬운 것은 무엇인가요?", a: "그해 산출세액입니다. 공제액이 산출세액보다 크면 넘는 금액은 없는 것으로 봅니다(소득세법 제61조). 계산기에 산출세액을 넣으면 이 한도까지 반영됩니다." },
  { q: "연금저축과 IRP를 같이 넣으면 계산이 달라지나요?", a: `연금저축은 ${manwon(pa.savingsOnlyLimit)}까지만 공제 대상에 들어갑니다. 연금저축에 ${manwon(8_000_000)}, IRP에 ${manwon(1_000_000)}을 넣으면 공제 대상은 ${manwon(over)}입니다. 넘긴 몫을 IRP로 돌렸다면 ${manwon(pa.combinedLimit)}이 됐습니다.` },
];
---

<GuideLayout title={title} description={description} updated={pa.taxCreditVerifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">아래 값은 예시입니다. 내 납입액으로 바꾸세요. 산출세액을 모르면 비워 두면 한도 전 금액입니다.</p>
    <div class="calc-input-wrap">
      <label for="irp-savings">연금저축 납입액(올해)</label>
      <input type="text" inputmode="numeric" id="irp-savings" value="6,000,000" data-won data-presets={PRESETS_SAVINGS} />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="irp-irp">IRP·DC 본인 납입액(올해)</label>
      <input type="text" inputmode="numeric" id="irp-irp" value="3,000,000" data-won data-presets={PRESETS_IRP} />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="irp-rate">종합소득금액 {won(pa.incomeThreshold)} 이하(근로소득만 있으면 총급여 5,500만원 이하)인가요?</label>
      <select id="irp-rate" data-seg>
        <option value="low" selected>이하 — {pa.creditRatePercentBelowThreshold}%</option>
        <option value="high">초과 — {pa.creditRatePercentAboveThreshold}%</option>
      </select>
    </div>
    <details>
      <summary>더 정확하게 — ISA 전환금액, 산출세액</summary>
      <div class="calc-input-wrap">
        <label for="irp-isa">ISA 만기 전환금액(만기 {pa.isaTransfer.window.days}일 안)</label>
        <input type="text" inputmode="numeric" id="irp-isa" value="" placeholder="0" data-won />
        <span class="unit">원</span>
      </div>
      <div class="calc-input-wrap">
        <label for="irp-tax">올해 산출세액(아는 경우)</label>
        <input type="text" inputmode="numeric" id="irp-tax" value="" placeholder="0" data-won />
        <span class="unit">원</span>
      </div>
    </details>

    <div
      class="result-hero"
      aria-live="polite"
      aria-atomic="true"
      data-bar="irp-hero|irp-extra"
      data-bar-labels="지금 줄어드는 세금|한도까지 더 줄일 수 있는 세금"
      data-dock="irp-hero"
    >
      <p class="label">줄어드는 세금(지방소득세 포함)</p>
      <p class="big" id="irp-hero">{won(ex.withLocal)}</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">공제 대상 금액</span><span class="value" id="irp-eligible">{won(ex.eligible)}</span></div>
      <div class="stat-chip"><span class="label">한도를 넘겨 빠진 돈</span><span class="value" id="irp-over">{won(exRoom.over)}</span></div>
      <div class="stat-chip"><span class="label">900만원까지 남은 금액</span><span class="value" id="irp-room">{won(exRoom.room)}</span></div>
      <div class="stat-chip"><span class="label">채우면 더 줄어드는 세금</span><span class="value" id="irp-extra">{won(exRoom.extraWithLocal)}</span></div>
      <div class="stat-chip" data-group="줄어드는 세금"><span class="label">소득세에서</span><span class="value" id="irp-income-tax">{won(ex.incomeTax)}</span></div>
      <div class="stat-chip"><span class="label">지방소득세에서</span><span class="value" id="irp-local">{won(ex.withLocal - ex.incomeTax)}</span></div>
    </div>
    <p class="meta" id="irp-cap-note" hidden></p>
    <p class="meta">공제 대상 금액 × 공제율 = 소득세에서 줄어드는 금액, 그 10%가 지방소득세에서 함께 줄어듭니다. 남은 금액은 IRP·DC 에 넣어야 공제 대상이 됩니다(연금저축은 600만원까지, 소득세법 제59조의3).</p>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ol>
    <li><strong>공제 대상 금액</strong> = min(연금저축, {won(pa.savingsOnlyLimit)}) + IRP, 최대 {won(pa.combinedLimit)}. ISA 전환금액이 있으면 그 10%(최대 300만원)를 더합니다.</li>
    <li><strong>소득세 공제</strong> = 공제 대상 금액 × {pa.creditRatePercentBelowThreshold}% 또는 {pa.creditRatePercentAboveThreshold}%</li>
    <li><strong>지방소득세</strong> = 소득세 공제 × 10%가 같이 줄어듭니다</li>
  </ol>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>
    못 쓴 공제는 "공제받지 않은 납입액"이 되어 다음 해로 돌릴 수 있습니다 —
    <a href="/guide/irp-tax-credit-carryover/">IRP 세액공제 이월</a>.
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    공제율 기준은 <a href="/guide/irp-tax-credit-rate/">IRP 세액공제율</a>,
    전체 흐름은 <a href="/guide/irp-tax-credit/">IRP 세액공제</a>에 있습니다.
  </p>

  <script src="../../../scripts/irp-credit.ts"></script>
</GuideLayout>
