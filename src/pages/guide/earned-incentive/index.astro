---
/**
 * "근로장려금" — 근로장려금 시리즈 허브(src/data/series/earned-incentive.ts). 2026도 이 글.
 * 근거: 조세특례제한법 제100조의2(목적), 제100조의3(신청자격·가구), 제100조의5(산정), 제100조의6(신청),
 * 제100조의30 제2항(자녀장려금이 중복을 막는 것은 자녀세액공제뿐).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/earned-incentive-2026.json";
import ci from "../../../rates/child-incentive-2026.json";
import { earnedIncentiveSeries } from "../../../data/series/earned-incentive";
import { seriesHref } from "../../../data/series/types";
import { schedule } from "../../../lib/child-incentive";
import { halfYearSchedule } from "../../../lib/earned-incentive";
import { eokwon } from "../../../lib/won";
import { koDate } from "../../../lib/tax-deadline";

const E = r.eligibility;
const F = r.formula;
const s = schedule(r.year);
const h = halfYearSchedule(r.year);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 earned-incentive.test.ts 가 rates 와 대조한다.
const title = "근로장려금 — 단독 165만원, 홑벌이 285만원, 맞벌이 330만원까지 받습니다";
const description =
  "근로장려금은 일하는 저소득 가구에 주는 환급금입니다. 가구 총소득이 단독 2,200만원, 홑벌이 3,200만원, 맞벌이 4,400만원 미만이고 재산이 2억4천만원 미만이면 최대 165만원, 285만원, 330만원을 받습니다. 5월에 신청하고, 근로소득만 있으면 반기 신청도 됩니다.";

const ANSWER = `근로장려금은 일하는 저소득 가구에 주는 환급금입니다. 가구 총소득이 단독 ${eokwon(E.totalIncomeUnder.single)}, 홑벌이 ${eokwon(E.totalIncomeUnder.oneEarner)}, 맞벌이 ${eokwon(E.totalIncomeUnder.dual)} 미만이고 재산이 ${eokwon(E.assetsUnder)} 미만이면 최대 ${eokwon(F.single.max)}, ${eokwon(F.oneEarner.max)}, ${eokwon(F.dual.max)}을 받습니다.`;

const QA = [
  { q: "근로장려금이란 무엇인가요?", a: `저소득자의 근로를 장려하고 소득을 지원하려고 세무서가 결정해 환급하는 돈입니다(조세특례제한법 제100조의2). 근로·사업·종교인소득이 있어야 신청할 수 있고, 소득이 너무 적거나 많으면 금액이 줄어드는 사다리꼴 구조입니다.` },
  { q: "2026 근로장려금은 누가 받나요?", a: `${r.year}년에 근로·사업·종교인소득이 있고, 부부 합산 총소득이 가구 구성별 기준(단독 ${eokwon(E.totalIncomeUnder.single)}·홑벌이 ${eokwon(E.totalIncomeUnder.oneEarner)}·맞벌이 ${eokwon(E.totalIncomeUnder.dual)}) 미만, 가구원 재산이 ${eokwon(E.assetsUnder)} 미만인 가구입니다(제100조의3 제1항).` },
  { q: "근로장려금은 언제 신청하나요?", a: `${r.year}년 소득분은 ${koDate(s.from)}부터 ${koDate(s.deadline)}까지 신청합니다(제100조의6 제1항). 그해 근로소득만 있었다면 반기 신청도 되는데, 하반기분은 ${koDate(h.second.from)}부터 ${koDate(h.second.deadline)}까지입니다(같은 조 제7항).` },
  { q: "근로장려금과 자녀장려금은 같이 받을 수 있나요?", a: `자녀장려금 조문(제100조의28~제100조의31)이 함께 받지 못하게 정한 것은 자녀세액공제뿐입니다(제100조의30 제2항). 근로장려금과 자녀장려금은 신청 자격과 금액을 따로 정합니다. 자녀장려금은 부양자녀가 있고 총소득 ${eokwon(ci.eligibility.totalIncomeUnder)} 미만이어야 합니다.` },
];
const more: Record<number, string> = { 1: "earned-incentive-eligibility", 2: "earned-incentive-apply" };
const labelOf = (slug: string) => earnedIncentiveSeries.items.find((x) => x.slug === slug)?.label ?? slug;
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>가구</th><th>총소득 기준(미만)</th><th>최대 금액</th><th>최대가 되는 총급여액 등</th></tr></thead>
    <tbody>
      <tr><th scope="row">단독</th><td>{eokwon(E.totalIncomeUnder.single)}</td><td>{eokwon(F.single.max)}</td><td>{eokwon(F.single.riseUnder)} 이상 {eokwon(F.single.flatUnder)} 미만</td></tr>
      <tr><th scope="row">홑벌이</th><td>{eokwon(E.totalIncomeUnder.oneEarner)}</td><td>{eokwon(F.oneEarner.max)}</td><td>{eokwon(F.oneEarner.riseUnder)} 이상 {eokwon(F.oneEarner.flatUnder)} 미만</td></tr>
      <tr><th scope="row">맞벌이</th><td>{eokwon(E.totalIncomeUnder.dual)}</td><td>{eokwon(F.dual.max)}</td><td>{eokwon(F.dual.riseUnder)} 이상 {eokwon(F.dual.flatUnder)} 미만</td></tr>
    </tbody>
  </table>
  <p>
    소득이 적은 구간에서는 벌수록 늘고, 가운데 구간에서는 최대 금액으로 평평하고, 그 위로는
    벌수록 줄어듭니다({F.article}). 내 금액은{" "}
    <a href="/guide/earned-incentive-amount/">근로장려금 금액</a>에서 계산해 보세요.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>자세히 — <a href={seriesHref(more[1])}>{labelOf(more[1])}</a></p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>자세히 — <a href={seriesHref(more[2])}>{labelOf(more[2])}</a></p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    자녀장려금은 <a href="/guide/child-incentive/">자녀장려금</a>에 따로 정리했습니다.
  </p>

  <h2>근로장려금, 질문별로 정리했습니다</h2>
  <ul>
    {earnedIncentiveSeries.items.map((x) => (
      <li><a href={seriesHref(x.slug)}>{x.label}</a></li>
    ))}
  </ul>

  <h2>이 글에 없는 것</h2>
  <ul>
    <li><strong>시행령 별표 11 근로장려금산정표</strong> — 실제 금액은 총급여액 구간별 이 표로 정합니다. 읽지 않아, 이 시리즈의 금액은 법 조문 식으로 한 어림입니다.</li>
  </ul>
</GuideLayout>
