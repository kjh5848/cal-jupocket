---
/**
 * "중도상환수수료 3년" — 중도상환수수료 시리즈. (중도상환수수료 3년 이후·면제 기간·면제시점 도래·주담대 중도상환수수료 3년도 이 글)
 * 근거: 금융소비자보호법 제20조 ① 4호 나목 1)~3), 민법 제160조 ③(그 달에 같은 날이 없으면 말일) — rates: prepayment-fee-2026.json
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/prepayment-fee-2026.json";
import { prepaymentFee, LEGAL_YEARS } from "../../../lib/prepayment-fee";
import { toDay, fromDay } from "../../../lib/date-calc";
import { won } from "../../../lib/won";

const d = (s: string) => toDay(s)!;
const leap = prepaymentFee({ amount: 100_000_000, ratePct: 1, start: d("2028-02-29"), maturity: null, payDate: d("2028-02-29") });
const near = prepaymentFee({ amount: 100_000_000, ratePct: 1, start: d("2025-06-02"), maturity: null, payDate: d("2028-05-02") });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 prepayment-fee-series.test.ts 가 rates 와 대조한다.
const title = "중도상환수수료 3년 — 대출계약이 성립한 날부터 3년이 지나면 법으로 받을 수 없습니다";
const description =
  "금융소비자보호법은 대출 중도상환수수료를 원칙적으로 금지하고, 계약이 성립한 날부터 3년 안에 갚는 경우 등에만 예외로 받게 합니다. 3년을 어디서부터 세는지, 끝날이 언제인지, 3년 이후와 만기가 짧은 대출은 어떻게 되는지 정리했습니다.";

const ANSWER = `중도상환수수료는 금융소비자보호법 제20조가 금지하는 불공정영업행위이고, 대출계약이 성립한 날부터 ${LEGAL_YEARS}년 안에 갚는 경우 등만 예외입니다. 그래서 실행일부터 ${LEGAL_YEARS}년이 되는 날부터는 남은 원금이 얼마든 수수료가 0원입니다.`;

const QA = [
  { q: "중도상환수수료 3년은 법 어디에 있나요?", a: `금융소비자보호법 제20조 제1항 제4호 나목입니다. 대출성 상품에서 '수수료, 위약금 또는 그 밖에 어떤 명목이든' 중도상환수수료를 부과하는 행위를 금지하고, 예외를 세 가지 둡니다 — 1) 계약이 성립한 날부터 ${LEGAL_YEARS}년 이내 상환 2) 다른 법령이 허용하는 경우 3) 시행령이 정하는 경우.` },
  { q: "3년은 언제부터 세고, 끝날은 언제인가요?", a: `조문은 '대출계약이 성립한 날부터'라고 적습니다. 만기나 금리 변경일에서 세지 않습니다. 실행일이 2월 29일이면 ${LEGAL_YEARS}년 뒤 같은 날이 없어 2월 28일이 끝날입니다(민법 제160조 ③) — 2028-02-29 실행이면 ${fromDay(leap.legalEnd)}, 부과기간 ${leap.windowDays.toLocaleString()}일입니다.` },
  { q: "3년이 거의 다 됐으면 수수료가 얼마 안 남나요?", a: `은행 대부분이 남은 날에 비례해 줄이는 방식이라 끝날이 가까울수록 0에 가까워집니다. 1억원 요율 1% 대출을 끝날 한 달 전에 갚으면 ${near.daysLeft}일치만 남아 ${won(near.fee)}입니다. 급하지 않다면 끝날 뒤로 미루는 것도 방법입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>즉 '받는 게 원칙이고 3년이면 면제'가 아니라 '받지 못하는 게 원칙이고 3년 안이면 예외'입니다. 일반 은행·저축은행 대출에서 실제로 쓰이는 것은 1)이고, 2)·3)은 다른 법령이나 시행령이 정한 특정 계약에만 해당합니다. 이 계산기와 글은 1)만 다룹니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>만기가 {LEGAL_YEARS}년보다 짧은 대출(1년짜리 신용대출 등)은 만기에 대출이 끝나므로 만기까지가 수수료가 붙을 수 있는 기간입니다. 은행 상품 안내가 '대출기간(최장 {LEGAL_YEARS}년)'이라고 적는 것이 이 뜻입니다. 기한을 연장했을 때 처음 실행일부터 세는지는 약정서의 문구를 확인하세요 — 처음 대출일부터 {LEGAL_YEARS}년(기한연장 포함)이라고 적은 은행 안내가 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>내 대출의 끝날과 지금 갚을 때 금액은 <a href="/guide/prepayment-fee-calculator/">중도상환수수료 계산기</a>에 실행일·만기일·갚는 날을 넣으면 나옵니다. 계산 순서와 시점별 예시표는 <a href="/guide/prepayment-fee/">중도상환수수료 계산</a>에 있습니다.</p>
</GuideLayout>
