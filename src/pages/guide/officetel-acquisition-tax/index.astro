---
/**
 * "오피스텔 취득세" — 취득세 시리즈. (오피스텔 취득세율 4.6%·주거용·주택 수·생애최초·분양도 이 글)
 * 근거: 지방세법 제11조 제1항 제7호 나목·제8호(주택 1~3%는 건축물대장 등에 주택으로 기재된 주거용 건축물), 제13조의3 제4호(주택 수),
 * 제151조(지방교육세), 농어촌특별세법 제5조(0.2%), 지방세특례제한법 제36조의3(생애최초 — 지방세법 제11조 제1항 제8호 주택).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import x from "../../../rates/acquisition-extra-2026.json";
import { acquisitionTotal } from "../../../lib/acquisition-total";
import { won, eokwon } from "../../../lib/won";

const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const prices = [150_000_000, 200_000_000, 300_000_000, 500_000_000];
const rows = prices.map((p) => ({ p, o: acquisitionTotal(p, "officetel"), h: acquisitionTotal(p, "house", { smallArea: true }) }));
const ex = acquisitionTotal(200_000_000, "officetel");

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 acquisition-series.test.ts 가 rates 와 대조한다.
const title = "오피스텔 취득세 — 주거용으로 써도 4%에 교육세·농특세를 더해 4.6%입니다";
const description =
  "오피스텔 취득세는 주거용으로 쓰더라도 4%이고 지방교육세 0.4%와 농어촌특별세 0.2%를 더해 4.6%입니다. 1~3% 주택 세율은 건축물대장 등에 주택으로 기재된 건물에만 적용되기 때문입니다. 다만 재산세를 주택으로 내는 오피스텔은 이후 주택 취득 때 주택 수에 들어갑니다.";

const ANSWER = `오피스텔 취득세는 주거용으로 쓰더라도 ${pct(x.baseRate)}이고 지방교육세 0.4%와 농어촌특별세 0.2%를 더해 4.6%입니다. 1~3% 주택 세율은 건축물대장·등기부 등에 주택으로 기재된 주거용 건축물에만 적용되기 때문입니다(지방세법 제11조 제1항 제8호). ${eokwon(200_000_000)}이면 ${won(ex.total)}입니다.`;

const QA = [
  { q: "오피스텔 취득세율은 몇 퍼센트인가요?", a: `주택 세율(1~3%)은 건축물대장·사용승인서·등기부에 주택으로 기재된 주거용 건축물에 적용됩니다(제11조 제1항 제8호). 그렇지 않은 오피스텔은 그 밖의 유상취득(농지 외) ${pct(x.baseRate)}이고, 지방교육세 0.4%·농특세 0.2%를 더해 실제 부담은 4.6%입니다.` },
  { q: "주거용 오피스텔도 4%인가요?", a: `취득세율은 실제 사용이 아니라 공부상 주택으로 기재되었는지로 정해지므로, 주거용으로 쓰더라도 주택으로 기재되지 않았다면 4%입니다. 같은 가격의 85㎡ 이하 아파트와 비교하면 ${eokwon(200_000_000)}에서 ${won(ex.total)} 대 ${won(acquisitionTotal(200_000_000, "house", { smallArea: true }).total)}입니다.` },
  { q: "오피스텔도 주택 수에 들어가나요?", a: `취득세 중과를 판단할 때 재산세를 주택으로 내는 오피스텔은 그 소유자의 주택 수에 넣습니다(제13조의3 제4호). 그래서 오피스텔을 산 뒤 아파트를 사면 2주택 취득이 되어 조정대상지역이면 8% 중과가 될 수 있습니다. 오피스텔 자체를 살 때는 4%입니다.` },
];
---

<GuideLayout title={title} description={description} updated={x.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>매매가</th><th>오피스텔(4.6%)</th><th>85㎡ 이하 아파트였다면</th></tr></thead>
    <tbody>{rows.map(({ p, o, h }) => <tr><th scope="row">{eokwon(p)}</th><td>{won(o.total)}</td><td>{won(h.total)}</td></tr>)}</tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>
    생애최초 감면도 '지방세법 제11조 제1항 제8호의 주택'을 대상으로 하므로(지방세특례제한법 제36조의3) 주택으로 기재되지 않은 오피스텔은
    그 정의에 들지 않습니다. 오피스텔 분양권의 취득세는 이 글에서 다루지 않았습니다.
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>중과 세율은 <a href="/guide/apartment-acquisition-tax/">아파트 취득세</a>, 상가·토지는 <a href="/guide/real-estate-acquisition-tax/">부동산 취득세</a>에 있습니다.</p>
</GuideLayout>
