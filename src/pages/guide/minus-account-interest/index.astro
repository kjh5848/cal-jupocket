---
/**
 * "마이너스통장 이자 계산" — 마이너스통장 이자 시리즈 허브. (계산 방식·계산 기준·이자 기준·이자 발생도 이 글)
 * 법령 숫자 없음 — 하루 이자 = 사용 금액 × 연 이자율 ÷ 그해 날수. 금액은 overdraftInterest() 가 낸다(rates: overdraft-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/overdraft-2026.json";
import { overdraftInterest } from "../../../lib/overdraft";
import { won } from "../../../lib/won";
import { minusAccountSeries as S } from "../../../data/series/minus-account";

const m30 = overdraftInterest({ amount: 10_000_000, ratePct: 6, days: 30, start: "2026-11-01", payDay: "last" });
const y27 = overdraftInterest({ amount: 10_000_000, ratePct: 6, days: 365, start: "2027-01-01", payDay: "last" });
const y28 = overdraftInterest({ amount: 10_000_000, ratePct: 6, days: 366, start: "2028-01-01", payDay: "last" });
const d28 = overdraftInterest({ amount: 10_000_000, ratePct: 6, days: 1, start: "2028-03-01", payDay: "last" });
const half = overdraftInterest({ amount: 5_000_000, ratePct: 6, days: 30, start: "2026-11-01", payDay: "last" });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 minus-account-series.test.ts 가 대조한다.
const title = "마이너스통장 이자 계산 — 쓴 금액에만, 하루 단위로 붙고 결제일에 모아서 나갑니다";
const description =
  "마이너스통장 이자는 한도가 아니라 실제로 쓴 금액에 연 이자율을 곱하고 한 해의 날수로 나눠 하루치씩 계산합니다. 쓴 날만큼 쌓인 이자가 매달 정한 결제일에 한 번에 청구되고, 윤년에는 한 해를 하루 더 길게 봅니다.";

const ANSWER = `마이너스통장 이자는 쓴 금액 × 연 이자율 ÷ 365(윤년 366)를 하루 이자로 보고 쓴 날수만큼 더합니다. 1,000만원을 연 6%로 30일 쓰면 하루 약 ${won(m30.dailyInterest)}, 30일 이자는 ${won(m30.totalInterest)}입니다.`;

const QA = [
  { q: "마이너스통장 이자 계산 방식을 순서대로 알려 주세요.", a: `① 연 이자율을 365로 나눠 하루 이율을 구하고(윤년이면 366) ② 그날 쓰고 있던 금액에 곱해 하루 이자를 냅니다 ③ 결제일 전날까지 하루 이자를 더한 금액이 결제일에 청구됩니다. 1,000만원 연 6%면 하루 약 ${won(m30.dailyInterest)}입니다.` },
  { q: "한도 전체에 이자가 붙나요?", a: `아닙니다. 이자는 실제로 꺼내 쓴 금액에만 붙습니다. 같은 6%여도 500만원을 30일 쓰면 ${won(half.totalInterest)}, 1,000만원이면 ${won(m30.totalInterest)}입니다. 다만 약정서에 '약정한도 미사용수수료'를 받기로 돼 있으면 쓰지 않은 한도에 이자 대신 수수료가 따로 붙을 수 있습니다.` },
  { q: "윤년에는 마이너스통장 이자가 더 나오나요?", a: `하루 이자는 오히려 조금 적습니다. 윤년에는 한 해를 366일로 나누기 때문입니다. 1,000만원 연 6%로 2027년 365일을 다 쓰면 ${won(y27.totalInterest)}, 2028년 366일이면 ${won(y28.totalInterest)}으로 1년 이자는 거의 같고, 2028년 하루 이자는 ${won(d28.totalInterest)}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>은행 여신거래약정서의 이자 계산 방법은 대개 "1년을 365일(윤년은 366일)로 보고 1일 단위로 계산"으로 적혀 있습니다. 쓰는 금액이 날마다 바뀌면 그날그날 잔액으로 계산하므로, 실제 청구액은 본인 통장의 일별 잔액과 약정서가 기준입니다. 금액·날수를 넣어 바로 보려면 <a href="/guide/minus-account-calculator/">마이너스통장 이자 계산기</a>를 쓰세요.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>여기 금액은 결제일(말일)마다 그 회차 이자의 원 미만을 버리고 더한 값입니다. 결제일이 언제냐에 따라 회차가 어떻게 나뉘는지는 <a href="/guide/minus-account-interest-payment/">마이너스통장 이자 납부일</a>에 있습니다. 기간을 정해 원금을 나눠 갚는 대출이라면 <a href="/guide/loan-interest/">대출이자 계산</a>이 맞습니다.</p>

  <h2>마이너스통장 이자 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
