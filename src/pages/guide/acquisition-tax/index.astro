---
/**
 * "취득세" — 취득세 시리즈 허브(39번 글, 같은 주소를 시리즈 구조로 고쳐 썼다). (취득세 세율표·신고기한·계산·지방교육세·농특세도 이 글)
 * 근거: 지방세법 제11조 제1항(원인별 세율·주택 1~3%·6억~9억 계산식), 제20조 제1항(60일·3개월·6개월), 제151조(지방교육세),
 * 농어촌특별세법 제5조(0.2%)·제4조 제11호(국민주택 규모 이하 주택 비과세), 제13조의2(중과).
 * 금액은 손으로 적지 않는다 — bill()·housePaidRate()·acquisitionTotal() 이 낸다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/local-tax-2026.json";
import x from "../../../rates/acquisition-extra-2026.json";
import { housePaidRate, rateFor, bill, DEADLINE } from "../../../lib/acquisition-tax";
import { acquisitionTotal } from "../../../lib/acquisition-total";
import { won, eokwon } from "../../../lib/won";
import { acquisitionSeries as S } from "../../../data/series/acquisition";

const A = r.acquisitionTax;
const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const prices = [300_000_000, 600_000_000, 700_000_000, 750_000_000, 900_000_000, 1_200_000_000];
const causes = [
  { cause: "housePaid" as const, label: "주택을 샀다(유상거래)" },
  { cause: "paidOther" as const, label: "상가·토지·오피스텔을 샀다" },
  { cause: "original" as const, label: "새로 지었다(원시취득)" },
  { cause: "inheritanceOther" as const, label: "상속받았다(농지 외)" },
  { cause: "gift" as const, label: "증여받았다" },
];
const base = 500_000_000;
const ex = acquisitionTotal(base, "house", { smallArea: true });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 acquisition-series.test.ts 가 rates 와 대조한다.
const title = "취득세 — 주택은 6억원 이하 1%·9억원 초과 3%, 고지서 없이 취득한 날부터 60일 안에 신고";
const description =
  "취득세는 집이나 땅을 얻을 때 한 번 내는 지방세로, 고지서가 오지 않아 취득한 날부터 60일 안에 직접 신고합니다. 주택을 사면 6억원 이하 1%, 9억원 초과 3%이고 그 사이는 계산식입니다. 상가·토지는 4%, 증여는 3.5%, 상속은 2.8%이며 지방교육세와 농특세가 붙습니다.";

const ANSWER = `취득세는 부동산을 얻을 때 한 번 내는 지방세로, 고지서 없이 취득한 날부터 ${DEADLINE.generalDays}일 안에 직접 신고·납부합니다(지방세법 제20조). 주택을 사면 6억원 이하 ${pct(A.housePaid.under.rate)}, 9억원 초과 ${pct(A.housePaid.over.rate)}이고 그 사이는 계산식입니다. 상가·토지는 ${pct(A.standard.paidOther)}, 증여 ${pct(A.standard.gift)}, 상속 ${pct(A.standard.inheritanceOther)}입니다(제11조).`;

const QA = [
  { q: "취득세 신고기한은 언제인가요?", a: `매매 등은 취득한 날부터 ${DEADLINE.generalDays}일, 증여·부담부증여는 ${DEADLINE.giftFrom}부터 ${DEADLINE.giftMonths}개월, 상속은 ${DEADLINE.inheritanceFrom}부터 ${DEADLINE.inheritanceMonths}개월(국외 상속인이 있으면 ${DEADLINE.inheritanceMonthsAbroad}개월)입니다(제20조 제1항). 증여·상속은 그 달의 말일부터 세는 점이 다릅니다.` },
  { q: "취득세 세율표는 어떻게 되나요?", a: `주택 유상거래 6억원 이하 1%, 6억~9억원은 (취득가액 × 2 ÷ 3억원 − 3) ÷ 100, 9억원 초과 3%입니다. 그 밖의 유상취득은 농지 3%·그 밖 4%, 증여 등 무상취득 3.5%, 상속 농지 2.3%·그 밖 2.8%, 원시취득 2.8%입니다(제11조 제1항). 다주택·법인 주택은 8~12% 중과입니다.` },
  { q: "취득세 말고 함께 내는 세금은 무엇인가요?", a: `지방교육세는 표준세율에서 2%를 뺀 세율로 다시 계산한 금액의 20%이고, 주택 유상거래는 세율의 절반 기준이라 1% 주택이면 0.1%입니다(제151조). 농어촌특별세는 표준세율 2%로 계산한 취득세의 10%, 즉 0.2%인데 전용 85㎡ 이하 주택은 비과세입니다.` },
  { q: "5억원 아파트를 사면 취득세가 얼마인가요?", a: `전용 85㎡ 이하 아파트를 ${eokwon(base)}에 사면 취득세 ${won(ex.acq)}(1%), 지방교육세 ${won(ex.edu)}, 농어촌특별세 비과세로 합계 ${won(ex.total)}입니다. 85㎡를 넘으면 농특세 ${won(acquisitionTotal(base, "house").rural ?? 0)}이 더해집니다. 생애최초면 취득세에서 200만원(소형 주택 300만원)까지 뺍니다.` },
];
---

<GuideLayout title={title} description={description} updated={x.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>3월 5일에 증여받았다면 3월 31일부터 3개월이라 6월 30일까지입니다. 취득일에서 3개월을 세면 한 달 가까이 틀립니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>주택 취득가액</th><th>세율</th><th>취득세</th><th>지방교육세</th><th>합계(농특세 제외)</th></tr></thead>
    <tbody>{prices.map((p) => { const b = bill({ price: p, cause: "housePaid" }); return <tr><th scope="row">{eokwon(p)}</th><td>{pct(b.rate)}</td><td>{won(b.acquisitionTax)}</td><td>{won(b.educationTax)}</td><td>{won(b.total)}</td></tr>; })}</tbody>
  </table>
  <p>
    6억~9억원 구간은 계산식이라 계단이 없습니다. 식에 6억원을 넣으면 {pct(housePaidRate(600_000_000))}, 9억원을 넣으면{" "}
    {pct(housePaidRate(900_000_000))}가 나와 위아래와 맞물립니다. 소수점 다섯째자리에서 반올림합니다.
  </p>
  <table>
    <thead><tr><th>{eokwon(base)} 부동산을</th><th>세율</th><th>취득세</th></tr></thead>
    <tbody>{causes.map(({ cause, label }) => <tr><th scope="row">{label}</th><td>{pct(rateFor(cause, base))}</td><td>{won(bill({ price: base, cause }).acquisitionTax)}</td></tr>)}</tbody>
  </table>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    국민주택 규모는 주거전용면적 {x.rural.nationalSize}㎡ 이하(수도권 밖 도시지역이 아닌 읍·면은 {x.rural.nationalSizeRural}㎡ 이하)입니다(주택법 제2조 제6호).
    중과세율이 붙는 주택의 농특세는 이 글에서 계산하지 않았습니다.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    직접 계산은 <a href="/acquisition-tax/">취득세 계산기</a>, 증여·상속과 비교하려면{" "}
    <a href="/guide/gift-tax-guide/">증여세</a>와 <a href="/guide/inheritance-tax-guide/">상속세</a>를 함께 보세요.
    아파트를 산다면 생애최초 감면과 2주택·3주택 중과까지 매매가별로 정리한{" "}
    <a href="/guide/apartment-acquisition-tax/">아파트 취득세</a>가 더 빠릅니다.
    잔금을 치르고 이사까지 남은 일(전입신고 기한 등)은 <a href="/guide/moving-checklist/">이사 체크리스트</a>에 순서대로 있습니다.
  </p>

  <h2>취득세 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
