---
/**
 * "퇴직금 IRP" — 퇴직금·퇴직연금 시리즈. (퇴직금 수령방법·IRP 의무·법바뀜·55세·일시금·IRP 계좌·세금도 이 글)
 * 근거: 근로자퇴직급여 보장법 제9조 제2항·제3항(IRP 이전 지급, 지정 안 하면 본인 명의 IRP), 시행령 제3조의2(예외 5가지),
 * 시행령 제18조 제1항(IRP 연금 55세·5년, 일시금 55세), 소득세법 제146조 제2항(60일 이내 입금 시 원천징수 안 함),
 * 제129조 제1항 제5호의3(연금수령 70%).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/severance-2026.json";
import { severanceTax } from "../../../lib/severance";
import { won } from "../../../lib/won";

const X = r.irpTransfer;
const P = r.pensionReceipt;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const ex = severanceTax(50_000_000, 7);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 severance-series.test.ts 가 rates 와 대조한다.
const title = "퇴직금 IRP — 퇴직금 수령방법은 원칙적으로 IRP 이전, 55세 이후 퇴직 등은 예외";
const description =
  "퇴직금은 근로자가 지정한 IRP 계정으로 옮기는 방법으로 받는 것이 원칙이고, 지정하지 않으면 본인 명의 IRP로 이전됩니다. 55세 이후 퇴직, 고시 금액 이하, 사망, 외국인 출국 등은 예외입니다. IRP에 있는 동안은 퇴직소득세를 떼지 않습니다.";

const ANSWER = `퇴직금은 근로자가 지정한 IRP 계정으로 이전하는 방법으로 지급하고, 지정하지 않으면 근로자 명의 IRP로 이전합니다(근로자퇴직급여 보장법 제9조 제2항·제3항). 55세 이후 퇴직 등은 예외입니다. IRP에 있는 동안은 퇴직소득세를 떼지 않고, 연금으로 받으면 그 ${pct(P.upTo10)}만 냅니다.`;

const QA = [
  { q: "퇴직금은 꼭 IRP로 받아야 하나요?", a: `원칙적으로 그렇습니다. 퇴직금은 근로자가 지정한 개인형퇴직연금(IRP) 계정 등으로 이전하는 방법으로 지급해야 하고, 지정하지 않으면 근로자 명의 IRP 계정으로 이전합니다(제9조 제2항·제3항). 그래서 퇴사하면 대부분 IRP 계좌를 먼저 만들게 됩니다.` },
  { q: "퇴직금을 IRP 말고 일시금으로 받을 수 있는 경우는?", a: `① 55세 이후 퇴직 ② 급여가 고용노동부 고시 금액 이하 ③ 근로자 사망 ④ 취업 체류자격 외국인이 퇴직 후 출국 ⑤ 다른 법령에 따라 급여를 공제하는 경우(남은 돈은 IRP로)입니다(시행령 제3조의2). 고시 금액은 이 글에서 확인하지 않았습니다.` },
  { q: "퇴직금을 IRP에 넣으면 세금은 어떻게 되나요?", a: `퇴직금이 연금계좌로 지급되거나 받은 날부터 60일 안에 연금계좌에 넣으면 연금외수령 전까지 퇴직소득세를 떼지 않습니다(소득세법 제146조 제2항). 나중에 연금으로 받으면 원래 세금의 ${pct(P.upTo10)}(10년차까지)·${pct(P.upTo20)}·${pct(P.over20)}만 내고, 일시에 찾으면 원래 퇴직소득세를 냅니다.` },
  { q: "IRP에 넣은 퇴직금은 언제 찾을 수 있나요?", a: `IRP 급여는 55세 이상이 연금(지급기간 5년 이상)이나 일시금으로 받습니다(시행령 제18조 제1항). 그 전에는 주택구입·전세·요양 등 법정 사유가 있을 때 중도인출하거나 계좌를 해지해야 하고, 해지하면 그때 퇴직소득세를 냅니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>
    이 의무는 2021년 4월 13일 개정으로 들어온 조항입니다(제9조 제2항 신설). 자동완성에 뜨는 '퇴직금 수령방법 법바뀜'이 이 조항입니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <table>
    <thead><tr><th>퇴직금 5천만원, 근속 7년</th><th>세금(지방세 포함)</th></tr></thead>
    <tbody>
      <tr><th scope="row">일시금으로 받거나 IRP를 해지할 때</th><td>{won(ex.total)}</td></tr>
      <tr><th scope="row">IRP에서 연금으로 받을 때(1~10년차)</th><td>{won(Math.floor(ex.total * P.upTo10))}</td></tr>
      <tr><th scope="row">IRP에서 연금으로 받을 때(11~20년차)</th><td>{won(Math.floor(ex.total * P.upTo20))}</td></tr>
    </tbody>
  </table>
  <p>연금수령은 매년 받는 금액에 이 비율을 적용한 원천징수라, 표는 전액을 그 구간에서 받는다고 가정한 어림입니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    받는 방법별 세금은 <a href="/guide/pension-receipt-method/">퇴직연금 수령방법</a>, 해지는{" "}
    <a href="/guide/pension-termination/">퇴직연금 해지</a>에 있습니다.
  </p>
</GuideLayout>
