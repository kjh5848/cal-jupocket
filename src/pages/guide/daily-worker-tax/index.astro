---
/**
 * "일용직 세금" — 원천세·지급명세서 시리즈. (일용직 세금 계산·6%·15만원·2.7%·소액부징수·지방소득세·연말정산 여부도 이 글)
 * 근거: 소득세법 제47조 제2항(1일 15만원), 제129조 제1항 제4호(6%), 제59조 제3항(55% 세액공제), 제134조 제3항, 제86조 제1호(1천원 미만),
 * 제14조 제3항 제2호(종합소득 합산 안 함), 시행령 제20조(일용근로자 범위).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/withholding-tax-2026.json";
import { dailyWorkerTax, dailyWorkerTaxFreeMax } from "../../../lib/withholding-tax";
import { won } from "../../../lib/won";

const D = r.daily;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const free = dailyWorkerTaxFreeMax();
const ex = dailyWorkerTax(200_000);
const rows = [150_000, 180_000, 187_000, 200_000, 250_000, 300_000].map((w) => ({ w, x: dailyWorkerTax(w) }));

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 withholding-tax-series.test.ts 가 rates 와 대조한다.
const title = "일용직 세금 — 일급에서 15만원을 빼고 6%, 다시 55%를 깎아 15만원 초과분의 2.7%";
const description =
  "일용직 세금은 일급에서 15만원을 빼고 6%를 곱한 뒤 55%를 세액공제합니다. 15만원 초과분의 2.7%이고, 하루치를 그날 받을 때 세액이 1천원 미만이면 떼지 않아 일급 18만7천원까지는 소득세가 없습니다. 일용근로소득은 연말정산·종합소득세에 합치지 않습니다.";

const ANSWER = `일용직 세금은 (일급 − 15만원) × ${pct(D.rate)}에서 그 ${pct(D.creditRate)}를 세액공제해 계산합니다(소득세법 제47조 제2항·제129조·제59조 제3항). 15만원을 넘는 부분의 2.7%이고, 하루치를 그날 받을 때 세액이 1천원 미만이면 떼지 않아(제86조) 일급 ${won(free)}까지는 소득세가 없습니다.`;

const QA = [
  { q: "일용직 세금은 어떻게 계산하나요?", a: `① 일급 − 근로소득공제 1일 15만원 ② × 원천징수세율 ${pct(D.rate)} = 산출세액 ③ − 산출세액의 ${pct(D.creditRate)} 근로소득세액공제입니다(제134조 제3항). 일급 20만원이면 (5만원 × 6%) = 3,000원에서 1,650원을 빼 소득세 ${won(ex.tax)}, 지방소득세 ${won(ex.local)}입니다.` },
  { q: "일용직은 얼마부터 세금을 떼나요?", a: `일급 15만원까지는 과세할 금액이 없고, 그 위로는 세액이 1천원 미만이면 소액부징수로 떼지 않습니다(제86조 제1호). 그래서 하루치를 그날 받으면 일급 ${won(free)}까지는 0원입니다. 다만 1천원 기준은 지급할 때 떼는 세액에 적용되므로 여러 날 치를 한꺼번에 받으면 합친 세액이 1천원을 넘어 떼일 수 있습니다.` },
  { q: "일용직도 연말정산이나 종합소득세 신고를 하나요?", a: `일용근로자의 근로소득은 종합소득과세표준에 합산하지 않습니다(제14조 제3항 제2호). 하루하루 원천징수로 세금이 끝나므로 일용근로소득만 있다면 연말정산·종합소득세 계산에 들어가지 않습니다. 같은 곳에서 3개월 이상 일하면 일용근로자가 아닐 수 있습니다(시행령 제20조).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>일급</th><th>산출세액(6%)</th><th>55% 공제 뒤</th><th>실제 떼는 소득세</th><th>지방소득세 포함</th></tr></thead>
    <tbody>{rows.map(({ w, x }) => <tr><th scope="row">{won(w)}</th><td>{won(x.computed)}</td><td>{won(x.raw)}</td><td>{x.raw > 0 && x.tax === 0 ? "0원(1천원 미만)" : won(x.tax)}</td><td>{won(x.total)}</td></tr>)}</tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    일용근로자 범위는 건설공사 종사자(같은 고용주에게 1년 이상 계속 고용 등 제외), 하역작업 종사자, 그 밖의 업무는 같은 고용주에게
    3개월 이상 계속 고용되지 않은 사람입니다. 4대보험은 <a href="/guide/daily-worker-insurance/">일용직 4대보험</a>, 신고는{" "}
    <a href="/guide/daily-worker-income-report/">일용직 소득신고</a>에 있습니다.
  </p>
</GuideLayout>
