---
/**
 * "이혼 재산분할 세금" — 이혼 재산분할 세금 시리즈 허브. (이혼 재산분할 양도세·증여세·협의이혼·이혼소송 재산분할 세금·사실혼도 이 글)
 * 근거: 지방세법 제15조 제1항 제6호, 시행령 제28조의6 제2항 / 판례 — 대법원 2012두10901(양도 아님), 2001두4573(위자료는 양도),
 * 2016두58901(과대 분할 초과분 증여세), 2016두36864(사실혼도 특례세율), 헌재 96헌바14. rates: divorce-2026.json
 * 소득세법·상증법에 이혼 재산분할을 정한 조문이 없어 판례 원문으로 썼다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/divorce-2026.json";
import { divisionAcqTax } from "../../../lib/divorce-tax";
import { won, manwon, eokwon } from "../../../lib/won";
import { divorceSeries as S } from "../../../data/series/divorce";

const A = r.acquisition;
const pct = (v: number) => `${Number((v * 100).toFixed(1))}%`;
const eduPct = pct((A.baseRate - A.heavyRate) * A.eduRate);
const B = 500_000_000;
const ex = divisionAcqTax(B);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 divorce-series.test.ts 가 rates·계산 함수와 대조한다.
const title = "이혼 재산분할 세금 — 양도세·증여세는 원칙적으로 없고 취득세는 1.5%, 위자료로 넘기면 양도세 대상입니다";
const description =
  "이혼 재산분할로 부동산을 넘기면 판례상 양도소득세·증여세 대상이 아니고, 받는 사람의 부동산 취득세는 1.5%입니다. 다만 위자료·양육비로 넘긴 부분은 양도세 대상이고, 과대하고 조세 회피 수단인 분할은 상당한 부분을 넘는 몫에 증여세가 붙을 수 있습니다.";

const ANSWER = `이혼 재산분할은 공동재산의 청산이라 넘기는 사람의 양도소득세(대법원 2012두10901)와 받는 사람의 증여세(헌재 96헌바14)가 원칙적으로 없고, 부동산 취득세는 ${pct(A.rate)}입니다(지방세법 제15조 제1항 제6호). 위자료·양육비로 넘긴 부분은 양도세 대상입니다(대법원 2001두4573).`;

const QA = [
  { q: "이혼 재산분할을 하면 양도소득세를 내나요?", a: `원칙적으로 내지 않습니다. 대법원은 재산분할이 실질적으로 공유물분할이라 양도소득세 과세대상인 유상양도가 아니라고 봅니다(2012두10901). 다만 같은 이혼이라도 위자료나 자녀양육비 명목으로 부동산을 넘긴 부분은 유상양도라 양도세 대상입니다(2001두4573). 어느 쪽인지는 문구만이 아니라 실질로 판단합니다.` },
  { q: "재산분할로 받으면 증여세를 내나요?", a: `원칙적으로 내지 않습니다. 헌법재판소는 재산분할에 증여세를 매기던 옛 상속세법 조항을 위헌으로 결정했고(96헌바14), 대법원도 가장이혼으로 무효가 아닌 이상 재산분할은 증여세 대상이 아니라고 봅니다(2016두58901). 다만 상당하다고 할 수 없을 만큼 과대하고 조세 회피 수단에 불과하면 상당한 부분을 넘는 몫만 증여세 대상이 될 수 있습니다.` },
  { q: "재산분할 취득세는 얼마인가요?", a: `무상취득 세율 ${pct(A.baseRate)}에서 중과기준세율 ${pct(A.heavyRate)}를 뺀 ${pct(A.rate)}이고, 지방교육세가 과세표준의 ${eduPct} 붙습니다. 시가 ${eokwon(B)} 아파트면 취득세 ${manwon(ex.acq)}, 지방교육세 ${manwon(ex.edu)}으로 ${manwon(ex.total)}입니다(농어촌특별세 제외). 조정대상지역 ${eokwon(A.heavyHouseFloor)} 이상 주택의 무상취득 중과도 적용되지 않습니다.` },
  { q: "사실혼을 정리할 때도 같은가요?", a: `취득세 특례세율은 사실혼 해소에 따른 재산분할에도 적용된다는 대법원 판결이 있습니다(2016두36864). 양도세·증여세 판례는 법률혼 이혼 사건이라, 사실혼에 그대로 적용되는지는 이 글에서 확인하지 않았습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>넘기는 이유</th><th>넘기는 사람 양도세</th><th>받는 사람 증여세</th><th>받는 사람 취득세</th></tr></thead>
    <tbody>
      <tr><th scope="row">재산분할</th><td>없음(대법원 2012두10901)</td><td>원칙적으로 없음(헌재 96헌바14)</td><td>{pct(A.rate)} + 지방교육세</td></tr>
      <tr><th scope="row">위자료·자녀양육비</th><td>과세대상 — 유상양도(대법원 2001두4573)</td><td>이 글에서 확인 못 함</td><td>이 글에서 확인 못 함</td></tr>
      <tr><th scope="row">과대한 재산분할(조세 회피)</th><td>—</td><td>상당한 부분을 넘는 몫(대법원 2016두58901)</td><td>—</td></tr>
    </tbody>
  </table>
  <p>대법원은 조정조항에 '재산분할은 아파트 소유권 이전으로 갈음한다'고 적혀 있어도, 가정법원 절차에서 그 아파트를 재산분할 대상으로 다뤘다면 대물변제가 아니라 재산분할로 받은 것이라고 봤습니다(2012두10901). 반대로 위자료와 재산분할 액수를 나누지 않고 넘겼다면 법원이 혼인기간·파탄 원인 등을 보고 위자료 몫을 정합니다(2001두4573).</p>
  <p>소득세법과 상속세 및 증여세법에는 이혼 재산분할을 따로 정한 조문이 없습니다. 그래서 이 글의 양도세·증여세 부분은 국가법령정보센터와 국세법령정보시스템에서 판결 원문을 읽고 썼습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>과세표준과 신고기한, 금액별 계산은 <a href="/guide/divorce-acquisition-tax/">재산분할 취득세</a>에 있습니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>위자료로 넘긴 경우와 재산분할로 받은 집을 나중에 팔 때는 <a href="/guide/divorce-alimony-tax/">위자료 세금</a>, 배우자 사이 증여는 <a href="/guide/gift-tax/">증여세 면제한도</a>에 있습니다.</p>

  <h2>쓰지 않은 것</h2>
  <ul>
    {r.notVerified.map((n) => <li>{n}</li>)}
  </ul>

  <h2>이혼 재산분할 세금 시리즈</h2>
  <ul>
    {[S.hub, ...S.items].map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
