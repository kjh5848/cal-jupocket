---
/**
 * "육아휴직 급여 계산" — 육아휴직 시리즈. (육아휴직 급여 계산기·월별 금액·6+6 계산·한부모·통상임금 기준·지급일도 이 글, 계산기 포함)
 * 계산: src/lib/parental-leave.ts schedule() — 고용보험법 시행령 제95조·제95조의3.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/parental-leave-2026.json";
import { schedule, bandTotals } from "../../../lib/parental-leave";
import { calcPresets } from "../../../data/calc-presets";
import { won, eokwon } from "../../../lib/won";

const P = r.pay;
const ex = schedule(3_000_000, 12);
const exB = bandTotals(ex.rows);
const PRESETS = JSON.stringify({ default: calcPresets["/guide/parental-leave-pay-calculator/"].default.amounts });
const low = schedule(2_000_000, 12);
const ss = schedule(5_000_000, 6, "sixSix");
const pays = [1_500_000, 2_000_000, 2_500_000, 3_000_000, 4_000_000];
const rows = pays.map((p) => ({ p, x: schedule(p, 12) }));

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 parental-leave-series.test.ts 가 rates 와 대조한다.
const title = "육아휴직 급여 계산 — 월 통상임금과 휴직 개월을 넣으면 달마다 받는 금액과 총액이 나옵니다";
const description =
  "육아휴직 급여 계산은 휴직 시작일 기준 월 통상임금에 1~6개월 100%, 7개월째부터 80%를 곱하고 상한(250만·200만·160만원)과 하한 70만원으로 맞춥니다. 월 통상임금 300만원이면 1년 2,310만원, 200만원이면 2,160만원입니다.";

const ANSWER = `육아휴직 급여 = 휴직 시작일 기준 월 통상임금 × 지급률(1~6개월 100%, 7개월째부터 80%)을 상한·하한으로 맞춘 금액입니다(고용보험법 시행령 제95조). 월 통상임금 300만원이면 1년 ${won(ex.total)}, 200만원이면 ${won(low.total)}이고, 6+6 특례는 6개월 상한이 최대 450만원입니다(제95조의3).`;

const QA = [
  { q: "육아휴직 급여는 어떻게 계산하나요?", a: `① 휴직 시작일 기준 월 통상임금을 구하고 ② 1~3개월은 100%·상한 ${eokwon(P.bands[0].cap)}, 4~6개월은 100%·상한 ${eokwon(P.bands[1].cap)}, 7개월째부터 80%·상한 ${eokwon(P.bands[2].cap)} ③ 결과가 ${eokwon(P.floor)}보다 적으면 ${eokwon(P.floor)}입니다(시행령 제95조). 통상임금은 정기적·일률적으로 지급하기로 정한 임금입니다(근로기준법 시행령 제6조).` },
  { q: "월 통상임금별 육아휴직 급여는 얼마인가요?", a: `월 통상임금이 250만원 이상이면 상한에 걸려 1년 ${won(ex.total)}이 됩니다. 200만원이면 1~6개월 200만원, 7개월째부터 160만원으로 ${won(low.total)}입니다. ${eokwon(Math.ceil(P.floor / P.bands[2].rate))} 미만이면 7개월째부터 하한 ${eokwon(P.floor)}이 적용됩니다.` },
  { q: "6+6 육아휴직 급여는 어떻게 계산하나요?", a: `자녀 출생 후 18개월 안에 부모가 모두 육아휴직을 하면 첫 6개월은 월 통상임금 100%에 상한이 1·2개월 250만원, 3개월 300만원, 4개월 350만원, 5개월 400만원, 6개월 450만원입니다(제95조의3). 통상임금 500만원인 부모가 각각 6개월이면 한 사람당 ${won(ss.total)}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">한 달 단위로 계산합니다. 6+6 특례는 부모가 각각 같은 개월 수를 쓴다고 봅니다 — 시행령 제95조의3 제1항은 부모가 '각각 1~6개월'을 쓴 경우만 정해, 쓴 개월 수가 서로 다를 때는 넣지 않았습니다. 1개월이 안 되는 달·분할 사용·회사에서 받은 금품 감액도 넣지 않았습니다.</p>
    <div class="calc-input-wrap">
      <label for="pl-pay">휴직 시작일 기준 월 통상임금</label>
      <input type="text" inputmode="numeric" id="pl-pay" value="3,000,000" data-won data-presets={PRESETS} /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="pl-months">휴직 개월</label>
      <input type="number" min="1" max="18" step="1" id="pl-months" value="12" data-step /><span class="unit">개월</span>
    </div>
    <div class="calc-input-wrap">
      <label for="pl-mode">유형</label>
      <select id="pl-mode" data-seg>
        <option value="normal" selected>일반</option>
        <option value="sixSix">6+6 특례(출생 후 18개월 안에 부모 모두)</option>
        <option value="single">한부모</option>
      </select>
    </div>
    <div
      class="result-hero"
      aria-live="polite"
      aria-atomic="true"
      data-bar="pl-b1|pl-b2|pl-b3"
      data-bar-labels="1~3개월째|4~6개월째|7개월째부터"
      data-dock="pl-hero"
    >
      <p class="label">육아휴직 급여 총액 (달마다 받는 금액의 합)</p>
      <p class="big" id="pl-hero">{won(ex.total)}</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">한 달 평균 (총액 ÷ <span id="pl-n">{ex.rows.length}</span>개월)</span><span class="value" id="pl-avg">{won(Math.floor(ex.total / ex.rows.length))}</span></div>
      <div class="stat-chip" data-group="육아휴직 급여 총액"><span class="label">1~3개월째 (100%, 상한 <span id="pl-c1">{eokwon(P.bands[0].cap)}</span>)</span><span class="value" id="pl-b1">{won(exB.first3)}</span></div>
      <div class="stat-chip"><span class="label">4~6개월째 (100%, 상한 <span id="pl-c2">{eokwon(P.bands[1].cap)}</span>)</span><span class="value" id="pl-b2">{won(exB.next3)}</span></div>
      <div class="stat-chip"><span class="label">7개월째부터 (80%, 상한 {eokwon(P.bands[2].cap)})</span><span class="value" id="pl-b3">{won(exB.after6)}</span></div>
    </div>
    <p class="meta">달마다 월 통상임금 × 지급률을 상한에서 자르고, {eokwon(P.floor)}보다 적으면 {eokwon(P.floor)}을 줍니다(시행령 제95조 제1항). 6+6 특례는 첫 6개월 상한이 달마다 250·250·300·350·400·450만원, 한부모는 1~3개월째 상한 300만원입니다(제95조의3).</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>개월</th><th>월 지급액</th></tr></thead>
        <tbody id="pl-rows">{ex.rows.map((x) => <tr><th scope="row">{x.month}개월째</th><td>{won(x.pay)}</td></tr>)}</tbody>
      </table>
    </div>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>월 통상임금</th><th>1~3개월</th><th>4~6개월</th><th>7~12개월</th><th>12개월 합계</th></tr></thead>
      <tbody>{rows.map(({ p, x }) => <tr><th scope="row">{eokwon(p)}</th><td>{won(x.rows[0].pay)}</td><td>{won(x.rows[3].pay)}</td><td>{won(x.rows[6].pay)}</td><td>{won(x.total)}</td></tr>)}</tbody>
    </table>
  </div>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>신청은 휴직 시작 1개월 뒤부터 끝난 뒤 12개월 안에 합니다 — <a href="/guide/parental-leave-pay-apply/">육아휴직급여 신청</a>. 조건과 전체 정리는 <a href="/guide/parental-leave-pay/">육아휴직급여</a>에 있습니다.</p>

  <script src="../../../scripts/parental-leave.ts"></script>
</GuideLayout>
