---
/**
 * "시급 계산기" — 시급 계산 시리즈. (시급계산기·알바 시급 계산기·시급 월급 계산기·시급계산기 주휴수당·최저시급 계산기도 이 글, 계산기 포함)
 * 계산: src/lib/labor.ts hourlyWagePay() — 근로기준법 제18조 제3항·제50조·제55조, 시행령 별표 2, 최저임금법 시행령 제5조, 2026·2027 고시(rates: labor-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/labor-2026.json";
import { hourlyWagePay, minWage } from "../../../lib/labor";
import { won } from "../../../lib/won";

const W = r.weeklyHoliday;
const m26 = minWage(2026);
const m27 = minWage(2027);
const ex = hourlyWagePay(m26, 8, 5);
const ex27 = hourlyWagePay(m27, 8, 5, true, 2027);
const alba = hourlyWagePay(m26, 6, 3);
const noHol = hourlyWagePay(m26, 8, 5, false);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 hourly-wage-series.test.ts 가 rates 와 대조한다.
const title = "시급 계산기 — 시급과 하루 근무시간·주 근무일수를 넣으면 주휴수당을 넣은 일급·주급·월급·연봉이 나옵니다";
const description =
  "시급 계산기는 시급, 하루 근무시간, 주 근무일수로 일급·주급·월급·연봉(세전)을 계산합니다. 주 15시간 이상이면 주휴수당을 더하고, 주 40시간이면 최저임금 고시의 월 209시간을 씁니다. 2026년과 2027년 최저시급을 버튼으로 넣을 수 있습니다.";

const ANSWER = `2026년 최저시급 ${won(m26)}으로 하루 8시간 주 5일이면 일급 ${won(ex.daily)}, 주급 ${won(ex.weekTotal)}(주휴 ${won(ex.weekHoliday)} 포함), 월급 ${won(ex.monthly)}, 연봉 ${won(ex.annual)}입니다. 2027년 ${won(m27)}이면 월급 ${won(ex27.monthly)}입니다.`;

const QA = [
  { q: "시급계산기에 주휴수당이 들어가나요?", a: `네. 1주 근무시간이 ${W.minWeeklyHours}시간 이상이면 근무시간 ÷ 5(최대 8시간)만큼의 주휴시간 임금을 주급과 월급에 더합니다(근로기준법 제18조 제3항, 시행령 별표 2). 주휴를 빼고 보면 주 40시간 최저시급 월급은 ${won(ex.monthly)}이 아니라 ${won(noHol.monthly)}입니다.` },
  { q: "알바 하루 6시간 주 3일이면 얼마인가요?", a: `2026년 최저시급으로 주 18시간이라 주휴 ${alba.holidayHours}시간이 붙어 주급 ${won(alba.weekTotal)}, 월 약 ${won(alba.monthly)}입니다. 그 주에 정해진 날을 다 나오지 않으면 주휴수당은 없습니다(시행령 제30조).` },
  { q: "하루 8시간·주 40시간을 넘게 넣으면 어떻게 되나요?", a: `넘는 시간은 연장근로라 이 계산에 넣지 않고 따로 알려 줍니다(근로기준법 제50조). 상시 5명 이상 사업장은 연장근로에 가산임금이 붙어(제56조) 시급 × 시간과 다릅니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">세전 금액입니다. 주휴수당은 주 5일 사업장에서 그 주 정해진 날을 다 나왔다고 보고 계산합니다. 월급은 주 40시간이면 고시의 209시간, 그 밖은 (주 시간 + 주휴) × 365 ÷ 7 ÷ 12 시간으로 곱합니다.</p>
    <div class="calc-input-wrap">
      <label for="hw-wage">시급</label>
      <input type="text" inputmode="numeric" id="hw-wage" value={m26.toLocaleString("ko-KR")} data-won />
      <span class="unit">원</span>
    </div>
    <div class="amount-presets" role="group" aria-label="시급 고르기">
      <button type="button" class="preset-chip" data-hw-wage={m26} data-hw-year="2026">2026 최저 {won(m26)}</button>
      <button type="button" class="preset-chip" data-hw-wage={m27} data-hw-year="2027">2027 최저 {won(m27)}</button>
    </div>
    <div class="calc-input-wrap">
      <label for="hw-daily">하루 근무시간</label>
      <input type="number" min="0.5" max="24" step="0.5" id="hw-daily" value="8" data-step />
      <span class="unit">시간</span>
    </div>
    <div class="calc-input-wrap">
      <label for="hw-days">주 근무일수</label>
      <input type="number" min="1" max="7" step="1" id="hw-days" value="5" data-step />
      <span class="unit">일</span>
    </div>
    <div class="calc-input-wrap">
      <label for="hw-holiday">주휴수당</label>
      <select id="hw-holiday" data-seg><option value="1" selected>넣기(개근)</option><option value="0">빼기</option></select>
    </div>
    <div class="calc-input-wrap">
      <label for="hw-year">최저임금 비교 연도</label>
      <select id="hw-year" data-seg><option value="2026" selected>2026년</option><option value="2027">2027년</option></select>
    </div>
    <div
      class="result-hero"
      aria-live="polite"
      aria-atomic="true"
      data-bar="hw-base|hw-hol"
      data-bar-labels="근무한 시간 임금|주휴수당"
      data-dock="hw-hero"
    >
      <p class="label">월급(세전)</p>
      <p class="big" id="hw-hero">{won(ex.monthly)}</p>
      <p class="meta" id="hw-note">2026년 최저시급 {won(m26)} 이상 · 연봉 {won(ex.annual)}</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">일급 (시급 × 하루 시간)</span><span class="value" id="hw-day">{won(ex.daily)}</span></div>
      <div class="stat-chip"><span class="label">주휴시간 (주 시간 ÷ 5)</span><span class="value" id="hw-hh">{ex.holidayHours}시간</span></div>
      <div class="stat-chip" data-group="주급"><span class="label">근무한 시간 임금</span><span class="value" id="hw-base">{won(ex.weekBase)}</span></div>
      <div class="stat-chip"><span class="label">주휴수당</span><span class="value" id="hw-hol">{won(ex.weekHoliday)}</span></div>
      <div class="stat-chip"><span class="label">주급 합계</span><span class="value" id="hw-week">{won(ex.weekTotal)}</span></div>
      <div class="stat-chip" data-group="월·연"><span class="label">월 시간</span><span class="value" id="hw-mh">{ex.monthHours}시간</span></div>
      <div class="stat-chip"><span class="label">연봉 (월급 × 12)</span><span class="value" id="hw-annual">{won(ex.annual)}</span></div>
    </div>
    <p class="meta" id="hw-over" hidden></p>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>주휴수당만 따로 보려면 <a href="/guide/weekly-holiday-pay-calculator/">주휴수당 계산기</a>, 209시간이 어디서 나왔는지는 <a href="/guide/hourly-wage-monthly/">시급 월급 환산</a>에 있습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>근무 패턴별 주급·월급 표는 <a href="/guide/hourly-wage/">시급 계산</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>세금과 보험료를 뗀 금액은 <a href="/guide/four-insurance-calculator/">4대보험 계산기</a>나 <a href="/freelancer-33/">3.3% 계산기</a>로, 월급이 최저임금을 넘는지는 <a href="/guide/minimum-wage-calculator/">최저임금 계산기</a>로 볼 수 있습니다.</p>

  <script src="../../../scripts/hourly-wage.ts"></script>
</GuideLayout>
