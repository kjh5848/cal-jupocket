---
/**
 * "중개보수 계산기" — 중개보수 시리즈. (복비 계산기·부동산 중개보수 계산기·아파트 복비 계산기·중개보수 계산기 부가세·상가 중개보수 계산기·원룸 복비 계산기도 이 글, 계산기 포함)
 * 계산: src/lib/brokerage-fee.ts brokerageFee() — 공인중개사법 시행규칙 제20조, [별표 1]·[별표 2](rates: brokerage-fee-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/brokerage-fee-2026.json";
import { brokerageFee } from "../../../lib/brokerage-fee";
import { won } from "../../../lib/won";

const ex = brokerageFee({ property: "housing", deal: "sale", amount: 500_000_000 });
const exJ = brokerageFee({ property: "housing", deal: "jeonse", amount: 300_000_000 });
const exShop = brokerageFee({ property: "other", deal: "sale", amount: 500_000_000 });
const exAgreed = brokerageFee({ property: "housing", deal: "sale", amount: 500_000_000, agreedPct: 0.3 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 brokerage-fee-series.test.ts 가 rates 와 대조한다.
const title = "중개보수 계산기 — 거래금액과 매매·전세·월세를 고르면 법정 상한 복비와 부가세 포함 금액이 나옵니다";
const description =
  "중개보수 계산기는 주택·오피스텔·상가 토지의 매매·전세·월세 거래금액으로 공인중개사법 시행규칙 별표 1·2의 상한 중개보수를 계산합니다. 월세는 보증금 + 월세 × 100으로 거래금액을 잡고, 협의 요율과 부가세 10%를 넣어 볼 수 있습니다.";

const ANSWER = `아파트 5억원 매매면 상한요율 0.4%로 한쪽이 내는 중개보수는 최대 ${won(ex.maxFee)}, 일반과세자 중개사무소라 부가세 10%가 붙으면 ${won(ex.feeWithVat)}입니다. 전세 3억원은 0.3%로 ${won(exJ.maxFee)}, 상가·토지 5억원 매매는 0.9% 이내라 최대 ${won(exShop.maxFee)}입니다.`;

const QA = [
  { q: "복비 계산기 결과가 꼭 내야 하는 금액인가요?", a: `아닙니다. 계산기 금액은 법이 정한 최대치이고, 실제 중개보수는 그 안에서 중개사와 협의해 정합니다(공인중개사법 시행규칙 제20조 ①). 5억원 매매를 0.4%가 아니라 0.3%로 합의하면 ${won(exAgreed.fee)}입니다. 아래 협의 요율 칸에 넣으면 바로 다시 계산됩니다.` },
  { q: "중개보수 계산기에서 부가세는 왜 따로 나오나요?", a: `중개도 부가가치세가 붙는 용역이라, 일반과세자 중개사무소는 중개보수에 10%를 붙여 청구하곤 합니다. 다만 시행규칙 별표에는 상한에 부가세가 들어가는지 빠지는지 적혀 있지 않아, 이 계산기는 중개보수와 부가세를 나눠 보여 줍니다. 간이과세자 사무소는 계산 방식이 달라 넣지 않았습니다. 계약 전에 사업자 유형과 부가세 포함 여부를 물어보는 게 확실합니다.` },
  { q: "오피스텔·상가는 어떻게 계산하나요?", a: `전용 85㎡ 이하이고 전용 부엌·화장실·목욕시설을 갖춘 오피스텔은 매매 0.5%, 임대차 0.4%가 상한입니다(별표 2). 그 요건을 못 갖춘 오피스텔과 상가·토지는 거래금액의 0.9% 이내에서 협의합니다(제20조 ④ 2호). 주택과 달리 한도액이 없습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">중개의뢰인 한쪽(매도인·매수인, 임대인·임차인 각각)이 내는 법정 상한입니다. 주택은 공인중개사법 시행규칙 별표 1 상한이고, 실제 한도는 중개사무소가 있는 시·도 조례가 그 안에서 정합니다(서울 조례는 별표 1과 같음).</p>
    <div class="calc-input-wrap">
      <label for="bf-prop">부동산 종류</label>
      <select id="bf-prop" data-seg>
        <option value="housing" selected>주택(아파트·빌라)</option>
        <option value="officetel">오피스텔(85㎡ 이하·설비)</option>
        <option value="other">상가·토지 등</option>
      </select>
    </div>
    <div class="calc-input-wrap">
      <label for="bf-deal">거래 종류</label>
      <select id="bf-deal" data-seg>
        <option value="sale" selected>매매·교환</option>
        <option value="jeonse">전세</option>
        <option value="monthly">월세</option>
      </select>
    </div>
    <div class="calc-input-wrap" id="bf-amount-wrap">
      <label for="bf-amount" id="bf-amount-label">거래금액</label>
      <input type="text" inputmode="numeric" id="bf-amount" value="500,000,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap" id="bf-deposit-wrap" hidden>
      <label for="bf-deposit">보증금</label>
      <input type="text" inputmode="numeric" id="bf-deposit" value="10,000,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap" id="bf-rent-wrap" hidden>
      <label for="bf-rent">월세</label>
      <input type="text" inputmode="numeric" id="bf-rent" value="500,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="bf-agreed">협의 요율(비우면 상한)</label>
      <input type="number" min="0" max="0.9" step="0.05" id="bf-agreed" placeholder="상한" data-step />
      <span class="unit">%</span>
    </div>
    <div
      class="result-hero"
      aria-live="polite"
      aria-atomic="true"
      data-bar="bf-fee|bf-vat"
      data-bar-labels="중개보수|부가세 10%"
      data-dock="bf-hero"
    >
      <p class="label">중개보수(한쪽, 부가세 포함)</p>
      <p class="big" id="bf-hero">{won(ex.feeWithVat)}</p>
      <p class="meta" id="bf-note">상한요율 0.4% · 부가세 빼면 {won(ex.fee)}</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip" data-group="거래금액"><span class="label">요율을 곱하는 거래금액</span><span class="value" id="bf-base">{won(ex.base)}</span></div>
      <div class="stat-chip"><span class="label">상한요율</span><span class="value" id="bf-cap">0.4%</span></div>
      <div class="stat-chip"><span class="label">구간 한도액</span><span class="value" id="bf-limit">없음</span></div>
      <div class="stat-chip" data-group="중개보수"><span class="label">법정 상한 중개보수</span><span class="value" id="bf-max">{won(ex.maxFee)}</span></div>
      <div class="stat-chip"><span class="label">적용 요율로 낸 중개보수</span><span class="value" id="bf-fee">{won(ex.fee)}</span></div>
      <div class="stat-chip"><span class="label">부가세 10%(일반과세자)</span><span class="value" id="bf-vat">{won(ex.vat)}</span></div>
      <div class="stat-chip"><span class="label">양쪽 합계(부가세 빼고)</span><span class="value" id="bf-both">{won(ex.bothSides)}</span></div>
    </div>
    <p class="meta" id="bf-extra" hidden></p>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>거래금액 구간별 요율표 전체는 <a href="/guide/brokerage-fee/">중개보수 요율표</a>에 있습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>부가세만 따로 계산해 보려면 <a href="/vat/">부가세 계산기</a>를 쓰면 됩니다. 월세 복비가 전세보다 적게 나오는 이유는 <a href="/guide/monthly-rent-brokerage-fee/">월세 복비</a>에 정리했습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>건물 안에 주택과 상가가 섞여 있으면 주택 면적이 절반 이상일 때 주택 요율, 절반 미만이면 주택 외 요율을 씁니다(제20조 ⑥). 집을 사면서 함께 내는 세금은 <a href="/acquisition-tax/">취득세 계산기</a>로 볼 수 있습니다.</p>

  <script src="../../../scripts/brokerage-fee.ts"></script>
</GuideLayout>
