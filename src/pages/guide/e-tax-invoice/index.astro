---
/**
 * "전자세금계산서 발행" — 사업자 신고 시리즈. (전자세금계산서 의무·대상·8천만원·개인사업자·전송·홈택스·종이 발급 가산세도 이 글)
 * 근거: 부가가치세법 제32조 제2항·제3항·제5항, 시행령 제68조 제1항~제5항·제7항, 제60조 제2항(가산세 — vat-penalty-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/business-filing-2026.json";
import vp from "../../../rates/vat-penalty-2026.json";
import { won, eokwon } from "../../../lib/won";

const E = r.eInvoice;
const P = vp.taxInvoice;
const pct = (x: number) => `${+(x * 100).toFixed(1)}%`;
const amount = 20_000_000;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 business-filing-series.test.ts 가 rates 와 대조한다.
const title = "전자세금계산서 발행 — 법인과 직전 연도 공급가액 8천만원 이상 개인사업자는 의무입니다";
const description =
  "전자세금계산서 발행은 법인사업자와 직전 연도 사업장별 공급가액이 8천만원 이상인 개인사업자의 의무입니다. 8천만원을 넘은 해의 다음 해 7월 1일부터 시작하고, 발급일 다음 날까지 국세청에 전송해야 합니다. 의무자가 종이로 발급하면 1% 가산세입니다.";

const ANSWER = `전자세금계산서 발행은 법인사업자와 직전 연도 사업장별 공급가액(면세 포함)이 ${eokwon(E.individualThreshold)} 이상인 개인사업자의 의무입니다(부가가치세법 제32조 제2항, 시행령 제68조 제1항). ${eokwon(E.individualThreshold)}을 넘은 해의 다음 해 7월 1일부터 시작하고, 발급일 다음 날까지 국세청에 전송합니다.`;

const QA = [
  { q: "전자세금계산서 의무 발행 대상은 누구인가요?", a: `법인사업자 전부와, 직전 연도 사업장별 재화·용역 공급가액(면세공급가액 포함) 합계가 ${eokwon(E.individualThreshold)} 이상인 개인사업자입니다. 한 번 대상이 되면 그 뒤 공급가액이 ${eokwon(E.individualThreshold)} 미만으로 줄어도 계속 의무자입니다(시행령 제68조 제1항).` },
  { q: "개인사업자는 언제부터 전자세금계산서를 발행해야 하나요?", a: `공급가액이 ${eokwon(E.individualThreshold)} 이상인 해의 다음 해 제2기 과세기간이 시작하는 날, 즉 7월 1일부터입니다(시행령 제68조 제2항). 세무서는 1개월 전까지 통지하고, 통지를 받지 못했으면 통지서를 받은 달의 다음다음 달 1일부터 발급합니다(제3항·제4항).` },
  { q: "전자세금계산서 의무자가 종이로 발행하면 어떻게 되나요?", a: `발급시기에 종이 세금계산서를 발급하면 공급가액의 ${pct(P.notIssuedException)} 가산세입니다(제60조 제2항 제2호 단서). 아예 발급하지 않은 ${pct(P.notIssued)}보다는 낮지만, ${eokwon(amount)} 거래면 ${won(Math.round(amount * P.notIssuedException))}입니다.` },
  { q: "전자세금계산서 전송 기한은 언제인가요?", a: `발급일의 다음 날까지 발급명세를 국세청장에게 전송해야 합니다(시행령 제68조 제7항). 늦게 전송하면 ${pct(P.eTransmitLate)}, 전송하지 않으면 ${pct(P.eTransmitNone)} 가산세입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>직전 연도 공급가액 8천만원 이상이 된 해</th><th>전자세금계산서 의무 시작</th></tr></thead>
    <tbody>
      <tr><th scope="row">2025년</th><td>2026년 7월 1일</td></tr>
      <tr><th scope="row">2026년</th><td>2027년 7월 1일</td></tr>
    </tbody>
  </table>
  <p>수정신고나 세무서의 결정·경정으로 8천만원 이상이 되면 그 다음 과세기간부터입니다(시행령 제68조 제2항 단서).</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    발급 경로는 {E.methods.join(" · ")}입니다(시행령 제68조 제5항). 의무자가 아니어도 전자로 발급할 수 있습니다(법 제32조 제5항).
    기재사항은 <a href="/guide/tax-invoice-how/">세금계산서 발행방법</a>에 있습니다.
  </p>
</GuideLayout>
