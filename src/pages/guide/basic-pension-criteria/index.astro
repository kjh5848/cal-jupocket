---
/**
 * "기초연금 기준" — 기초연금 시리즈. (선정기준액·소득인정액·수급자격 재산·금융재산·재산 기준·근로소득 공제·자녀 집·자동차·자격조건도 이 글)
 * 근거: 기초연금법 제2조 제4호·제3조, 시행규칙 제4조(연 4%), 고시 제2026-156호 제2조·제4조·제6조·제6조의2·제8조·제9조·제11조. rates: basic-pension-2026.json
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/basic-pension-2026.json";
import { propertyIncome, workIncome } from "../../../lib/basic-pension";
import { won, eokwon } from "../../../lib/won";

const P = r.property;
const I = r.income;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const exProp = propertyIncome({ general: 300_000_000, financial: 50_000_000, region: "metro" });
const exWork = workIncome(2_000_000);
// 단독가구가 근로소득 없이 대도시에서 받을 수 있는 재산 한도(일반재산만, 금융재산 2천만원 이하·부채 없음)
const propMax = P.basic.metro + Math.floor((r.selection.single * 12) / P.conversionRate);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 basic-pension-series.test.ts 가 rates 와 대조한다.
const title = "기초연금 기준 — 소득인정액이 혼자 월 247만원, 부부 월 395만2천원 이하여야 합니다";
const description =
  "기초연금 기준은 소득인정액이 2026년 선정기준액(혼자 월 247만원, 부부 월 395만2천원) 이하인지입니다. 소득인정액은 소득평가액에 재산의 소득환산액을 더한 값으로, 재산은 기본재산(대도시 1억3,500만원)과 금융재산 2천만원을 빼고 연 4%로 환산합니다.";

const ANSWER = `기초연금 기준은 소득인정액이 선정기준액 이하인지입니다(기초연금법 제3조). 2026년 선정기준액은 혼자 사는 노인 월 ${eokwon(r.selection.single)}, 부부 월 ${eokwon(r.selection.couple)}입니다. 소득인정액 = 소득평가액 + 재산의 소득환산액이고(제2조 제4호), 재산은 공제 후 연 ${pct(P.conversionRate)}로 월 소득에 환산합니다(시행규칙 제4조).`;

const QA = [
  { q: "소득인정액은 어떻게 계산하나요?", a: `본인과 배우자의 소득평가액에 재산의 소득환산액을 더합니다(제2조 제4호). 재산의 소득환산액 = [(일반재산 − 기본재산액) + (금융재산 − ${eokwon(P.financialDeduction)}) − 부채] × 연 ${pct(P.conversionRate)} ÷ 12입니다(시행규칙 제4조). 대도시에 3억원 집과 예금 5천만원이 있으면 월 ${won(exProp)}입니다.` },
  { q: "기초연금 재산 기준은 얼마인가요?", a: `재산 자체의 한도는 따로 없고 소득인정액으로 봅니다. 기본재산액(대도시 ${eokwon(P.basic.metro)}, 중소도시 ${eokwon(P.basic.city)}, 농어촌 ${eokwon(P.basic.rural)})과 금융재산 ${eokwon(P.financialDeduction)}을 빼고 환산합니다(고시 제8조·제9조). 소득이 없는 대도시 단독가구면 일반재산 약 ${eokwon(Math.floor(propMax / 10_000_000) * 10_000_000)}까지가 기준 안입니다.` },
  { q: "일하면 기초연금을 못 받나요?", a: `근로소득은 월 ${eokwon(I.workDeduction)}을 빼고 남은 금액의 ${pct(I.workExtraRate)}를 더 뺀 뒤 소득으로 봅니다(고시 제6조). 월 200만원을 벌면 소득평가액은 ${won(exWork)}입니다. 부부는 각자 따로 공제합니다. 이자소득은 월 ${won(I.interestDeduction)}을 뺍니다(고시 제6조의2).` },
  { q: "자동차나 자녀 명의 집도 보나요?", a: `차량가액 4천만원 이상 자동차는 가액 전부를 월 소득으로 봅니다. 차령 10년 이상·화물차·생업용 등은 빠집니다(고시 제11조). 자녀(1촌 직계비속) 소유의 시가표준액 6억원 이상 주택에 무료로 살면 무료임차소득을 소득으로 봅니다(고시 제4조).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>지역</th><th>기본재산액(빼는 금액)</th><th>범위</th></tr></thead>
    <tbody>
      <tr><th scope="row">대도시</th><td>{eokwon(P.basic.metro)}</td><td rowspan="3">{P.basicRegions}</td></tr>
      <tr><th scope="row">중소도시</th><td>{eokwon(P.basic.city)}</td></tr>
      <tr><th scope="row">농어촌</th><td>{eokwon(P.basic.rural)}</td></tr>
    </tbody>
  </table>
  <p>재산 한도 어림은 근로·연금 소득이 없고, 금융재산이 {eokwon(P.financialDeduction)} 이하이며 부채가 없는 경우입니다. 소득이 있으면 그만큼 낮아집니다. 일반재산 가액을 어떻게 매기는지(공시가격·임차보증금 등)는 시행규칙 제3조의 세부라 이 글에서 다루지 않았습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>내 소득과 재산을 넣어 보려면 <a href="/guide/basic-pension-calculator/">기초연금 모의계산</a>, 받는 금액은 <a href="/guide/basic-pension-amount/">기초연금 금액</a>에 있습니다.</p>
</GuideLayout>
