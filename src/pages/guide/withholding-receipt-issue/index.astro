---
/**
 * "원천징수영수증 발급" — 원천징수영수증 시리즈.
 * (발급 방법·홈택스·조회·출력·확인·직인·회사직인·양식도 이 글 — 화면·서식은 조문 밖이라 절로만)
 * 조문이 답하는 것: 발급 의무가 누구에게 언제 있나(제143조·제144조·제146조).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import w from "../../../rates/withholding-receipt-2026.json";

const title = "원천징수영수증 발급 — 회사가 줄 의무가 있고, 기한은 소득마다 다릅니다";
const description =
  "원천징수영수증 발급은 내가 신청해서 받는 것이 아니라 세금을 뗀 회사·거래처가 줄 의무입니다. 근로소득은 다음 해 2월 말일까지, 3.3% 사업소득은 지급할 때, 퇴직소득은 다음 달 말일까지입니다.";

const ANSWER = "원천징수영수증은 세금을 떼고 돈을 준 쪽이 발급할 의무가 있는 서류입니다. 근로소득은 회사가 다음 해 2월 말일까지, 3.3% 사업소득은 거래처가 지급할 때, 퇴직소득은 지급한 달의 다음 달 말일까지 발급합니다. 받지 못했다면 먼저 준 쪽에 요청합니다.";

const QA = [
  { q: "원천징수영수증은 어디서 발급받나요?", a: "세금을 떼고 소득을 준 곳입니다. 근로소득은 회사, 사업소득은 거래처, 퇴직소득은 퇴직금을 준 쪽이 발급 의무를 집니다(소득세법 제143조·제144조·제146조). 세무서가 발급하는 서류가 아닙니다." },
  { q: "원천징수영수증 발급 기한은 언제인가요?", a: `근로소득은 ${w.earned.deadline}, 사업소득은 ${w.business.deadline}, 퇴직소득은 ${w.severance.deadline}입니다. 중도 퇴사자의 근로소득은 마지막 급여를 받은 달의 다음 달 말일까지입니다.` },
  { q: "회사가 원천징수영수증을 안 주면 어떻게 하나요?", a: "먼저 회사에 요청합니다. 발급은 회사의 법적 의무이고(제143조), 두 곳에서 일했다면 종된 근무지는 요청을 받으면 지체 없이 발급해야 한다고 따로 적혀 있습니다(제143조 제2항)." },
  { q: "원천징수영수증에 회사 직인이 있어야 하나요?", a: "소득세법 조문에는 직인 요건이 적혀 있지 않습니다. 영수증의 서식은 재정경제부령(시행규칙 별지 서식)이 정하는데, 이 글에서는 그 서식을 읽지 않아 직인 칸에 대해서는 단정하지 않습니다." },
];
---

<GuideLayout title={title} description={description} updated={w.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>이 글에 없는 것</h2>
  <ul>
    <li><strong>홈택스·손택스 조회·출력 화면</strong> — 조문 밖이고 화면이 바뀝니다.</li>
    <li><strong>영수증 서식(양식)과 칸 이름</strong> — 시행규칙 별지 서식은 읽지 않았습니다.</li>
    <li><strong>발급하지 않았을 때의 제재</strong> — 확인하지 않았습니다.</li>
  </ul>
</GuideLayout>
