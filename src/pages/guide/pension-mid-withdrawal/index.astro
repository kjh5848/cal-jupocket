---
/**
 * "퇴직연금 중도인출" — 퇴직금·퇴직연금 시리즈. (사유·조건·무주택자·주택구입·전세·세금·DC형·IRP도 이 글)
 * 근거: 근로자퇴직급여 보장법 제22조·시행령 제14조(DC 중도인출 사유), 시행령 제18조 제2항(IRP 중도인출), 시행령 제2조(담보 사유·50% 한도),
 * 소득세법 제146조 제2항(연금외수령 때 원천징수).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/severance-2026.json";

const D = r.dc;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 severance-series.test.ts 가 rates 와 대조한다.
const title = "퇴직연금 중도인출 — 무주택자 주택구입·전세, 6개월 이상 요양, 파산·회생 등 법정 사유만";
const description =
  "퇴직연금 중도인출은 DC형과 IRP에서 무주택자의 주택구입이나 전세금, 6개월 이상 요양 의료비, 5년 내 파산·개인회생, 재난, 담보대출 상환 같은 법정 사유가 있을 때만 됩니다. DB형은 중도인출 규정이 없고, 꺼낸 돈에는 퇴직소득세가 붙습니다.";

const ANSWER = `퇴직연금 중도인출은 DC형(근로자퇴직급여 보장법 제22조, 시행령 제14조)과 IRP(시행령 제18조)에서 무주택자 주택구입·전세, 6개월 이상 요양 의료비, 5년 내 파산·개인회생, 재난, 담보대출 상환 같은 법정 사유가 있을 때만 됩니다. 이유 없이 꺼낼 수는 없습니다.`;

const QA = [
  { q: "퇴직연금 중도인출 사유는 무엇인가요?", a: `DC형은 ① 무주택자 본인 명의 주택구입 ② 무주택자 전세금·보증금(한 사업 1회) ③ 본인·배우자·부양가족 6개월 이상 요양 의료비가 연간 임금총액의 12.5% 초과 ④ 5년 내 파산선고·개인회생 개시 ⑤ 재난 피해 ⑥ 퇴직연금 담보대출 원리금 상환입니다(시행령 제14조).` },
  { q: "퇴직연금 중도인출 무주택자 기준은 무엇인가요?", a: `시행령은 '무주택자인 가입자가 본인 명의로 주택을 구입하는 경우'와 '무주택자인 가입자가 주거 목적으로 전세금·보증금을 부담하는 경우'로 적고 있습니다(시행령 제2조 제1항 제1호·제1호의2). 전세는 한 직장에서 1회만 됩니다. 무주택 판단의 세부 기준은 이 글에서 확인하지 않았습니다.` },
  { q: "퇴직연금을 중도인출하면 세금은?", a: `IRP·DC에 쌓인 퇴직금은 연금이 아닌 방식으로 꺼내면 그때 퇴직소득세를 원천징수합니다(소득세법 제146조 제2항 — 연금외수령 전까지만 미룸). 본인이 세액공제받고 넣은 돈과 수익은 기타소득 15%이고, 의료목적 등 부득이한 인출은 연금소득으로 분리과세합니다.` },
  { q: "중도인출 말고 담보대출은 안 되나요?", a: `됩니다. 주택구입·전세·요양·파산·회생·대학등록금·혼례비·장례비 등 사유가 있으면 퇴직연금 급여를 받을 권리를 적립금의 50% 한도에서 담보로 제공할 수 있습니다(법 제7조 제2항, 시행령 제2조). 중도인출과 달리 적립금은 그대로 남습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ol>{D.midReasons.map((x) => <li>{x}</li>)}</ol>
  <p>{r.irpWithdrawal.rule}(시행령 제18조 제2항). DB형은 법에 중도인출 규정이 없습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    담보대출은 <a href="/guide/retirement-pension-loan/">퇴직연금 담보대출</a>, 퇴직금 쪽 같은 제도는{" "}
    <a href="/guide/severance-interim-settlement/">퇴직금 중간정산</a>에 있습니다.
  </p>
</GuideLayout>
