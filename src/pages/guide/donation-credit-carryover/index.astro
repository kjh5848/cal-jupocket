---
/**
 * "기부금 세액공제 이월" — 기부금 세액공제 시리즈.
 * 근거: 소득세법 제61조 제2항(10년 이월), 제60조 제1항 제3호(이월분 먼저), 제34조 제5항(사업자 필요경비 이월).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/special-credit-2026.json";

const C = r.donation.carryover;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 special-credit-series.test.ts 가 rates 와 대조한다.
const title = "기부금 세액공제 이월 — 올해 못 받은 기부금은 10년 동안 넘겨 공제합니다";
const description =
  "기부금 세액공제 이월은 한도를 넘었거나 세금이 적어 올해 공제받지 못한 기부금을 다음 해부터 10년 안에 공제받는 제도입니다. 이월된 기부금은 그해 낸 기부금보다 먼저 공제합니다. 의료비·교육비에는 이런 이월이 없습니다.";

const ANSWER = `올해 공제받지 못한 기부금은 다음 과세기간 개시일부터 ${C.years}년 이내에 끝나는 과세기간으로 이월해 공제합니다(소득세법 제61조 제2항). 한도를 넘은 일반기부금과, 세액공제가 산출세액을 넘어 못 받은 기부금이 대상이며, 이월분을 먼저 공제합니다.`;

const QA = [
  { q: "기부금 세액공제 이월이란 무엇인가요?", a: `세액공제 합계가 공제기준산출세액을 넘어 공제받지 못한 기부금과, 일반기부금 한도를 넘어 공제받지 못한 기부금을 다음 해로 넘기는 것입니다. 다음 과세기간 개시일부터 ${C.years}년 이내에 끝나는 각 과세기간에 기부금 공제율을 적용해 공제합니다(제61조 제2항).` },
  { q: "이월된 기부금과 올해 기부금은 무엇을 먼저 공제하나요?", a: `이월된 것을 먼저 공제합니다. 이월공제가 인정되는 세액공제에서 그해 생긴 공제액과 이전 과세기간에서 이월된 미공제액이 함께 있으면 이월된 미공제액을 먼저 공제한다고 정합니다(제60조 제1항 제3호).` },
  { q: "의료비·교육비도 이월되나요?", a: `아닙니다. 제61조 제2항의 이월은 기부금 세액공제액에만 있습니다. 의료비·교육비 등은 근로소득 산출세액을 넘으면 넘는 금액이 없는 것으로 되어(제61조 제1항) 다음 해로 넘어가지 않습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ul>
    <li>한도 초과 — 일반기부금이 소득금액 30%(종교단체는 10%+α)를 넘은 부분 — <a href="/guide/donation-credit-limit/">기부금 세액공제 한도</a></li>
    <li>세액 부족 — 자녀·연금계좌·특별세액공제 등 합계가 산출세액을 넘어 못 받은 기부금 공제분</li>
  </ul>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    사업자가 필요경비에 넣지 못한 기부금도 10년간 이월해 필요경비에 넣을 수 있습니다(제34조 제5항).
    이월 금액을 다음 해 연말정산에 어떻게 반영하는지(서식)는 이 글에서 다루지 않습니다.
  </p>
</GuideLayout>
