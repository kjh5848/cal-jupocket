---
/**
 * "전입신고 확정일자" — 이사 시리즈. (이사 전입신고·전입신고 기간·전입신고 언제·이사 확정일자 기한·확정일자 받는 법·이사 전입신고 예비군·전월세 신고도 이 글)
 * 근거: 주민등록법 제11조·제16조 ①·제17조·제40조 ④, 주택임대차보호법 제3조 ①·제3조의2 ②·제3조의6 ①·⑤,
 * 부동산 거래신고 등에 관한 법률 제6조의2·제6조의5·제28조 ⑤, 시행령 제4조의3(rates: moving-2026.json).
 * 쓰지 않은 것: 과태료 지연 일수별 금액(주민등록법 시행령 별표 4 미확인), 온라인 신청 절차(원문 미확인), 판례의 '다음 날 0시' 표현.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import AffiliateBox from "../../../components/AffiliateBox.astro";
import m from "../../../rates/moving-2026.json";
import { manwon, eokwon } from "../../../lib/won";

const D = m.moveIn.reportDays;
const fine = manwon(m.moveIn.fineMax);
const L = m.leaseReport;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 moving.test.ts 가 rates 와 대조한다.
const title = "전입신고 확정일자 — 전입신고는 전입한 날부터 14일 안에, 확정일자는 정해진 기한이 없지만 둘을 다 갖춰야 보증금을 먼저 돌려받습니다";
const description =
  "전입신고는 새 주소에 전입한 날부터 14일 이내에 하고, 늦으면 5만원 이하 과태료입니다. 확정일자는 법에 기한이 없지만 우선변제권은 입주·전입신고와 확정일자를 모두 갖춰야 생깁니다. 받는 곳, 대항력이 생기는 날, 임대차 신고와의 관계를 정리했습니다.";

const ANSWER = `전입신고는 전입한 날부터 ${D}일 이내에 새 주소지 시·군·구에 해야 합니다(주민등록법 제16조). 확정일자는 법에 정해진 기한이 없지만, 전세·월세 보증금을 경매·공매에서 먼저 돌려받으려면 입주·전입신고(대항요건)와 확정일자를 모두 갖춰야 합니다(주택임대차보호법 제3조의2).`;

const QA = [
  { q: "이사 전입신고는 언제까지 해야 하나요?", a: `새 주소에 전입한 날부터 ${D}일 이내입니다(주민등록법 제16조 ①). 세대주가 하는 것이 원칙이고, 세대주가 못 하면 세대원 본인이나 위임받은 배우자·직계혈족 등이 대신할 수 있습니다(제11조). 정당한 사유 없이 기간을 넘기면 ${fine} 이하 과태료입니다(제40조 ④).` },
  { q: "확정일자는 언제까지 받아야 하나요?", a: `법에 정한 기한은 없습니다. 다만 우선변제권은 대항요건(주택 인도와 주민등록)과 임대차계약서상의 확정일자를 모두 갖춘 임차인에게 생기므로(주택임대차보호법 제3조의2 ②), 확정일자를 늦게 받으면 그만큼 권리도 늦게 갖춰집니다. 전입신고 때 함께 받으면 두 날짜가 맞춰집니다.` },
  { q: "전입신고를 하면 대항력은 언제 생기나요?", a: `주택을 넘겨받고(인도) 주민등록을 마친 다음 날부터 제삼자에게 효력이 생깁니다(주택임대차보호법 제3조 ①). 이때 전입신고를 한 때에 주민등록이 된 것으로 봅니다. 그래서 짐을 들인 날 전입신고를 하면 그다음 날부터 대항력이 있습니다.` },
  { q: "확정일자는 어디서 받나요?", a: `주택이 있는 곳의 읍·면사무소, 동 주민센터, 시·군·구 출장소, 지방법원·지원과 등기소, 공증인이 부여합니다(주택임대차보호법 제3조의6 ①). 수수료를 내야 하고(같은 조 ⑤), 주택 임대차 신고를 계약서와 함께 접수하면 확정일자를 부여한 것으로 봅니다(부동산거래신고법 제6조의5 ③).` },
  { q: "전월세 신고도 따로 해야 하나요?", a: `보증금이 ${eokwon(L.depositOver)}을 넘거나 월세가 ${manwon(L.monthlyRentOver)}을 넘는 주택 임대차 계약은 계약일부터 ${L.days}일 안에 신고해야 합니다(부동산거래신고법 제6조의2, 시행령 제4조의3). 다만 임차인이 전입신고를 하면 이 신고를 한 것으로 봅니다(제6조의5 ①).` },
  { q: "전입신고하면 예비군·민방위 주소도 바뀌나요?", a: `그렇습니다. 주민등록 전입신고를 하면 병역법·민방위기본법·인감증명법·국민기초생활 보장법·국민건강보험법·장애인복지법에 따른 거주지 이동의 전출신고와 전입신고를 한 것으로 봅니다(주민등록법 제17조).` },
];
---

<GuideLayout title={title} description={description} updated={m.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>기간을 넘긴 일수에 따라 과태료를 얼마로 매기는지는 주민등록법 시행령 별표가 정하는데, 이 글에서는 그 표를 확인하지 않아 법률의 상한({fine} 이하)만 적었습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>살던 집 보증금을 아직 못 받았는데 먼저 이사를 나가야 한다면, 임차권등기명령으로 임차권등기를 마쳐 두면 주민등록을 옮겨도 이미 얻은 대항력과 우선변제권이 유지됩니다(제3조의3 ⑤). 이삿날 전후로 할 일 전체는 <a href="/guide/moving-checklist/">이사 체크리스트</a>에 순서대로 있습니다.</p>

  <AdSlot />

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>{QA[4].q}</h2>
  <p class="qa-lead">{QA[4].a}</p>
  <p>신고 대상 지역은 {L.regions}입니다(시행령 제4조의3 ②). 보증금과 월세를 그대로 두고 기간만 늘리는 갱신 계약은 대상이 아닙니다(같은 조 ①). 신고하지 않으면 {manwon(L.fineMax)} 이하 과태료입니다(법 제28조 ⑤ 3호). 전입신고로 갈음할 때 함께 내야 하는 서류는 시행규칙이 정하는데, 이 글에서는 확인하지 않았습니다.</p>

  <h2>{QA[5].q}</h2>
  <p class="qa-lead">{QA[5].a}</p>
  <p>전세·월세 계약 때 낸 중개보수가 법정 상한 안인지는 <a href="/guide/brokerage-fee/">중개보수 요율표</a>와 <a href="/guide/monthly-rent-brokerage-fee/">월세 복비</a>에서 확인할 수 있습니다.</p>

  <AffiliateBox id="moving-quote" />
</GuideLayout>
