---
/**
 * "법인세 과세표준" — 법인세 시리즈. (과세표준 계산·익금·손금·이월결손금 15년·80% 한도·사업연도 1년 미만도 이 글)
 * 근거: 법인세법 제13조(이월결손금 15년·80%(중소기업 100%)·비과세·소득공제, 이월 불가 항목), 제14조(익금 − 손금), 제55조 제2항(1년 미만).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/corporate-tax-2026.json";
import { corporateTax } from "../../../lib/corporate-tax";
import { won, eokwon } from "../../../lib/won";

const T = r.taxBase;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const income = 500_000_000;
const loss = 600_000_000;
const generalBase = income - Math.min(loss, income * T.lossCap);
const smeBase = income - Math.min(loss, income);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 registration-corporate-series.test.ts 가 rates 와 대조한다.
const title = "법인세 과세표준 — 익금에서 손금을 빼고, 15년 안의 이월결손금은 소득의 80%까지만";
const description =
  "법인세 과세표준은 익금에서 손금을 뺀 각 사업연도 소득에서 15년 이내 이월결손금, 비과세소득, 소득공제를 차례로 뺀 금액입니다. 이월결손금은 일반 법인이 소득의 80%까지만 뺄 수 있고 중소기업은 100%입니다. 여기에 법인세율을 곱합니다.";

const ANSWER = `법인세 과세표준은 각 사업연도 소득(익금 − 손금)에서 15년 이내 이월결손금, 비과세소득, 소득공제를 차례로 뺀 금액입니다(법인세법 제13조·제14조). 이월결손금은 일반 법인이 소득의 ${pct(T.lossCap)}까지만 뺄 수 있고 중소기업 등은 100%입니다.`;

const QA = [
  { q: "법인세 과세표준은 어떻게 계산하나요?", a: `익금 총액 − 손금 총액 = 각 사업연도 소득이고(제14조 제1항), 여기서 ① 이월결손금 ② 비과세소득 ③ 소득공제를 차례로 뺍니다(제13조 제1항). 그해 다 빼지 못한 비과세소득과 소득공제는 다음 해로 넘어가지 않습니다(제2항).` },
  { q: "이월결손금은 얼마나 뺄 수 있나요?", a: `각 사업연도 개시일 전 ${T.lossYears}년 안에 생기고 신고·결정된 결손금만 뺄 수 있고, 한도는 그해 소득의 ${pct(T.lossCap)}입니다. 중소기업과 회생계획 이행 기업 등은 100%입니다(제13조 제1항 단서). 소득 ${eokwon(income)}에 이월결손금 ${eokwon(loss)}이면 일반 법인은 과세표준 ${won(generalBase)}, 중소기업은 0원입니다.` },
  { q: "과세표준에 따라 법인세는 얼마인가요?", a: `2026년 시작 사업연도 기준으로 과세표준 ${eokwon(generalBase)}이면 ${won(corporateTax(generalBase))}, 2억원이면 ${won(corporateTax(200_000_000))}, 10억원이면 ${won(corporateTax(1_000_000_000))}입니다(제55조). 여기서 감면·세액공제·중간예납세액을 빼고 냅니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>소득 {eokwon(income)}, 이월결손금 {eokwon(loss)}</th><th>공제</th><th>과세표준</th><th>법인세</th></tr></thead>
    <tbody>
      <tr><th scope="row">일반 법인(80% 한도)</th><td>{won(income - generalBase)}</td><td>{won(generalBase)}</td><td>{won(corporateTax(generalBase))}</td></tr>
      <tr><th scope="row">중소기업(100%)</th><td>{won(income - smeBase)}</td><td>{won(smeBase)}</td><td>{won(corporateTax(smeBase))}</td></tr>
    </tbody>
  </table>
  <p>중소기업의 범위(조세특례제한법 제6조)는 이 글에서 확인하지 않았습니다. 다 빼지 못한 이월결손금은 남은 기간 안에서 다음 해로 넘어갑니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>사업연도가 1년 미만이면 12개월로 환산해 세율을 적용합니다(제55조 제2항) — <a href="/guide/corporate-tax-rate/">법인세율</a>.</p>
</GuideLayout>
