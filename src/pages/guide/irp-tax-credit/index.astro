---
/**
 * "IRP 세액공제" — 마흔아홉 번째 글(49번). IRP 세액공제 시리즈의 허브.
 *
 * 처음에는 한 편에 조건·한도·언제까지·이월·해지를 다 담았다. 사용자가 "자동완성
 * 키워드마다 글을 쓰라" 고 해서(2026-10-12) 키워드별 글 15편으로 나눴고, 이 글은
 * 머리말 `irp 세액공제` 를 받으면서 질문마다 짧은 답과 해당 글로 가는 길을 둔다.
 * 시리즈 목록은 src/data/series/irp-tax-credit.ts 한 곳에 있다.
 *
 * 구조: 한 줄 답 → 질문형 소제목 → 바로 아래 첫 답(qa-lead) → 자세히. FAQ 구조화
 * 데이터에 같은 문장이 들어간다(snippet-structure.test.ts).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import pa from "../../../rates/pension-account-2026.json";
import { won, manwon } from "../../../lib/won";
import { pensionCredit } from "../../../lib/pension-credit";
import { irpSeries, irpHref, IRP_WITH_SAVINGS } from "../../../data/series/irp-tax-credit";

const title = "IRP 세액공제 조건과 한도 — 12월 31일까지 넣어야 올해 몫입니다";
const description =
  "IRP 세액공제는 소득이 있는 사람이 12월 31일까지 넣은 돈에 대해 받습니다. 연금저축과 합쳐 900만원, 공제율 12~15%. 퇴직금이 들어온 몫은 빠지고, 못 받은 금액은 신청해야 다음 해로 넘어갑니다.";

const rows = [3_000_000, 6_000_000, 9_000_000].map((irp) => ({
  irp,
  low: pensionCredit({ savings: 0, irp }, true),
  high: pensionCredit({ savings: 0, irp }, false),
}));
const top = rows[2];

const ANSWER = `IRP 세액공제는 소득이 있는 사람이 그해 12월 31일까지 넣은 돈의 ${pa.creditRatePercentAboveThreshold}~${pa.creditRatePercentBelowThreshold}%를 세금에서 빼 주는 제도입니다. 연금저축과 합쳐 ${manwon(pa.combinedLimit)}까지라 최대 ${manwon(top.low.withLocal)}(지방소득세 포함)이 줄어듭니다.`;

const QA = [
  { q: "IRP 세액공제란 무엇인가요?", a: "IRP(개인형 퇴직연금)에 넣은 돈의 일정 비율을 그해 소득세에서 빼 주는 제도입니다. 소득세법 제59조의3의 연금계좌세액공제이고, 연금저축과 한도를 같이 씁니다." },
  { q: "IRP 세액공제 조건은 무엇인가요?", a: "종합소득이 있고, 내가 직접 넣은 돈이고, 그해 낼 세금이 있어야 합니다. 퇴직금으로 들어온 몫과 다른 연금계좌에서 옮겨 온 돈은 공제 대상이 아닙니다." },
  { q: "IRP 세액공제 한도는 얼마인가요?", a: `연금저축과 합쳐 연 ${manwon(pa.combinedLimit)}입니다. 연금저축은 그중 ${manwon(pa.savingsOnlyLimit)}까지만 셉니다. 계좌에는 연 ${manwon(pa.contributionRules.annualLimit)}까지 넣을 수 있지만 공제는 ${manwon(pa.combinedLimit)}에서 멈춥니다.` },
  { q: "IRP 세액공제 계산은 어떻게 하나요?", a: `공제 대상 금액에 ${pa.creditRatePercentBelowThreshold}%(종합소득금액 ${manwon(pa.incomeThreshold)} 이하) 또는 ${pa.creditRatePercentAboveThreshold}%를 곱하고 지방소득세 10%를 더합니다. ${manwon(9_000_000)}이면 ${manwon(top.low.withLocal)} 또는 ${manwon(top.high.withLocal)}입니다.` },
  { q: "IRP 세액공제 언제까지 넣어야 하나요?", a: "12월 31일까지입니다. 공제는 그해(1월 1일~12월 31일) 넣은 돈에 대해 받고, 지난해 몫을 올해 소급해 넣을 수는 없습니다." },
  { q: "IRP 세액공제 못 받은 금액은 이월되나요?", a: "자동으로는 안 되고 신청해야 넘어갑니다. 공제받지 않은 납입액을 올해 납입분으로 전환해 달라고 금융회사에 신청하면 신청한 날 넣은 것으로 봅니다(시행령 제118조의3)." },
  { q: "IRP 세액공제 받는 법은 무엇인가요?", a: "직장인은 연말정산 때 회사에, 사업소득자는 5월 종합소득세 신고 때 반영합니다. 놓쳤다면 법정신고기한부터 5년 안에 경정청구로 되찾을 수 있습니다." },
  { q: "IRP 세액공제 단점은 무엇인가요?", a: `돈이 묶입니다. ${pa.annuityRequirement.minAge}세 이후·가입 ${pa.annuityRequirement.minYearsSinceOpening}년이 지나야 연금으로 받을 수 있고, 그 전에 해지하면 공제받은 원금과 수익에 16.5%가 붙습니다.` },
];
const more: Record<number, string> = {
  1: "irp-tax-credit-eligibility",
  2: "irp-tax-credit-limit",
  3: "irp-tax-credit-calculator",
  4: "irp-tax-credit-deadline",
  5: "irp-tax-credit-carryover",
  6: "irp-tax-credit-how-to-claim",
  7: "irp-tax-credit-downsides",
};
const labelOf = (slug: string) => irpSeries.find((s) => s.slug === slug)?.label ?? slug;
---

<GuideLayout title={title} description={description} updated={pa.taxCreditVerifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  {QA.map((x, i) => (
    <>
      <h2>{x.q}</h2>
      <p class="qa-lead">{x.a}</p>
      {i === 3 && (
        <table>
          <thead>
            <tr><th>IRP 납입(연금저축 없음)</th><th>{pa.creditRatePercentBelowThreshold}% 구간</th><th>{pa.creditRatePercentAboveThreshold}% 구간</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr><th scope="row">{won(r.irp)}</th><td>{won(r.low.withLocal)}</td><td>{won(r.high.withLocal)}</td></tr>
            ))}
          </tbody>
        </table>
      )}
      {more[i] && (
        <p>자세히 — <a href={irpHref(more[i])}>{labelOf(more[i])}</a></p>
      )}
    </>
  ))}

  <AdSlot />

  <h2>IRP 세액공제, 질문별로 정리했습니다</h2>
  <p>검색창에 실제로 뜨는 질문마다 한 편씩 썼습니다.</p>
  <ul>
    {irpSeries.map((s) => (
      <li><a href={irpHref(s.slug)}>{s.label}</a></li>
    ))}
    <li><a href={irpHref(IRP_WITH_SAVINGS.slug)}>연금저축 IRP 세액공제 한도</a></li>
  </ul>
</GuideLayout>
