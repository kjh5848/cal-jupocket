---
/**
 * "예금 단리 복리 차이" — 예금 이자 시리즈. (단리 복리 확인 방법·월복리 계산도 이 글)
 * 단리·월복리 식은 상품 약정(법령 아님). 세금은 소득세법 제129조 ① 1호·지방세법 제103조의13. 금액은 depositInterest() 가 낸다(rates: deposit-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/deposit-2026.json";
import { depositInterest } from "../../../lib/deposit";
import { won } from "../../../lib/won";
import { depositSeries as S } from "../../../data/series/deposit";

const base = { principal: 100_000_000, ratePct: 3, months: 12, method: "simple", tax: "normal" } as const;
const terms = [12, 24, 36, 60].map((months) => {
  const s = depositInterest({ ...base, months });
  const m = depositInterest({ ...base, months, method: "monthly" });
  return { months, s, m };
});
const [y1, , y3, y5] = terms;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 deposit-interest-series.test.ts 가 대조한다.
const title = "예금 단리 복리 차이 — 단리는 원금에만, 월복리는 매달 붙은 이자에도 이자가 붙습니다";
const description =
  "예금 단리는 처음 넣은 원금에만 이자가 붙고, 월복리는 달마다 생긴 이자를 원금에 더해 다음 달 이자를 계산합니다. 같은 이율이면 기간이 길수록 월복리 이자가 더 많아지고, 차이는 세금을 뗀 뒤에도 남습니다. 상품이 어느 쪽인지 확인하는 방법도 정리했습니다.";

const ANSWER = `같은 1억원·연 3%라도 1년이면 단리 ${won(y1.s.grossInterest)}, 월복리 ${won(y1.m.grossInterest)}으로 ${won(y1.m.grossInterest - y1.s.grossInterest)} 차이이고, 5년이면 단리 ${won(y5.s.grossInterest)}, 월복리 ${won(y5.m.grossInterest)}으로 ${won(y5.m.grossInterest - y5.s.grossInterest)}까지 벌어집니다(세전).`;

const QA = [
  { q: "단리와 월복리는 계산이 어떻게 다른가요?", a: `단리는 원금 × 연 이자율 × 개월 ÷ 12로 끝입니다. 월복리는 연 이자율을 12로 나눈 월 이율로 매달 이자를 계산해 원금에 더하고, 다음 달에는 불어난 금액에 다시 월 이율을 곱합니다. 식으로는 원금 × {(1 + 연 이자율 ÷ 12)^개월 − 1}입니다.` },
  { q: "세금을 떼고 나면 차이가 얼마나 남나요?", a: `1억원·연 3%·3년이면 세후로 단리 ${won(y3.s.netInterest)}, 월복리 ${won(y3.m.netInterest)}입니다. 세금은 받는 이자에 같은 비율로 붙으니 세전 차이의 약 85%가 그대로 남습니다.` },
  { q: "내 예금이 단리인지 복리인지 어떻게 확인하나요?", a: `상품설명서나 약관의 '이자 계산 방법'·'이자 지급 방식' 칸을 보세요. 정기예금은 만기에 한 번에 받는 단리형이 많고, '월복리'라고 따로 적힌 상품만 매달 이자를 원금에 더합니다. 매달 이자를 받아 가는 '월이자 지급식'이면 원금에 더해지지 않으니 단리와 같습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>1억원 · 연 3%</th><th>단리(세전)</th><th>월복리(세전)</th><th>차이</th></tr></thead>
      <tbody>
        {terms.map((t) => <tr><th scope="row">{t.months}개월</th><td>{won(t.s.grossInterest)}</td><td>{won(t.m.grossInterest)}</td><td>{won(t.m.grossInterest - t.s.grossInterest)}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>세금은 이자의 14%(소득세)와 그 10%(지방소득세)를 각각 10원 미만 버리고 뗍니다 — 계산 순서는 <a href="/guide/deposit-interest/">예금 이자 계산</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>원금·이율·기간을 넣고 단리·월복리를 바꿔 보면 차이가 바로 나옵니다 — <a href="/guide/deposit-interest-calculator/">예금 이자 계산기</a>.</p>

  <h2>예금 이자 시리즈</h2>
  <ul>
    <li><a href={`/guide/${S.hub.slug}/`}>{S.hub.label}</a></li>
    {S.items.filter((i) => i.slug !== "deposit-simple-compound").map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
