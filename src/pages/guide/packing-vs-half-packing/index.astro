---
/**
 * "포장이사 반포장이사 차이" — 이사 시리즈. (포장이사 뜻·반포장이사 뜻·반포장이사란·일반이사 차이·반포장이사 준비도 이 글)
 * 숫자 없음 — 포장이사·반포장이사는 법령에 정의가 없는 업계 용어이고, 가격도 공식 출처가 없다. 고르는 기준(짐 양·시간·일손)만 쓰고 가격은 견적 비교로 넘긴다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import AffiliateBox from "../../../components/AffiliateBox.astro";

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts).
const title = "포장이사 반포장이사 차이 — 짐 싸기와 새 집 정리를 업체가 어디까지 하느냐의 차이이고, 짐 양·시간·일손으로 고릅니다";
const description =
  "포장이사는 짐 싸기부터 새 집 정리까지 업체가 맡고, 반포장이사는 포장·운반은 업체가 하되 정리 등 일부를 직접 하는 방식으로 흔히 나눕니다. 법에 정한 정의가 없어 업체마다 범위가 다르니 견적서에 포함 범위를 적어 받아 비교하세요.";

const ANSWER = `포장이사는 짐 싸기, 운반, 새 집에서 풀고 정리하기까지 업체가 맡는 방식이고, 반포장이사는 포장·운반은 업체가 하되 새 집 정리 같은 일부를 직접 하는 방식으로 흔히 나눕니다. 법에 정한 정의가 없어 업체마다 범위가 다르므로, 견적서에 무엇까지 해 주는지 적어 받아 비교하세요.`;

const QA = [
  { q: "포장이사와 반포장이사는 무엇이 다른가요?", a: `차이는 '누가 무엇을 하느냐'입니다. 포장이사는 짐 싸기·운반·새 집 배치와 정리를 업체가 다 하고, 반포장이사는 큰 짐 포장과 운반은 업체가 하되 잔짐 포장이나 새 집에서 풀고 정리하는 일을 직접 하는 경우가 많습니다. 운반 위주로 맡기고 포장은 직접 하면 흔히 일반이사라고 부릅니다.` },
  { q: "반포장이사는 어떤 경우에 맞나요?", a: `짐이 많지 않고, 이사 전후로 직접 싸고 풀 시간과 일손이 있을 때 맞습니다. 반대로 짐이 많거나, 맞벌이·육아로 시간이 없거나, 그릇·액자처럼 깨지기 쉬운 물건이 많으면 포장이사가 손이 덜 갑니다. 가격만 보고 고르면 남은 일을 누가 할지가 빠지기 쉽습니다.` },
  { q: "견적을 받을 때 무엇을 적어야 하나요?", a: `이삿날, 출발·도착 주소와 층수, 엘리베이터·사다리차 필요 여부, 큰 가구·가전 목록, 포장과 정리를 어디까지 맡길지, 짐 보관이 필요한지를 적습니다. 같은 내용을 여러 업체에 똑같이 보내야 포장 방식에 따른 차이를 제대로 비교할 수 있습니다.` },
  { q: "포장이사 비용은 얼마인가요?", a: `포장 방식별 이사 가격을 모은 공식 기준이나 통계가 없어 이 글에서는 금액을 적지 않습니다. 업체가 짐 양·거리·층수·날짜를 보고 견적으로 정하므로, 같은 조건으로 포장이사와 반포장이사 견적을 함께 받아 비교하는 것이 가장 정확합니다.` },
];

const rows = [
  { k: "짐 싸기", full: "업체", half: "큰 짐은 업체, 잔짐은 직접인 경우가 많음", basic: "직접" },
  { k: "운반·배치", full: "업체", half: "업체", basic: "업체" },
  { k: "새 집에서 풀고 정리", full: "업체", half: "직접인 경우가 많음", basic: "직접" },
  { k: "맞는 경우", full: "짐이 많고 시간·일손이 부족할 때", half: "짐이 적당하고 정리는 직접 할 수 있을 때", basic: "짐이 적고 포장을 직접 할 수 있을 때" },
];
---

<GuideLayout title={title} description={description} updated="2026-10-31" faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>아래 표는 흔히 쓰는 구분입니다. 업체마다 '반포장'에 넣는 일이 달라, 같은 이름이라도 견적서의 포함 항목으로 확인해야 합니다.</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>구분</th><th>포장이사</th><th>반포장이사</th><th>일반이사</th></tr></thead>
      <tbody>
        {rows.map((r) => <tr><th scope="row">{r.k}</th><td>{r.full}</td><td>{r.half}</td><td>{r.basic}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>날짜를 정할 때 손없는날을 따진다면 그날과 다른 날을 나란히 넣어 보세요 — 달마다 날짜는 <a href="/guide/moving-lucky-day/">손없는날</a>에 있습니다. 계약부터 전입신고까지 할 일은 <a href="/guide/moving-checklist/">이사 체크리스트</a>에 순서대로 정리했습니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <AffiliateBox id="moving-quote" />
</GuideLayout>
