---
/**
 * "산재 처리방법" — 산재 시리즈 허브. (산재보험·산재신청·산재처리 기준·산재 보상금·산재 불이익도 이 글)
 * 근거: 산재보험법 제36조·제37조·제40조·제41조·제52조·제57조·제111조의2·제112조·제116조, 소득세법 제12조 제3호 다목,
 * 근로기준법 제23조 제2항. rates: industrial-accident-2026.json
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/industrial-accident-2026.json";
import { industrialAccidentSeries as S } from "../../../data/series/industrial-accident";

const C = r.claim;
const pct = (v: number) => `${Number((v * 100).toFixed(1))}%`;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 industrial-accident-series.test.ts 가 rates 와 대조한다.
const title = "산재 처리방법 — 근로자가 근로복지공단에 직접 신청하고, 일 못 한 날은 평균임금 70%를 받습니다";
const description =
  "산재 처리방법은 근로자가 재해 경위와 의학적 소견을 적어 근로복지공단에 요양급여를 신청하는 것부터입니다. 3일 이내로 나으면 요양급여가 없고, 일하지 못한 기간이 3일을 넘으면 평균임금 70%의 휴업급여를 청구합니다. 신청을 이유로 한 해고·불이익은 금지입니다.";

const ANSWER = `산재 처리는 근로자가 소속 사업장, 재해 발생 경위, 의학적 소견을 적은 서류로 근로복지공단에 요양급여를 신청하면서 시작됩니다(산재보험법 제41조). 진료한 산재보험 의료기관이 근로자 동의를 받아 대신 신청할 수도 있습니다. 공단이 업무상 재해로 인정하면 치료비, 일하지 못한 기간의 휴업급여 등을 청구해 받습니다.`;

const QA = [
  { q: "산재 처리방법은 어떤 순서인가요?", a: `① 근로자가 공단에 요양급여 신청(병원 대행 가능) ② 공단이 업무상 재해인지 판단 ③ 인정되면 치료비는 요양급여로, 일하지 못한 기간은 휴업급여로 청구합니다. 보험급여는 청구해야 지급되고(제36조 제2항), 3일 이내 요양으로 나으면 요양급여를 주지 않습니다(제40조 제3항).` },
  { q: "산재처리 기준은 무엇인가요?", a: `업무상 사고(일하던 중, 회사 시설 결함, 회사 행사 중 등), 업무상 질병(유해 요인 노출, 직장 내 괴롭힘·고객 폭언으로 인한 정신질환 등), 출퇴근 재해가 업무상 재해입니다(제37조 제1항). 다만 업무와 재해 사이에 상당인과관계가 없거나 고의·자해·범죄행위로 생긴 경우는 제외됩니다.` },
  { q: "산재 신청하면 회사에서 불이익을 받나요?", a: `사업주는 근로자가 보험급여를 신청했다는 이유로 해고하거나 불이익한 처우를 할 수 없습니다(제111조의2). 업무상 부상·질병으로 요양하며 휴업한 기간과 그 후 30일 동안은 해고도 금지됩니다(근로기준법 제23조 제2항). 사업주는 근로자가 요구하면 필요한 증명을 해 줘야 합니다(제116조).` },
  { q: "산재 신청은 언제까지 해야 하나요?", a: `보험급여를 받을 권리는 ${C.limitationYears}년간 행사하지 않으면 시효로 소멸합니다. 장해급여·유족급여·장례비는 ${C.limitationLongYears}년입니다(제112조 제1항). 최초 청구로 시효가 중단되면 그 효력은 다른 보험급여에도 미칩니다(제113조).` },
  { q: "산재 보상금에도 세금이 붙나요?", a: `산재보험법에 따라 받는 요양급여·휴업급여·장해급여·간병급여·유족급여 등은 소득세 비과세입니다(소득세법 제12조 제3호 다목). 근로의 제공으로 인한 부상·질병·사망과 관련해 받는 배상·보상·위자료 성질의 급여도 같은 목에 들어 있습니다.` },
];

const KINDS = [
  ["요양급여", "업무상 부상·질병의 치료(진찰·약제·수술·입원·간병·이송 등)", "제40조"],
  ["휴업급여", `요양으로 일하지 못한 기간 1일 평균임금의 ${pct(r.leavePay.rate)}, 3일 이내면 없음`, "제52조"],
  ["장해급여", "치유 후 남은 장해, 등급별 평균임금 × 일수", "제57조, 별표 2"],
  ["간병급여", "치유 후에도 간병이 필요해 실제로 간병받는 사람", "제61조"],
  ["유족급여·장례비", "업무상 사망", "제36조 제1항"],
  ["상병보상연금·직업재활급여", "종류만 적음 — 지급 요건은 이 글에서 다루지 않았습니다", "제36조 제1항"],
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>보험급여</th><th>무엇을</th><th>근거</th></tr></thead>
    <tbody>{KINDS.map(([k, w, a]) => <tr><th scope="row">{k}</th><td>{w}</td><td>{a}</td></tr>)}</tbody>
  </table>
  <p>휴업급여 금액은 <a href="/guide/industrial-accident-leave-pay/">산재 휴업급여</a>에서 평균임금으로 계산할 수 있고, 장해가 남았을 때 받는 금액은 <a href="/guide/industrial-accident-disability/">산재 장해등급 보상금</a>에 있습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>출퇴근 재해는 회사가 제공한 통근버스 등 사업주의 지배관리 아래 이동한 경우와, 통상적인 경로·방법으로 출퇴근하던 중의 사고입니다. 경로를 벗어나거나 중단한 동안과 그 뒤의 사고는 제외되지만, 일상생활에 필요한 행위로 대통령령이 정한 사유면 출퇴근 재해로 봅니다(제37조 제3항). 업무상 질병은 공단의 업무상질병판정위원회가 심의합니다(제38조).</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>사업주의 행방불명 등으로 증명을 받을 수 없으면 생략할 수 있습니다(제116조 제3항). 근로자가 산재보험 급여를 받았거나 받을 수 있으면, 사업주는 같은 사유로 근로기준법의 재해보상 책임을 면합니다(제80조 제1항).</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>{QA[4].q}</h2>
  <p class="qa-lead">{QA[4].a}</p>

  <h2>쓰지 않은 것</h2>
  <ul>{r.notVerified.map((n) => <li>{n}</li>)}</ul>

  <h2>산재 시리즈</h2>
  <ul>{[S.hub, ...S.items].map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}</ul>
</GuideLayout>
