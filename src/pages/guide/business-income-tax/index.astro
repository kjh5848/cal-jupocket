---
/**
 * "사업소득세" — 소득세율·과세표준 시리즈. (사업소득세율·3.3%·프리랜서·계산·필요경비·5월 신고도 이 글)
 * 근거: 소득세법 제129조 제1항 제3호(원천징수 100분의 3), 제19조 제2항(총수입금액 − 필요경비), 제14조 제2항(종합 합산), 제55조(기본세율).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/income-tax-rate-2026.json";
import tr from "../../../rates/2026.json";
import { businessWithholding, basicTax } from "../../../lib/income-tax-rate";
import { won, eokwon } from "../../../lib/won";

const ex = businessWithholding(1_000_000);
const yearly = 30_000_000;
const pre = businessWithholding(yearly);
/** 경비율 두 가지로 본 결과 — 경비가 많을수록 과세표준이 줄어든다 */
const scenario = (expense: number) => {
  const base = Math.max(0, yearly - expense - tr.personalDeductionPerHead);
  const t = basicTax(base);
  return { expense, base, tax: Math.max(0, t.tax - tr.standardTaxCredit) };
};
const lowExp = scenario(6_000_000);
const highExp = scenario(18_000_000);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 income-tax-rate-series.test.ts 가 rates 와 대조한다.
const title = "사업소득세 — 3.3%는 미리 떼는 돈이고, 실제 세율은 5월에 6~45%로 정산됩니다";
const description =
  "사업소득세는 프리랜서 등에게 대가를 줄 때 3%와 지방소득세 0.3%를 미리 떼고, 다음 해 5월 종합소득세 신고 때 총수입금액에서 필요경비를 뺀 사업소득금액으로 기본세율 6~45%를 적용해 다시 계산합니다. 경비를 많이 인정받을수록 세금이 줄어듭니다.";

const ANSWER = `사업소득세는 대가를 줄 때 3%(지방소득세 포함 3.3%)를 미리 떼고(소득세법 제129조 제1항 제3호), 다음 해 5월 총수입금액 − 필요경비 = 사업소득금액으로 기본세율 6~45%를 적용해 다시 계산합니다(제19조·제55조). 100만원을 받으면 ${won(ex.total)}을 떼고 ${won(ex.net)}이 들어옵니다.`;

const QA = [
  { q: "사업소득세율은 3.3%인가요?", a: `3.3%는 원천징수세율 3%와 지방소득세 0.3%로, 미리 떼는 세금입니다. 최종 세금은 1년 사업소득금액에 종합소득세 기본세율(6~45%)을 적용해 5월에 정합니다. 미리 낸 것보다 적게 나오면 돌려받고, 많이 나오면 더 냅니다.` },
  { q: "사업소득세는 어떻게 계산하나요?", a: `① 총수입금액 − 필요경비 = 사업소득금액(제19조 제2항) ② 다른 종합소득과 합치고 ③ 인적공제 등을 빼 과세표준 ④ × 기본세율 ⑤ − 세액공제 순서입니다. 경비가 수입보다 크면 결손금이 됩니다. 장부가 없으면 업종별 경비율로 필요경비를 추계합니다.` },
  { q: "연 3천만원 버는 프리랜서 사업소득세는 얼마인가요?", a: `미리 떼인 금액은 ${won(pre.total)}입니다. 경비 ${eokwon(lowExp.expense)}만 인정되면 결정세액이 약 ${won(lowExp.tax)}, 경비 ${eokwon(highExp.expense)}이면 약 ${won(highExp.tax)}입니다(본인 공제·표준세액공제 7만원만, 지방소득세 별도). 차이는 5월에 정산됩니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>업종별 경비율은 <a href="/guide/expense-rate/">단순경비율</a>, 정산 구조는 <a href="/guide/33-settlement/">3.3%는 종합소득세에서 정산됩니다</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <table>
    <thead><tr><th>연 총수입 {eokwon(yearly)}</th><th>과세표준</th><th>결정세액</th><th>미리 뗀 소득세(3%)</th></tr></thead>
    <tbody>
      {[lowExp, highExp].map((s) => <tr><th scope="row">경비 {eokwon(s.expense)}</th><td>{won(s.base)}</td><td>{won(s.tax)}</td><td>{won(pre.tax)}</td></tr>)}
    </tbody>
  </table>
  <p>
    결정세액이 미리 뗀 소득세보다 적으면 그 차이를 돌려받습니다 — <a href="/income-tax-refund/">종소세 환급 예상 계산기</a>.
    3.3% 실수령액 계산은 <a href="/freelancer-33/">프리랜서 3.3% 계산기</a>에 있습니다.
  </p>
</GuideLayout>
