---
/**
 * "근로소득세율" — 소득세율·과세표준 시리즈. (연봉별 근로소득세·실효세율·몇프로·2026도 이 글)
 * 근거: 소득세법 제47조(근로소득공제)·제50조(기본공제)·제51조의3·제52조(보험료 공제)·제55조(기본세율)·제59조(근로소득세액공제)·
 * 제59조의4 제9항(표준세액공제 13만원). 계산: income-tax-rate.ts earnedTaxByPay() = four-insurance payroll() + year-end-calc yearEnd().
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/income-tax-rate-2026.json";
import y from "../../../rates/year-end-2026.json";
import { earnedTaxByPay } from "../../../lib/income-tax-rate";
import { won, eokwon } from "../../../lib/won";

const pays = [24_000_000, 30_000_000, 40_000_000, 50_000_000, 60_000_000, 80_000_000, 100_000_000, 150_000_000];
const rows = pays.map((p) => ({ p, x: earnedTaxByPay(p) }));
const ex = earnedTaxByPay(50_000_000);
const pctx = (v: number) => `${(v * 100).toFixed(2)}%`;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 income-tax-rate-series.test.ts 가 rates 와 대조한다.
const title = "근로소득세율 — 세율표는 6~45%지만 연봉 5천만원 1인 가구 실효세율은 약 5.85%";
const description =
  "근로소득세율은 종합소득세와 같은 기본세율 6~45%입니다. 다만 총급여에서 근로소득공제·인적공제·4대보험을 빼고 근로소득세액공제까지 받으므로 실제 부담은 훨씬 낮습니다. 다른 공제 없는 1인 가구라면 연봉 5천만원의 실효세율은 지방소득세 포함 약 5.85%입니다.";

const ANSWER = `근로소득세율은 기본세율 6~45%입니다(소득세법 제55조). 하지만 총급여에서 근로소득공제·인적공제·4대보험료를 빼고 근로소득세액공제·표준세액공제까지 받아, 다른 공제가 없는 1인 가구 연봉 5천만원은 1년 ${won(ex.total)}(지방소득세 포함, 실효 ${pctx(ex.effective)})입니다.`;

const QA = [
  { q: "근로소득세율은 몇 프로인가요?", a: `세율표 자체는 과세표준 1,400만원 이하 6%부터 10억원 초과 45%까지 8단계로 종합소득세와 같습니다. 근로자는 과세표준에 이 세율을 곱한 산출세액에서 근로소득세액공제(산출세액 130만원까지 55%, 넘는 부분 30%, 총급여별 한도)를 뺍니다(제59조).` },
  { q: "연봉별 근로소득세는 얼마인가요?", a: `1인 가구, 4대보험 외 공제 없음, 표준세액공제 13만원을 가정하면 연봉 3천만원 ${won(rows[1].x.total)}, 5천만원 ${won(rows[3].x.total)}, 1억원 ${won(rows[6].x.total)}(지방소득세 포함, 1년)입니다. 부양가족·카드·의료비 공제가 있으면 더 내려갑니다.` },
  { q: "근로소득세 실효세율은 왜 낮나요?", a: `과세표준이 총급여보다 훨씬 작기 때문입니다. 연봉 5천만원이면 근로소득공제 ${won(ex.earnedDeduction)}, 본인 기본공제 ${won(y.calc.basicDeductionPerHead.amount)}, 국민연금·건강·고용보험료를 빼 과세표준이 ${won(ex.base)}이고, 산출세액 ${won(ex.computedTax)}에서 근로소득세액공제 ${won(ex.earnedCredit)}을 또 뺍니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>연봉(총급여)</th><th>과세표준</th><th>결정세액</th><th>지방세 포함</th><th>월 평균</th><th>실효세율</th></tr></thead>
      <tbody>{rows.map(({ p, x }) => <tr><th scope="row">{eokwon(p)}</th><td>{won(x.base)}</td><td>{won(x.decided)}</td><td>{won(x.total)}</td><td>{won(x.monthly)}</td><td>{pctx(x.effective)}</td></tr>)}</tbody>
    </table>
  </div>
  <p>
    4대보험은 연봉 ÷ 12를 월급으로 보고 2026년 요율로 계산했습니다 — <a href="/guide/four-insurance-calculator/">4대보험 계산기</a>.
    실제 매달 떼는 금액은 간이세액표라 이 월 평균과 다를 수 있습니다.
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    내 공제를 넣어 보려면 <a href="/guide/year-end-calculator/">연말정산 계산기</a>, 세율표는{" "}
    <a href="/guide/income-tax-brackets/">소득세율표</a>에 있습니다.
  </p>
</GuideLayout>
