---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import rates from "../../../rates/2026.json";
import { round1 } from "../../../lib/rate-display";
import { estimateRefund } from "../../../lib/income-tax";

const title = "종합소득세 세율 구간(2026), 왜 이렇게 나올까";
const description =
  "종합소득세는 누진세율표로 계산됩니다. 2026년 8단계 세율·누진공제표를 정리하고, 소득이 많아지면 실효세율이 3.3%보다 훨씬 높아질 수 있는 이유를 설명합니다.";

const businessRatePercent = round1(rates.withholding.business * 100); // 3.3

// rates/2026.json의 incomeTaxBrackets 배열을 그대로 순회해 표를 만든다.
// 값(구간 경계·세율·누진공제)은 전부 JSON에서 가져오고, 하드코딩하지 않는다.
const bracketRows = rates.incomeTaxBrackets.map((bracket, i) => {
  const prevUpTo = i > 0 ? rates.incomeTaxBrackets[i - 1].upTo : null;
  const rangeLabel =
    prevUpTo === null
      ? `${(bracket.upTo as number).toLocaleString("ko-KR")}원 이하`
      : bracket.upTo === null
        ? `${prevUpTo.toLocaleString("ko-KR")}원 초과`
        : `${prevUpTo.toLocaleString("ko-KR")}원 초과 ${bracket.upTo.toLocaleString(
            "ko-KR",
          )}원 이하`;
  return {
    rangeLabel,
    ratePercent: round1(bracket.rate * 100),
    deductionLabel: `${bracket.deduction.toLocaleString("ko-KR")}원`,
  };
});

// 계산 원리 예시 — 과세표준 하나를 정해 어느 구간에 속하는지, 세액이 어떻게
// 나오는지 직접 계산해 보여준다. 세율·누진공제는 여기서도 JSON에서 찾는다.
const exampleTaxableBase = 78500000;
const exampleBracket = rates.incomeTaxBrackets.find(
  (bracket) => bracket.upTo === null || exampleTaxableBase <= bracket.upTo,
)!;
const exampleRatePercent = round1(exampleBracket.rate * 100);
const exampleComputedTax =
  Math.round(exampleTaxableBase * exampleBracket.rate) -
  exampleBracket.deduction;

// 반전 인사이트 예시 — 계산기와 동일한 estimateRefund()를 그대로 재사용해
// "총수입은 크지만 인정받는 경비가 적은" 경우 실효세율이 얼마나 뛰는지 보여준다.
const insightGrossIncome = 100000000;
const insight = estimateRefund({
  grossIncome: insightGrossIncome,
  expenseRate: 0.2,
  dependents: 1,
});
const insightEffectiveRatePercent = round1(
  (insight.computedTax / insightGrossIncome) * 100,
);
const insightExtraPayment = -insight.refund; // refund가 음수면 추가납부액
---

<GuideLayout title={title} description={description} updated="2026-08-21">
      <h1>{title}</h1>

      <div class="callout">
        <p>
          "나는 {businessRatePercent}%만 떼였으니 세율이 낮은 사람"이라고
          생각하기 쉽지만, 종합소득세 신고 때 실제로 적용되는 건 이{" "}
          {businessRatePercent}%가 아니라 <strong>과세표준 구간별로 다른
          누진세율표</strong>입니다. 소득이 많아질수록 이 표 때문에 실제
          세율이 크게 달라집니다.
        </p>
      </div>

      <p>
        <a href="/guide/33-settlement/"
          >지난 글</a
        >에서 {businessRatePercent}% 원천징수는 예납일 뿐이고 실제 세액은
        다음 해 5월 신고로 정산된다는 점을 살펴봤습니다. 이번 글은 그 실제
        세액이 <strong>어떤 계산 방식</strong>으로 나오는지, 왜 소득이
        많아지면 예납액보다 훨씬 많이 낼 수 있는지를 다룹니다.
      </p>

      <h2>누진세율이란 무엇인가</h2>
      <p>
        누진세율은 소득 전체에 하나의 세율을 곱하는 방식이 아닙니다.{" "}
        <strong>과세표준을 구간으로 나누고, 각 구간을 넘어가는 부분에만 그
        구간의 세율을 적용</strong>합니다. 예를 들어 과세표준이 6천만원이면
        6천만원 전부에 24%를 곱하는 게 아니라, 1,400만원까지는 6%,
        1,400만원 초과~5,000만원까지는 15%, 나머지 5,000만원 초과분만
        24%가 적용되는 식입니다.
      </p>
      <p>
        이걸 매번 구간별로 나눠 계산하면 번거로우므로, 실무에서는{" "}
        <strong>"과세표준 × 해당 구간 세율 − 누진공제액"</strong> 한 번의
        계산으로 같은 결과를 냅니다. 아래 표의 누진공제액은 그렇게
        구간별로 나눠 계산한 값과 똑같아지도록 미리 빼둔 보정값입니다.
      </p>

      <h2>2026년 종합소득세 누진세율표</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>과세표준</th>
              <th>세율</th>
              <th>누진공제</th>
            </tr>
          </thead>
          <tbody>
            {
              bracketRows.map((row) => (
                <tr>
                  <td>{row.rangeLabel}</td>
                  <td>{row.ratePercent}%</td>
                  <td>{row.deductionLabel}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p>
        예를 들어 과세표준이 {exampleTaxableBase.toLocaleString("ko-KR")}원이면
        위 표에서 세율 {exampleRatePercent}% 구간에 속합니다. 계산은{" "}
        {exampleTaxableBase.toLocaleString("ko-KR")}원 × {exampleRatePercent}% −{" "}
        {exampleBracket.deduction.toLocaleString("ko-KR")}원(누진공제) ={" "}
        <strong>{exampleComputedTax.toLocaleString("ko-KR")}원</strong>이
        됩니다(세액공제 반영 전 산출세액 기준).
      </p>

      <div class="ad-slot" data-ad="guide-income-tax-brackets-mid"></div>

      <h2>반전: 소득이 많으면 실효세율이 {businessRatePercent}%를 훌쩍 넘습니다</h2>
      <p>
        원천징수 {businessRatePercent}%는 소득 규모나 경비율과 무관하게
        총수입에 일률적으로 적용되는 숫자입니다. 하지만 위 누진세율표는
        소득이 많아질수록, 그리고 필요경비로 인정받는 금액이 적을수록{" "}
        <strong>더 높은 세율 구간</strong>으로 올라갑니다. 그 결과 실제로
        낸 세금을 총수입으로 나눈 <strong>실효세율</strong>이{" "}
        {businessRatePercent}%보다 훨씬 높아질 수 있습니다.
      </p>

      <div class="callout warn">
        <p>
          ⚠️ 총수입 {insightGrossIncome.toLocaleString("ko-KR")}원인 프리랜서가{" "}
          <a href="/guide/expense-rate/">업종 단순경비율</a> 20%만
          인정받는다고 가정하면(인적공제 1명 기준),
          결정세액은 {insight.computedTax.toLocaleString("ko-KR")}원입니다.
          총수입 대비 <strong>실효세율 약 {insightEffectiveRatePercent}%</strong>로,{" "}
          {businessRatePercent}%로 예납한 {insight.prepaid.toLocaleString(
            "ko-KR",
          )}원보다 <strong>{insightExtraPayment.toLocaleString(
            "ko-KR",
          )}원을 추가로 납부</strong>해야 하는 경우입니다. 지방소득세(결정세액의
          10%)까지 더하면 실제 부담은 이보다 더 커집니다. "{businessRatePercent}%
          떼였으니 세금은 다 냈다"는 가정이 소득이 클수록 위험해지는
          이유입니다.
        </p>
      </div>

      <p>
        내 과세표준이 어느 구간에 해당하는지, 실효세율이 얼마나 될지는
        총수입과 경비율에 따라 다릅니다. 직접 숫자를 넣어{" "}
        <a href="/income-tax-refund/"
          ><strong>종소세 환급 예상 계산기</strong></a
        >로 확인해볼 수 있습니다.{" "}
        <a href="/guide/33-settlement/"
          >{businessRatePercent}% 예납과 정산의 관계</a
        >를 아직 안 보셨다면 함께 읽어보시길 권합니다.
      </p>

      <p class="actions">
        <a class="btn" href="/income-tax-refund/"
          >내 과세표준 구간·실효세율 계산하기</a
        >
      </p>

      <div class="ad-slot" data-ad="guide-income-tax-brackets-bottom"></div>
</GuideLayout>
