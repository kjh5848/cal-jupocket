---
/**
 * "소득세율표" — 소득세율·과세표준 시리즈 허브(링크허브 8번, 같은 주소를 시리즈 구조로 고쳐 썼다).
 * (종합소득세 세율 구간·누진세율·누진공제·2026·3.3%와의 차이도 이 글)
 * 근거: 소득세법 제55조 제1항(표 — img alt 로 rates/2026.json 과 대조), 제14조(과세표준), 제129조 제1항(원천징수세율).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/income-tax-rate-2026.json";
import tr from "../../../rates/2026.json";
import { basicTax } from "../../../lib/income-tax-rate";
import { estimateRefund } from "../../../lib/income-tax";
import { won, eokwon } from "../../../lib/won";
import { incomeTaxRateSeries as S } from "../../../data/series/income-tax-rate";

const B = tr.incomeTaxBrackets;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const label = (i: number) => (B[i].upTo === null ? `${eokwon(B[i - 1].upTo!)} 초과` : i === 0 ? `${eokwon(B[i].upTo!)} 이하` : `${eokwon(B[i - 1].upTo!)} 초과 ${eokwon(B[i].upTo!)} 이하`);
const ex = basicTax(60_000_000);
const insight = estimateRefund({ grossIncome: 100_000_000, expenseRate: 0.2, dependents: 1 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 income-tax-rate-series.test.ts 가 rates 와 대조한다.
const title = "소득세율표 — 2026년 과세표준 1,400만원 이하 6%부터 10억원 초과 45%까지 8단계";
const description =
  "소득세율표는 과세표준을 8개 구간으로 나눠 1,400만원 이하 6%부터 10억원 초과 45%까지 매깁니다. 초과분에만 그 구간 세율을 곱하는 누진세율이라 과세표준 6천만원이면 6천만원 전부에 24%를 곱하지 않습니다. 근로·사업·기타소득을 합친 종합소득에 같은 표를 씁니다.";

const ANSWER = `소득세율표는 과세표준 ${eokwon(B[0].upTo!)} 이하 ${pct(B[0].rate)}부터 ${eokwon(B[6].upTo!)} 초과 ${pct(B[7].rate)}까지 8단계입니다(소득세법 제55조 제1항). 초과분에만 그 구간 세율을 곱하는 누진세율이라, 과세표준 6천만원이면 세금은 ${won(ex.tax)}(평균 ${(ex.average * 100).toFixed(1)}%)입니다.`;

const QA = [
  { q: "2026년 소득세율표는 어떻게 되나요?", a: `과세표준 1,400만원 이하 6%, 5,000만원 이하 15%, 8,800만원 이하 24%, 1억5천만원 이하 35%, 3억원 이하 38%, 5억원 이하 40%, 10억원 이하 42%, 10억원 초과 45%입니다(제55조 제1항). 지방소득세가 그 10분의 1만큼 더 붙습니다.` },
  { q: "누진세율은 어떻게 계산하나요?", a: `과세표준 전체에 한 세율을 곱하지 않고 구간을 넘는 부분에만 그 구간 세율을 곱합니다. 과세표준 6천만원이면 1,400만원까지 6%, 5,000만원까지 15%, 나머지 1,000만원만 24%라 ${won(ex.tax)}입니다. '과세표준 × 세율 − 누진공제'로 계산해도 같습니다.` },
  { q: "3.3% 떼였는데 세율표와 무슨 관계인가요?", a: `3.3%는 사업소득을 받을 때 미리 떼는 원천징수세율(제129조 제1항 제3호, 지방세 포함)이고 최종 세율이 아닙니다. 다음 해 5월 종합소득세 신고 때 이 세율표로 다시 계산해 덜 냈으면 더 내고 많이 냈으면 돌려받습니다.` },
  { q: "근로소득세율도 같은 표인가요?", a: `같습니다. 근로소득도 근로소득공제와 인적공제 등을 뺀 과세표준에 이 기본세율을 적용합니다. 다만 매달은 간이세액표로 떼고 연말정산으로 맞추며, 근로소득세액공제가 있어 실제 부담은 표의 세율보다 훨씬 낮습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>과세표준</th><th>세율</th><th>누진공제</th><th>구간 끝 세액</th></tr></thead>
      <tbody>{B.map((b, i) => <tr><th scope="row">{label(i)}</th><td>{pct(b.rate)}</td><td>{b.deduction ? won(b.deduction) : "없음"}</td><td>{b.upTo ? won(basicTax(b.upTo).tax) : "—"}</td></tr>)}</tbody>
    </table>
  </div>
  <p>'구간 끝 세액'은 조문 표에 적힌 기본세액(84만원·624만원·1,536만원 …)과 같습니다 — 국가법령정보센터 원문 표와 대조했습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    총수입 {eokwon(100_000_000)}인 프리랜서가 단순경비율 20%만 인정받고 인적공제 1명이면 결정세액(표준세액공제 반영)이 {won(insight.computedTax)}이고
    총수입의 약 {((insight.computedTax / 100_000_000) * 100).toFixed(1)}%입니다. 3.3%로 미리 낸 돈보다 많아 5월에 더 냅니다 —{" "}
    <a href="/guide/33-settlement/">3.3%는 종합소득세에서 정산됩니다</a>, <a href="/income-tax-refund/">종소세 환급 예상 계산기</a>.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    퇴직금도 같은 기본세율을 쓰지만 근속연수로 나눠 12배로 환산한 과세표준에 곱하고 다시 근속연수만큼으로 되돌려, 같은 금액이라도 실효세율이 훨씬 낮습니다 —{" "}
    <a href="/guide/severance-tax/">퇴직금 세금 계산 방법</a>.
    집·땅을 2년 이상 갖고 있다 팔 때도 이 6~45% 기본세율을 쓰지만 근로·사업소득과 합치지 않고 따로 계산합니다(소득세법 제104조) —{" "}
    <a href="/guide/capital-gains-tax/">양도소득세 계산 방법</a>.
    직장인이 연말정산에서 받는 공제 가운데 인적공제·보험료·신용카드는 과세표준을 줄여 이 표의 세율만큼만 효과가 나고, 근로소득·연금계좌·월세 공제는 세금에서 바로 빠집니다 —{" "}
    <a href="/guide/year-end-income-deduction/">연말정산 소득공제와 세액공제 차이</a>.
  </p>

  <h2>소득세율·과세표준 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
