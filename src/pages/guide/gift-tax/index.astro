---
/**
 * "증여세 면제한도" — 상속세(26번 글)의 옆자리.
 *
 * 자동완성 135개를 묶어 세어 보면 축이 갈린다. 면제한도 16 · 신고기한 16 ·
 * 신고방법 16 · 세율 16 · 기준 15. 그중 이 글이 답하는 것은 앞의 둘이다.
 *
 * 흥미로운 것은 신고기한 묶음 안에 **"증여세 신고기한 3개월"과 "증여세
 * 신고기한 6개월"이 나란히** 잡힌다는 점이다. 상속세가 6개월이라 헷갈리는
 * 것이고, 그 혼동이 이 글의 존재 이유이기도 하다.
 *
 * 26번 글과 겹치지 않게 척추를 증여 쪽에 둔다 — 공제가 10년마다 다시
 * 생긴다는 것, 부모가 준 것은 합산된다는 것, 기한이 3개월이라는 것.
 * 상속세는 비교 기준점으로만 나온다.
 *
 * 금액은 전부 lib/gift.ts 로 뽑는다. 본문에 손으로 적은 값이 없다.
 * 출처: rates/gift-2026.json (국세청 증여세 안내 + 조문 원문, 2026-09-16 확인)
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/gift-2026.json";
import {
  computeGift,
  taxFreeCeiling,
  taxOn,
  relationCap,
  type Relation,
} from "../../../lib/gift";
import { formatWon, formatMan } from "../../../lib/money";

const title = "증여세 면제한도, 10년마다 다시 생깁니다";
const description =
  "증여세 면제한도는 배우자 6억, 자녀 5천만원입니다. 한 번 쓰면 끝이 아니라 10년이 지나면 다시 생기고, 결혼이나 출산이면 1억이 더 붙습니다. 관계별 금액과 신고기한 3개월을 국세청 기준으로 정리했습니다.";

const 억 = 100_000_000;
const pct = (v: number) => Math.round(v * 100);

/** 관계별 "여기까지는 0원" 경계. 이 글의 뼈대다. */
const rows: Relation[] = [
  "spouse",
  "ascendant",
  "descendant",
  "relative",
  "other",
];
const ceilings = rows.map((relation) => ({
  relation,
  item: r.relationDeduction.items.find((i) => i.key === relation)!,
  ceiling: taxFreeCeiling(relation),
}));

const ASCENDANT_CAP = relationCap("ascendant");
const MINOR_CAP = relationCap("ascendant", true);
const MB = r.marriageBirthDeduction.amount;
const MB_CEILING = taxFreeCeiling("ascendant", { marriageBirth: true });

/** 부모가 자녀에게 주는 사다리 — 자동완성에 붙어 나온 금액 그대로. */
const ladder = [1, 2, 3, 4, 5, 10].map((n) => {
  const amount = n * 억;
  const plain = computeGift({ amount, relation: "ascendant" });
  const wedding = computeGift({
    amount,
    relation: "ascendant",
    marriageBirth: MB,
  });
  return { n, amount, plain, wedding, gap: plain.payable - wedding.payable };
});

/** 10년을 나눠 주면 어떻게 달라지나 — 한 번에 1억 vs 5천 + 10년 뒤 5천. */
const ONCE = computeGift({ amount: 억, relation: "ascendant" });
const SPLIT_EACH = computeGift({ amount: ASCENDANT_CAP, relation: "ascendant" });

/** 한도를 이미 쓴 뒤에 또 받으면 — 첫 원이 바로 과세된다. */
const REUSED = computeGift({
  amount: ASCENDANT_CAP,
  relation: "ascendant",
  usedWithin10y: ASCENDANT_CAP,
});

const srcNts = r.sources.find((s) => s.label.includes("항목별"))!;
const srcDeadline = r.sources.find((s) => s.label.includes("유의사항"))!;
const srcFlow = r.sources.find((s) => s.label.includes("흐름도"))!;
const srcLaw = r.sources.find((s) => s.label.includes("법령 원문"))!;
---

<GuideLayout title={title} description={description} updated={r.verifiedOn}>
  <h1>{title}</h1>

  <div class="callout">
    <p>
      부모님이 전세금을 보태 주시거나 결혼할 때 목돈을 받게 되면 가장 먼저
      걸리는 것이 <strong>“이거 신고해야 하나”</strong>입니다. 자녀가 부모에게
      받을 때는 <strong>{formatMan(ASCENDANT_CAP)}까지 세금이 0원</strong>입니다.
      그런데 이 금액은 한 번 쓰면 사라지는 것이 아니라{" "}
      <strong>{r.relationDeduction.windowYears}년이 지나면 다시 생깁니다.</strong>
    </p>
    <p>
      검색할 때 흔히 쓰는 <strong>“면제한도”</strong>가 세법의{" "}
      <strong>증여재산공제</strong>를 가리킵니다. 법에 면제한도라는 항목은
      따로 없지만 찾으시는 그 금액이 맞습니다. 아래에서는 법에 적힌 대로
      “공제”라고 부릅니다.
    </p>
  </div>

  <h2>증여세 면제한도, 누구에게 얼마인가요?</h2>
  <p>
    준 사람이 나에게 어떤 관계인지로 갈립니다. 이 금액까지는 세금이 0원입니다.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>준 사람</th>
          <th>{r.relationDeduction.windowYears}년간 0원</th>
          <th>비고</th>
        </tr>
      </thead>
      <tbody>
        {
          ceilings.map(({ relation, item, ceiling }) => (
            <tr>
              <td>{item.label}</td>
              <td>
                <strong>{ceiling === 0 ? "없음" : formatMan(ceiling)}</strong>
              </td>
              <td>
                {relation === "ascendant"
                  ? `받는 사람이 미성년자면 ${formatMan(MINOR_CAP)}`
                  : relation === "relative"
                    ? "형제자매·삼촌·며느리·사위가 여기입니다"
                    : relation === "other"
                      ? "친구·이웃 등. 받은 금액 전부가 과세표준입니다"
                      : relation === "spouse"
                        ? "혼인신고를 한 배우자만. 사실혼은 제외됩니다"
                        : "자녀가 부모에게 줄 때도 같습니다"}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p>
    표에서 자주 놓치는 칸이 <strong>기타 친족</strong>입니다. 형제자매에게
    받는 돈은 {formatMan(relationCap("relative"))}까지만 공제됩니다 —
    부모에게 받을 때의 {Math.round(ASCENDANT_CAP / relationCap("relative"))}분의
    1입니다. 며느리·사위도 직계비속이 아니라 여기에 들어갑니다.
  </p>

  <AdSlot label="guide-gift-tax-mid" />

  <h2>왜 여기저기 “10년”이 붙나요?</h2>
  <p>
    증여세에서 10년은 두 군데에 나옵니다. 둘은 다른 규칙인데 자주 섞입니다.
  </p>
  <ol>
    <li>
      <strong>공제 한도가 {r.relationDeduction.windowYears}년 합산입니다.</strong>{" "}
      이번에 공제받을 금액과 그 전 10년 안에 공제받은 금액을 합해 한도를
      넘는 부분은 공제하지 않습니다
    </li>
    <li>
      <strong>이전 증여가 과세가액에 다시 더해집니다.</strong> 증여일 전 10년
      이내에 같은 사람에게 받은 금액의 합이{" "}
      {formatMan(r.priorGiftAggregation.threshold)} 이상이면 그 금액을 이번
      과세가액에 가산합니다
    </li>
  </ol>
  <p>
    두 번째에 함정이 하나 있습니다. <strong>아버지와 어머니는 한 사람으로
    봅니다.</strong> 증여자가 직계존속이면 그 배우자를 동일인에 포함하기
    때문입니다. 아버지에게 {formatMan(30_000_000)}, 어머니에게{" "}
    {formatMan(30_000_000)}을 따로 받아도 합쳐서{" "}
    {formatMan(60_000_000)}으로 계산합니다.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>부모가 자녀에게</th>
          <th>과세표준</th>
          <th>낼 세금</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{formatMan(ASCENDANT_CAP)} (첫 증여)</td>
          <td>{formatWon(SPLIT_EACH.base)}</td>
          <td><strong>{formatWon(SPLIT_EACH.payable)}</strong></td>
        </tr>
        <tr>
          <td>{formatMan(ASCENDANT_CAP)} (10년 안에 또)</td>
          <td>{formatWon(REUSED.base)}</td>
          <td><strong>{formatWon(REUSED.payable)}</strong></td>
        </tr>
        <tr>
          <td>{formatMan(ASCENDANT_CAP)} (10년 지나서 또)</td>
          <td>{formatWon(SPLIT_EACH.base)}</td>
          <td><strong>{formatWon(SPLIT_EACH.payable)}</strong></td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    같은 {formatMan(ASCENDANT_CAP)}인데 두 번째 줄만 세금이 붙습니다.
    한 번에 {formatMan(억)}을 주면 {formatWon(ONCE.payable)}이지만, 10년을
    띄워 {formatMan(ASCENDANT_CAP)}씩 두 번이면 양쪽 다 0원입니다.
  </p>

  <h2>결혼하거나 아이를 낳으면 {formatMan(MB)}이 더 붙습니다</h2>
  <p>
    {r.marriageBirthDeduction.article.replace("상속세 및 증여세법 ", "")}가
    따로 두는 공제입니다. <strong>직계존속에게 받을 때만</strong> 적용되고,
    위의 {formatMan(ASCENDANT_CAP)}과 <strong>별개로</strong> 붙습니다.
    그래서 경계가 {formatMan(MB_CEILING)}이 됩니다.
  </p>
  <ul>
    <li>
      <strong>혼인</strong> — 혼인관계증명서상 신고일{" "}
      <strong>전후 {r.marriageBirthDeduction.marriageWindowYears}년</strong> 이내.
      결혼 전에 받아도 됩니다
    </li>
    <li>
      <strong>출산·입양</strong> — 출생신고서상 출생일 또는 입양신고일부터{" "}
      <strong>{r.marriageBirthDeduction.birthWindowYears}년</strong> 이내
    </li>
    <li>
      <strong>둘을 합해 {formatMan(r.marriageBirthDeduction.combinedCap)}이
      한도입니다.</strong> 결혼할 때 {formatMan(MB)}을 다 받았다면 나중에
      아이를 낳아도 이 공제는 남아 있지 않습니다
    </li>
  </ul>
  <p>
    혼인 전에 공제받고 증여일부터{" "}
    {r.marriageBirthDeduction.marriageWindowYears}년 안에 결혼하지 않으면
    되돌려야 합니다. 2년이 되는 날이 속하는 달의 말일부터 3개월 안에
    수정신고나 기한 후 신고를 하면 가산세는 면제되지만{" "}
    <strong>이자상당액은 붙습니다.</strong>
  </p>

  <h2>자녀에게 {formatMan(억)}을 주면 세금이 얼마인가요?</h2>
  <p>
    부모가 성년 자녀에게 줄 때입니다. 오른쪽은 결혼·출산{" "}
    {formatMan(MB)} 공제를 함께 받는 경우입니다.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>받는 금액</th>
          <th>기본 ({formatMan(ASCENDANT_CAP)} 공제)</th>
          <th>결혼·출산이면</th>
          <th>차이</th>
        </tr>
      </thead>
      <tbody>
        {
          ladder.map((row) => (
            <tr>
              <td>{formatMan(row.amount)}</td>
              <td>
                <strong>{formatWon(row.plain.payable)}</strong>
              </td>
              <td>{formatWon(row.wedding.payable)}</td>
              <td>{row.gap === 0 ? "—" : formatWon(row.gap)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    신고기한 안에 신고하면 붙는 <strong>신고세액공제{" "}
    {pct(r.filingCredit.rate)}%</strong>를 이미 뺀 금액입니다.{" "}
    {formatMan(ladder[5].amount)}을 받는 경우로 보면 산출세액{" "}
    {formatWon(ladder[5].plain.computed)}에서{" "}
    {formatWon(ladder[5].plain.filingCredit)}을 깎아{" "}
    {formatWon(ladder[5].plain.payable)}입니다. 신고를 안 하면 이 공제부터
    사라집니다.
  </p>

  <h2>세율은 상속세와 똑같습니다</h2>
  <p>
    증여세 세율을 따로 정해 둔 조문이 없습니다.{" "}
    {r.bracketsArticle.replace("상속세 및 증여세법 ", "")} — 증여세는
    과세표준에 <strong>상속세 세율</strong>을 적용해 계산합니다. 그래서 두
    세금의 차이는 세율이 아니라 <strong>공제와 기한</strong>에서 나옵니다.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>과세표준</th>
          <th>세율</th>
          <th>누진공제</th>
          <th>산출세액</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{formatMan(억)} 이하</td>
          <td>{pct(r.brackets[0].rate)}%</td>
          <td>—</td>
          <td>{formatWon(taxOn(억))}</td>
        </tr>
        <tr>
          <td>{formatMan(5 * 억)} 이하</td>
          <td>{pct(r.brackets[1].rate)}%</td>
          <td>{formatMan(r.brackets[1].deduction)}</td>
          <td>{formatWon(taxOn(5 * 억))}</td>
        </tr>
        <tr>
          <td>{formatMan(10 * 억)} 이하</td>
          <td>{pct(r.brackets[2].rate)}%</td>
          <td>{formatMan(r.brackets[2].deduction)}</td>
          <td>{formatWon(taxOn(10 * 억))}</td>
        </tr>
        <tr>
          <td>{formatMan(30 * 억)} 이하</td>
          <td>{pct(r.brackets[3].rate)}%</td>
          <td>{formatMan(r.brackets[3].deduction)}</td>
          <td>{formatWon(taxOn(30 * 억))}</td>
        </tr>
        <tr>
          <td>{formatMan(30 * 억)} 초과</td>
          <td>{pct(r.brackets[4].rate)}%</td>
          <td>{formatMan(r.brackets[4].deduction)}</td>
          <td>—</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    같은 세율표를 상속세 쪽에서 보시려면{" "}
    <a href="/guide/inheritance-tax/">상속세 면제한도</a>에 가족 구성별
    경계를 정리해 뒀습니다.
  </p>

  <h2>신고기한은 {r.deadline.months}개월입니다 — 6개월이 아닙니다</h2>
  <p>
    <strong>{r.deadline.from}부터 {r.deadline.months}개월</strong> 이내입니다.
    상속세가 6개월이라 헷갈리기 쉬운데 증여세는 절반입니다.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th></th>
          <th>증여세</th>
          <th>상속세</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>기한</td>
          <td><strong>{r.deadline.months}개월</strong></td>
          <td>6개월</td>
        </tr>
        <tr>
          <td>세는 시작점</td>
          <td>증여받은 날이 속하는 달의 말일</td>
          <td>상속개시일이 속하는 달의 말일</td>
        </tr>
        <tr>
          <td>세율</td>
          <td colspan="2">같습니다 (10~50% 5단계)</td>
        </tr>
        <tr>
          <td>신고세액공제</td>
          <td colspan="2">{pct(r.filingCredit.rate)}%로 같습니다</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    예를 들어 6월 10일에 받았다면 6월 30일부터 세어 9월 30일이 기한입니다.
    그날이 토요일·공휴일·근로자의 날이면 그 다음날까지입니다.
  </p>
  <p>
    넘기면 <strong>신고세액공제 {pct(r.filingCredit.rate)}%가 먼저
    사라지고</strong> 무신고가산세가 붙습니다. 그 계산은{" "}
    <a href="/guide/late-filing-penalty/">신고 기한을 놓쳤다면</a>에
    정리해 뒀습니다.
  </p>

  <h2>손자에게 바로 주면 {pct(r.generationSkip.rate)}%가 더 붙습니다</h2>
  <p>
    받는 사람이 <strong>증여자의 자녀가 아닌 직계비속</strong>이면 산출세액에{" "}
    {pct(r.generationSkip.rate)}%를 가산합니다. 한 세대를 건너뛰면서 증여세를
    한 번 덜 내는 것을 막는 규정입니다. 미성년자이면서 증여재산가액이{" "}
    {formatMan(r.generationSkip.minorOverAmount)}을 넘으면{" "}
    {pct(r.generationSkip.minorRate)}%입니다.
  </p>
  <p>
    다만 공제는 손자도 직계비속이라{" "}
    {formatMan(relationCap("descendant"))}을 그대로 받습니다 — 공제는 같고
    세액만 할증됩니다. 자녀가 이미 사망해 손자가 받는 경우에는 할증이
    붙지 않습니다.
  </p>

  <h2>2026년 증여세 개정, 언제부터 적용되나요?</h2>
  <p>
    <strong>{r.lawVersion}</strong>이 지금 시행 중인 법입니다. 이 글의 공제
    금액과 세율은 그 법과 국세청 안내에서 {r.verifiedOn}에 확인한 값이고,
    오늘 증여하면 적용되는 금액이 이것입니다.
  </p>
  <p>
    “면제한도 상향”, “기준 완화” 같은 말이 검색에 자주 잡히는데, 국회에서
    논의 중인 개정안의 숫자는 <strong>여기에 싣지 않습니다.</strong> 개정은
    통과와 공포를 거쳐 <strong>시행일이 와야</strong> 적용되고, 그 전까지는
    위 금액이 그대로입니다. 확정되지 않은 숫자로 계산하면 실제와 다른
    금액이 나옵니다. 확정되면 원문에서 다시 확인한 뒤 이 글을 갱신합니다.
  </p>

  <h2>이 글이 다루지 않는 것</h2>
