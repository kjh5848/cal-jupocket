---
/**
 * "기초연금 모의계산" — 기초연금 시리즈. (기초연금 계산·수급자격 확인·소득인정액 계산기·계산법도 이 글, 계산기 포함)
 * 계산: src/lib/basic-pension.ts propertyIncome()·workIncome()·basicPension() — 기초연금법 제2조·제3조·제8조,
 * 시행령 제11조, 시행규칙 제4조, 고시 제2026-156호. 국민연금 연계 감액은 넣지 않는다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/basic-pension-2026.json";
import { propertyIncome, basicPension, npsFullUpTo } from "../../../lib/basic-pension";
import { won, eokwon } from "../../../lib/won";

const P = r.property;
const exProp = propertyIncome({ general: 300_000_000, financial: 50_000_000, region: "metro" });
const exRec = exProp + 600_000;
const ex = basicPension({ recognized: exRec, couple: false });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 basic-pension-series.test.ts 가 rates 와 대조한다.
const title = "기초연금 모의계산 — 소득과 재산을 넣으면 소득인정액과 받을 수 있는 금액이 나옵니다";
const description =
  "기초연금 모의계산은 근로소득·연금 등 소득과 집·예금·부채를 넣어 소득인정액을 구하고, 2026년 선정기준액(혼자 월 247만원, 부부 월 395만2천원)과 비교해 받을 수 있는 금액을 냅니다. 국민연금 연계 감액은 넣지 않은 어림입니다.";

const ANSWER = `기초연금 모의계산은 ① 근로소득은 월 ${eokwon(r.income.workDeduction)} 공제 후 70%만 ② 재산은 기본재산·금융재산 ${eokwon(P.financialDeduction)}·부채를 빼고 연 4% ÷ 12 ③ 둘을 더한 소득인정액을 선정기준액과 비교합니다(기초연금법 제2조·제3조, 시행규칙 제4조). 대도시 3억원 집·예금 5천만원·기타소득 월 60만원이면 ${won(ex.total)}입니다.`;

const QA = [
  { q: "기초연금 모의계산은 어떻게 하나요?", a: `소득평가액(근로소득은 월 ${eokwon(r.income.workDeduction)}을 빼고 30%를 더 뺀 금액, 연금 등 기타 소득은 그대로)에 재산의 소득환산액을 더해 소득인정액을 구합니다. 그 값이 선정기준액 이하면 대상이고, 기초연금을 더해 선정기준액을 넘으면 차액만 받습니다(제8조 제2항).` },
  { q: "예시로 계산하면 얼마인가요?", a: `대도시에 사는 혼자인 노인이 3억원 집과 예금 5천만원을 갖고 있고 연금 등 소득이 월 60만원이면, 재산 환산액 ${won(exProp)} + 소득 60만원 = 소득인정액 ${won(exRec)}입니다. 선정기준액 ${won(r.selection.single)} 이하라 ${won(ex.total)}을 받습니다.` },
  { q: "모의계산 결과와 실제가 다를 수 있나요?", a: `다를 수 있습니다. 국민연금 급여액이 ${won(npsFullUpTo())}을 넘으면 연계 감액이 있고(제5조·제6조), 일반재산 가액 산정·부채 인정 범위·자녀 집 무료임차소득 같은 세부가 실제 조사에서 반영됩니다. 정확한 금액은 신청 후 30일 안에 받는 결정 통지로 확인합니다(시행규칙 제8조).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card">
    <p class="meta">2026년 기준 어림입니다. 국민연금 연계 감액, 고급 자동차·회원권, 자녀 집 무료임차소득은 넣지 않았습니다. 근로소득을 뺀 소득·재산은 부부면 두 사람 것을 합해 넣으세요.</p>
    <div class="calc-input-wrap">
      <label for="bp-hh">가구</label>
      <select id="bp-hh"><option value="single" selected>혼자 사는 노인</option><option value="couple">부부(둘 다 65세 이상)</option></select>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-region">사는 곳</label>
      <select id="bp-region"><option value="metro" selected>대도시(특별시·광역시 구, 특례시)</option><option value="city">중소도시(도의 시, 세종)</option><option value="rural">농어촌(도의 군)</option></select>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-work">본인 근로소득(월)</label>
      <input type="text" inputmode="numeric" id="bp-work" value="0" /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-work2">배우자 근로소득(월, 혼자면 0)</label>
      <input type="text" inputmode="numeric" id="bp-work2" value="0" /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-other">연금 등 그 밖의 소득(월)</label>
      <input type="text" inputmode="numeric" id="bp-other" value="600,000" /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-general">집·땅 등 일반재산</label>
      <input type="text" inputmode="numeric" id="bp-general" value="300,000,000" /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-fin">예금 등 금융재산</label>
      <input type="text" inputmode="numeric" id="bp-fin" value="50,000,000" /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="bp-debt">부채</label>
      <input type="text" inputmode="numeric" id="bp-debt" value="0" /><span class="unit">원</span>
    </div>
    <div class="result-hero" aria-live="polite" aria-atomic="true">
      <p class="label">월 기초연금(어림)</p>
      <p class="big" id="bp-hero">{won(ex.total)}</p>
      <p class="meta" id="bp-note"></p>
    </div>
    <div class="stat-row">
      <div class="stat-chip"><span class="label">소득인정액(월)</span><span class="value" id="bp-rec">{won(exRec)}</span></div>
      <div class="stat-chip"><span class="label">재산 환산액(월)</span><span class="value" id="bp-prop">{won(exProp)}</span></div>
      <div class="stat-chip"><span class="label">선정기준액</span><span class="value" id="bp-limit">{won(r.selection.single)}</span></div>
    </div>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>계산 기준의 출처는 <a href="/guide/basic-pension-criteria/">기초연금 기준</a>, 금액 구조는 <a href="/guide/basic-pension-amount/">기초연금 금액</a>에 있습니다.</p>

  <script src="../../../scripts/basic-pension.ts"></script>
</GuideLayout>
