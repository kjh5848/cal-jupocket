---
/**
 * "중개보수 요율표" — 중개보수 시리즈 허브. (중개보수·부동산 중개보수 요율·중개보수 뜻·복비 뜻·부동산 중개수수료율·아파트 복비도 이 글)
 * 근거: 공인중개사법 시행규칙 제20조 ①·③·④, [별표 1]·[별표 2], 서울특별시 주택 중개보수 등에 관한 조례 [별표 1](rates: brokerage-fee-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/brokerage-fee-2026.json";
import { brokerageFee } from "../../../lib/brokerage-fee";
import { won, eokwon } from "../../../lib/won";
import { brokerageFeeSeries as S } from "../../../data/series/brokerage-fee";

type Band = { below: number | null; permille: number; cap: number | null };
const range = (bands: Band[], i: number) => {
  const lo = i === 0 ? 0 : bands[i - 1].below!;
  const hi = bands[i].below;
  if (lo === 0) return `${eokwon(hi!)} 미만`;
  return hi === null ? `${eokwon(lo)} 이상` : `${eokwon(lo)} 이상 ${eokwon(hi)} 미만`;
};
const sale = r.housing.sale as Band[];
const lease = r.housing.lease as Band[];
const ex = brokerageFee({ property: "housing", deal: "sale", amount: 1_000_000_000 });
const exSmall = brokerageFee({ property: "housing", deal: "sale", amount: 180_000_000 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 brokerage-fee-series.test.ts 가 rates 와 대조한다.
const title = "중개보수 요율표 — 주택 매매는 0.4~0.7%, 전세·월세는 0.3~0.6%이고 2억원 미만 매매엔 한도액이 있습니다";
const description =
  "중개보수(복비)는 공인중개사법 시행규칙 별표 1의 거래금액 구간별 상한요율 안에서 정합니다. 주택 매매·임대차 요율표와 한도액, 오피스텔 0.5%·0.4%, 상가·토지 0.9%, 매수인과 매도인이 각각 낸다는 점을 정리했습니다.";

const ANSWER = `중개보수는 중개사에게 내는 수수료(복비)로, 거래금액 구간마다 정해진 상한요율을 곱한 금액까지 받을 수 있습니다(공인중개사법 시행규칙 제20조, 별표 1). 주택 10억원 매매면 0.5%로 한쪽이 최대 ${won(ex.maxFee)}, 1억8천만원이면 0.5%로 계산한 90만원이 한도액을 넘어 ${won(exSmall.maxFee)}까지입니다. 매수인과 매도인이 각각 냅니다.`;

const QA = [
  { q: "중개보수는 무슨 뜻이고 누가 내나요?", a: `공인중개사가 거래를 중개하고 받는 보수입니다. 흔히 복비, 부동산 중개수수료라고 부릅니다. 주택은 중개의뢰인 쌍방에게서 각각 받으므로 매매면 매도인과 매수인이, 임대차면 임대인과 임차인이 각자 냅니다(시행규칙 제20조 ①).` },
  { q: "주택 중개보수 요율표는 어떻게 되나요?", a: `아래 표가 시행규칙 별표 1의 상한입니다. 한도액이 있는 구간은 요율로 계산한 금액이 한도액보다 크면 한도액까지만 받습니다. 실제 한도는 중개사무소가 있는 시·도 조례가 이 안에서 정하는데, 서울시 조례 별표 1은 이 표와 같습니다.` },
  { q: "오피스텔·상가·토지 요율은 다른가요?", a: `전용 85㎡ 이하이고 전용 부엌·화장실·목욕시설을 갖춘 오피스텔은 매매 ${r.officetel.salePermille / 10}%, 임대차 ${r.officetel.leasePermille / 10}%가 상한입니다(별표 2). 그 밖의 중개대상물은 거래금액의 ${r.other.permille / 10}% 이내에서 협의합니다(제20조 ④ 2호).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>권리관계 확인이나 계약금 반환 보장에 든 실비는 중개보수와 따로 청구할 수 있습니다(제20조 ②). 내 거래금액으로 바로 계산하려면 <a href="/guide/brokerage-fee-calculator/">중개보수 계산기</a>에 넣어 보세요.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>거래</th><th>거래금액</th><th>상한요율</th><th>한도액</th></tr></thead>
      <tbody>
        {sale.map((b, i) => <tr><th scope="row">{i === 0 ? "매매·교환" : ""}</th><td>{range(sale, i)}</td><td>{b.permille / 10}%</td><td>{b.cap === null ? "-" : won(b.cap)}</td></tr>)}
        {lease.map((b, i) => <tr><th scope="row">{i === 0 ? "임대차 등" : ""}</th><td>{range(lease, i)}</td><td>{b.permille / 10}%</td><td>{b.cap === null ? "-" : won(b.cap)}</td></tr>)}
      </tbody>
    </table>
  </div>
  <p>구간 경계는 '이상·미만'입니다. 9억원 매매는 0.4% 구간이 아니라 0.5% 구간이라, 8억9천만원보다 9억원일 때 복비가 크게 뜁니다. 중개대상물과 중개사무소의 소재지가 다르면 중개사무소가 있는 시·도의 조례를 따릅니다(제20조 ③).</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>월세는 보증금에 월세 100배를 더해 거래금액을 잡기 때문에 같은 집이라도 전세와 복비가 다릅니다. 자세한 계산은 <a href="/guide/monthly-rent-brokerage-fee/">월세 복비</a>에 이어집니다. 계약을 마쳤다면 이삿날까지 할 일은 <a href="/guide/moving-checklist/">이사 체크리스트</a>에 정리했습니다.</p>

  <h2>중개보수 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
