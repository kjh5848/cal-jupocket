---
/**
 * "폐업 부가세 확정신고" — 부가세 확정신고 시리즈.
 * 근거: 부가가치세법 제5조 제3항(과세기간 = 개시일~폐업일), 제49조·제67조(폐업일이 속한 달의 다음 달 25일).
 * 폐업일의 기준은 대통령령 — 읽지 않았다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import vf from "../../../rates/vat-final-2026.json";
import { vatFinalDeadline, koDate } from "../../../lib/tax-deadline";

const ex = koDate(vatFinalDeadline(2027, 3)); // 2027년 3월 폐업

const title = "폐업 부가세 확정신고 — 폐업한 달의 다음 달 25일까지 합니다";
const description =
  "폐업하면 부가세 확정신고 기한이 당겨집니다. 과세기간은 그 기간의 시작일부터 폐업일까지이고, 폐업일이 속한 달의 다음 달 25일까지 신고·납부합니다. 간이과세자도 같습니다.";

const ANSWER = `폐업하면 1월·7월을 기다리지 않습니다. 과세기간은 그 기간의 시작일부터 폐업일까지이고, 폐업일이 속한 달의 다음 달 25일까지 확정신고합니다. 2027년 3월에 폐업하면 ${ex}이 기한입니다.`;

const QA = [
  { q: "폐업하면 부가세 확정신고는 언제 하나요?", a: "폐업일이 속한 달의 다음 달 25일 이내입니다(부가가치세법 제49조 제1항). 일반과세자의 정기 확정신고(7월·1월)를 기다리지 않고 기한이 당겨집니다. 간이과세자도 같습니다(제67조 제1항)." },
  { q: "폐업할 때 부가세는 몇 달치를 신고하나요?", a: "폐업일이 속하는 과세기간의 시작일부터 폐업일까지입니다(제5조 제3항). 예를 들어 일반과세자가 3월 10일에 폐업하면 1월 1일부터 3월 10일까지가 마지막 과세기간입니다." },
  { q: "폐업 부가세 확정신고 기한이 주말이면 어떻게 되나요?", a: `다음 날로 넘어갑니다(국세기본법 제5조). 2027년 3월 폐업이면 4월 25일이 일요일이라 ${ex}까지입니다.` },
];
---

<GuideLayout title={title} description={description} updated={vf.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>이 글에 없는 것</h2>
  <ul>
    <li><strong>폐업일을 언제로 보는지</strong> — 제5조 제3항이 대통령령으로 넘기는데, 그 조문은 읽지 않았습니다.</li>
    <li><strong>폐업 때 남은 재고·설비에 대한 과세</strong> — 이 글에서는 다루지 않습니다.</li>
  </ul>
  <p>
    정기 기한은 <a href="/guide/vat-final-return-period/">부가세 확정신고 기간</a>에 있습니다.
  </p>
</GuideLayout>
