---
/**
 * "전세 계약서 특약" — 법무부 표준계약서에 인쇄된 특약 문구와 HUG 전세사기예방센터의 특약 안내. (전세 특약 문구·전세 특약사항·전세 특약 예시·근저당 못 잡게 하는 특약·전세보증보험 특약도 이 글)
 * 근거: 법무부 주택임대차표준계약서 2023. 10. 6. 개정본(원본게시용 PDF 2쪽 [특약사항]), HUG 전세사기예방센터 '특약사항 작성'·'등기부등본 확인'·'주택 확인 및 이사',
 * 주택임대차보호법 제3조의6·제3조의7·제10조(시행 2026. 1. 2.). 조사 기록: docs/research/jeonse-special-clauses.md. 날짜·전화번호는 rates/hug-jeonse-2026.json.
 * 쓰지 않은 것: HUG가 권하는 특약의 문구 그대로의 예문(안내에 없음), 특약 문구의 효력(무효 여부), 근저당 말소 특약의 집행 방법, 계약금 반환 범위, 전세대출 은행의 특약 요구,
 * 가계약·재계약 특약(원문 확인 필요).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import Callout from "../../../components/Callout.astro";
import HugChatEntry from "../../../components/HugChatEntry.astro";
import r from "../../../rates/hug-jeonse-2026.json";

const L = r.standardLease;
const S = r.sources;
const kdate = (s: string) => {
  const [y, m, d] = s.split("-").map(Number);
  return `${y}년 ${m}월 ${d}일`;
};
const REV = kdate(L.revisedOn);
const PHONE = r.legal.legalAidPhone;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts).
const title = "전세 계약서 특약 문구 — 표준계약서에 인쇄된 6가지와 넣으면 안 되는 것";
const description =
  "전세 계약서 특약 문구를 법무부 표준계약서 [특약사항]에서 그대로 옮겼습니다. 근저당 설정 금지 특약, HUG 안내, 반환보증이 막히는 특약, 집주인이 보여 줘야 하는 서류를 정리했습니다.";

const ANSWER = `전세 계약서 특약은 직접 지어 쓰기 전에 법무부 주택임대차표준계약서(${REV} 개정본)의 [특약사항]을 먼저 봅니다. 담보권 설정 금지, 사전에 알리지 않은 선순위 정보나 체납이 있을 때의 계약 해제 같은 문구가 이미 인쇄돼 있고, 계약서 맨 아래 '기타' 칸에 더 적을 수 있습니다. 반환채권 양도금지 특약이 있으면 HUG 반환보증에 가입할 수 없으니 넣지 않습니다.`;

const QA = [
  {
    q: "전세 계약서 특약 뭐라고 넣어요?",
    a: `법무부 표준계약서(${REV} 개정본)의 [특약사항]에는 여섯 가지가 인쇄돼 있습니다. 담보권 설정 금지, 그 위반 때의 해제·해지와 손해배상, 사전에 알리지 않은 선순위 임대차 정보나 일정 금액을 넘는 미납·체납 국세·지방세가 있을 때 계약금을 포기하지 않고 해제, 분쟁조정위원회 조정 신청 동의 여부, 철거·재건축 계획, 상세주소 소유자 동의 여부입니다. 여기에 없는 약속은 '기타' 칸에 직접 적습니다. 문구는 공인중개사나 대한법률구조공단(${PHONE})에 확인하세요.`,
  },
  {
    q: "근저당 못 잡게 하는 특약이 표준계약서에 있나요?",
    a: `있습니다. 주택을 넘겨받은 임차인이 정한 날짜까지 전입신고와 확정일자를 받기로 하고, 임대인은 그 약정일자의 다음 날까지 저당권 등 담보권을 설정할 수 없다는 문구가 인쇄돼 있습니다. 어기면 임차인이 계약을 해제·해지할 수 있고 임대인이 손해를 배상한다는 문구가 이어집니다. 날짜 칸은 비어 있어서 계약할 때 채웁니다.`,
  },
  {
    q: "특약 때문에 HUG 전세보증 가입이 안 될 수도 있나요?",
    a: `반환채권 양도금지 특약이 있으면 HUG 전세보증금반환보증에 가입할 수 없다고 HUG 안내에 나옵니다. 반대로 보증 가입이 되는 집이라는 말을 듣고 계약한다면, 임차인에게 잘못이 없는데 가입이 안 될 때 계약을 취소하고 보증금을 돌려준다는 내용을 특약으로 적어 두라고 HUG 전세사기예방센터가 안내합니다.`,
  },
  {
    q: "집주인이 계약할 때 보여 줘야 하는 게 있나요?",
    a: `있습니다. 임대차계약을 체결할 때 임대인은 해당 주택의 확정일자 부여일·차임·보증금 등 정보와 납세증명서(국세·지방세)를 임차인에게 제시해야 합니다. 임대인이 계약 전에 열람에 동의하는 것으로 대신할 수 있습니다(주택임대차보호법 제3조의7).`,
  },
  {
    q: "특약을 쓰고 나면 더 할 일이 있나요?",
    a: `입주 직후 등기부를 다시 떼어 특약을 어기지 않았는지 확인합니다. 특약을 어겼다는 사실은 등기부에 새로 생긴 권리로 드러날 수 있기 때문입니다. 집의 상태를 기준으로 계약하는 특약이 있으면 입주 직후 사진도 남겨 둡니다.`,
  },
];
---

<GuideLayout title={title} description={description} updated={r.standardLease.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />
  <HugChatEntry />

  <h2>전세 계약서 특약 문구, 표준계약서에 이미 인쇄돼 있는 것</h2>
  <p class="qa-lead">전세 계약서를 쓸 때 가장 안전한 출발점은 법무부 표준계약서입니다. 법무부 주택임대차법령정보에서 {REV} 개정본을 받을 수 있고, 사용용(hwp)과 원본 게시용(pdf)이 따로 올라와 있습니다. 중개사가 다른 양식을 쓰면 법무부 원본과 어떻게 다른지 비교해 보라는 안내도 같은 페이지에 있습니다. 받는 곳은 <a href={S.standardLease} rel="noopener" target="_blank">법무부 주택임대차표준계약서 안내</a>이고, 아래 문구는 <a href={L.file} rel="noopener" target="_blank">원본 게시용 PDF</a> 2쪽의 [특약사항]에서 옮겼습니다. 빈칸은 계약할 때 채웁니다.</p>

  <ol class="clause-list">
    <li>
      <strong>담보권 설정 금지</strong>
      <blockquote class="clause">주택을 인도받은 임차인은 ____년 __월 __일까지 주민등록(전입신고)과 주택임대차계약서상 확정일자를 받기로 하고, 임대인은 위 약정일자의 다음날까지 임차주택에 저당권 등 담보권을 설정할 수 없다.</blockquote>
    </li>
    <li>
      <strong>위반하면 해제·해지와 손해배상</strong>
      <blockquote class="clause">임대인이 위 특약에 위반하여 임차주택에 저당권 등 담보권을 설정한 경우에는 임차인은 임대차계약을 해제 또는 해지할 수 있다. 이 경우 임대인은 임차인에게 위 특약 위반으로 인한 손해를 배상하여야 한다.</blockquote>
    </li>
    <li>
      <strong>알리지 않은 선순위 정보·체납이 나오면 계약금을 포기하지 않고 해제</strong>
      <blockquote class="clause">임대차계약을 체결한 임차인은 임대차계약 체결 시를 기준으로 임대인이 사전에 고지하지 않은 선순위 임대차 정보(주택임대차보호법 제3조의6 제3항)가 있거나 미납 또는 체납한 국세·지방세가 ______원을 초과하는 것을 확인한 경우 임대차기간이 시작하는 날까지 제5조에도 불구하고 계약금 등의 명목으로 임대인에게 교부한 금전 기타 물건을 포기하지 않고 임대차계약을 해제할 수 있다.</blockquote>
      <p class="clause-note">제5조는 중도금(없으면 잔금)을 내기 전에 임차인은 계약금을 포기하고, 임대인은 계약금의 배액을 돌려주고 계약을 해제할 수 있다는 조항입니다. 위 특약은 그 조항에도 불구하고 계약금을 포기하지 않고 해제할 수 있게 합니다.</p>
    </li>
    <li>
      <strong>분쟁조정위원회 조정 먼저</strong>
      <blockquote class="clause">주택임대차계약과 관련하여 분쟁이 있는 경우 임대인 또는 임차인은 법원에 소를 제기하기 전에 먼저 주택임대차분쟁조정위원회에 조정을 신청한다. (□ 동의 □ 미동의)</blockquote>
    </li>
    <li><strong>철거·재건축 계획</strong> — 구체적 계획이 있는지(□ 없음 □ 있음), 있으면 공사 시기와 소요 기간을 적는 칸입니다.</li>
    <li><strong>상세주소 부여 동의</strong> — 상세주소가 없는 집에서 임차인이 상세주소 부여를 신청할 때 소유자가 동의하는지(□ 동의 □ 미동의) 적는 칸입니다.</li>
  </ol>

  <p>이 여섯 가지 아래에 '기타' 칸이 비어 있습니다. 표준계약서에 없는 약속은 여기에 직접 적습니다. 법무부 게시글에 따르면 계약 체결 뒤 입주 전에 임대인이 담보권을 설정하지 못하게 하는 특약은 2022년 개정에서, 사전에 고지하지 않은 정보나 체납이 있을 때 해제하는 특약은 2023년 수정에서 들어갔습니다. 예전 양식을 쓰는 계약서에는 없을 수 있습니다.</p>

  <Callout icon="📄">표준계약서의 해제 특약은 임차인이 확인한 시점이 '임대차기간이 시작하는 날까지'일 때 쓰입니다. 입주를 한참 앞두고 계약했다면 이 기간에 등기부와 납세 정보를 다시 확인할 일정을 잡아 두세요. 날짜는 <a href="/guide/hug-jeonse-checklist/">HUG 전세대출 체크리스트</a>에서 계약일·잔금일을 넣어 뽑을 수 있습니다.</Callout>

  <h2>전세 특약 뭐 넣어야 해요 — HUG가 적으라고 안내하는 것</h2>
  <p class="qa-lead">HUG 전세사기예방센터는 <a href={S.specialClausesHug} rel="noopener" target="_blank">특약사항 작성</a> 안내에서 특약도 계약 내용만큼 중요하고, 특히 돈에 관한 내용이면 더 그렇다고 말합니다. 이 안내는 취지만 알려 주고 그대로 옮겨 쓸 문구는 정해 주지 않습니다. 그래서 이 글도 HUG 예문이라며 문장을 만들어 드리지 않고, 안내하는 내용만 정리합니다.</p>
  <ul>
    <li><strong>집을 볼 때 구두로 한 약속</strong> — 계약서에 없는 약속은 반드시 특약으로 적으라고 합니다. 안내에 나오는 예가 곰팡이를 없애고 새로 도배해 주겠다는 말입니다.</li>
    <li><strong>선순위 근저당을 없애겠다는 약속</strong> — 계약하고 나면 임차인보다 앞선 빚을 없애겠다고 했다면 특약을 꼭 쓰고, 그 조건을 지키지 않으면 계약이 무효라는 내용까지 넣어 적으라고 합니다.</li>
    <li><strong>전세보증금반환보증 가입 가능</strong> — 집주인이 보증에 가입할 수 있는 집이라고 했다면, 임차인에게 잘못이 없는데 가입할 수 없을 때 계약을 취소하고 보증금을 돌려준다는 내용을 계약서에 명시하라고 합니다.</li>
    <li><strong>이미 전세권이 설정된 집</strong> — 곧 나갈 세입자가 설정한 전세권이면 그것을 없애는 내용을 특약에 넣고 계약하면 됩니다. 이전 세입자가 보증금을 못 받아서 등기한 것이면 계약하지 않는 편이 좋다고 안내합니다(<a href={S.registryCheck} rel="noopener" target="_blank">HUG 등기부등본 확인</a>).</li>
    <li><strong>다가구주택</strong> — 임대인에게 확정일자 확인동의서를 받아 선순위 보증금을 확인합니다. 동의하지 않으면 관련 특약을 쓰고 계약한 뒤 동 주민센터에서 다가구 전입세대 확정일자 열람을 해 보고, 위험하다고 보면 특약에 따라 계약을 해지할 수 있게 공인중개사에게 중재를 요청하라고 합니다.</li>
    <li><strong>주택 상태·계약조건</strong> — 계약서 확인 항목에 옵션, 수리비 부담 같은 주택 상태 관련 특약과 근저당 말소 같은 계약조건이 따로 들어 있습니다.</li>
  </ul>

  <AdSlot />

  <h2>전세 특약 보증보험 — 넣으면 안 되는 문구</h2>
  <p class="qa-lead">HUG 전세보증금반환보증에는 반환채권 양도금지 특약이 없어야 한다는 가입 조건이 있습니다. 계약서에 이 특약이 적혀 있으면 가입할 수 없으니, 집주인이나 중개사가 쓰자고 해도 먼저 보증 가입 조건과 맞는지 확인합니다. 다른 가입 조건은 <a href={S.returnGuarantee} rel="noopener" target="_blank">HUG 전세보증금반환보증 안내</a>에 있고, 내 집이 기준 안에 드는지는 <a href="/guide/hug-jeonse-guarantee-calculator/">HUG 전세보증 가능 여부 계산기</a>로 먼저 가늠해 볼 수 있습니다.</p>
  <p>특약을 쓸 때 부딪칠 만한 건 이 한 가지입니다. 다른 특약이 가입을 막는지는 이 글이 확인하지 못했습니다. 특약이 보증 가입에 영향을 주는지 헷갈리면 계약 전에 HUG에 문구를 대고 물어보세요.</p>

  <h2>전세 사기 막는 특약사항, 집주인이 계약 때 보여 줘야 하는 것</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>계약하려는 사람은 임대인의 동의를 받아 확정일자부여기관에 해당 주택의 확정일자 부여일·차임·보증금 정보를 요청할 수도 있습니다(같은 법 제3조의6 제4항). 앞 절의 해제 특약은 이 정보와 맞물립니다. 계약 때 임대인이 알려 준 정보와 나중에 확인한 정보가 다르면 그 특약이 쓰이기 때문입니다. 법령 원문은 <a href={S.leaseProtectionAct} rel="noopener" target="_blank">국가법령정보센터 주택임대차보호법</a>에서 볼 수 있습니다.</p>

  <h2>특약을 쓴 뒤 — 입주 직후 등기부 다시 확인</h2>
  <p class="qa-lead">{QA[4].a}</p>
  <p>HUG 전세사기예방센터도 계약 뒤 입주 직후에 등기부를 확인해 특약을 어기지 않았는지 점검하라고 안내합니다. 확인한 결과 특약과 다른 권리가 새로 생겼다면 계약서에 적은 해제·해지 조건이 있는지 보고, 공인중개사나 아래 상담 창구와 바로 상의합니다.</p>

  <h2>법률 자문이 아닙니다 — 문구는 직접 확인하세요</h2>
  <p>이 글은 법무부와 HUG가 공개한 자료에 인쇄·안내된 내용을 옮긴 것이고, 법률 자문이 아닙니다. 특약 문구가 법적으로 어떤 효력을 갖는지, 계약금을 얼마까지 돌려받는지는 확인하지 못했습니다. 주택임대차보호법 제10조는 이 법에 어긋나는 약정으로서 임차인에게 불리한 것은 효력이 없다고 정하고 있지만, 어떤 문구가 여기에 걸리는지는 이 글이 판단하지 않습니다. 실제로 쓸 문구는 계약을 중개하는 공인중개사에게 확인하고, 더 따져 봐야 하면 <a href={S.legalAid} rel="noopener" target="_blank">대한법률구조공단</a> 법률상담 {PHONE}에 물어보세요.</p>
  <Callout icon="ℹ️">'전세 도우미'는 HUG 공식 서비스가 아니라 JU포켓이 공개 자료로 만든 비공식 안내입니다. 날짜와 보증 조건은 위 입구에서 계약일을 넣어 확인할 수 있고, 특약 문구를 대신 지어 주지는 않습니다. 이 글의 내용은 {L.verifiedOn} 기준으로 법무부·HUG·법제처 원문을 확인했으며, 이후에 바뀌었을 수 있습니다.</Callout>
