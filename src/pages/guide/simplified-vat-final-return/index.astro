---
/**
 * "간이과세자 부가세 확정신고" — 부가세 확정신고 시리즈.
 * 근거: 부가가치세법 제5조 제1항 제1호(1월~12월), 제67조(25일·예정부과 공제·합계표), 제69조(4,800만원 납부면제).
 * 신고 의무와 납부 면제가 같은 것인지는 조문이 따로 말하지 않아 쓰지 않는다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import vf from "../../../rates/vat-final-2026.json";
import v from "../../../rates/vat-2026.json";
import { vatFinalDeadline, koDate } from "../../../lib/tax-deadline";
import { manwon } from "../../../lib/won";

const d = koDate(vatFinalDeadline(2026, 12));

const title = "간이과세자 부가세 확정신고 — 1년치를 다음 해 1월 25일에 한 번";
const description =
  "간이과세자 부가세 확정신고는 1월 1일~12월 31일 1년치를 다음 해 1월 25일까지 한 번 합니다. 7월에 예정부과로 낸 세금은 빼고 내고, 세금계산서합계표를 함께 냅니다. 2026년분은 2027년 1월 25일까지입니다.";

const ANSWER = `간이과세자는 1월 1일~12월 31일 1년치를 다음 해 1월 25일까지 한 번 확정신고합니다. 2026년분은 ${d}이 기한입니다. 중간에 예정부과로 낸 세금은 빼고 내고, 세금계산서합계표를 같이 냅니다.`;

const QA = [
  { q: "간이과세자 부가세 확정신고는 언제 하나요?", a: "간이과세자의 과세기간은 1월 1일부터 12월 31일까지 한 번이라(부가가치세법 제5조), 그 뒤 25일 안인 다음 해 1월 1일~25일에 확정신고하고 납부합니다(제67조 제1항)." },
  { q: "간이과세자가 7월에 낸 세금은 어떻게 되나요?", a: "확정신고로 낼 세금에서 뺍니다. 예정부과로 이미 납부한 세액은 공제하고 납부한다고 제67조 제2항이 정합니다." },
  { q: "간이과세자 확정신고 때 같이 내야 하는 서류가 있나요?", a: "매출·매입처별 세금계산서합계표를 신고할 때 함께 제출해야 합니다(제67조 제3항). 세금계산서를 주고받은 거래가 있으면 거래처별로 정리해 냅니다." },
  { q: "간이과세자는 4,800만원 미만이면 부가세를 안 내나요?", a: `해당 과세기간의 공급대가 합계가 ${manwon(48_000_000)} 미만이면 납부의무가 면제됩니다(제69조 제1항). 면제 대상인데 모르고 냈다면 세무서가 환급해야 합니다(같은 조 제4항).` },
];
---

<GuideLayout title={title} description={description} updated={vf.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>
    폐업하면 기한이 당겨집니다 — 폐업일이 속한 달의 다음 달 25일입니다(제67조 제1항).
    <a href="/guide/closing-vat-final-return/">폐업 부가세 확정신고</a>에 있습니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    세금계산서를 발행할 수 있는 간이과세자인지는 <a href="/guide/simplified-tax-invoice/">간이과세자
    세금계산서 발행</a>에 있습니다.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    {v.simplified.paymentExemptionNote} 다만 이 조문은 <strong>납부</strong>의무를
    말합니다. 신고 의무까지 함께 없어지는지는 조문이 따로 말하지 않아 여기서
    단정하지 않겠습니다. 전자신고세액공제는 간이과세자도 받지만 낼 세금을 넘지
    못합니다 — <a href="/guide/vat-e-filing-credit/">부가세 전자신고세액공제</a>.
  </p>
</GuideLayout>
