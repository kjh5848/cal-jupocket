---
/**
 * "irp 세액공제율" — IRP 세액공제 시리즈.
 * 12%와 15%를 가르는 선은 종합소득금액 4,500만원(근로소득만 있으면 총급여 5,500만원).
 * 반전: 직장인은 연봉(총급여)으로, 사업자는 경비를 뺀 소득금액으로 잰다 — 같은 숫자가 아니다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import pa from "../../../rates/pension-account-2026.json";
import rates from "../../../rates/2026.json";
import { won, manwon } from "../../../lib/won";
import { round1 } from "../../../lib/rate-display";

const lo = pa.creditRatePercentBelowThreshold;
const hi = pa.creditRatePercentAboveThreshold;
const loEff = round1(lo * (1 + rates.localTaxRate));
const hiEff = round1(hi * (1 + rates.localTaxRate));

const title = "IRP 세액공제율 — 12%와 15%를 가르는 4,500만원, 직장인은 5,500만원";
const description =
  "IRP 세액공제율은 종합소득금액 4,500만원 이하면 15%, 넘으면 12%입니다. 근로소득만 있으면 총급여 5,500만원이 기준입니다. 지방소득세까지 치면 16.5%와 13.2%입니다.";

const ANSWER = `IRP 세액공제율은 종합소득금액 ${manwon(pa.incomeThreshold)} 이하(근로소득만 있으면 총급여 5,500만원 이하)면 ${lo}%, 넘으면 ${hi}%입니다. 지방소득세까지 치면 실제로 줄어드는 비율은 ${loEff}%와 ${hiEff}%입니다.`;

const QA = [
  { q: "IRP 세액공제율은 몇 %인가요?", a: `${lo}%와 ${hi}% 둘입니다. 해당 과세기간의 종합소득금액이 ${manwon(pa.incomeThreshold)} 이하면 ${lo}%, 넘으면 ${hi}%입니다(소득세법 제59조의3 제1항).` },
  { q: "직장인은 연봉 얼마까지 15%인가요?", a: "근로소득만 있으면 총급여 5,500만원 이하일 때 15%입니다. 조문이 근로소득만 있는 사람은 종합소득금액 대신 총급여액으로 재도록 따로 적어 두었습니다." },
  { q: "프리랜서·사업자는 무엇으로 재나요?", a: `종합소득금액입니다. 사업소득은 수입에서 필요경비를 뺀 금액이 소득금액이라, 매출이 ${manwon(pa.incomeThreshold)}을 넘어도 경비를 빼고 나면 15% 구간일 수 있습니다.` },
  { q: "지방소득세까지 치면 실제 공제율은 얼마인가요?", a: `소득세가 줄어든 만큼 그 10%인 지방소득세도 같이 줄어서, 실제로 줄어드는 비율은 ${loEff}%와 ${hiEff}%입니다. 900만원이면 각각 ${manwon(Math.round(9_000_000 * loEff / 100))}과 ${manwon(Math.round(9_000_000 * hiEff / 100))}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={pa.taxCreditVerifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead>
      <tr><th>기준</th><th>공제율</th><th>지방소득세 포함</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">종합소득금액 {won(pa.incomeThreshold)} 이하<br /><small>근로소득만: 총급여 5,500만원 이하</small></th><td>{lo}%</td><td>{loEff}%</td></tr>
      <tr><th scope="row">그 초과</th><td>{hi}%</td><td>{hiEff}%</td></tr>
    </tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>
    총급여는 비과세 급여를 뺀 연간 급여입니다. 연봉 계약서의 숫자와 다를 수
    있으니 원천징수영수증의 총급여 칸으로 확인하는 편이 정확합니다.
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    근로소득과 사업소득이 같이 있으면 총급여 기준이 아니라 합친 종합소득금액
    {won(pa.incomeThreshold)}이 기준입니다. 조문이 총급여 기준을 "근로소득만
    있는 경우"로 한정해 두었기 때문입니다.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    금액별로 계산해 보려면 <a href="/guide/irp-tax-credit-calculator/">IRP
    세액공제 계산기</a>를 쓰세요.
  </p>
</GuideLayout>
