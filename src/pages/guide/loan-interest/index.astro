---
/**
 * "대출이자 계산" — 대출이자 계산 시리즈 허브. (대출이자 계산방법·계산법·공식·1억 대출 이자·한 달 이자도 이 글)
 * 법령 숫자 없음 — 월 이자 = 남은 원금 × 연 이자율 ÷ 12. 금액은 loanSchedule() 이 낸다(rates: loan-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/loan-2026.json";
import { loanSchedule } from "../../../lib/loan";
import { won } from "../../../lib/won";
import { loanSeries as S } from "../../../data/series/loan";

const lv = loanSchedule({ principal: 100_000_000, months: 360, ratePct: 4, method: "level" });
const bu4 = loanSchedule({ principal: 100_000_000, months: 12, ratePct: 4, method: "bullet" });
const bu5 = loanSchedule({ principal: 100_000_000, months: 12, ratePct: 5, method: "bullet" });
const row1 = lv.rows[0];
const row2 = lv.rows[1];

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 loan-series.test.ts 가 대조한다.
const title = "대출이자 계산 — 남은 원금에 연 이자율의 12분의 1을 곱하고, 상환 방식에 따라 총 이자가 달라집니다";
const description =
  "대출이자는 매달 남은 원금 × 연 이자율 ÷ 12로 계산합니다. 원금이 줄면 다음 달 이자도 줄기 때문에, 원금을 언제 얼마나 갚느냐(원리금균등·원금균등·만기일시)에 따라 같은 금리라도 총 이자가 크게 달라집니다.";

const ANSWER = `대출이자는 매달 남은 원금 × 연 이자율 ÷ 12로 계산합니다. 1억원을 연 4%로 빌리면 첫 달 이자는 ${won(bu4.firstPayment)}이고, 원금을 갚아 잔액이 줄면 다음 달 이자도 줄어듭니다.`;

const QA = [
  { q: "대출이자 계산 방법을 순서대로 알려 주세요.", a: `① 연 이자율을 12로 나눠 월 이자율을 구하고 ② 남은 원금에 곱해 이번 달 이자를 냅니다 ③ 이번 달 갚은 원금만큼 잔액을 줄여 다음 달에 반복합니다. 1억원 4% 30년 원리금균등이면 첫 달 이자 ${won(row1.interest)}·원금 ${won(row1.principal)}, 둘째 달 이자 ${won(row2.interest)}입니다.` },
  { q: "1억 대출 이자는 4%와 5%에서 얼마나 차이 나나요?", a: `원금을 갚지 않는 만기일시로 보면 한 달 이자가 4%는 ${won(bu4.firstPayment)}, 5%는 ${won(bu5.firstPayment)}입니다. 1년이면 ${won(bu4.totalInterest)}과 ${won(bu5.totalInterest)}으로 약 ${won(bu5.totalInterest - bu4.totalInterest)} 차이입니다. 원금을 나눠 갚으면 잔액이 줄어 이자도 함께 줄어듭니다.` },
  { q: "같은 금리인데 총 이자가 왜 다르게 나오나요?", a: `이자는 남은 원금에만 붙어서, 원금을 빨리 갚을수록 총 이자가 적습니다. 같은 조건이면 원금균등이 가장 적고, 원리금균등이 그다음, 기간 내내 원금이 그대로인 만기일시가 가장 많습니다. 1억원 4% 30년 원리금균등의 총 이자는 ${won(lv.totalInterest)}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>금액·기간을 넣어 회차별 상환표를 바로 보려면 <a href="/guide/loan-calculator/">대출 이자 계산기</a>를 쓰세요. 세 상환 방식을 같은 조건으로 나란히 보여 줍니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>여기 금액은 월 단위로 계산하고 원 미만을 버린 값입니다. 은행은 실제 날수로 하루 이자를 계산하는 상품이 많아, 31일인 달과 28일인 달의 이자가 조금씩 다를 수 있습니다. 대출 약정서의 이자 계산 방법이 기준입니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>방식마다 매달 부담이 어떻게 달라지는지는 <a href="/guide/loan-repayment-methods/">원리금균등 원금균등 차이</a>에 정리했습니다. 새 대출을 얼마까지 받을 수 있는지는 이 한 해 원리금을 연소득으로 나눈 비율로 정해집니다 — 대출 종류별로 원리금을 세는 법은 <a href="/guide/dsr/">DSR 계산</a>에 있습니다.</p>

  <h2>대출이자 계산 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>
</GuideLayout>
