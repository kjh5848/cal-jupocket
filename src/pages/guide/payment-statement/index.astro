---
/**
 * "지급명세서" — 원천세·지급명세서 시리즈. (지급명세서 제출기한·2월 말·3월 10일·휴폐업·가산세 1%도 이 글)
 * 근거: 소득세법 제164조 제1항(다음 연도 2월 말일, 사업·근로·퇴직·종교인·봉사료 3월 10일, 휴폐업 다음다음 달 말일, 일용 다음 달 말일)·
 * 제6항·제7항, 제81조의11 제1항(1%, 3개월 내 0.5%).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/withholding-tax-2026.json";
import { statementPenalty } from "../../../lib/withholding-tax";
import { won, eokwon } from "../../../lib/won";

const N = r.penalty;
const pct = (v: number) => `${+(v * 100).toFixed(3)}%`;
const paid = 50_000_000;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 withholding-tax-series.test.ts 가 rates 와 대조한다.
const title = "지급명세서 — 다음 해 2월 말일, 근로·퇴직·사업소득은 3월 10일, 안 내면 지급액의 1%";
const description =
  "지급명세서는 한 해 동안 누구에게 어떤 소득을 얼마나 줬는지 사람별로 적어 내는 서류입니다. 이자·배당·기타소득 등은 다음 해 2월 말일, 근로·퇴직·원천징수대상 사업소득은 3월 10일까지이고 일용근로소득은 매달입니다. 안 내면 지급액의 1%, 3개월 안에 내면 0.5%입니다.";

const ANSWER = `지급명세서는 소득을 준 사람이 받은 사람별 지급 내역을 내는 서류로, 다음 연도 2월 말일까지 냅니다. 근로·퇴직소득, 원천징수대상 사업소득, 종교인소득, 봉사료는 3월 10일까지입니다(소득세법 제164조 제1항). 안 내면 지급금액의 ${pct(N.statementNone)} 가산세입니다(제81조의11).`;

const QA = [
  { q: "지급명세서 제출기한은 언제인가요?", a: `이자·배당·연금·기타소득 등은 지급일이 속하는 해의 다음 연도 2월 말일, 원천징수대상 사업소득·근로소득·퇴직소득·종교인소득·봉사료는 다음 연도 3월 10일입니다. 일용근로소득은 지급한 달의 다음 달 말일이고, 휴업·폐업·해산하면 그 달의 다음다음 달 말일입니다(제164조 제1항).` },
  { q: "지급명세서를 안 내면 가산세는 얼마인가요?", a: `제출하지 않은 분의 지급금액의 ${pct(N.statementNone)}이고, 기한 후 3개월 안에 내면 ${pct(N.statementNoneWithin3m)}입니다. 내용이 불분명하거나 사실과 다르면 그 분의 ${pct(N.statementNone)}입니다(제81조의11 제1항). 산출세액이 없어도 붙습니다. 연간 ${eokwon(paid)} 지급분이면 ${won(statementPenalty(paid, "annual"))}입니다.` },
  { q: "지급명세서를 따로 안 내도 되는 경우가 있나요?", a: `세금계산서합계표·계산서합계표를 냈거나 전자(세금)계산서를 전송한 분 중 지급명세서에 해당하는 것은 낸 것으로 봅니다(제164조 제6항). 사업소득·인적용역 기타소득은 간이지급명세서를 낸 부분도 마찬가지입니다(제7항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>소득</th><th>2026년 지급분 제출기한</th></tr></thead>
    <tbody>
      <tr><th scope="row">이자·배당·연금·기타소득 등</th><td>2027년 2월 말일</td></tr>
      <tr><th scope="row">근로·퇴직소득, 원천징수대상 사업소득, 종교인소득, 봉사료</th><td>2027년 3월 10일</td></tr>
      <tr><th scope="row">일용근로소득</th><td>지급한 달의 다음 달 말일</td></tr>
      <tr><th scope="row">휴업·폐업·해산</th><td>그 달의 다음다음 달 말일(일용은 다음 달 말일)</td></tr>
    </tbody>
  </table>
  <p>기한이 토요일·공휴일이면 그다음 날입니다(국세기본법 제5조).</p>

  <AdSlot />

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    매달 내는 것은 <a href="/guide/simplified-payment-statement/">간이지급명세서</a>, 원천징수영수증은{" "}
    <a href="/guide/withholding-receipt/">원천징수영수증</a>에 있습니다.
  </p>
</GuideLayout>
