---
/**
 * "선납이연 계산기" — 적금 이자 시리즈. (적금 선납이연·선납이연 뜻·6-1-5 적금·선납이연 6-6·1-11 하는 법도 이 글, 계산기 포함)
 * 계산: src/lib/prepay-defer.ts prepayDefer() — 회차마다 약정일과 넣는 날의 차이, 순지연일수 ÷ 계약월수 = 만기 연장. 이자는 installmentSavings().
 * 근거: 적립식예금약관 제4조 ①③④·제7조 ③, 민법 제160조 ③ (rates: installment-savings-2026.json prepayDefer)
 * 2026-10-24 도구 담기 루틴(roberin #35) — 대조는 docs/calc-benchmark.md, 테스트 src/lib/__tests__/prepay-defer.test.ts
 * 프리셋 없음 — 자동완성(keywords/ac-prepay-defer-2026-10-24.csv)에 금액 줄기가 없고 묶음 줄기(6-1-5·6-6·1-11)는 납입 방식 버튼으로 씀.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/installment-savings-2026.json";
import { prepayDefer, koDate, type PrepayDeferResult } from "../../../lib/prepay-defer";
import { INTEREST_RATE, LOCAL_RATIO } from "../../../lib/deposit";
import { won } from "../../../lib/won";

const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const base = { start: "2026-01-10", months: 12, monthly: 500_000, ratePct: 3.5, method: "simple" } as const;
const run = (groups: number[], lastDate?: string) => prepayDefer({ ...base, groups, lastDate }) as PrepayDeferResult;
const ex = run([6, 1, 5]);
const six = run([6, 6]);
const sixLate = run([6, 6], "2027-01-09");
const one = run([1, 11]);
const n = (v: number) => v.toLocaleString("ko-KR");

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts).
const title = "선납이연 계산기 — 적금을 6-1-5·6-6·1-11로 나눠 넣으면 만기가 늦어지는지 날짜로 계산합니다";
const description =
  "선납이연 계산기는 정기적금을 몇 달치씩 미리·늦게 넣을 때 회차마다 선납일수와 지연일수, 순지연일수와 월평균 지연일수를 셈해 만기가 며칠 늦어지는지 보여 줍니다. 마지막 묶음을 언제까지 넣어야 만기가 그대로인지도 구하고, 이자는 매달 넣은 것과 같은 계약금액으로 계산합니다.";

const ANSWER = `${koDate(base.start)}에 가입한 12개월 적금을 6-1-5로 넣으면 1회차 날 6회분은 모두 ${n(ex.totalEarly)}일을 미리 넣은 셈입니다. 마지막 5회분을 ${koDate(ex.latestLastDate)}까지 넣으면 지연일수(${n(ex.totalLate)}일)가 선납일수를 넘지 않아 만기 ${koDate(ex.maturity)}이 그대로이고, 은행은 매달 넣은 것과 같은 계약금액을 줍니다(적립식예금약관 제4조 ③④). 월 50만원 연 3.5%면 세후 이자 ${won(ex.savings.netInterest)}입니다.`;

const QA = [
  { q: "선납이연이 뭔가요?", a: `정기적금 몇 회차를 약정일보다 먼저 넣고(선납) 몇 회차를 늦게 넣어(이연) 일찍 넣은 날수로 늦게 넣은 날수를 메우는 방법입니다. 약관은 총지연일수에서 총선납일수를 뺀 순지연일수가 남을 때만 입금지연이율로 셈한 돈을 빼거나 순지연일수를 계약월수로 나눈 일수만큼 만기를 늦춥니다(제4조 ③). 선납이 더 많으면 계약금액만 줍니다(제4조 ④).` },
  { q: "6-1-5, 6-6, 1-11은 어떻게 넣나요?", a: `숫자는 몇 회분씩 묶어 넣는지입니다. 6-1-5는 1회차 날 6회분, 7회차 날 1회분, 마지막에 5회분을 넣습니다. 6-6은 1회차 날 6회분을 넣고 나머지 6회분을 ${koDate(six.latestLastDate)}까지, 1-11은 1회분을 넣고 나머지 11회분을 ${koDate(one.latestLastDate)}까지 넣으면 순지연일수가 0 이하라 만기가 늦어지지 않습니다(${koDate(base.start)} 가입 12개월 기준).` },
  { q: "선납이연을 하면 이자를 더 받나요?", a: `아닙니다. 약관은 매달 약정일에 넣었을 때의 이자를 원금에 더한 계약금액을 주고, 선납일수가 지연일수보다 많아도 계약금액만 준다고 정합니다(제4조 ①④). 월 50만원 연 3.5% 12개월이면 어떤 순서로 넣어도 세전 이자 ${won(ex.savings.grossInterest)}, ${pct(INTEREST_RATE * (1 + LOCAL_RATIO))}를 떼고 ${won(ex.savings.netInterest)}입니다. 얻는 것은 돈을 늦게 넣는 동안 다른 데 둘 수 있는 기간입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.prepayDefer.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">매달 같은 날 같은 돈을 넣는 정기적금 기준입니다. 약정일·만기일은 가입일과 같은 날짜(그 날짜가 없는 달은 말일)로 봅니다. 자유적립식은 이 규칙이 적용되지 않고(약관 제7조 ③), 선납 허용 여부와 회차 수는 상품마다 다르니 가입한 은행 약관을 확인하세요.</p>
    <div class="calc-input-wrap">
      <label for="pd-start">가입일(1회차 날)</label>
      <input type="date" id="pd-start" value={base.start} />
    </div>
    <div class="calc-input-wrap">
      <label for="pd-months">계약 기간</label>
      <input type="number" id="pd-months" value={base.months} min="1" max="120" step="1" inputmode="numeric" data-step />
      <span class="unit">개월</span>
    </div>
    <div class="calc-input-wrap">
      <label for="pd-monthly">월 납입액</label>
      <input type="text" inputmode="numeric" id="pd-monthly" value={base.monthly.toLocaleString("ko-KR")} data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="pd-rate">연 이자율</label>
      <input type="number" id="pd-rate" value={base.ratePct} min="0" max="30" step="0.01" inputmode="decimal" />
      <span class="unit">%</span>
    </div>
    <div class="calc-input-wrap">
      <label for="pd-method">이자 방식</label>
      <select id="pd-method" data-seg>
        <option value="simple" selected>단리</option>
        <option value="monthly">월복리</option>
      </select>
    </div>
    <div class="calc-input-wrap">
      <label for="pd-pattern">나눠 넣기</label>
      <select id="pd-pattern" data-seg>
        <option value="6-1-5" selected>6-1-5</option>
        <option value="6-6">6-6</option>
        <option value="1-11">1-11</option>
        <option value="each">매달</option>
        <option value="custom">직접</option>
      </select>
    </div>
    <div class="calc-input-wrap" id="pd-custom-wrap" hidden>
      <label for="pd-custom">묶음(합 = 개월 수)</label>
      <input type="text" id="pd-custom" value="4-4-4" placeholder="예: 4-4-4" />
    </div>
    <div class="calc-input-wrap">
      <label for="pd-last">마지막 묶음 넣는 날</label>
      <input type="date" id="pd-last" value="" />
    </div>
    <p class="meta">마지막 묶음 날을 비워 두면 만기가 늦어지지 않는 가장 늦은 날로 계산합니다. 가운데 묶음은 그 묶음 첫 회차의 약정일에 넣는다고 봅니다.</p>
    <div
      class="result-hero"
      aria-live="polite"
      aria-atomic="true"
      data-bar="pd-early|pd-late"
      data-bar-labels="선납일수|지연일수"
      data-dock="pd-hero"
    >
      <p class="label">만기일</p>
      <p class="big" id="pd-hero">{koDate(ex.maturity)}</p>
      <p class="meta" id="pd-note">순지연일수가 0 이하라 만기가 늦어지지 않습니다 — 마지막 묶음을 {koDate(ex.latestLastDate)}까지 넣으면 됩니다</p>
    </div>
    <p class="meta" id="pd-error" role="alert" hidden></p>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">총선납일수</span><span class="value" id="pd-early">{n(ex.totalEarly)}일</span></div>
      <div class="stat-chip"><span class="label">총지연일수</span><span class="value" id="pd-late">{n(ex.totalLate)}일</span></div>
      <div class="stat-chip"><span class="label">순지연일수</span><span class="value" id="pd-net">{n(ex.net)}일</span></div>
      <div class="stat-chip"><span class="label">월평균 지연일수</span><span class="value" id="pd-avg">{ex.avgDelay}일</span></div>
      <div class="stat-chip"><span class="label">마지막 묶음 넣는 날</span><span class="value" id="pd-lastv">{koDate(ex.lastDate)}</span></div>
      <div class="stat-chip"><span class="label">만기 안 늦어지는 마지막 날</span><span class="value" id="pd-latest">{koDate(ex.latestLastDate)}</span></div>
      <div class="stat-chip"><span class="label">세전 이자</span><span class="value" id="pd-gross">{won(ex.savings.grossInterest)}</span></div>
      <div class="stat-chip"><span class="label">세금</span><span class="value" id="pd-tax">−{won(ex.savings.tax)}</span></div>
      <div class="stat-chip" data-group="만기에 받는 돈"><span class="label">넣은 돈</span><span class="value" id="pd-p">{won(ex.savings.principal)}</span></div>
      <div class="stat-chip"><span class="label">세후 이자</span><span class="value" id="pd-netint">{won(ex.savings.netInterest)}</span></div>
    </div>
    <p class="meta" id="pd-warn" hidden></p>

    <details>
      <summary>회차마다 약정일과 넣는 날</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>회차</th><th>약정일</th><th>넣는 날</th><th>선납</th><th>지연</th></tr></thead>
          <tbody id="pd-rows">
            {ex.rows.map((v) => <tr><th scope="row">{v.round}회</th><td>{v.due}</td><td>{v.paid}</td><td>{v.early ? `${v.early}일` : ""}</td><td>{v.late ? `${v.late}일` : ""}</td></tr>)}
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>선납일수는 약정일보다 며칠 먼저 넣었는지, 지연일수는 며칠 늦게 넣었는지를 회차마다 더한 값입니다. 입금지연이율은 은행이 영업점에 게시하는 이율이라 이 계산기는 빼는 금액을 셈하지 않고 만기를 늦추는 쪽만 보여 줍니다. 월평균 지연일수가 소수일 때 며칠로 처리하는지도 약관에 없어 버린 날과 올린 날을 함께 적습니다. 출처는 하나은행 적립식예금약관(확인 {r.prepayDefer.verifiedOn})입니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>마지막 묶음을 너무 늦게 넣으면 만기가 밀립니다. 같은 6-6이라도 나머지 6회분을 만기 전날({koDate(sixLate.lastDate)}) 넣으면 순지연일수 {n(sixLate.net)}일, 월평균 {sixLate.avgDelay}일이라 만기가 {koDate(sixLate.delayedFloor)}~{koDate(sixLate.delayedCeil)}로 늦어질 수 있습니다. 만기일까지 모든 회차를 넣지 않으면 중도해지이율이 적용될 수 있어(약관 제6조 ③) 마지막 묶음은 만기 전에 넣어야 합니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>실제 넣은 날로 이자를 다시 셈하는 계산기는 미리 넣은 회차에 이자를 더 붙여 이보다 많게 나오기도 하지만, 약관 기준으로는 계약금액이 상한입니다. 세금과 회차별 이자 계산은 <a href="/guide/installment-savings-calculator/">적금 이자 계산기</a>, 계산 순서는 <a href="/guide/installment-savings-interest/">적금 이자 계산</a>에 있습니다.</p>

  <script src="../../../scripts/prepay-defer.ts"></script>
</GuideLayout>
