---
/**
 * "퇴직금" — 퇴직금 한 편(조건·계산·지급기한). (퇴직금 계산 방법·계산법·공식·평균임금·얼마·조건·1년·주 15시간·5인 미만·알바·지급일·14일·지연이자·시효도 이 글)
 *
 * 2026-11-07 쪼갠 글 합치기 시범 — 퇴직금 조건(/guide/severance-pay-criteria/)·퇴직금 지급기한(/guide/severance-pay-deadline/)을
 * 이 글의 섹션으로 합치고 두 주소는 public/_redirects 로 이 글의 #criteria·#deadline 에 넘긴다.
 * 이유: 같은 '퇴직금' 질문을 얇은 3편으로 나눠 구글이 셋 다 색인하지 않았다(docs/superpowers/specs/2026-11-07-cta-redesign-design.md 진단).
 *
 * 근거: 근로자퇴직급여 보장법 제3조·제4조 제1항·제8조 제1항·제9조·제10조, 근로기준법 제2조 제1항 제6호·제2항·제36조·제37조 제1항 제1호,
 * 시행령 제17조·제18조, 고용노동부 퇴직금 계산 안내. 금액은 severancePayByDays()·severanceTax() 가 낸다(severance-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import Callout from "../../../components/Callout.astro";
import r from "../../../rates/severance-2026.json";
import { severancePayByDays, parseDate, oneYearServed, serviceDays } from "../../../lib/severance-pay";
import { severanceTax } from "../../../lib/severance";
import { won } from "../../../lib/won";

const B = r.pay.byDays;
const D = r.deadline;
const d = (s: string) => parseDate(s)!;
const ex = severancePayByDays({ start: d("2023-10-01"), lastWorkDay: d("2026-09-30"), wages3m: 9_000_000, annualBonus: 0, leavePay: 0, dailyOrdinary: 0, over15h: true });
const tax = severanceTax(ex.amount, 3);
const okDays = serviceDays(d("2025-01-01"), d("2025-12-31"));
const ok = oneYearServed(d("2025-01-01"), d("2025-12-31"));
const short = oneYearServed(d("2025-01-01"), d("2025-12-30"));
const pct = (v: number) => `${Math.round(v * 100)}%`;
/** 퇴직금 1천만원을 30일 늦게 받으면 — 연 20% 일할 */
const late = Math.floor((10_000_000 * D.lateInterest * 30) / 365);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 severance-pay-series.test.ts 가 rates 와 대조한다.
const title = "퇴직금 — 1년·주 15시간이면 받고, 1일 평균임금 × 30일 × 재직일수 ÷ 365, 퇴직 후 14일 안에";
const description =
  "퇴직금은 계속근로 1년 이상·4주 평균 주 15시간 이상이면 5명 미만 사업장·아르바이트도 받습니다. 1일 평균임금 × 30일 × 재직일수 ÷ 365로 계산하고, 퇴직한 날부터 14일 안에 받아야 하며 늦으면 지연이자가 붙습니다.";

const ANSWER = `퇴직금은 계속근로 1년 이상·4주 평균 주 15시간 이상이면 받고(근로자퇴직급여 보장법 제4조), 1일 평균임금 × ${r.pay.daysPerYear}일 × 재직일수 ÷ ${B.daysInYear}로 계산합니다. 월 300만원을 받고 3년 일했다면 약 ${won(ex.amount)}입니다.`;

const QA = [
  { q: "퇴직금 조건은 무엇인가요?", a: `계속근로기간 1년 이상과 4주 평균 1주 소정근로시간 15시간 이상 두 가지입니다(제4조 제1항). 근로자를 쓰는 모든 사업장에 적용되므로 5명 미만 사업장도 같고, 동거하는 친족만 쓰는 사업과 가구 내 고용만 빠집니다(제3조). 아르바이트·계약직도 고용 형태와 상관없이 두 조건만 봅니다.` },
  { q: "퇴직금 1년은 정확히 언제 채워지나요?", a: `퇴직일(마지막 근무일 다음 날)이 입사일의 1년 뒤 같은 날 이후면 1년입니다. 2025년 1월 1일 입사라면 2025년 12월 31일까지 일해야 재직일수 ${okDays}일로 1년이 ${ok ? "됩니다" : "안 됩니다"}. 12월 30일이 마지막 근무일이면 ${short ? "1년입니다" : "하루 모자라 1년 미만"}입니다.` },
  { q: "퇴직금 계산 방법을 순서대로 알려 주세요.", a: `① 재직일수 = 입사일부터 마지막 근무일까지 날수 ② 퇴직일(마지막 근무일 다음 날) 전 3개월 임금 총액 ÷ 그 기간 날수 = 1일 평균임금 ③ 1일 평균임금 × ${r.pay.daysPerYear} × 재직일수 ÷ ${B.daysInYear}입니다. 2023년 10월 1일 입사·2026년 9월 30일 퇴사, 3개월 임금 900만원이면 ${ex.serviceDays.toLocaleString()}일, ${ex.period.days}일로 나눠 ${won(ex.amount)}입니다.` },
  { q: "평균임금에는 무엇이 들어가나요?", a: `퇴직 전 3개월 동안 받은 세전 임금 전부입니다. 기본급·각종 수당에 더해 1년 동안 받은 상여금의 3/12, 퇴직 전에 이미 생긴 연차 중 못 쓴 날의 수당의 3/12을 더합니다(고용노동부). 이렇게 낸 금액이 1일 통상임금보다 적으면 통상임금을 평균임금으로 봅니다(근로기준법 제2조 제2항).` },
  { q: "퇴직금은 언제까지 받아야 하나요?", a: `퇴직한 날(지급사유 발생일)부터 ${D.days}일 안에 지급해야 합니다(제9조 제1항). 특별한 사정이 있으면 당사자 합의로 기일을 늦출 수 있지만, 사용자가 일방적으로 늦출 수는 없습니다. 퇴직금은 원칙적으로 근로자의 IRP 계정으로 이전하는 방법으로 줍니다(제9조 제2항).` },
  { q: "퇴직금을 늦게 주거나 못 받으면 어떻게 되나요?", a: `${D.days}일이 되는 날까지 주지 않으면 그다음 날부터 연 ${pct(D.lateInterest)} 지연이자가 붙습니다(근로기준법 제37조 제1항 제1호, 시행령 제17조). 1천만원을 30일 늦게 받으면 약 ${won(late)}입니다. 퇴직금을 받을 권리는 ${r.pay.limitationYears}년간 행사하지 않으면 시효로 사라집니다(제10조).` },
];
---

<GuideLayout title={title} description={description} updated={r.pay.byDays.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2 id="criteria">{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>주 15시간이 안 되는 짧은 근무만 했거나 1년을 못 채우면 회사가 퇴직급여제도를 둘 의무가 없습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <Callout icon="📅">날짜만 넣으면 1년이 됐는지와 금액을 함께 보여 주는 <a href="/guide/severance-pay-calculator/">퇴직금 계산기</a>가 있습니다.</Callout>

  <h2 id="calc">{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>실수령액이 아니라 세금·4대보험을 떼기 전 금액을 넣습니다. 퇴직하면서 새로 생긴 연차수당은 평균임금에 넣지 않습니다. 수습·휴업·육아휴직 같은 기간이 3개월 안에 끼어 있으면 그 기간과 임금을 빼고 계산하는 규정(근로기준법 시행령 제2조)이 있어 회사 정산표와 차이가 날 수 있습니다.</p>

  <AdSlot />

  <h2 id="deadline">{QA[4].q}</h2>
  <p class="qa-lead">{QA[4].a}</p>
  <p>임금·보상금 등 다른 금품도 같은 {D.days}일입니다(근로기준법 제36조).</p>

  <h2>{QA[5].q}</h2>
  <p class="qa-lead">{QA[5].a}</p>
  <p>
    지연이자 제외 사유는 임금채권보장법상 도산 등, 법령상 자금 확보가 어려운 경우, 퇴직금의 존재 여부를 법원이나
    노동위원회에서 다투는 것이 적절한 경우 등입니다(근로기준법 시행령 제18조).
  </p>
  <p>받은 퇴직금에는 퇴직소득세가 붙습니다. 위 예시 {won(ex.amount)}·근속 3년이면 지방소득세까지 {won(tax.total)}입니다 — <a href="/guide/severance-tax-calculator/">퇴직금 세금 계산기</a>.</p>
</GuideLayout>
