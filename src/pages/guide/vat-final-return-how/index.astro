---
/**
 * "부가세 확정신고 방법" — 부가세 확정신고 시리즈. (확정신고서·발급·발급 방법·출력도 이 글)
 * 조문이 말하는 방법만 쓴다: 무엇을(과세표준·납부/환급세액), 어디에(사업장 관할 세무서),
 * 무엇과 함께(세금계산서합계표), 어떻게 내는지(신고서와 함께 또는 납부서로 한국은행등).
 * 홈택스 화면과 신고서 출력은 조문 밖이라 절로만 둔다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import vf from "../../../rates/vat-final-2026.json";
import vp from "../../../rates/vat-penalty-2026.json";
import { won } from "../../../lib/won";

const pct = (x: number) => `${Math.round(x * 1000) / 10}%`;

const title = "부가세 확정신고 방법 — 사업장 관할 세무서에 신고서와 합계표를 냅니다";
const description =
  "부가세 확정신고 방법은 과세기간의 과세표준과 납부·환급세액을 사업장 관할 세무서에 신고하고, 세금계산서합계표를 함께 내고, 세금을 납부하는 것입니다. 직접 전자신고하면 5천원을 공제받습니다.";

const ANSWER = `과세기간의 과세표준과 납부세액(또는 환급세액)을 사업장 관할 세무서에 신고하고 세금을 냅니다. 세금계산서를 주고받았다면 매출·매입처별 합계표를 함께 내야 하고, 직접 전자신고하면 ${won(vf.eFilingCredit.amount)}을 공제받습니다.`;

const QA = [
  { q: "부가세 확정신고는 어떻게 하나요?", a: "과세기간에 대한 과세표준과 납부세액 또는 환급세액을 납세지 관할 세무서장에게 신고하고(부가가치세법 제49조 제1항), 그 세금을 신고서와 함께 세무서에 내거나 납부서로 한국은행 등에 냅니다(같은 조 제2항)." },
  { q: "부가세 확정신고는 어느 세무서에 하나요?", a: "사업장 관할 세무서입니다. 부가가치세 납세지는 각 사업장의 소재지이고(제6조 제1항), 사업장이 없으면 주소나 거소가 사업장입니다. 사업장이 여럿이면 원칙적으로 사업장마다 신고합니다." },
  { q: "부가세 확정신고 때 함께 내야 하는 서류는 무엇인가요?", a: `매출·매입처별 세금계산서합계표입니다. 내지 않으면 공급가액의 ${pct(vp.salesList.notSubmitted)}가 가산세로 붙고, 예정신고 때 못 내 확정신고 때 낸 매출처별 합계표는 ${pct(vp.salesList.lateAtFinalReturn)}입니다(제60조 제6항).` },
  { q: "부가세 확정신고서는 어떻게 발급받나요?", a: "확정신고서는 따로 발급받는 증명서가 아니라 내가 세무서에 낸 신고서 자체입니다. 사본이 필요하면 신고한 경로(전자신고라면 신고 내역)에서 출력하고, 세무서가 확인해 주는 증명서는 별도의 민원입니다." },
];
---

<GuideLayout title={title} description={description} updated={vf.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ol>
    <li><strong>과세기간을 확인한다</strong> — 일반과세자는 6개월(예정신고했다면 남은 3개월), 간이과세자는 1년</li>
    <li><strong>매출세액과 매입세액을 맞춘다</strong> — 주고받은 세금계산서를 거래처별로 정리</li>
    <li><strong>신고서와 합계표를 낸다</strong> — 기한은 과세기간이 끝난 뒤 25일</li>
    <li><strong>낸 세금에서 뺄 것을 뺀다</strong> — {vf.final.deductOnPayment.join(", ")}({vf.final.deductArticle})</li>
    <li><strong>납부하거나 환급을 기다린다</strong></li>
  </ol>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    {vp.salesList.note} 간이과세자도 신고할 때 합계표를 함께 냅니다(제67조 제3항).
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    홈택스의 신고서 조회·출력 화면은 조문 밖이고 자주 바뀌어 다루지 않습니다.
    신고 자체를 직접 전자신고로 하면 공제가 붙습니다 —{" "}
    <a href="/guide/vat-e-filing-credit/">부가세 전자신고세액공제</a>.
  </p>

  <h2>이 글에 없는 것</h2>
  <ul>
    <li><strong>신고서 서식과 그 밖의 첨부서류 목록</strong> — 시행령과 시행규칙에 있고 읽지 않았습니다.</li>
    <li><strong>부가가치세 과세표준증명 등 민원증명</strong>의 근거</li>
  </ul>
</GuideLayout>
