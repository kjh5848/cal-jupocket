---
/**
 * "종합소득세 환급" — 세금 환급 시리즈. (종소세 환급·3.3% 프리랜서·환급 신청·경정청구·기한 후 신고도 이 글)
 * 근거: 소득세법 제70조(5월 확정신고, 결손금이 있어도 신고)·제85조 제4항(기납부세액 > 총결정세액이면 환급·충당),
 * 국세기본법 제45조의2(경정청구 5년)·제45조의3(기한 후 신고) — refund-2026.json.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/tax-refund-2026.json";
import rf from "../../../rates/refund-2026.json";
import { estimateRefund } from "../../../lib/income-tax";
import { won, eokwon } from "../../../lib/won";

const gross = 20_000_000;
const ex = estimateRefund({ grossIncome: gross, expenseRate: 0.6, dependents: 1 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 tax-refund-series.test.ts 가 rates 와 대조한다.
const title = "종합소득세 환급 — 미리 뗀 3.3%가 결정세액보다 많으면 5월 신고로 돌려받습니다";
const description =
  "종합소득세 환급은 프리랜서처럼 3.3%를 미리 떼였거나 중간예납을 낸 사람이 5월 확정신고 때 1년 결정세액을 계산해 이미 낸 세금이 더 많으면 그 차이를 돌려받는 것입니다. 신고하지 않으면 환급도 없고, 놓쳤다면 기한 후 신고나 5년 안의 경정청구로 받습니다.";

const ANSWER = `종합소득세 환급은 원천징수(3.3% 등)·중간예납으로 낸 세금이 1년 종합소득 총결정세액보다 많을 때 그 초과분을 돌려받는 것입니다(소득세법 제85조 제4항). 다음 해 5월 확정신고로 계산하고(제70조), 놓쳤다면 기한 후 신고나 ${rf.correctionClaim.withinYears}년 안의 경정청구로 받습니다.`;

const QA = [
  { q: "종합소득세 환급은 누가 받나요?", a: `원천징수·중간예납 등으로 이미 낸 세액이 종합소득 총결정세액을 넘는 사람입니다(제85조 제4항). 수입이 적고 경비가 많은 프리랜서, 결손이 난 사업자처럼 3.3%로 미리 뗀 세금이 실제 세금보다 많은 경우가 대표적입니다. 세무서는 초과분을 환급하거나 다른 국세에 충당합니다.` },
  { q: "종합소득세 환급은 신청해야 받나요?", a: `5월 1일부터 31일까지 종합소득세 확정신고를 해야 계산됩니다(제70조 제1항). 결손금이 있어도 신고 대상입니다. 신고서에서 환급세액이 계산되면 세무서가 즉시 국세환급금으로 결정합니다(국세기본법 제51조 제1항). 신고하지 않으면 이 계산이 시작되지 않습니다.` },
  { q: "3.3% 프리랜서는 환급을 얼마나 받나요?", a: `연 총수입 ${eokwon(gross)}, 단순경비율 60%로 가정하고 본인 공제만 받으면 결정세액 ${won(ex.computedTax)}에 지방소득세 ${won(ex.localTax)}을 더한 ${won(ex.totalTax)}보다 미리 뗀 세금(3.3%) ${won(ex.prepaid)}이 많아 차이 ${won(ex.refund)}을 돌려받는 어림입니다. 업종별 경비율과 공제에 따라 달라집니다.` },
  { q: "환급 신고 기간을 놓쳤다면 어떻게 하나요?", a: `아예 신고하지 않았다면 세무서가 결정·통지하기 전까지 기한 후 신고를 할 수 있고(국세기본법 제45조의3), 신고는 했지만 환급을 덜 받았다면 법정신고기한 후 ${rf.correctionClaim.withinYears}년 안에 경정청구를 합니다(제45조의2). 경정청구에는 ${rf.correctionClaim.replyWithinMonths}개월 안에 답이 옵니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    경비율 60%는 계산 예시를 위한 가정입니다. 내 업종으로 계산하려면 <a href="/income-tax-refund/">종소세 환급 예상 계산기</a>와{" "}
    <a href="/guide/expense-rate/">단순경비율</a>을 보세요.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    기한 후 신고 환급은 <a href="/guide/late-filing-refund/">기한후신고 환급</a>, 들어오는 시기는{" "}
    <a href="/guide/income-tax-refund-date/">종합소득세 환급일</a>에 있습니다.
  </p>
</GuideLayout>
