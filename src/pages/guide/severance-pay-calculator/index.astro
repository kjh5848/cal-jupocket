---
/**
 * "퇴직금 계산기" — 퇴직금 계산 시리즈. (퇴직금 계산·자동 계산·모의계산·예상 퇴직금·평균임금 계산기도 이 글, 계산기 포함)
 * 계산: src/lib/severance-pay.ts severancePayByDays() — 근로자퇴직급여 보장법 제4조 제1항·제8조 제1항, 근로기준법 제2조 제1항 제6호·제2항,
 * 고용노동부 퇴직금 계산 안내(재직일수/365·상여 3/12·퇴직일 = 마지막 근무일 다음 날). rates: severance-2026.json pay
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/severance-2026.json";
import { severancePayByDays, parseDate } from "../../../lib/severance-pay";
import { won } from "../../../lib/won";

const B = r.pay.byDays;
const d = (s: string) => parseDate(s)!;
const ymd = (x: Date) => `${x.getFullYear()}. ${x.getMonth() + 1}. ${x.getDate()}.`;
const base = { annualBonus: 0, leavePay: 0, dailyOrdinary: 0, over15h: true };
const ex = severancePayByDays({ ...base, start: d("2023-10-01"), lastWorkDay: d("2026-09-30"), wages3m: 9_000_000 });
const bonus = severancePayByDays({ ...base, start: d("2023-10-01"), lastWorkDay: d("2026-09-30"), wages3m: 9_000_000, annualBonus: 4_000_000 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 severance-pay-series.test.ts 가 rates 와 대조한다.
const title = "퇴직금 계산기 — 입사일·마지막 근무일·3개월 임금만 넣으면 법정 퇴직금이 나옵니다";
const description =
  "퇴직금 계산기는 입사일과 마지막 근무일로 재직일수를, 퇴직 전 3개월 임금으로 1일 평균임금을 구해 1일 평균임금 × 30일 × 재직일수 ÷ 365로 퇴직금을 계산합니다. 상여금·연차수당은 4분의 1을 더하고, 1일 통상임금이 더 크면 통상임금으로 계산합니다.";

const ANSWER = `퇴직금 계산기는 1일 평균임금 × 30일 × 재직일수 ÷ 365로 계산합니다(근로자퇴직급여 보장법 제8조, 고용노동부 산정 방법). 월 300만원을 받다 3년(${ex.serviceDays.toLocaleString()}일) 일하고 그만두면 퇴직금은 약 ${won(ex.amount)}입니다.`;

const QA = [
  { q: "퇴직금 계산 예시를 보여 주세요.", a: `${ymd(d("2023-10-01"))} 입사, ${ymd(d("2026-09-30"))}까지 일했다면 퇴직일은 다음 날인 ${ymd(ex.retireDate)}, 재직일수는 ${ex.serviceDays.toLocaleString()}일입니다. 퇴직 전 3개월(${ex.period.days}일) 임금 900만원을 ${ex.period.days}로 나눈 1일 평균임금 약 ${won(Math.floor(ex.average))}에 30일을 곱하고 ${ex.serviceDays.toLocaleString()}/365를 곱하면 ${won(ex.amount)}입니다.` },
  { q: "상여금과 연차수당은 어떻게 넣나요?", a: `최근 1년 동안 받은 상여금 총액의 3/12을 3개월 임금에 더합니다. 연 400만원이면 100만원이 더해져 위 예시의 퇴직금이 ${won(bonus.amount)}으로 늘어납니다. 연차수당은 퇴직 전에 이미 생겨 있던(전년도분) 못 쓴 연차의 수당만 3/12을 더하고, 퇴직하면서 새로 생긴 연차수당은 넣지 않습니다(고용노동부).` },
  { q: "1년이 안 되면 계산 결과는 어떻게 보나요?", a: `계속근로기간 1년 미만이거나 4주 평균 주 소정근로시간이 15시간 미만이면 법정 퇴직금 대상이 아닙니다(근로자퇴직급여 보장법 제4조 제1항). 계산기는 금액을 참고로 보여 주되 '대상 아님'을 함께 표시합니다. 회사 규정으로 더 주는 것은 별개입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.pay.byDays.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">세금 떼기 전 법정 퇴직금 어림입니다. 평균임금에서 빼는 기간(수습·휴업·육아휴직 등, 근로기준법 시행령 제2조)과 퇴직연금(DB·DC) 지급액은 넣지 않았습니다. 1일 평균임금은 끊지 않고 최종 금액만 원 미만을 버립니다.</p>
    <div class="calc-input-wrap">
      <label for="sp-start">입사일</label>
      <input type="date" id="sp-start" value="2023-10-01" min="1980-01-01" max="2027-12-31" />
    </div>
    <div class="calc-input-wrap">
      <label for="sp-last">마지막 근무일(퇴직일은 다음 날)</label>
      <input type="date" id="sp-last" value="2026-09-30" min="1980-01-01" max="2027-12-31" />
    </div>
    <div class="calc-input-wrap">
      <label for="sp-wages">퇴직 전 3개월 임금 총액(세전)</label>
      <input type="text" inputmode="numeric" id="sp-wages" value="9,000,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="sp-bonus">최근 1년 상여금 총액</label>
      <input type="text" inputmode="numeric" id="sp-bonus" value="0" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="sp-leave">퇴직 전에 이미 생긴 연차 중 못 쓴 날의 수당</label>
      <input type="text" inputmode="numeric" id="sp-leave" value="0" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="sp-ordinary">1일 통상임금(모르면 0)</label>
      <input type="text" inputmode="numeric" id="sp-ordinary" value="0" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="sp-hours">4주 평균 주 소정근로시간</label>
      <select id="sp-hours" data-seg>
        <option value="1" selected>15시간 이상</option>
        <option value="0">15시간 미만</option>
      </select>
    </div>
    <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="sp-hero">
      <p class="label">예상 퇴직금(세전)</p>
      <p class="big" id="sp-hero">{won(ex.amount)}</p>
      <p class="meta" id="sp-status">법정 퇴직금 대상 — 계속근로 1년 이상 · 주 15시간 이상</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">재직일수</span><span class="value" id="sp-days">{ex.serviceDays.toLocaleString()}일</span></div>
      <div class="stat-chip"><span class="label">퇴직일</span><span class="value" id="sp-retire">{ymd(ex.retireDate)}</span></div>
      <div class="stat-chip"><span class="label">평균임금 기간</span><span class="value" id="sp-period">{ymd(ex.period.from)} ~ {ymd(ex.period.to)} ({ex.period.days}일)</span></div>
      <div class="stat-chip" data-group="3개월 임금"><span class="label">3개월 임금</span><span class="value" id="sp-w">{won(9_000_000)}</span></div>
      <div class="stat-chip"><span class="label">상여금 3/12</span><span class="value" id="sp-badd">{won(0)}</span></div>
      <div class="stat-chip"><span class="label">연차수당 3/12</span><span class="value" id="sp-ladd">{won(0)}</span></div>
      <div class="stat-chip"><span class="label">1일 평균임금(원 미만 생략)</span><span class="value" id="sp-avg">{won(Math.floor(ex.average))}</span></div>
      <div class="stat-chip"><span class="label">적용 1일 임금</span><span class="value" id="sp-applied">{won(Math.floor(ex.applied))}</span></div>
    </div>
    <p class="meta">3개월 임금 + 상여금·연차수당의 3/12을 평균임금 기간의 날수로 나누면 1일 평균임금입니다(근로기준법 제2조 제1항 제6호). 1일 통상임금이 더 크면 그 값으로 바꿉니다(같은 조 제2항). 여기에 30일 × 재직일수 ÷ 365를 곱합니다.</p>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>평균임금 기간은 퇴직일 3개월 전 날부터 마지막 근무일까지입니다. 그 달에 같은 날이 없으면 그 달 말일부터 셉니다. 2월 28일이 마지막 근무일이면 퇴직일은 3월 1일, 기간은 12월 1일~2월 28일로 90일입니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    퇴직금이 나오는지는 <a href="/guide/severance-pay-criteria/">퇴직금 조건</a>, 계산 순서는{" "}
    <a href="/guide/severance-pay/">퇴직금</a>, 받은 퇴직금에 붙는 세금은 <a href="/guide/severance-tax-calculator/">퇴직금 세금 계산기</a>에 있습니다.
  </p>

  <script src="../../../scripts/severance-pay.ts"></script>
</GuideLayout>
