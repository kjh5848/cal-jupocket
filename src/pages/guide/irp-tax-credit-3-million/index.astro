---
/**
 * "irp 세액공제 300만원" — IRP 세액공제 시리즈.
 * 300만원은 연금저축 600만원을 채운 사람이 IRP로 메울 남은 칸이다.
 * 반전: 연금저축이 600만원 미만이면 IRP에 300만원보다 더 넣어도 공제된다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import pa from "../../../rates/pension-account-2026.json";
import { won, manwon } from "../../../lib/won";
import { pensionCredit } from "../../../lib/pension-credit";

const combo = pensionCredit({ savings: 6_000_000, irp: 3_000_000 }, true);
const only300 = pensionCredit({ savings: 0, irp: 3_000_000 }, true);
const mix = pensionCredit({ savings: 4_000_000, irp: 5_000_000 }, true);
const over = pensionCredit({ savings: 8_000_000, irp: 1_000_000 }, true);

const title = "IRP 세액공제 300만원 — 연금저축 600만원을 채운 사람의 남은 칸";
const description =
  "IRP 300만원은 연금저축 600만원을 채운 사람이 900만원 한도를 마저 채우는 금액입니다. 둘을 합치면 15% 구간 기준 148만 5천원이 돌아옵니다. 연금저축이 600만원보다 적으면 IRP에 더 넣어도 됩니다.";

const ANSWER = `연금저축에 ${manwon(pa.savingsOnlyLimit)}을 채웠다면 IRP에 ${manwon(3_000_000)}을 더 넣어야 공제 한도 ${manwon(pa.combinedLimit)}이 찹니다. 15% 구간이면 둘을 합쳐 ${manwon(combo.withLocal)}이 세금에서 빠집니다.`;

const QA = [
  { q: "IRP 세액공제 300만원은 무슨 뜻인가요?", a: `연금저축 공제 한도 ${manwon(pa.savingsOnlyLimit)}과 연금저축+IRP 합산 한도 ${manwon(pa.combinedLimit)}의 차이입니다. 연금저축을 다 채운 사람은 IRP에 ${manwon(3_000_000)}만 더 넣으면 한도를 다 씁니다.` },
  { q: "IRP에 300만원만 넣으면 얼마 돌려받나요?", a: `IRP ${manwon(3_000_000)}만 넣고 연금저축이 없으면 공제 대상은 ${manwon(3_000_000)}입니다. 15% 구간이면 지방소득세 포함 ${manwon(only300.withLocal)}이 줄어듭니다.` },
  { q: "연금저축이 600만원보다 적으면 IRP에 더 넣어도 되나요?", a: `됩니다. 연금저축 ${manwon(4_000_000)} + IRP ${manwon(5_000_000)}이면 공제 대상은 ${manwon(mix.eligible)}입니다. IRP는 합산 한도 안에서 연금저축이 비운 자리를 다 채울 수 있습니다.` },
  { q: "연금저축에 600만원보다 많이 넣으면 어떻게 되나요?", a: `${manwon(pa.savingsOnlyLimit)}을 넘긴 몫은 공제에서 빠집니다. 연금저축 ${manwon(8_000_000)} + IRP ${manwon(1_000_000)}이면 공제 대상은 ${manwon(over.eligible)}뿐입니다. 넘긴 ${manwon(2_000_000)}을 IRP로 돌렸다면 ${manwon(pa.combinedLimit)}이 됐습니다.` },
];
---

<GuideLayout title={title} description={description} updated={pa.taxCreditVerifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>
    조문은 "연금저축계좌에 납입한 금액 중 600만원 이내의 금액과 퇴직연금계좌에
    납입한 금액을 합한 금액이 연 900만원을 초과하면 그 초과하는 금액은 없는
    것으로 한다"고 씁니다(소득세법 제59조의3 제1항 단서). 300만원은 이 두 숫자
    사이에서 나옵니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <table>
    <thead>
      <tr><th>연금저축</th><th>IRP</th><th>공제 대상</th><th>15% 구간 환급</th></tr>
    </thead>
    <tbody>
      <tr><td>{won(6_000_000)}</td><td>{won(3_000_000)}</td><td>{won(combo.eligible)}</td><td>{won(combo.withLocal)}</td></tr>
      <tr><td>{won(4_000_000)}</td><td>{won(5_000_000)}</td><td>{won(mix.eligible)}</td><td>{won(mix.withLocal)}</td></tr>
      <tr><td>{won(8_000_000)}</td><td>{won(1_000_000)}</td><td>{won(over.eligible)}</td><td>{won(over.withLocal)}</td></tr>
      <tr><td>0원</td><td>{won(3_000_000)}</td><td>{won(only300.eligible)}</td><td>{won(only300.withLocal)}</td></tr>
    </tbody>
  </table>
  <p>
    순서는 정해져 있지 않습니다. 어느 계좌에 먼저 넣든 연말 기준 합계로
    셉니다. 연금저축과 IRP의 차이는{" "}
    <a href="/guide/pension-savings-tax-credit/">연금저축 IRP 세액공제</a>에
    있습니다.
  </p>
</GuideLayout>
