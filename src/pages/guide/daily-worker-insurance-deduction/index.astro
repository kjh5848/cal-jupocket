---
/**
 * "일용직 4대보험 공제" — 4대보험 시리즈. (일용직 고용보험 공제·일용직 건강보험 공제·일용직 국민연금 금액·일용직 4대보험 요율도 이 글)
 * 자동완성(keywords/ac-daily-worker-insurance-2026-10-19.csv): 일용직 4대보험 공제·요율·계산기, 일용직 고용보험 공제·계산·요율,
 * 일용직 건강보험 공제·건강보험료 계산, 일용직 국민연금 계산·금액. 금액 줄기(일당 15만원·20만원 4대보험)는 확장 0건.
 * 근거: 국민연금법 시행령 제2조 제1호, 국민건강보험법 제6조 ②·시행령 제9조, 고용보험법 시행령 제3조 ②, 보험료징수법 제13조 —
 * 계산은 src/lib/daily-worker-insurance.ts(rates: four-insurance-2026.json).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/four-insurance-2026.json";
import { dailyWorkerInsurance } from "../../../lib/daily-worker-insurance";
import { pensionRate, careRatio } from "../../../lib/four-insurance";
import { won } from "../../../lib/won";

const D = r.daily;
const pct = (v: number) => `${+(v * 100).toFixed(4)}%`;
const ew = r.employment.unemployment * r.employment.workerShare;
const hw = r.health.rate * r.health.employeeShare;
const wages = [100_000, 130_000, 150_000, 200_000, 250_000];
const rows = wages.map((w) => ({
  w,
  day: Math.floor(w * ew + 1e-6),
  m: dailyWorkerInsurance({ dayWage: w, days: 20, hours: 8, monthOrMore: true }),
}));
const ex = rows[2].m;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 daily-worker-insurance-series.test.ts 가 rates 와 대조한다.
const title = "일용직 4대보험 공제 — 고용보험 0.9%는 늘 떼고, 1개월 이상·월 8일이면 국민연금 4.75%와 건강보험 3.595%가 붙습니다";
const description =
  "일용직 4대보험 공제는 일당에서 고용보험 0.9%를 떼는 것이 기본입니다. 1개월 이상 이어 일하면서 한 달 8일 이상(일반 사업장은 60시간 이상도) 일하면 국민연금 4.75%가, 1개월 이상이고 한 달 60시간 이상이면 건강보험 3.595%와 장기요양보험료가 더해집니다.";

const ANSWER = `일용직 4대보험 공제는 일당 × 고용보험 ${pct(ew)}가 기본입니다(일당 15만원이면 하루 ${won(rows[2].day)}). 1개월 이상 이어 일하며 한 달 ${D.pensionMinDays}일 이상이면 국민연금 ${pct(pensionRate())}, ${D.healthMinHours}시간 이상이면 건강보험 ${pct(hw)}·장기요양보험료가 붙어 일당 15만원 × 20일이면 ${won(ex.insurance)}입니다.`;

const QA = [
  { q: "일용직 고용보험 공제는 얼마인가요?", a: `일당 × ${pct(ew)}입니다. 실업급여 보험료율 1.8%를 근로자와 사업주가 반씩 내기 때문입니다(보험료징수법 제13조). 일용근로자는 근로시간과 관계없이 고용보험이 적용되어 하루만 일해도 떼고, 65세 이후 새로 고용된 사람은 이 보험료가 없습니다.` },
  { q: "일용직 국민연금 금액은 어떻게 계산하나요?", a: `한 달 일당 합계(기준소득월액, 천원 미만 버림) × ${pct(pensionRate())}이고 10원 미만은 버립니다. 1개월 이상 계속 일하며 한 달 ${D.pensionMinDays}일 이상, 건설 현장이 아니면 ${D.pensionMinHours}시간 이상 일한 달에 뗍니다(국민연금법 시행령 제2조). 한 달 합계가 하한보다 적으면 하한액으로 계산합니다.` },
  { q: "일용직 건강보험 공제는 언제부터 하나요?", a: `고용 기간이 1개월 이상일 때입니다. 1개월 미만 일용근로자와 한 달 근로시간 ${D.healthMinHours}시간 미만 단시간근로자는 직장가입자에서 빠집니다(국민건강보험법 제6조, 시행령 제9조). 직장가입자가 되면 한 달 보수 × ${pct(hw)}와 그 건강보험료의 약 ${(careRatio() * 100).toFixed(2)}%인 장기요양보험료를 뗍니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.daily.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <caption>일당별 공제 — 1개월 이상 계속, 이번 달 20일 × 8시간, 18세 이상 60세 미만(원 미만 버림)</caption>
    <thead><tr><th>일당</th><th>하루 고용보험</th><th>국민연금</th><th>건강 + 장기요양</th><th>고용보험</th><th>한 달 4대보험</th></tr></thead>
    <tbody>
      {rows.map(({ w, day, m }) => (
        <tr><th scope="row">{won(w)}</th><td>{won(day)}</td><td>{won(m.pension)}</td><td>{won(m.health + m.care)}</td><td>{won(m.employment)}</td><td>{won(m.insurance)}</td></tr>
      ))}
    </tbody>
  </table>
  <p>일용직 소득세(15만원 넘는 부분의 2.7%)는 이 표에 넣지 않았습니다. 세금까지 뺀 금액은 <a href="/guide/daily-worker-insurance-calculator/">일용직 4대보험 계산기</a>에서 볼 수 있습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>시행령은 한 달 소득이 보건복지부 고시 금액 이상인 경우도 포함한다고 정하지만, 그 고시 금액은 이 글에서 원문으로 확인하지 못했습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>보험별 가입 기준 표는 <a href="/guide/daily-worker-insurance/">일용직 4대보험</a>에, 고용보험 요율 전체는 <a href="/guide/employment-insurance-premium/">고용보험료</a>에 있습니다.</p>
</GuideLayout>
