---
/**
 * "가상자산 과세 유예" — 코인 세금 시리즈. (코인 세금 유예·유예 가능성·확정·내년 코인 세금·폐지·2027 시행도 이 글)
 * 근거: 소득세법 부칙(법률 제17757호, 2020. 12. 29.) 제5조 — 적용 시기 <개정 2021. 12. 8., 2022. 12. 31., 2024. 12. 31.>,
 * 조문별 [시행일: 2027. 1. 1.] 표시, 지방세법 부칙 제6조. rates: crypto-2026.json
 * 계류 중인 법안의 내용·처리 전망은 법령 원문이 아니라서 다루지 않는다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/crypto-2026.json";
import { eokwon } from "../../../lib/won";

const pct = (v: number) => `${Math.round(v * 100)}%`;
const total = pct(r.rate + r.localRate);
const fmt = (d: string) => { const [y, m, dd] = d.split("-").map(Number); return `${y}년 ${m}월 ${dd}일`; };

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 crypto-series.test.ts 가 rates 와 대조한다.
const title = "가상자산 과세 유예 — 지금 법은 2027년 1월 1일 시행이고, 적용 시기는 세 번 미뤄졌습니다";
const description =
  "가상자산 과세는 현행 소득세법 부칙상 2027년 1월 1일 이후 양도·대여분부터 적용됩니다. 이 적용 시기는 2021년 12월, 2022년 12월, 2024년 12월 세 번 개정돼 미뤄졌고, 다시 바꾸려면 국회가 부칙을 또 개정해야 합니다. 개정 전까지는 2027년 시행이 법입니다.";

const ANSWER = `현행 소득세법은 2027년 1월 1일 이후 가상자산을 양도·대여하는 분부터 과세합니다(부칙 법률 제17757호 제5조). 이 적용 시기는 ${r.delays.map(fmt).join(", ")} 세 번 개정돼 미뤄졌습니다. 다시 미루거나 없애려면 국회가 법을 또 개정해야 하고, 그 전까지는 2027년 시행이 현행 법입니다.`;

const QA = [
  { q: "코인 세금은 또 유예되나요?", a: `현행 법만 보면 유예되지 않은 상태입니다. 소득세법 부칙 제5조는 2027년 1월 1일 이후 양도·대여분부터 적용한다고 정하고, 과세 조문마다 [시행일: 2027. 1. 1.]이 붙어 있습니다. 바뀌려면 국회가 이 부칙을 개정해야 합니다. 계류 중인 법안의 내용과 전망은 법령 원문이 아니라 이 글에서 다루지 않았습니다.` },
  { q: "가상자산 과세는 몇 번 미뤄졌나요?", a: `부칙 제5조의 적용 시기 조항에 ${r.delays.map(fmt).join(", ")} 세 차례 개정 표시가 있습니다. 과세 근거를 처음 만든 법률 제17757호는 2020년 12월 29일 공포됐고, 그 뒤 세 번 고쳐 지금의 2027년 1월 1일이 됐습니다. 지방소득세 쪽(지방세법 부칙 제6조)도 같은 시행일을 따릅니다.` },
  { q: "2027년에 시행되면 무엇이 바뀌나요?", a: `코인을 팔거나 빌려줘서 생긴 1년 이익에서 ${eokwon(r.deduction)}을 빼고 소득세 ${pct(r.rate)}와 지방소득세 ${pct(r.localRate)}, 합계 ${total}를 냅니다(소득세법 제64조의3, 지방세법 제93조). 2027년 1월 1일 전 보유분은 2026년 12월 31일 시가와 실제 취득가액 중 큰 금액을 취득가액으로 봅니다(제37조 제5항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>이 글은 법령 원문에 적힌 것만 씁니다. 법이 다시 개정되면 그날 이 글의 날짜와 내용을 고칩니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>계산 구조와 신고는 <a href="/guide/crypto-tax/">코인 과세</a>, 내 금액은 <a href="/guide/crypto-tax-calculator/">코인 세금 계산기</a>에 있습니다.</p>
</GuideLayout>
