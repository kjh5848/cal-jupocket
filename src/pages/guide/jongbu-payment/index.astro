---
/**
 * "종부세 납부기간" — 종부세 시리즈. (납부시기도 이 글)
 * 근거: 종합부동산세법 제16조 제1항(12월 1~15일 부과·징수)·제3항(신고납부 선택), 제20조·시행령 제16조(분납),
 * 농어촌특별세법 제5조(20%)·제9조(분납 비율), 국세기본법 제5조(기한이 주말이면 다음 날).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/comprehensive-property-2026.json";
import { installmentAmount, PAYMENT } from "../../../lib/comprehensive-property-tax";
import { shiftToBusinessDay, koDate } from "../../../lib/tax-deadline";
import { won, eokwon } from "../../../lib/won";

const due = shiftToBusinessDay(new Date(Date.UTC(r.year, 11, 15)));
const [low, high] = r.installment.tiers;
const pct = (v: number) => `${Math.round(v * 100)}%`;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 jongbu-series.test.ts 가 rates 와 대조한다.
const title = "종부세 납부기간 — 12월 1일부터 15일까지, 250만원을 넘으면 나눠 낼 수 있습니다";
const description =
  "종부세 납부기간은 매년 12월 1일부터 15일까지입니다. 세무서가 고지서를 보내고, 원하면 같은 기간에 직접 신고할 수도 있습니다. 세액이 250만원을 넘으면 납부기한까지 신청해 나눠 낼 수 있고, 종부세액의 20%인 농어촌특별세도 함께 냅니다.";

const ANSWER = `종부세 납부기간은 매년 ${PAYMENT.from}부터 ${PAYMENT.to}까지입니다(종합부동산세법 제16조 제1항). ${r.year}년분 기한은 ${koDate(due)}입니다. 세액이 ${eokwon(low.over)}을 넘으면 기한까지 신청해 나눠 낼 수 있고, 종부세액의 ${pct(r.ruralTax.rate)}인 농어촌특별세도 함께 냅니다.`;

const QA = [
  { q: "종부세 납부기간은 언제인가요?", a: `관할세무서장이 세액을 결정해 해당 연도 ${PAYMENT.from}부터 ${PAYMENT.to}까지 부과·징수합니다(제16조 제1항). 고지서는 납부기간 시작 ${PAYMENT.noticeBeforeDays}일 전까지 보냅니다. 기한이 토요일·공휴일이면 그다음 날까지입니다.` },
  { q: "종부세 납부시기에 직접 신고할 수도 있나요?", a: `있습니다. 고지 대신 같은 기간(${PAYMENT.from}~${PAYMENT.to})에 과세표준과 세액을 관할세무서장에게 신고·납부할 수 있고, 그러면 세무서의 결정은 없었던 것으로 봅니다(제16조 제3항). 고지된 세액과 내 계산이 다르면 신고로 바로잡을 수 있다는 뜻입니다.` },
  { q: "종부세를 나눠 낼 수 있나요?", a: `세액이 ${eokwon(low.over)}을 넘으면 납부기한까지 신청해 일부를 나중에 낼 수 있습니다(제20조). ${eokwon(low.over)} 초과 ${eokwon(high.over)} 이하면 ${eokwon(low.over)}을 넘는 금액, ${eokwon(high.over)} 초과면 세액의 50% 이하를 나눌 수 있습니다(시행령 제16조).` },
  { q: "종부세와 함께 내는 세금이 있나요?", a: `농어촌특별세가 함께 붙습니다. 종합부동산세법에 따라 내야 할 종부세액의 ${pct(r.ruralTax.rate)}입니다(농어촌특별세법 제5조 제1항 제8호). 종부세를 나눠 내면 농어촌특별세도 같은 비율로 나눠 낼 수 있습니다(같은 법 제9조).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>일정</th><th>날짜</th><th>근거</th></tr></thead>
    <tbody>
      <tr><th scope="row">과세기준일</th><td>{r.assessmentDate.date}</td><td>{r.assessmentDate.article}</td></tr>
      <tr><th scope="row">합산배제·1주택 특례·공동명의 신청</th><td>{r.exclusionReport.period}</td><td>제8조 제3항·제5항, 제10조의2</td></tr>
      <tr><th scope="row">고지서 발송</th><td>납부기간 시작 {PAYMENT.noticeBeforeDays}일 전까지</td><td>제16조</td></tr>
      <tr><th scope="row">납부기간</th><td>{PAYMENT.from} ~ {PAYMENT.to} ({r.year}년분 기한 {koDate(due)})</td><td>제16조 제1항</td></tr>
    </tbody>
  </table>
  <p>날짜는 주말만 반영했고 공휴일 달력은 대조하지 않았습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <table>
    <thead><tr><th>세액</th><th>나눌 수 있는 금액</th><th>예</th></tr></thead>
    <tbody>
      <tr><th scope="row">{eokwon(low.over)} 이하</th><td>없음</td><td>—</td></tr>
      <tr><th scope="row">{eokwon(low.over)} 초과 {eokwon(high.over)} 이하</th><td>세액 − {eokwon(low.over)}</td><td>400만원이면 {won(installmentAmount(4_000_000))}</td></tr>
      <tr><th scope="row">{eokwon(high.over)} 초과</th><td>세액의 50% 이하</td><td>1,000만원이면 {won(installmentAmount(10_000_000))}</td></tr>
    </tbody>
  </table>
  <p>나눈 금액을 언제까지 내는지(분납 기간)는 이번에 확인하지 않았습니다. 납부유예 제도도 이 글에서 다루지 않습니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    세액을 미리 가늠하려면 <a href="/guide/jongbu-calculator/">종부세 계산기</a>를 쓰세요.
    농어촌특별세까지 더한 값을 보여 줍니다.
  </p>
</GuideLayout>
