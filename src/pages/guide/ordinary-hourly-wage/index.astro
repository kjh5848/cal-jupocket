---
/**
 * "통상시급" — 통상임금 시리즈. (통상시급 계산·통상시급 계산 방법·통상시급 뜻·통상시급 기본시급 차이·통상시급 주휴수당·통상시급 최저시급도 이 글)
 * 계산: src/lib/ordinary-wage.ts basisHours()·ordinaryWage() — 근로기준법 시행령 제6조 ② 제3호·제4호(rates: ordinary-wage-2026.json),
 * 주휴시간 labor.ts weeklyHolidayHours()(근로기준법 제18조 ③·제55조 ①).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/ordinary-wage-2026.json";
import { ordinaryWage, basisHours } from "../../../lib/ordinary-wage";
import { minWage } from "../../../lib/labor";
import { won } from "../../../lib/won";

const m26 = minWage(2026);
const std = { weeklyHours: 40, dailyHours: 8 };
const mo = (amount: number, b = std) => ordinaryWage([{ amount, period: "month", include: true }], b);
const basic = mo(2_500_000);
const withAllowance = ordinaryWage(
  [
    { amount: 2_500_000, period: "month", include: true },
    { amount: 200_000, period: "month", include: true },
  ],
  std,
);
const weeks = [40, 35, 30, 25, 20, 15, 14].map((w) => ({ w, h: basisHours({ weeklyHours: w, dailyHours: w / 5 }) }));
const sat4 = basisHours({ ...std, extraPaidWeekly: 4 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 ordinary-wage-series.test.ts 가 rates 와 대조한다.
const title = "통상시급 — 월 통상임금 ÷ 월 기준시간이고, 주 40시간이면 주휴를 넣은 209시간으로 나눕니다";
const description =
  "통상시급은 통상임금을 시간 단위로 바꾼 금액입니다. 월급제는 1주 소정근로시간에 주휴시간 등 유급시간을 더하고 1년 평균 주 수를 곱해 12로 나눈 월 기준시간으로 나누고, 주 40시간이면 209시간입니다. 기본급만 나눈 기본시급과 다른 점, 주 근로시간별 기준시간 표도 봅니다.";

const ANSWER = `통상시급 = 월 통상임금 ÷ 월 기준시간입니다(근로기준법 시행령 제6조 제2항 제4호). 주 40시간이면 소정근로 40시간 + 주휴 8시간 = 1주 48시간이고, 월로는 209시간입니다. 기본급 ${won(2_500_000)}에 통상임금인 수당 ${won(200_000)}이 더 있으면 통상시급은 ${won(withAllowance.hourly)}로, 기본급만 나눈 ${won(basic.hourly)}보다 큽니다.`;

const QA = [
  { q: "209시간은 어떻게 나오나요?", a: `1주 기준시간 48시간(소정근로 40 + 주휴 8) × 1년 평균 주 수(365 ÷ 7) ÷ 12 = 208.57시간이고, 최저임금 고시는 월 환산 기준을 209시간으로 적습니다. 이 사이트는 주 40시간이면 209시간, 그 밖은 산식 값을 씁니다. 1주 15시간 미만이면 주휴가 없어 소정근로시간만 셉니다(근로기준법 제18조 제3항).` },
  { q: "통상시급과 기본시급은 무엇이 다른가요?", a: `기본시급은 기본급만 시간으로 나눈 값이고, 통상시급은 통상임금에 들어가는 수당·상여금까지 모두 시간급으로 바꿔 더한 값입니다(제2항 제7호). 기본급 ${won(2_500_000)}이면 기본시급 ${won(basic.hourly)}, 통상임금인 수당 ${won(200_000)}이 있으면 통상시급 ${won(withAllowance.hourly)}입니다.` },
  { q: "통상시급이 최저시급보다 낮으면 안 되나요?", a: `최저임금은 따로 계산합니다. 최저임금 비교에는 매월 1회 이상 정기적으로 주는 임금을 넣고 연장·야간·휴일 수당 등은 빼며(최저임금법 제6조 제4항), 통상임금과 범위를 정하는 법이 다릅니다. 2026년 최저시급은 ${won(m26)}이고, 월급이 최저임금에 맞는지는 최저임금 계산기로 보세요.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>1주 소정근로시간</th><th>주휴시간</th><th>1주 기준시간</th><th>월 기준시간</th></tr></thead>
      <tbody>
        {weeks.map(({ w, h }) => <tr><th scope="row">{w}시간</th><td>{h.holiday}시간</td><td>{h.weekly}시간</td><td>{Math.round(h.monthly * 100) / 100}시간</td></tr>)}
      </tbody>
    </table>
  </div>
  <p>주휴시간은 1주 소정근로시간 ÷ 5(하루 8시간까지)입니다. 토요일 4시간을 유급으로 처리하는 회사처럼 주휴 말고 유급인 시간이 있으면 1주 기준시간에 더합니다(제3호) — 주 40시간에 토요일 유급 4시간이면 1주 {sat4.weekly}시간, 월 {Math.round(sat4.monthly * 100) / 100}시간입니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>분기·연간 상여금처럼 매달 받지 않는 임금도 통상임금에 들어간다면 개월 수로 나눠 월 금액으로 바꾼 뒤 더합니다. 어떤 수당을 넣을지 정하는 기준은 <a href="/guide/ordinary-wage/">통상임금</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>최저임금 비교는 <a href="/guide/minimum-wage-calculator/">최저임금 계산기</a>로, 통상시급으로 연장·야간·휴일 수당을 셈하려면 <a href="/guide/overtime-pay-calculator/">야근수당 계산기</a>로, 수당과 상여금을 넣어 통상시급을 바로 보려면 <a href="/guide/ordinary-wage-calculator/">통상임금 계산기</a>를 쓰세요.</p>
</GuideLayout>
