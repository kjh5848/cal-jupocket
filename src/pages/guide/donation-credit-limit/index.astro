---
/**
 * "기부금 세액공제 한도" — 기부금 세액공제 시리즈. (한도계산·기준소득금액도 이 글)
 * 근거: 소득세법 제59조의4 제4항 제2호 가목·나목(일반기부금 한도), 시행령 제118조의7 제4항(사업자 소득금액), 제61조 제2항(이월).
 * 특례기부금 한도식(제34조 제2항 제2호)은 이미지라 숫자로 옮기지 않았다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/special-credit-2026.json";
import { donationCredit } from "../../../lib/special-credit";
import { won } from "../../../lib/won";

const L = r.donation.generalLimit;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const a = donationCredit({ income: 40_000_000, general: 15_000_000 });
const b = donationCredit({ income: 40_000_000, religious: 6_000_000, general: 1_000_000 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 special-credit-series.test.ts 가 rates 와 대조한다.
const title = "기부금 세액공제 한도 — 일반기부금은 소득금액 30%, 종교단체가 있으면 10%+α";
const description =
  "기부금 세액공제 한도는 일반기부금의 경우 소득금액의 30%입니다. 종교단체에 기부한 금액이 있으면 소득금액의 10%에 '소득금액 20%와 종교단체 외 기부금 중 적은 금액'을 더한 금액이 한도입니다. 넘은 금액은 10년간 이월됩니다.";

const ANSWER = `일반기부금 세액공제 한도는 소득금액의 ${pct(L.nonReligiousRate)}입니다. 종교단체 기부금이 있으면 소득금액 × ${pct(L.religiousRate)} + (소득금액 × ${pct(L.otherRate)}와 종교단체 외 기부금 중 적은 금액)이 한도입니다(소득세법 제59조의4 제4항 제2호). 넘는 금액은 10년간 이월됩니다.`;

const QA = [
  { q: "기부금 세액공제 한도는 얼마인가요?", a: `일반기부금은 종교단체 기부금이 없으면 소득금액의 ${pct(L.nonReligiousRate)}, 있으면 소득금액의 ${pct(L.religiousRate)}에 '소득금액 ${pct(L.otherRate)}와 종교단체 외 기부금 중 적은 금액'을 더한 금액입니다(제2호 가목·나목). 특례기부금은 일반기부금보다 먼저 공제합니다.` },
  { q: "기부금 한도의 기준소득금액은 무엇인가요?", a: `${L.incomeDefinition}(제4항 제2호 가목). 근로소득만 있으면 총급여에서 근로소득공제를 뺀 근로소득금액이 출발점이고, 사업소득이 있으면 기부금을 필요경비에 넣기 전 금액으로 봅니다(시행령 제118조의7 제4항).` },
  { q: "기부금 세액공제 한도 계산 예시를 보여 주세요.", a: `소득금액 4,000만원에 일반기부금 1,500만원(종교단체 없음)이면 한도는 ${won(a.limit)}이라 ${won(a.generalIn)}만 올해 공제 대상이고 ${won(a.carry)}은 이월됩니다. 같은 소득에 종교단체 600만원·그 외 100만원이면 한도는 ${won(b.limit)}입니다.` },
  { q: "한도를 넘은 기부금은 어떻게 되나요?", a: `한도를 넘어 공제받지 못한 일반기부금과, 세액공제 합계가 산출세액을 넘어 공제받지 못한 기부금은 다음 과세기간 개시일부터 10년 이내에 끝나는 과세기간으로 이월해 공제합니다(제61조 제2항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ul>
    <li>{L.religious}</li>
    <li>{L.nonReligious}</li>
  </ul>
  <p>
    특례기부금 자체의 한도 계산식(소득세법 제34조 제2항 제2호)은 이미지로 되어 있어 이 글에서 숫자로
    옮기지 않았습니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <table>
    <thead><tr><th>소득금액 4,000만원</th><th>한도</th><th>올해 공제 대상</th><th>이월</th><th>세액공제</th></tr></thead>
    <tbody>
      <tr><th scope="row">일반기부금 1,500만원(종교 없음)</th><td>{won(a.limit)}</td><td>{won(a.generalIn)}</td><td>{won(a.carry)}</td><td>{won(a.credit)}</td></tr>
      <tr><th scope="row">종교 600만원 + 그 외 100만원</th><td>{won(b.limit)}</td><td>{won(b.generalIn)}</td><td>{won(b.carry)}</td><td>{won(b.credit)}</td></tr>
    </tbody>
  </table>
  <p>세액공제는 산출세액 한도(제61조 제2항) 전 값입니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>자세히 — <a href="/guide/donation-credit-carryover/">기부금 세액공제 이월</a></p>
</GuideLayout>
