---
/**
 * "HUG 전세보증 가능 여부 계산기" — 정부 지원 도우미 첫 사업(설계 docs/superpowers/specs/2026-11-07-gov-support-assistant-design.md).
 * (허그 전세보증 조건·전세보증금반환보증 가입 조건·전세안심보증 한도·보증한도 계산도 이 글, 계산기 포함)
 * 계산: src/lib/hug-jeonse.ts hugGuarantee() — 주택가격(공시가격 × 140% 또는 시세) × 90% − 선순위, 선순위 60%(다가구 80%) 선.
 * 근거: rates/hug-jeonse-2026.json (HUG 상품개요, 2026-11-07 확인). 결과는 추산 — 판정은 HUG 심사.
 * 보증료: hugPremium() — 반환보증 구간별 요율표(2026-11-08 확인), 할인 하나·할증을 줄로 나눠 보여 준다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import CalcCta from "../../../components/CalcCta.astro";
import AdSlot from "../../../components/AdSlot.astro";
import Callout from "../../../components/Callout.astro";
import JeonseGlossary from "../../../components/JeonseGlossary.astro";
import HugChatEntry from "../../../components/HugChatEntry.astro";
import r from "../../../rates/hug-jeonse-2026.json";
import { hugGuarantee, hugPremium, DISCOUNT_LABEL } from "../../../lib/hug-jeonse";
import { won } from "../../../lib/won";

const G = r.guarantee;
const P = r.premium;
const ok = hugGuarantee({ type: "row", capital: true, deposit: 250_000_000, senior: 0, basis: "public", price: 200_000_000 });
const okPrem = hugPremium({ type: "row", deposit: 250_000_000, seniorTotal: ok.seniorTotal, housePrice: ok.housePrice, days: 730 });
const ng = hugGuarantee({ type: "row", capital: true, deposit: 250_000_000, senior: 50_000_000, basis: "public", price: 200_000_000 });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts).
const title = "HUG 전세보증 가능 여부 계산기 — 공시가격·보증금·근저당을 넣으면 보증한도와 가입 가능 여부가 나옵니다";
const description =
  "HUG 전세보증 가능 여부 계산기는 주택 유형·공시가격(또는 시세)·보증금·근저당을 넣으면 HUG가 보는 주택가격과 보증한도, 보증금 + 선순위가 90% 선 안에 드는지를 추산합니다. 근저당이 있으면 보증되는 최대 보증금도 보여 줍니다.";

const ANSWER = `HUG 전세보증은 보증금 + 선순위채권이 주택가격의 ${G.ltvLimitPct}% 안이어야 합니다. 공시가격 2억원 다세대는 주택가격을 ${won(ok.housePrice)}으로 봐서 보증금 ${won(ok.ltvLine)}까지 되지만, 근저당 5천만원이 있으면 최대 ${won(ng.maxDeposit)}입니다.`;

const QA = [
  { q: "HUG 전세보증 조건은 무엇인가요?", a: `보증금 + 선순위채권이 주택가격 × ${G.ltvLimitPct}% 안이고, 선순위채권이 주택가격의 ${G.seniorLimitPct}%(단독·다가구·다중은 다른 세입자 보증금을 더해 ${G.seniorLimitMultiFamilyPct}%) 안이어야 합니다. 보증금은 수도권 ${won(G.depositCap.capital)}, 그 외 ${won(G.depositCap.other)} 이하입니다(HUG 상품개요, ${r.verifiedOn} 확인).` },
  { q: "주택가격은 어떻게 정하나요?", a: `HUG가 정한 순서대로 정합니다. 감정평가서(${G.appraisalValidMonths}개월 이내)가 있으면 그 금액을 먼저 쓰고, 연립·다세대는 공동주택가격 × ${G.publicPriceMultiplierPct}%, 단독·다가구는 개별단독주택가격 × ${G.publicPriceMultiplierPct}%, 아파트·오피스텔은 시세(KB 등)를 먼저 봅니다. 계산기는 공시가격이면 × ${G.publicPriceMultiplierPct}%, 시세·감정가면 그대로 씁니다.` },
  { q: "보증료는 얼마인가요?", a: `보증료는 세입자가 냅니다. 보증금 × 연 보증료율 × 계약일수 ÷ 365이고, 요율은 연 ${G.premiumRateRangePct.min}~${G.premiumRateRangePct.max}%에서 보증금 구간·아파트 여부·빚 비율(부채비율)로 정해집니다. 공시가격 2억원 빌라에 보증금 2억 5천만원, 2년이면 연 ${okPrem.ratePct}%가 붙어 약 ${won(okPrem.base)}입니다. 연소득 5천만원 이하면 ${P.discountPct.lowIncome}%, 신혼부부면 ${P.discountPct.newlywed}% 할인됩니다(HUG 상품개요, ${P.verifiedOn} 확인).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />
  <HugChatEntry />

  <div class="calc-card" data-two>
    <p class="meta">HUG 전세반환보증·전세안심보증 상품개요의 가입 조건으로 추산합니다({r.verifiedOn} 확인). 실제 심사는 주택가격 적용 순서·등기부 권리관계·위반건축물·서류를 함께 보므로 결과가 다를 수 있습니다. 판정이 아니라 미리 가늠해 보는 용도입니다.</p>
    <div class="calc-input-wrap">
      <label for="hg-type">주택 유형</label>
      <select id="hg-type">
        <option value="apartment">아파트</option>
        <option value="officetel">오피스텔</option>
        <option value="row" selected>연립·다세대(빌라)</option>
        <option value="multi">단독·다가구·다중</option>
      </select>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-region">지역</label>
      <select id="hg-region" data-seg><option value="capital" selected>수도권</option><option value="other">그 외</option></select>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-basis">가격 기준</label>
      <select id="hg-basis" data-seg><option value="public" selected>공시가격(× {G.publicPriceMultiplierPct}%)</option><option value="market">시세·감정가</option></select>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-price">가격</label>
      <input type="text" inputmode="numeric" id="hg-price" value="200,000,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-deposit">전세 보증금</label>
      <input type="text" inputmode="numeric" id="hg-deposit" value="250,000,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-senior">집에 먼저 잡힌 빚 — 근저당 채권최고액(선순위채권)</label>
      <input type="text" inputmode="numeric" id="hg-senior" value="0" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap" id="hg-others-wrap" hidden>
      <label for="hg-others">나보다 앞선 다른 세입자 보증금 합계</label>
      <input type="text" inputmode="numeric" id="hg-others" value="0" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-term">계약기간</label>
      <select id="hg-term" data-seg><option value="12">1년</option><option value="24" selected>2년</option></select>
    </div>
    <div class="calc-input-wrap">
      <label for="hg-discount">보증료 할인(하나만)</label>
      <select id="hg-discount">
        <option value="none" selected>해당 없음</option>
        {Object.entries(DISCOUNT_LABEL).map(([k, v]) => <option value={k}>{v} {P.discountPct[k as keyof typeof P.discountPct]}%</option>)}
      </select>
    </div>
    <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hg-hero">
      <p class="label">HUG 전세보증(추산)</p>
      <p class="big" id="hg-hero">{ok.ok ? "가입 가능" : "어려움"}</p>
      <p class="meta" id="hg-note">보증한도 {won(ok.guaranteeLimit)} · 보증금이 이 금액 안이어야 합니다</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">HUG가 보는 주택가격</span><span class="value" id="hg-house">{won(ok.housePrice)}</span></div>
      <div class="stat-chip"><span class="label">{G.ltvLimitPct}% 선(보증금 + 선순위)</span><span class="value" id="hg-ltv">{won(ok.ltvLine)}</span></div>
      <div class="stat-chip"><span class="label">보증한도</span><span class="value" id="hg-limit">{won(ok.guaranteeLimit)}</span></div>
      <div class="stat-chip"><span class="label">보증되는 최대 보증금</span><span class="value" id="hg-max">{won(ok.maxDeposit)}</span></div>
      <div class="stat-chip"><span class="label">보증료율(빚 비율 <span id="hg-debt">{okPrem.debtRatioPct}</span>%)</span><span class="value" id="hg-rate">연 {okPrem.ratePct}%</span></div>
      <div class="stat-chip"><span class="label">내는 보증료(추산)</span><span class="value" id="hg-premium">{won(okPrem.total)}</span></div>
      <div class="stat-chip"><span class="label">선순위 한도</span><span class="value" id="hg-senior-line">{won(ok.seniorLine)}</span></div>
      <div class="stat-chip"><span class="label">보증금 상한</span><span class="value" id="hg-cap">{won(ok.depositCap)}</span></div>
    </div>
    <ul class="meta" id="hg-checks"></ul>
    <p class="meta" id="hg-premium-note"></p>
  </div>

  <CalcCta path={Astro.url.pathname} where="next" />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>이 밖에 계약기간 {G.minTermYears}년 이상, 공인중개사가 날인한 계약서, 전입신고와 확정일자, 등기부 갑구에 압류·가압류·경매신청·가처분·가등기가 없을 것, 건물과 토지가 모두 임대인 소유일 것, 위반건축물이 아닐 것(아파트 제외) 같은 조건이 있습니다. 서류에서 이것을 확인하는 순서는 <a href="/guide/hug-jeonse-checklist/">HUG 전세대출 체크리스트</a>에 있습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <Callout icon="🔎">공시가격은 부동산공시가격알리미(realtyprice.kr)에서 주소로 찾을 수 있습니다. 근저당 채권최고액은 등기부등본 을구에 있습니다.</Callout>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>공식 안내: <a href={r.sources.returnGuarantee} rel="noopener" target="_blank">HUG 전세보증금반환보증 상품개요</a> · <a href={r.sources.loanGuarantee} rel="noopener" target="_blank">HUG 전세안심보증 상품개요</a></p>

  <JeonseGlossary />

  <script src="../../../scripts/hug-guarantee.ts"></script>
</GuideLayout>
