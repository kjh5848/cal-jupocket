---
/**
 * "이사 체크리스트" — 이사 시리즈 허브. (이사 준비 체크리스트·이사 전 체크리스트·이사 시 해야 할 일·전세 이사 체크리스트·이사 비용도 이 글)
 * 근거: 주민등록법 제16조 ①·제17조·제40조 ④, 주택임대차보호법 제3조 ①·제3조의2 ②·제3조의3 ①·⑤,
 * 부동산 거래신고 등에 관한 법률 제6조의2·제6조의5, 시행령 제4조의3(rates: moving-2026.json).
 * 이사 비용 예시는 중개보수(brokerage-fee.ts)·취득세(acquisition-total.ts) 계산 함수로 뽑고, 이사업체 비용은 공식 출처가 없어 견적으로 넘긴다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import AffiliateBox from "../../../components/AffiliateBox.astro";
import m from "../../../rates/moving-2026.json";
import { brokerageFee } from "../../../lib/brokerage-fee";
import { acquisitionTotal } from "../../../lib/acquisition-total";
import { won, manwon, eokwon } from "../../../lib/won";
import { movingSeries as S } from "../../../data/series/moving";

const D = m.moveIn.reportDays;
const fine = manwon(m.moveIn.fineMax);
const L = m.leaseReport;
const jeonse = brokerageFee({ property: "housing", deal: "jeonse", amount: 300_000_000 });
const sale = brokerageFee({ property: "housing", deal: "sale", amount: 500_000_000 });
const acq = acquisitionTotal(500_000_000, "house", { smallArea: true });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 moving.test.ts 가 rates 와 대조한다.
const title = "이사 체크리스트 — 이사 전 날짜·견적, 이삿날 전입신고·확정일자, 이사 후 14일 안에 끝낼 일까지 순서대로";
const description =
  "이사 체크리스트를 이사 전·이삿날·이사 후로 나눴습니다. 전입신고는 전입한 날부터 14일 안, 전세·월세 보증금은 입주·전입신고와 확정일자를 갖춰야 먼저 돌려받고, 보증금 6천만원 초과나 월세 30만원 초과면 30일 안에 임대차 신고 대상입니다.";

const ANSWER = `이사 전에는 날짜·견적과 중개보수·취득세 같은 예산을 정하고, 이삿날에는 짐을 들인 뒤 전입신고와 확정일자를 챙깁니다. 전입신고는 전입한 날부터 ${D}일 안에 해야 하고(주민등록법 제16조), 늦으면 ${fine} 이하 과태료입니다. 보증금은 입주·전입신고와 확정일자를 함께 갖춰야 우선변제를 받습니다.`;

const QA = [
  { q: "이사 전에는 무엇부터 해야 하나요?", a: `이삿날을 정하고 업체 견적을 받는 것이 먼저입니다. 같은 날짜·짐 양으로 여러 곳에 받아야 비교가 됩니다. 살던 집이 전세·월세라면 보증금을 이삿날 받을 수 있는지 확인하고, 임대차가 끝났는데 못 받으면 임차권등기명령을 신청할 수 있습니다(주택임대차보호법 제3조의3).` },
  { q: "이삿날에는 무엇을 해야 하나요?", a: `새 집에 짐을 들이고(주택 인도) 전입신고를 하는 것이 핵심입니다. 임차인은 인도와 주민등록을 마친 다음 날부터 대항력이 생기고(주택임대차보호법 제3조 ①), 여기에 확정일자까지 갖추면 경매·공매 때 후순위 권리자보다 먼저 보증금을 받을 권리가 생깁니다(제3조의2 ②).` },
  { q: `이사 후 ${D}일 안에 할 일은 무엇인가요?`, a: `전입신고입니다. 신고의무자가 새 주소에 전입한 날부터 ${D}일 이내에 새 주소지 시·군·구에 해야 하고(주민등록법 제16조 ①), 정당한 사유 없이 늦으면 ${fine} 이하 과태료입니다(제40조 ④). 전입신고를 하면 병역법·민방위기본법 등의 전출입 신고도 한 것으로 봅니다(제17조).` },
  { q: "이사 비용은 무엇을 더해야 하나요?", a: `중개사무소에 내는 중개보수, 집을 샀다면 취득세, 그리고 이사업체 비용입니다. 중개보수와 취득세는 법이 정한 상한·세율로 계산되지만, 이사업체 비용은 정해진 공식 가격이 없어 업체 견적으로 비교해야 합니다.` },
];

const steps = [
  { when: "계약 직후", what: "이삿날 정하기 · 같은 조건으로 이사 견적 여러 곳 받기", basis: "—" },
  { when: "계약일부터 30일 안", what: `주택 임대차 신고 — 보증금 ${eokwon(L.depositOver)} 초과 또는 월세 ${manwon(L.monthlyRentOver)} 초과(전입신고를 하면 한 것으로 봄)`, basis: "부동산거래신고법 제6조의2·제6조의5" },
  { when: "살던 집을 나가기 전", what: "보증금 돌려받을 날 확인 · 임대차가 끝났는데 못 받으면 임차권등기명령", basis: "주택임대차보호법 제3조의3" },
  { when: "이삿날", what: "짐 들이기(인도) · 전입신고 · 계약서에 확정일자", basis: "주택임대차보호법 제3조·제3조의2" },
  { when: `전입한 날부터 ${D}일 안`, what: `전입신고 마감 — 늦으면 ${fine} 이하 과태료`, basis: "주민등록법 제16조·제40조" },
];
---

<GuideLayout title={title} description={description} updated={m.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>한눈에 보는 이사 체크리스트</h2>
  <p>법이 기한을 정한 일과 그 근거만 시점 순서로 모았습니다. 기한이 없는 일(짐 정리·청소 등)은 집마다 달라 넣지 않았습니다.</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>언제</th><th>할 일</th><th>근거</th></tr></thead>
      <tbody>
        {steps.map((s) => <tr><th scope="row">{s.when}</th><td>{s.what}</td><td>{s.basis}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>임차권등기를 마치면 그 뒤 이사를 가서 주민등록을 옮겨도 이미 얻은 대항력과 우선변제권을 잃지 않습니다(제3조의3 ⑤). 날짜를 고를 때 손없는날을 따지는 경우가 많은데, 달마다 날짜는 <a href="/guide/moving-lucky-day/">손없는날</a>에, 업체에 맡길 범위는 <a href="/guide/packing-vs-half-packing/">포장이사 반포장이사 차이</a>에 정리했습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>전입신고를 한 때에 주민등록이 된 것으로 봅니다(제3조 ① 후단). 확정일자를 받는 곳과 기한, 임대차 신고와의 관계는 <a href="/guide/move-in-report/">전입신고 확정일자</a>에서 따로 다룹니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>같은 조문이 국민기초생활 보장법·국민건강보험법·인감증명법·장애인복지법의 거주지 이동 신고도 전입신고로 갈음한다고 정합니다. 보증금 {eokwon(L.depositOver)} 초과나 월세 {manwon(L.monthlyRentOver)} 초과 임대차는 계약일부터 {L.days}일 안에 임대차 신고 대상인데, 임차인이 전입신고를 하면 이 신고도 한 것으로 봅니다(부동산거래신고법 제6조의5 ①).</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>예를 들어 전세 3억원 계약이면 임차인이 내는 중개보수 상한이 {won(jeonse.maxFee)}입니다. 5억원 아파트(전용 85㎡ 이하)를 샀다면 중개보수 상한 {won(sale.maxFee)}에 취득세·지방교육세 합계 {won(acq.total)}까지 더해집니다(부가세 별도, 생애최초 감면 등은 빼고 계산). 내 금액으로는 <a href="/guide/brokerage-fee-calculator/">중개보수 계산기</a>와 <a href="/acquisition-tax/">취득세 계산기</a>에 넣어 보면 됩니다. 이사업체 비용만은 짐 양·거리·층수·날짜에 따라 업체가 정하므로, 같은 조건으로 견적을 받아 위 금액에 더하세요.</p>

  <h2>이사 시리즈</h2>
  <ul>
    {S.items.map((i) => <li><a href={`/guide/${i.slug}/`}>{i.label}</a></li>)}
  </ul>

  <AffiliateBox id="moving-quote" />
</GuideLayout>
