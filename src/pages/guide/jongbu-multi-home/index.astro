---
/**
 * "다주택자 종부세" — 종부세 시리즈. (1가구2주택종부세도 이 글)
 * 근거: 종합부동산세법 제8조 제1항 제3호(9억원)·제4항(1주택자로 보는 2주택), 제9조 제1항(2주택 이하·3주택 이상 표),
 * 시행령 제4조의3 제3항(주택 수 계산 — 공동 소유·다가구·빠지는 주택), 농어촌특별세법 제5조.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/comprehensive-property-2026.json";
import { estimate, deductionFor } from "../../../lib/comprehensive-property-tax";
import { won, eokwon } from "../../../lib/won";

const prices = [1_500_000_000, 2_000_000_000, 3_000_000_000, 5_000_000_000];
const row = (p: number) => ({
  p,
  one: estimate({ totalPrice: p, oneHome: true }).total,
  two: estimate({ totalPrice: p, homes: "upTo2Homes" }).total,
  three: estimate({ totalPrice: p, homes: "from3Homes" }).total,
});
const rows = prices.map(row);
const ex = row(2_000_000_000);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 jongbu-series.test.ts 가 rates 와 대조한다.
const title = "다주택자 종부세 — 공제는 9억원, 3주택부터는 과세표준 12억원 위 세율이 높아집니다";
const description =
  "다주택자 종부세는 주택 공시가격 합계에서 9억원만 빼고 60%를 곱해 계산합니다. 1가구 2주택은 2주택 이하 세율을, 3주택 이상은 과세표준 12억원 초과 구간부터 더 높은 세율을 적용합니다. 상속주택·일시적 2주택 등은 주택 수에서 빠질 수 있습니다.";

const ANSWER = `다주택자 종부세는 공시가격 합계에서 ${eokwon(deductionFor(false))}만 빼고 60%를 곱한 과세표준으로 계산하며, 1세대 1주택 세액공제가 없습니다. 2주택은 2주택 이하 세율, 3주택 이상은 과세표준 ${eokwon(r.rates.sameUntil)} 초과 구간부터 더 높은 세율입니다(종합부동산세법 제9조 제1항).`;

const QA = [
  { q: "다주택자 종부세는 어떻게 계산하나요?", a: `납세의무자별로 주택 공시가격을 합산하고 ${eokwon(deductionFor(false))}을 뺀 뒤 60%를 곱합니다(제8조 제1항 제3호). 1세대 1주택자가 아니므로 ${eokwon(deductionFor(true))} 공제와 나이·보유기간 세액공제를 받지 못합니다. 세율은 소유한 주택 수에 따라 표가 갈립니다.` },
  { q: "1가구 2주택 종부세는 얼마인가요?", a: `공시가격 합계 20억원 기준으로 1세대 1주택이면 ${won(ex.one)}, 2주택이면 ${won(ex.two)}입니다(종부세+농어촌특별세, 재산세액 공제 전 상한). 공제가 ${eokwon(deductionFor(true))}에서 ${eokwon(deductionFor(false))}으로 줄고 세액공제가 없어지는 차이입니다.` },
  { q: "3주택 이상 종부세율은 얼마인가요?", a: `과세표준 ${eokwon(r.rates.sameUntil)}까지는 2주택 이하와 같고, 그 위로 25억원 이하 2%, 50억원 이하 3%, 94억원 이하 4%, 초과 5%입니다(제9조 제1항 제2호 표). 2주택 이하는 같은 구간이 1.3%·1.5%·2%·2.7%입니다.` },
  { q: "종부세 주택 수에서 빠지는 주택이 있나요?", a: `있습니다. 합산배제 임대주택, 요건을 갖춘 상속주택, 일시적 2주택의 신규주택, 지방 저가주택 등은 주택 수에 넣지 않습니다(시행령 제4조의3 제3항 제3호). 공동 소유 주택은 각자 1주택으로, 다가구주택은 1주택으로 셉니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>공시가격 합계</th><th>1세대 1주택</th><th>2주택</th><th>3주택 이상</th></tr></thead>
      <tbody>
        {rows.map((x) => (
          <tr><th scope="row">{eokwon(x.p)}</th><td>{won(x.one)}</td><td>{won(x.two)}</td><td>{won(x.three)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p>
    종부세와 농어촌특별세(20%)를 합한 값이고, 1세대 1주택은 나이·보유기간 공제를 넣지 않았습니다.
    재산세액 공제와 세부담 상한 전이라 실제 고지서는 이보다 작습니다.
  </p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    구간별 누진 계산식은 <a href="/guide/jongbu-rate/">종부세 세율</a>에 표로 정리했습니다.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <ul>
    {r.houseCount.rules.map((x) => <li>{x}</li>)}
    <li>2024년 1월 10일~2027년 12월 31일에 취득·준공한 전용 60㎡ 이하, 취득가액 6억원(수도권 밖 3억원) 이하의 아파트 아닌 소형 신축주택 등(시행령 제4조의3 제3항 제3호 바목, 세부 요건은 재정경제부령)</li>
  </ul>
  <p>
    2주택이지만 1세대 1주택자로 보는 경우(일시적 2주택·상속주택·지방 저가주택)는 9월 16일~30일에
    신청해야 합니다 — <a href="/guide/jongbu-criteria/">종부세 기준</a>.
  </p>
</GuideLayout>
