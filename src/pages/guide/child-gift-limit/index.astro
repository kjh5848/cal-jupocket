---
/**
 * "자녀 증여 한도" — 증여세 시리즈. (성인자녀 증여한도·미성년 자녀·자녀 증여세 면제 한도·비과세·10년 기준·부모 합산·손자 증여도 이 글)
 * 근거: 상속세 및 증여세법 제53조(직계존속 5천만원·미성년 2천만원, 10년 합산), 제53조의2(혼인·출산 1억원), 제47조 제2항(부모는 동일인),
 * 제57조(세대생략 30%), 제56조(세율), 제69조(신고세액공제 3%). rates: gift-2026.json · 계산: computeGift()
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/gift-2026.json";
import { computeGift, relationCap } from "../../../lib/gift";
import { won, eokwon } from "../../../lib/won";

const adult = relationCap("ascendant");
const minor = relationCap("ascendant", true);
const mb = r.marriageBirthDeduction.combinedCap;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const ex1 = computeGift({ amount: 100_000_000, relation: "ascendant" });
const ex2 = computeGift({ amount: 30_000_000, relation: "ascendant", minor: true });
const amounts = [50_000_000, 100_000_000, 200_000_000, 300_000_000, 500_000_000];
const rows = amounts.map((a) => ({ a, x: computeGift({ amount: a, relation: "ascendant" }) }));

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 child-gift-series.test.ts 가 rates 와 대조한다.
const title = "자녀 증여 한도 — 성인 자녀 10년간 5천만원, 미성년 자녀 2천만원까지 세금이 없습니다";
const description =
  "자녀 증여 한도는 부모에게 받는 자녀 기준 10년 동안 성인 5천만원, 미성년 2천만원입니다. 아버지와 어머니가 준 금액은 합쳐서 보고, 혼인·출산 때는 1억원을 더 받을 수 있습니다. 한도를 넘으면 넘은 금액에 10%부터 세금이 붙어 1억원을 주면 485만원입니다.";

const ANSWER = `자녀 증여 한도는 자녀가 부모(직계존속)에게 받을 때 10년 합산 ${eokwon(adult)}, 미성년 자녀는 ${eokwon(minor)}입니다(상속세 및 증여세법 제53조). 아버지와 어머니가 준 금액은 합쳐서 보고(제47조 제2항), 혼인·출산 때는 ${eokwon(mb)}을 더 공제받습니다(제53조의2). 1억원을 주면 증여세는 ${won(ex1.payable)}입니다.`;

const QA = [
  { q: "성인 자녀 증여 한도는 얼마인가요?", a: `부모·조부모 등 직계존속에게 받으면 10년 동안 합산해 ${eokwon(adult)}까지 공제됩니다(제53조). 한 번에 쓰는 금액이 아니라 해당 증여 전 10년 안에 공제받은 금액과 합친 한도라, 5년 전에 3천만원을 받았다면 이번에는 2천만원만 공제됩니다. 10년이 지나면 한도가 다시 생깁니다.` },
  { q: "미성년 자녀 증여 한도는 얼마인가요?", a: `받는 자녀가 미성년자면 직계존속에게 받는 공제가 10년 합산 ${eokwon(minor)}으로 줄어듭니다(제53조). 미성년 자녀에게 3천만원을 주면 1천만원이 과세표준이 되어 증여세는 ${won(ex2.payable)}입니다(신고세액공제 3% 반영). 성년이 된 뒤의 증여는 ${eokwon(adult)} 한도가 적용됩니다.` },
  { q: "엄마 아빠가 각각 주면 한도가 두 배인가요?", a: `아닙니다. 공제는 받는 사람 기준으로 직계존속 전체에 대해 10년 ${eokwon(adult)}이고, 증여자가 직계존속이면 그 배우자를 같은 사람으로 보아 아버지와 어머니가 준 금액을 합칩니다(제47조 제2항). 조부모에게 받아도 같은 직계존속 공제 안에서 쓰며, 손자녀는 산출세액에 ${pct(r.generationSkip.rate)}가 더 붙습니다(제57조).` },
  { q: "자녀 증여 한도를 넘으면 세금은 얼마인가요?", a: `넘은 금액이 과세표준이 되고 1억원 이하 10%, 5억원 이하 20% 등 누진세율이 붙습니다(제56조). 성인 자녀에게 1억원을 주면 과세표준 ${eokwon(ex1.base)}, 산출세액 ${won(ex1.computed)}, 기한 안 신고 시 3% 공제 후 ${won(ex1.payable)}입니다(제69조).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>성인 자녀가 받는 금액</th><th>공제</th><th>과세표준</th><th>내는 증여세(3% 공제 후)</th><th>실효세율</th></tr></thead>
      <tbody>{rows.map(({ a, x }) => <tr><th scope="row">{eokwon(a)}</th><td>{eokwon(x.deductions.total)}</td><td>{eokwon(x.base)}</td><td>{won(x.payable)}</td><td>{(x.effectiveRate * 100).toFixed(2)}%</td></tr>)}</tbody>
    </table>
  </div>
  <p>10년 안에 받은 다른 증여가 없고 혼인·출산공제를 쓰지 않은 경우입니다. 결혼할 때 받는 돈은 <a href="/guide/child-wedding-gift/">자녀 결혼자금 증여</a>, 직접 넣어 보려면 <a href="/guide/gift-tax-calculator/">증여세 계산기</a>를 쓰세요. 증여받은 달의 말일부터 3개월 안에 받은 사람이 신고합니다 — <a href="/guide/gift-tax-filing/">증여세 신고</a>.</p>
</GuideLayout>
