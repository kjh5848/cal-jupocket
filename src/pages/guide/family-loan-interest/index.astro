---
/**
 * "가족간 차용증 이자율" — 가족간 차용증 시리즈. (가족간 차용증 무이자·이자·이자율 계산·이자소득세도 이 글, 계산기 포함)
 * 근거: 상증법 제41조의4, 시행령 제31조의4, 시행규칙 제10조의5 → 법인세법 시행규칙 제43조 ②, 소득세법 제129조(비영업대금 25%).
 * 계산: family-loan.ts loanGiftTax()·noGiftPrincipal()·interestWithholding().
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/family-loan-2026.json";
import fin from "../../../rates/financial-income-2026.json";
import { loanGiftTax, noGiftPrincipal, interestWithholding, giftTaxStartYear } from "../../../lib/family-loan";
import { won, manwon, eokwon } from "../../../lib/won";

const L = r.loanGift;
const pct = (v: number) => `${Number((v * 100).toFixed(1))}%`;
const approxEok = (n: number) => eokwon(Math.floor(n / 10_000) * 10_000);
const P = 500_000_000;
const ex = loanGiftTax(P, 0.02);
const ib = interestWithholding(ex.interest);
const exStart = giftTaxStartYear(P, 0.02);
const RATES = [0, 0.01, 0.02, 0.03, 0.04];

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 family-loan-series.test.ts 가 rates·계산 함수와 대조한다.
const title = "가족간 차용증 이자율 — 4.6%보다 덜 낸 이자가 1년 1천만원을 넘으면 그 금액이 증여입니다";
const description =
  "가족간 차용증 이자율은 세법상 적정 이자율 4.6%가 기준입니다. 대출금 × 4.6%에서 실제 낸 이자를 뺀 금액이 1년 1천만원 이상이면 증여재산가액이 됩니다. 연 2% 이자를 내면 약 3억8,461만원까지는 해당하지 않고, 받은 이자에는 25% 원천징수가 붙습니다.";

const ANSWER = `세법상 적정 이자율은 ${pct(L.rate)}입니다(상증법 시행규칙 제10조의5, 법인세법 시행규칙 제43조 제2항). 대출금 × ${pct(L.rate)} − 실제 낸 이자가 1년에 ${manwon(L.threshold)} 이상이면 증여재산가액이 되므로, 이자를 낼수록 증여가 되지 않는 대출금이 커집니다. 연 2%면 약 ${approxEok(noGiftPrincipal(0.02))}까지입니다.`;

const QA = [
  { q: "가족간 차용증 이자율은 몇 %로 써야 하나요?", a: `세금만 보면 ${pct(L.rate)} 이상이면 이자 차이로 인한 증여는 생기지 않습니다. 그보다 낮아도 '대출금 × ${pct(L.rate)} − 실제 낸 이자'가 1년에 ${manwon(L.threshold)} 미만이면 제외됩니다(시행령 제31조의4). 그래서 빌리는 금액이 클수록 필요한 이자율이 올라갑니다.` },
  { q: "5억원을 연 2%로 빌리면 어떻게 되나요?", a: `적정 이자 ${won(ex.fair)}에서 실제 이자 ${won(ex.interest)}을 빼면 1년 이익이 ${won(ex.gain)}이라 증여재산가액이 됩니다. 부모에게 빌린 성년 자녀가 10년간 증여재산공제를 쓰지 않았다면 첫해는 공제 안이라 ${won(ex.tax?.payable ?? 0)}입니다. 이익은 해마다 다시 생기고 공제는 10년 합산이라 ${exStart}년째에 증여세가 생깁니다.` },
  { q: "이자를 받는 부모님도 세금을 내나요?", a: `개인끼리 받는 이자는 비영업대금의 이익이라 이자소득이고, 원천징수 세율은 ${pct(fin.withholding.nonBusinessLoan)}입니다(소득세법 제129조). 여기에 지방소득세가 그 10% 붙습니다. 연 2%로 5억원이면 이자 ${won(ex.interest)}에 소득세 ${won(ib.tax)}, 지방소득세 ${won(ib.localTax)}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card">
    <p class="meta">빌린 금액과 약정 이자율(연)을 넣으세요. 1년 단위로 계산하고, 증여세는 부모에게 빌린 성년 자녀가 10년간 다른 증여 없이 같은 조건으로 빌리는 경우입니다.</p>
    <div class="calc-input-wrap">
      <label for="fl-amount">빌린 금액</label>
      <input type="text" inputmode="numeric" id="fl-amount" value="500,000,000" /><span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="fl-rate">약정 이자율(연)</label>
      <input type="number" min="0" max="20" step="0.1" id="fl-rate" value="2" /><span class="unit">%</span>
    </div>
    <div class="result-hero" aria-live="polite" aria-atomic="true">
      <p class="label">1년 증여이익</p>
      <p class="big" id="fl-hero">{won(ex.gain)}</p>
      <p class="meta" id="fl-note">1천만원 이상이라 증여재산가액이 됩니다. 첫해 증여세 {won(ex.tax?.payable ?? 0)}, 이익이 10년 합산돼 {exStart}년째부터 증여세가 생깁니다.</p>
    </div>
    <div class="stat-row">
      <div class="stat-chip"><span class="label">적정 이자(4.6%)</span><span class="value" id="fl-fair">{won(ex.fair)}</span></div>
      <div class="stat-chip"><span class="label">실제 이자</span><span class="value" id="fl-int">{won(ex.interest)}</span></div>
      <div class="stat-chip"><span class="label">증여 안 되는 한도</span><span class="value" id="fl-max">약 {approxEok(noGiftPrincipal(0.02))}</span></div>
      <div class="stat-chip"><span class="label">증여세 시작</span><span class="value" id="fl-start">{exStart}년째</span></div>
    </div>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>약정 이자율</th><th>증여가 안 되는 대출금(1년 이익 1천만원 미만)</th></tr></thead>
    <tbody>{RATES.map((x) => <tr><th scope="row">연 {pct(x)}</th><td>약 {approxEok(noGiftPrincipal(x))}</td></tr>)}<tr><th scope="row">연 {pct(L.rate)} 이상</th><td>금액과 관계없이 이자 차이 없음</td></tr></tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>원천징수 신고·납부 절차는 이 글에서 확인하지 않았습니다. 증여 판단 전체는 <a href="/guide/family-loan/">가족간 차용증</a>, 차용증에 적을 칸은 <a href="/guide/family-loan-howto/">차용증 쓰는법</a>에 있습니다.</p>

  <script src="../../../scripts/family-loan.ts"></script>
</GuideLayout>
