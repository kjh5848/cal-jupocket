---
/**
 * "자녀장려금 신청 기간" — 자녀장려금 시리즈. (신청·신청 방법·자녀장려금신청·2027 자녀장려금도 이 글)
 * 근거: 조세특례제한법 제100조의30 제1항·제3항, 준용 제100조의6 제2항·제5항·제8항·제11항, 제100조의7 제2항(95%).
 * 기한 계산: src/lib/child-incentive.ts schedule() — 주말만 미루고 공휴일 달력은 갖고 있지 않다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/child-incentive-2026.json";
import { schedule } from "../../../lib/child-incentive";
import { koDate } from "../../../lib/tax-deadline";

const A = r.apply;
const now = schedule(r.year); // 2026년 소득분 → 2027년 신청
const prev = schedule(r.year - 1); // 2025년 소득분 → 2026년 신청
const pct = Math.round(r.reductions.late.rate * 100);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 child-incentive.test.ts 가 rates 와 대조한다.
const title = "자녀장려금 신청 기간 — 5월 종합소득세 신고 기간, 놓치면 6개월 안에 95%";
const description =
  "자녀장려금 신청 기간은 다음 해 5월 종합소득세 확정신고 기간입니다. 2026년 소득분은 2027년 5월 1일부터 5월 31일까지 신청합니다. 놓쳤다면 신청기간이 끝난 다음 날부터 6개월 안에 신청할 수 있지만 금액의 95%만 받습니다.";

const ANSWER = `자녀장려금 신청 기간은 다음 해 5월 종합소득세 확정신고 기간입니다. ${r.year}년 소득분은 ${koDate(now.from)}부터 ${koDate(now.deadline)}까지 신청합니다. 놓쳤다면 ${koDate(now.lateTo)}까지 신청할 수 있지만 금액의 ${pct}%만 받습니다.`;

const QA = [
  { q: "자녀장려금 신청 기간은 언제인가요?", a: `소득세법에 따른 종합소득과세표준 확정신고 기간, 곧 다음 해 5월 1일부터 5월 31일까지입니다(조세특례제한법 제100조의30 제1항). 기한이 토요일·공휴일이면 그다음 날까지입니다. ${r.year}년 소득분의 기한은 ${koDate(now.deadline)}입니다.` },
  { q: "자녀장려금 신청 기간을 놓치면 어떻게 되나요?", a: `신청기간 종료일의 다음 날부터 ${A.late.months}개월 안에 신청할 수 있습니다(제100조의6 제8항 준용). 대신 산정한 금액의 ${pct}%만 받습니다(제100조의7 제2항 준용). ${r.year}년 소득분은 ${koDate(now.lateTo)}까지입니다.` },
  { q: "자녀장려금 신청 방법은 무엇인가요?", a: `신청자격과 산정한 자녀장려금을 적은 자녀장려금신청서에 증거자료를 붙여 납세지 관할 세무서장에게 냅니다(제100조의30 제1항). 동의하면 세무서가 직권으로 신청할 수도 있습니다(제100조의6 제11항 준용).` },
  { q: "2027년 자녀장려금은 언제 신청하나요?", a: `2027년에 신청하는 자녀장려금은 ${r.year}년 소득분이고, ${koDate(now.from)}부터 ${koDate(now.deadline)}까지입니다. 근로장려금을 반기 신청했다면 본인 의사에 따라 그해 자녀장려금도 신청한 것으로 봅니다(제100조의30 제3항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>소득 연도</th><th>정기 신청</th><th>늦은 신청({pct}%)</th></tr></thead>
    <tbody>
      <tr><th scope="row">{r.year - 1}년분</th><td>{koDate(prev.from)} ~ {koDate(prev.deadline)}</td><td>~ {koDate(prev.lateTo)}</td></tr>
      <tr><th scope="row">{r.year}년분</th><td>{koDate(now.from)} ~ {koDate(now.deadline)}</td><td>~ {koDate(now.lateTo)}</td></tr>
    </tbody>
  </table>
  <p>
    {r.year - 1}년분은 5월 31일이 일요일이라 기한이 6월 1일로 밀렸습니다(국세기본법 제5조).
    주말만 반영한 날짜이고, 공휴일 달력은 따로 대조하지 않았습니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <ul>
    <li>{A.finalReturn.rule} ({A.finalReturn.article})</li>
    <li>{A.heir.rule} ({A.heir.article})</li>
  </ul>
  <p>홈택스·손택스 신청 화면은 이 글에서 다루지 않습니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    신청한 뒤 언제 받는지는 <a href="/guide/child-incentive-pay-date/">자녀장려금 지급일</a>,
    얼마인지는 <a href="/guide/child-incentive-amount/">자녀장려금 금액</a>에 있습니다.
  </p>
</GuideLayout>
