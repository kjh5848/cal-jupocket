---
/**
 * "연말정산 간소화" — 연말정산 시리즈. (간소화 서비스·미리보기도 이 글)
 * 근거: 소득세법 제165조(증명서류 발급자가 국세청에 제출, 부양가족 동의 시 자료 제공).
 * 개통일·미리보기 일정은 법령이 아니라 국세청 공고라 쓰지 않는다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import y from "../../../rates/year-end-2026.json";

const title = "연말정산 간소화 — 병원·카드사가 국세청에 낸 서류를 모아 보는 것입니다";
const description =
  "연말정산 간소화 자료는 병원·카드사·보험사 같은 증명서류 발급자가 국세청에 제출한 자료입니다(소득세법 제165조). 부양가족 자료는 그 가족이 동의해야 볼 수 있고, 간소화에 없는 공제는 직접 서류를 모아야 합니다.";

const ANSWER = "연말정산 간소화 자료는 병원·카드사·보험사처럼 공제 증명서류를 발급하는 곳이 국세청에 낸 자료를 모아 보여 주는 것입니다(소득세법 제165조). 부양가족 자료는 그 가족의 동의가 있어야 보이고, 간소화에 없는 공제는 직접 서류를 받아 회사에 냅니다.";

const QA = [
  { q: "연말정산 간소화란 무엇인가요?", a: "소득공제·세액공제 증명서류를 발급하는 자(병원·카드사·보험사 등)가 그 서류를 국세청장에게 제출하도록 한 제도입니다(소득세법 제165조 제1항). 근로자는 국세청에 모인 자료를 받아 회사에 냅니다." },
  { q: "부양가족의 연말정산 간소화 자료는 어떻게 보나요?", a: "그 가족이 정보 제공에 동의해야 합니다. 국세청장은 기본공제대상자로부터 서면 등으로 동의를 받은 경우에 근로자에게 그 부양가족의 자료를 제공할 수 있습니다(제165조 제6항)." },
  { q: "간소화 자료에 없는 공제는 어떻게 하나요?", a: "직접 증명서류를 받아 회사에 냅니다. 간소화 제출 의무는 대통령령으로 정하는 공제의 증명서류에만 있고(제165조 제1항), 받는 사람이 제출을 거부한 경우 등에는 제출되지 않습니다." },
  { q: "연말정산 간소화 서비스와 미리보기는 언제 열리나요?", a: "법령에 날짜가 없습니다. 개통일과 미리보기 일정은 국세청이 해마다 공고합니다. 법이 정한 날은 회사가 정산하는 2월분 급여 지급일과 그 전까지의 공제신고서 제출 기한입니다." },
];
---

<GuideLayout title={title} description={description} updated={y.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>
    받은 자료를 다른 사람에게 주거나 과세 목적 밖으로 쓰면 안 된다는 규정도 같은
    조문에 있습니다(제165조 제2항).
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    회사에 내는 기한은 <a href="/guide/year-end-settlement/">연말정산 기간과 순서</a>에
    있습니다.
  </p>
</GuideLayout>
