---
/**
 * "상속세 세율" — 상속세 시리즈. (세율표·상속세율·구간·누진 공제·자녀·증여세 세율 차이도 이 글)
 * 근거: 상속세 및 증여세법 제26조(표 — img alt 로 대조), 제27조(세대생략 할증), 제56조(증여세가 같은 표 준용), 제69조 제1항(3%).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/inheritance-2026.json";
import { taxOn } from "../../../lib/inheritance";
import { won, eokwon } from "../../../lib/won";

const B = r.brackets;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const label = (i: number) => (B[i].upTo === null ? `${eokwon(B[i - 1].upTo!)} 초과` : i === 0 ? `${eokwon(B[i].upTo!)} 이하` : `${eokwon(B[i - 1].upTo!)} 초과 ${eokwon(B[i].upTo!)} 이하`);
const bases = [100_000_000, 500_000_000, 1_000_000_000, 3_000_000_000, 5_000_000_000];

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 gift-inheritance-series.test.ts 가 rates 와 대조한다.
const title = "상속세 세율 — 10%·20%·30%·40%·50%, 과세표준 30억원을 넘으면 50%입니다";
const description =
  "상속세 세율은 과세표준 1억원 이하 10%, 5억원 이하 20%, 10억원 이하 30%, 30억원 이하 40%, 30억원 초과 50%의 5단계 누진세율입니다. 증여세도 같은 표를 씁니다. 손자녀가 상속받으면 30%를 할증하고, 기한 안에 신고하면 3%를 공제합니다.";

const ANSWER = `상속세 세율은 과세표준 ${eokwon(B[0].upTo!)} 이하 ${pct(B[0].rate)}, ${eokwon(B[1].upTo!)} 이하 ${pct(B[1].rate)}, ${eokwon(B[2].upTo!)} 이하 ${pct(B[2].rate)}, ${eokwon(B[3].upTo!)} 이하 ${pct(B[3].rate)}, 그 초과 ${pct(B[4].rate)}입니다(상속세 및 증여세법 제26조). 증여세도 같은 표를 씁니다(제56조).`;

const QA = [
  { q: "상속세 세율은 얼마인가요?", a: `과세표준에 따라 ${pct(B[0].rate)}부터 ${pct(B[4].rate)}까지 5단계 초과누진세율입니다(제26조). 과세표준은 상속재산에서 채무·장례비를 빼고 사전증여를 더한 과세가액에서 일괄공제·배우자공제 등 상속공제를 뺀 금액이라, 재산 전체에 세율을 곱하는 것이 아닙니다.` },
  { q: "상속세 누진공제는 얼마인가요?", a: `과세표준 × 그 구간 세율에서 누진공제를 빼면 산출세액이 됩니다. 누진공제는 20% 구간 ${eokwon(B[1].deduction)}, 30% 구간 ${eokwon(B[2].deduction)}, 40% 구간 ${eokwon(B[3].deduction)}, 50% 구간 ${eokwon(B[4].deduction)}입니다. 과세표준 10억원이면 ${won(taxOn(1_000_000_000))}입니다.` },
  { q: "상속세와 증여세 세율은 다른가요?", a: `같습니다. 증여세는 제26조의 상속세 세율을 그대로 준용합니다(제56조). 두 세금의 차이는 세율이 아니라 계산 단위(상속세는 재산 전체, 증여세는 받은 사람별)와 공제, 신고기한(6개월·3개월)에서 납니다.` },
  { q: "손자녀가 상속받으면 세율이 높아지나요?", a: `세율표는 같지만, 상속인이 피상속인의 자녀가 아닌 직계비속이면 그 사람 몫 산출세액에 ${pct(r.generationSkip.rate)}를 더합니다. 미성년자이면서 받는 재산이 20억원을 넘으면 ${pct(r.generationSkip.minorRate)}입니다. 대습상속은 할증하지 않습니다(제27조).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>과세표준</th><th>세율</th><th>누진공제</th></tr></thead>
    <tbody>
      {B.map((b, i) => <tr><th scope="row">{label(i)}</th><td>{pct(b.rate)}</td><td>{b.deduction ? eokwon(b.deduction) : "없음"}</td></tr>)}
    </tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead><tr><th>과세표준</th><th>산출세액</th><th>신고세액공제 3% 후</th></tr></thead>
    <tbody>
      {bases.map((b) => { const t = taxOn(b); return <tr><th scope="row">{eokwon(b)}</th><td>{won(t)}</td><td>{won(t - Math.round(t * r.filingCredit.rate))}</td></tr>; })}
    </tbody>
  </table>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>증여세 쪽 예시는 <a href="/guide/gift-tax-rate/">증여세 세율</a>에 있습니다.</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    세율이 바뀌는지 — 2026-10-13 현재 시행 중인 법은 {r.lawVersion}이고, 논의 중인 개편은{" "}
    <a href="/guide/inheritance-tax-reform/">상속세 개편</a>에 확정 여부만 정리했습니다.
  </p>
</GuideLayout>
