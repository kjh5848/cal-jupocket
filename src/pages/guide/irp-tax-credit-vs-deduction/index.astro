---
/**
 * "irp 세액공제 소득공제" — IRP 세액공제 시리즈.
 * 자동완성에 두 말이 붙어 뜨는 것은 헷갈려서다. IRP는 세액공제(소득세법 제59조의3)이고
 * 소득공제가 아니다. 차이: 소득공제는 과세표준을 줄여 '내 최고 세율' 만큼 효과,
 * 세액공제는 계산된 세금에서 '정해진 비율' 만큼 뺀다.
 * 세율표는 rates/2026.json 의 incomeTaxBrackets(소득세법 제55조, 이미 검증).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import pa from "../../../rates/pension-account-2026.json";
import rates from "../../../rates/2026.json";
import { manwon, won } from "../../../lib/won";
import { pensionCredit } from "../../../lib/pension-credit";

const amount = 9_000_000;
const credit = pensionCredit({ savings: 0, irp: amount }, true).incomeTax;
const b = rates.incomeTaxBrackets;
// 소득공제였다면 줄었을 세금 = 금액 × 그 사람의 최고 세율(구간이 바뀌지 않는다고 가정)
const asDeduction = (rate: number) => Math.round(amount * rate);
const rows = [b[0], b[1], b[2], b[3]].map((x) => ({ rate: x.rate, saved: asDeduction(x.rate) }));

const title = "IRP 세액공제 소득공제 — IRP는 소득공제가 아니라 세액공제입니다";
const description =
  "IRP는 소득공제가 아니라 세액공제입니다. 소득공제는 과세표준을 줄여 내 최고 세율만큼 효과가 있고, 세액공제는 계산이 끝난 세금에서 12% 또는 15%를 그대로 뺍니다. 그래서 소득이 낮을수록 상대적으로 유리합니다.";

const ANSWER = `IRP는 세액공제입니다. 소득공제처럼 과세표준을 줄이는 것이 아니라, 계산이 끝난 세금에서 넣은 돈의 ${pa.creditRatePercentAboveThreshold}% 또는 ${pa.creditRatePercentBelowThreshold}%를 그대로 뺍니다. 그래서 소득이 많든 적든 같은 비율이고, 세율이 낮은 사람일수록 상대적으로 유리합니다.`;

const QA = [
  { q: "IRP는 소득공제인가요, 세액공제인가요?", a: "세액공제입니다. 소득세법 제59조의3의 이름이 연금계좌세액공제이고, 종합소득산출세액에서 공제한다고 적혀 있습니다. 연말정산 서류에서도 소득공제 칸이 아니라 세액공제 칸에 들어갑니다." },
  { q: "소득공제와 세액공제는 무엇이 다른가요?", a: "소득공제는 세금을 매기기 전의 소득(과세표준)을 줄이고, 세액공제는 계산이 끝난 세금을 줄입니다. 그래서 소득공제는 내 최고 세율만큼, 세액공제는 법이 정한 비율만큼 효과가 납니다." },
  { q: "IRP 세액공제는 고소득자에게 불리한가요?", a: `상대적으로는 그렇습니다. 같은 ${manwon(amount)}이 소득공제였다면 최고 세율이 높은 사람일수록 많이 줄었겠지만, 세액공제는 15% 또는 12%로 고정입니다. 소득이 낮은 쪽이 오히려 15%를 받습니다.` },
];
---

<GuideLayout title={title} description={description} updated={pa.taxCreditVerifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <table>
    <thead>
      <tr><th>&nbsp;</th><th>소득공제</th><th>세액공제(IRP)</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">줄이는 것</th><td>과세표준</td><td>계산된 세금</td></tr>
      <tr><th scope="row">효과의 크기</th><td>금액 × 내 최고 세율</td><td>금액 × {pa.creditRatePercentAboveThreshold}% 또는 {pa.creditRatePercentBelowThreshold}%</td></tr>
      <tr><th scope="row">소득이 높을수록</th><td>효과가 커진다</td><td>비율이 같다(오히려 12%로 낮아진다)</td></tr>
    </tbody>
  </table>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    비교를 위해 {won(amount)}이 만약 소득공제였다면 얼마나 줄었을지를 세율
    구간별로 놓아 봅니다. 실제 IRP는 오른쪽 열이 아니라 아래 문단의 금액입니다.
  </p>
  <table>
    <thead>
      <tr><th>내 최고 세율</th><th>소득공제였다면 줄었을 소득세</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr><th scope="row">{Math.round(r.rate * 100)}%</th><td>{won(r.saved)}</td></tr>
      ))}
    </tbody>
  </table>
  <p>
    실제 IRP 세액공제는 15% 구간이면 {won(credit)}(소득세 기준)입니다. 최고
    세율이 15% 이하인 사람에게는 세액공제가 같거나 더 크고, 24% 이상인 사람에게는
    소득공제였다면 더 컸을 것입니다. 이 표는 공제 때문에 세율 구간이 바뀌지 않는다고
    가정한 단순 비교입니다.
  </p>
  <p>
    공제율이 어떻게 갈리는지는 <a href="/guide/irp-tax-credit-rate/">IRP
    세액공제율</a>, 세율표는 <a href="/guide/income-tax-brackets/">종합소득세 세율
    구간</a>에 있습니다.
  </p>
</GuideLayout>
