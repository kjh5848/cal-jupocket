---
/**
 * "성실사업자 기준" — 성실신고 시리즈. (성실사업자 요건·표준세액공제 12만원·의료비·교육비·월세 세액공제·성실신고확인대상자와 차이도 이 글)
 * 근거: 소득세법 제59조의4 제9항 제2호(표준세액공제 12만원·7만원), 시행령 제118조의8(성실사업자 요건 3가지),
 * 조세특례제한법 제122조의3(의료비·교육비 15%, 월세 15·17%, 추가 요건). rates: diligent-filer-2026.json
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/diligent-filer-2026.json";
import { eokwon } from "../../../lib/won";

const B = r.diligentBusiness;
const SC = r.standardCredit;
const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 diligent-series.test.ts 가 rates 와 대조한다.
const title = "성실사업자 기준 — 카드·현금영수증 가맹, 장부 신고, 사업용계좌 3분의 2 사용 세 가지";
const description =
  "성실사업자는 신용카드·현금영수증 가맹점에 모두 가입하고, 장부로 소득을 신고하고, 사업용계좌로 써야 할 금액의 3분의 2 이상을 쓴 사업자입니다. 표준세액공제가 7만원 대신 12만원이고, 2년 이상 사업 등 요건을 더 갖추면 의료비·교육비 15% 세액공제도 받습니다.";

const ANSWER = `성실사업자는 ① 신용카드·현금영수증 가맹점 모두 가입 ② 장부를 기록해 그에 따라 소득 신고 ③ 사업용계좌 신고와 써야 할 금액의 3분의 2 이상 사용을 모두 갖춘 사업자입니다(소득세법 시행령 제118조의8). 표준세액공제가 ${eokwon(SC.other)} 대신 ${eokwon(SC.diligentBusiness)}입니다(제59조의4 제9항).`;

const QA = [
  { q: "성실사업자 기준은 무엇인가요?", a: `세 가지를 모두 갖춰야 합니다(시행령 제118조의8 제1항). ① 신용카드가맹점과 현금영수증가맹점에 모두 가입(그해 발급 거부 등으로 통보받으면 제외) ② 장부를 비치·기록하고 그에 따라 소득금액을 계산해 신고(추계 결정 연도 제외) ③ 사업용계좌를 신고하고 써야 할 금액의 3분의 2 이상을 사용.` },
  { q: "성실사업자는 어떤 혜택이 있나요?", a: `근로소득이 없는 사업자가 조특법 의료비·교육비·월세 세액공제를 신청하지 않으면 표준세액공제를 받는데, 성실사업자는 연 ${eokwon(SC.diligentBusiness)}, 그 밖의 사업자는 연 ${eokwon(SC.other)}입니다(소득세법 제59조의4 제9항 제2호). 요건을 더 갖추면 의료비·교육비 ${pct(r.medicalEdu.rate)} 세액공제와 월세 세액공제도 됩니다.` },
  { q: "의료비·교육비 세액공제를 받는 성실사업자 요건은요?", a: `위 세 가지에 더해 ① 그해 신고 수입금액이 직전 3년 연평균의 ${pct(B.extraForMedical.growthRatio)}를 넘고 ② 과세기간 개시일 현재 ${B.extraForMedical.years}년 이상 계속 사업했으며 ③ 체납·조세범 처벌 등 시행령 요건에 해당해야 합니다(조특법 제122조의3 제1항). 2026년 과세연도 지출분까지입니다.` },
  { q: "성실사업자와 성실신고확인대상자는 다른가요?", a: `다릅니다. 성실신고확인대상자는 수입금액이 업종별 기준(15억원·7억5천만원·5억원) 이상이라 세무사 확인서를 내야 하는 사업자이고, 성실사업자는 규모와 관계없이 위 요건을 갖춘 사업자입니다. 성실신고확인서를 낸 사업자는 성실사업자 요건 없이도 의료비·교육비·월세 공제를 받습니다(제122조의3).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>①은 카드·현금영수증 가맹 대신 전사적 기업자원 관리설비(ERP)나 판매시점정보관리시스템(POS)을 도입한 사업자 등 재정경제부령으로 정하는 사업자여도 됩니다. 그 범위는 이 글에서 다루지 않았습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>의료비·교육비 공제율은 {pct(r.medicalEdu.rate)}(미숙아·선천성이상아 의료비 20%, 난임시술비 30%)이고, 의료비 공제액은 총급여액 대신 사업소득금액을 넣어 근로자 의료비 공제와 같은 방식으로 계산합니다(조특법 제122조의3 제2항). 월세는 종합소득금액 7천만원 이하면 15%, 4천500만원 이하면 17%이고 월세 1천만원까지입니다(제3항).</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>성실신고확인대상자의 기준·기한·가산세는 <a href="/guide/diligent-filer/">성실신고대상자</a>에 있습니다.</p>
</GuideLayout>
