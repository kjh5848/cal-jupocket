---
/**
 * "주휴수당 조건" — 주휴수당 시리즈. (주휴수당 지급기준·기준·지급 조건·15시간·개근·5인 미만·못 받는 경우·단시간도 이 글)
 * 근거: 근로기준법 제18조 제3항(4주 평균 15시간), 제55조 제1항, 시행령 제30조 제1항(개근), 시행령 별표 1(4명 이하 적용),
 * 별표 2(단시간근로자 유급휴일), 제49조(임금 시효 3년). rates: labor-2026.json
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/labor-2026.json";
import { weeklyHolidayPay, minWage } from "../../../lib/labor";
import { won } from "../../../lib/won";

const W = r.weeklyHoliday;
const m26 = minWage(2026);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 weekly-holiday-series.test.ts 가 rates 와 대조한다.
const title = "주휴수당 조건 — 4주 평균 주 15시간 이상, 그 주 개근 두 가지면 됩니다";
const description =
  "주휴수당 지급기준은 두 가지입니다. 4주 동안 평균한 1주 소정근로시간이 15시간 이상이고, 그 주에 일하기로 정한 날을 모두 출근해야 합니다. 5명 미만 사업장·아르바이트·단시간근로자도 같고, 받지 못한 주휴수당은 3년 안에 청구할 수 있습니다.";

const ANSWER = `주휴수당 조건은 ① 4주 평균 1주 소정근로시간 ${W.minWeeklyHours}시간 이상(근로기준법 제18조 제3항) ② 그 주의 소정근로일 개근(시행령 제30조 제1항) 두 가지입니다. 사업장 규모나 고용 형태는 묻지 않아 5명 미만 사업장 아르바이트도 받습니다(시행령 별표 1·별표 2).`;

const QA = [
  { q: "주휴수당 15시간 기준은 어떻게 세나요?", a: `한 주만 보지 않고 4주 동안(4주 미만으로 일하면 그 기간)을 평균한 1주 소정근로시간으로 봅니다(제18조 제3항). 소정근로시간은 계약으로 정한 시간이라 연장근로는 넣지 않습니다(제2조 제1항 제8호). 평균이 ${W.minWeeklyHours}시간 미만이면 주휴수당과 연차휴가가 모두 적용되지 않습니다.` },
  { q: "개근은 무슨 뜻인가요?", a: `그 주에 일하기로 정한 날(소정근로일)을 하루도 빠지지 않고 출근한 것입니다(시행령 제30조 제1항). 주 3일 근무 계약이면 그 3일만 다 나오면 되고, 계약에 없는 날은 따지지 않습니다. 한 주를 결근하면 그 주의 주휴수당만 없고 다음 주에는 다시 생깁니다.` },
  { q: "5인 미만 사업장도 주휴수당을 줘야 하나요?", a: `줘야 합니다. 상시 4명 이하 사업장에 적용되는 근로기준법 조항을 정한 시행령 별표 1에 제55조 제1항(유급휴일)이 들어 있습니다. 반면 연차휴가(제60조)는 빠져 있어 5명 미만 사업장에는 연차가 없습니다. 단시간근로자에게도 유급휴일을 줘야 합니다(별표 2 제4호).` },
  { q: "주휴수당을 못 받았으면 어떻게 하나요?", a: `주휴수당은 임금이라 3년 안에 청구할 수 있고, 지나면 시효로 소멸합니다(제49조). 퇴사했다면 사용자는 퇴직일부터 14일 안에 밀린 임금을 모두 지급해야 합니다(제36조). 2026년 최저시급 기준 주 20시간이면 한 주에 ${won(weeklyHolidayPay(m26, 20).weekly)}입니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>4주 근무 예</th><th>1주 평균</th><th>주휴수당</th></tr></thead>
    <tbody>
      <tr><th scope="row">매주 16시간</th><td>16시간</td><td>있음</td></tr>
      <tr><th scope="row">12·12·20·20시간</th><td>16시간</td><td>있음</td></tr>
      <tr><th scope="row">매주 14시간</th><td>14시간</td><td>없음</td></tr>
    </tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>다음 주에도 계속 일하기로 되어 있어야 하는지 같은 세부 요건은 법 조문이 아니라 행정해석 영역이라 이 글에서 다루지 않았습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>얼마를 받는지는 <a href="/guide/weekly-holiday-pay-calculator/">주휴수당 계산기</a>, 전체 정리는 <a href="/guide/weekly-holiday-pay/">주휴수당</a>에 있습니다.</p>
</GuideLayout>
