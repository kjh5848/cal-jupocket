---
/**
 * "교육비세액공제" — 교육비 세액공제 시리즈 허브(src/data/series/special-credit.ts). 연말정산 교육비·교육비 공제도 이 글.
 * 근거: 소득세법 제59조의4 제3항(2025. 12. 23. 개정, 2026. 1. 1. 이후 지급분부터), 시행령 제118조의6.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/special-credit-2026.json";
import { educationCreditSeries } from "../../../data/series/special-credit";
import { seriesHref } from "../../../data/series/types";
import { educationCredit } from "../../../lib/special-credit";
import { won, eokwon } from "../../../lib/won";

const E = r.education;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const ex = educationCredit([{ kind: "school", amount: 4_000_000 }, { kind: "university", amount: 8_000_000 }]);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 special-credit-series.test.ts 가 rates 와 대조한다.
const title = "교육비세액공제 — 낸 교육비의 15%, 2026년분부터 자녀 소득과 관계없습니다";
const description =
  "연말정산 교육비세액공제는 근로자가 본인과 가족을 위해 낸 교육비의 15%를 세금에서 뺍니다. 자녀 등 1명당 대학생 900만원, 취학 전·초중고 300만원 한도이고 본인은 한도가 없습니다. 2026년에 낸 교육비부터 가족의 소득과 관계없이 공제됩니다.";

const ANSWER = `교육비세액공제는 근로자가 본인과 기본공제대상자를 위해 낸 교육비의 ${pct(E.rate)}를 세금에서 뺍니다(소득세법 제59조의4 제3항). 1명당 대학생 ${eokwon(E.caps.university)}, 취학 전·초중고 ${eokwon(E.caps.school)} 한도이고 본인은 한도가 없습니다. 2026년 지급분부터 가족 소득과 관계없습니다.`;

const QA = [
  { q: "교육비세액공제란 무엇인가요?", a: `근로소득이 있는 사람이 그해 지급한 교육비의 ${pct(E.rate)}를 종합소득산출세액에서 빼 주는 특별세액공제입니다. 수업료·입학금·보육비용·급식비·교과서대금·방과후 수업료 등이 대상이고(시행령 제118조의6), 연말정산에서 신청해야 적용됩니다.` },
  { q: "연말정산 교육비는 누구 것까지 되나요?", a: `본인과 기본공제대상자인 배우자·직계비속·형제자매·입양자·위탁아동입니다. 2025년 12월 개정으로 2026년에 지급한 교육비부터는 이들의 나이와 소득을 따지지 않습니다(부칙 제5조). 직계존속(부모님) 교육비는 장애인 특수교육비 외에는 목록에 없습니다.` },
  { q: "교육비세액공제 한도는 얼마인가요?", a: `가족은 1명당 대학생 연 ${eokwon(E.caps.university)}, 초등학교 취학 전 아동과 초·중·고등학생 연 ${eokwon(E.caps.school)}입니다. 본인 교육비와 장애인 특수교육비는 한도를 정하지 않았고, 대학원 교육비는 본인만 공제됩니다(제59조의4 제3항).` },
  { q: "학원비도 교육비세액공제가 되나요?", a: `초등학교 취학 전 아동의 학원·체육시설 수강료와, 2026년분부터 9세 미만 또는 2학년 이하 초등학생의 예능 학원·체육시설 수강료가 됩니다(월 단위, 주 1회 이상 교습과정). 그 밖의 초·중·고등학생 학원비는 공제 대상 목록에 없습니다.` },
];
const labelOf = (slug: string) => educationCreditSeries.items.find((x) => x.slug === slug)?.label ?? slug;
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <ul>
    {E.items.list.map((x) => <li>{x}</li>)}
  </ul>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>자세히 — <a href={seriesHref("education-credit-income")}>{labelOf("education-credit-income")}</a></p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    예를 들어 고등학생 자녀 학비 400만원, 대학생 자녀 등록금 800만원이면 고등학생은 {eokwon(E.caps.school)}
    {" "}한도라 공제 대상이 합쳐 {won(ex.base)}, 세액공제는 {won(ex.credit)}입니다 —{" "}
    <a href={seriesHref("education-credit-limit")}>{labelOf("education-credit-limit")}</a>.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>자세히 — <a href={seriesHref("education-credit-academy")}>{labelOf("education-credit-academy")}</a></p>

  <h2>교육비 세액공제, 질문별로 정리했습니다</h2>
  <ul>
    {educationCreditSeries.items.map((x) => <li><a href={seriesHref(x.slug)}>{x.label}</a></li>)}
  </ul>
  <p>
    의료비·기부금은 <a href="/guide/medical-credit/">의료비세액공제</a>,{" "}
    <a href="/guide/donation-credit/">기부금세액공제</a>에 있습니다. 납입증명서 같은 제출 서류의 서식은
    시행규칙이라 이 시리즈에서 다루지 않습니다.
  </p>
</GuideLayout>
