---
/**
 * "양도소득세 신고" — 양도소득세 시리즈. (신고 방법·예정신고·확정신고·신고 안하면·분납·양도차손 신고도 이 글)
 * 근거: 소득세법 제105조(예정신고 — 달·반기 말일부터 2개월, 부담부증여 3개월, 차익 없어도 신고), 제110조(확정신고 5월),
 * 제112조(1천만원 초과 분납 2개월), 국세기본법 제5조(기한이 토요일·공휴일이면 다음 날).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/capital-gains-2026.json";
import { preliminaryDue } from "../../../lib/capital-gains";
import { shiftToBusinessDay, koDate } from "../../../lib/tax-deadline";
import { eokwon } from "../../../lib/won";

const P = r.filing.preliminary;
const I = r.filing.installment;
/** 3·1절(관공서의 공휴일에 관한 규정 제2조) — 하반기 주식·12월 양도분 기한이 2027년 3월 1일(월)로 밀린다. 그 밖의 공휴일 달력은 들고 있지 않다 */
const HOLIDAYS = ["2027-03-01"];
const due = (y: number, m: number, k: "realEstate" | "shares") => koDate(shiftToBusinessDay(preliminaryDue(y, m, k), HOLIDAYS));

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 capital-gains-series.test.ts 가 rates 와 대조한다.
const title = "양도소득세 신고 — 판 달의 말일부터 2개월 안에 예정신고, 다음 해 5월 확정신고";
const description =
  "양도소득세 신고는 부동산을 판 달의 말일부터 2개월 안에 하는 예정신고가 기본입니다. 국내 주식은 반기 말일부터 2개월이고, 양도차익이 없어도 신고합니다. 예정신고를 했으면 확정신고는 대개 생략되며, 낼 세금이 1천만원을 넘으면 2개월 나눠 낼 수 있습니다.";

const ANSWER = `양도소득세 신고는 부동산을 판 달의 말일부터 ${P.realEstateMonths}개월 안에 하는 예정신고가 기본입니다(소득세법 제105조). 국내 주식은 반기 말일부터 ${P.sharesHalfMonths}개월입니다. 예정신고를 했으면 다음 해 5월 확정신고는 대개 하지 않아도 되고, 낼 세금이 ${eokwon(I.over)}을 넘으면 ${I.months}개월 나눠 낼 수 있습니다.`;

const QA = [
  { q: "양도소득세 신고는 언제 하나요?", a: `토지·건물·부동산에 관한 권리는 양도일이 속하는 달의 말일부터 ${P.realEstateMonths}개월 안에 예정신고합니다. 2026년 10월 13일에 팔았다면 ${due(2026, 10, "realEstate")}까지입니다. 국내 주식은 반기 말일부터 ${P.sharesHalfMonths}개월, 부담부증여의 채무 부분은 달의 말일부터 ${P.burdenGiftMonths}개월입니다.` },
  { q: "양도소득세 확정신고도 해야 하나요?", a: `예정신고를 했다면 다음 해 5월 1일부터 31일까지의 확정신고는 하지 않아도 됩니다(제110조). 다만 한 해에 누진세율이 적용되는 자산을 두 번 이상 팔아 각각 예정신고한 경우처럼 합산하면 세액이 달라지는 경우에는 확정신고를 해야 합니다.` },
  { q: "양도차익이 없거나 손해를 봤어도 신고해야 하나요?", a: `해야 합니다. 예정신고는 양도차익이 없거나 양도차손이 발생한 경우에도 적용된다고 조문에 적혀 있습니다(제105조 제3항). 손실을 신고해 두면 같은 해 같은 그룹 자산의 양도소득금액에서 그 차손을 뺄 수 있습니다(제102조).` },
  { q: "양도소득세를 나눠 낼 수 있나요?", a: `예정신고나 확정신고로 낼 세액이 각각 ${eokwon(I.over)}을 넘으면 일부를 납부기한이 지난 뒤 ${I.months}개월 안에 나눠 낼 수 있습니다(제112조). 나눠 낼 수 있는 금액의 세부 한도는 시행령에 있어 이 글에서는 숫자로 쓰지 않습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>판 것</th><th>예정신고 기한</th></tr></thead>
    <tbody>
      <tr><th scope="row">토지·건물·분양권 등</th><td>양도일이 속하는 달의 말일부터 {P.realEstateMonths}개월</td></tr>
      <tr><th scope="row">국내 주식(대주주·장외·비상장)</th><td>양도일이 속하는 반기의 말일부터 {P.sharesHalfMonths}개월</td></tr>
      <tr><th scope="row">부담부증여의 채무 부분</th><td>달의 말일부터 {P.burdenGiftMonths}개월</td></tr>
      <tr><th scope="row">해외주식·파생상품</th><td>예정신고 없음 — 다음 해 5월 확정신고</td></tr>
    </tbody>
  </table>
  <p>달별 날짜는 <a href="/guide/capital-gains-deadline/">양도세 신고기간</a>에 정리했습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    기한 안에 신고하지 않으면 무신고·납부지연 가산세가 붙습니다. 양도소득세 가산세율은 이 글에서 따로 확인하지 않았습니다.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    낼 세금의 어림은 <a href="/guide/capital-gains-calculator/">양도세 계산기</a>로 먼저 확인하세요. 지방소득세는
    양도소득세의 10분의 1이 표준세율입니다(지방세법 제103조의3).
  </p>
</GuideLayout>
