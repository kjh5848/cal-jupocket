---
/**
 * "자동차세 연납 환급" — 자동차세 연납 시리즈. (환급 신청·연납 후 차량 매각도 이 글)
 * 근거: 지방세법 제128조 제5항·제129조·제130조, 시행령 제126조(일할계산식).
 * 반전: 판 사람이 동의하면 산 사람이 그 연세액을 낸 것으로 본다(제130조 제3항 단서).
 * 이미 낸 돈과의 차액을 돌려받는 절차(지방세기본법 환급)는 읽지 않았다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import lt from "../../../rates/local-tax-2026.json";

const T = lt.vehicleTax.transfer;

const title = "자동차세 연납 환급 — 차를 팔면 소유한 날만큼만 내고, 넘긴 몫은 정리합니다";
const description =
  "자동차세를 연납한 뒤 차를 팔면 소유기간만큼 일할계산합니다. 판 사람이 동의하면 산 사람이 그 연세액을 낸 것으로 보고, 폐차하면 그 기분 세액을 일할계산합니다. 지방세법 제129조·제130조 기준입니다.";

const ANSWER = "자동차세를 연납하고 차를 팔면 소유기간만큼 일할계산합니다. 판 사람이 동의하면 산 사람이 그 연세액을 낸 것으로 보기 때문에 거래 당사자끼리 정리하는 길이 있고, 폐차하면 그 기분 세액을 일할계산합니다.";

const QA = [
  { q: "자동차세 연납하고 차를 팔면 환급되나요?", a: "세금은 소유기간에 따라 일할계산해 판 사람과 산 사람에게 각각 부과합니다(지방세법 제129조). 판 사람이 연세액을 한꺼번에 낸 경우, 판 사람이 동의하면 산 사람이 그 세액을 낸 것으로 봅니다(제130조 제3항)." },
  { q: "자동차세 일할계산은 어떻게 하나요?", a: "연세액에 과세대상기간 일수를 곱하고 그해 총일수로 나눕니다. 차령 3년 이상 비영업용 승용차는 그 기분 세액에 일수를 곱하고 기분의 총일수로 나눕니다(시행령 제126조)." },
  { q: "연납한 차를 폐차하면 어떻게 되나요?", a: "말소등록한 날이 속하는 기분의 세액을 일할계산합니다(제130조 제1항). 말소등록하는 사람은 그 등록일에 일할계산해 신고납부할 수도 있습니다(제128조 제5항)." },
  { q: "일할계산한 세금이 아주 적으면 어떻게 되나요?", a: "계산한 세액이 2천원 미만이면 징수하지 않습니다(지방세법 제130조 제4항)." },
];
---

<GuideLayout title={title} description={description} updated={lt.vehicleTax.prepayDiscount.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>
    조문이 정한 것은 두 가지입니다. 소유기간에 따른 일할계산, 그리고 판 사람이
    동의하면 산 사람이 낸 것으로 본다는 것. 이미 낸 돈과의 차액을 돌려받는 환급
    절차는 지방세기본법 쪽이라 이 글에서 다루지 않았습니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>이 글에 없는 것</h2>
  <ul>
    <li><strong>환급 신청 절차와 기한</strong> — 지방세기본법의 환급 규정은 읽지 않았습니다.</li>
    <li><strong>일할계산 신청서 서식</strong> — 행정안전부령입니다.</li>
  </ul>
</GuideLayout>
