---
/**
 * "퇴직연금 해지" — 퇴직금·퇴직연금 시리즈. (퇴직금 IRP 해지·해지 세금·DC형 해지·IRP 계좌 출금도 이 글)
 * 근거: 근로자퇴직급여 보장법 제22조(DC는 법정 사유가 있을 때만 중도인출), 시행령 제18조(IRP 급여 55세·중도인출 사유),
 * 소득세법 제146조 제2항(연금외수령 전까지 원천징수 미룸), 제129조 제1항 제5호의3·제6호 나목, 제48조·제55조.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/severance-2026.json";
import { severanceTax } from "../../../lib/severance";
import { won } from "../../../lib/won";

const P = r.pensionReceipt;
const N = r.pensionIncome;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const ex = severanceTax(50_000_000, 7);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 severance-series.test.ts 가 rates 와 대조한다.
const title = "퇴직연금 해지 — IRP에 넣은 퇴직금은 해지하는 순간 미뤄 둔 퇴직소득세를 냅니다";
const description =
  "퇴직연금 해지는 보통 퇴사 뒤 IRP를 깨는 것입니다. IRP로 옮긴 퇴직금은 퇴직소득세를 미뤄 둔 것이라 해지하면 그 세금을 그대로 내고, 세액공제받은 납입금과 수익에는 기타소득 15%가 붙습니다. 재직 중 DC형은 법정 사유가 있을 때만 꺼낼 수 있습니다.";

const ANSWER = `퇴직연금 해지는 보통 퇴사 뒤 IRP를 깨는 것을 말합니다. IRP로 옮긴 퇴직금은 연금외수령 전까지 퇴직소득세를 미룬 것이라(소득세법 제146조 제2항) 해지하면 그 세금을 그대로 내고, 세액공제받은 납입금과 수익에는 기타소득 ${pct(N.nonAnnuity)}가 붙습니다.`;

const QA = [
  { q: "퇴직금 IRP 해지 세금은 얼마인가요?", a: `IRP에 넣어 둔 퇴직금은 해지할 때 원래 계산된 퇴직소득세를 원천징수합니다. 퇴직금 5천만원·근속 7년이면 지방소득세 포함 ${won(ex.total)}입니다. 같은 돈을 55세 이후 연금으로 받으면 ${pct(P.upTo10)}만 내므로 약 ${won(Math.floor(ex.total * P.upTo10))}입니다.` },
  { q: "IRP를 해지하면 내가 넣은 돈에도 세금이 붙나요?", a: `세액공제를 받고 넣은 돈과 운용수익은 연금이 아니게 꺼내면 기타소득으로 ${pct(N.nonAnnuity)}(지방소득세 포함 16.5%)를 뗍니다(제129조 제1항 제6호 나목). 세액공제를 받지 않은 원금에는 붙지 않습니다.` },
  { q: "회사 다니면서 DC형을 해지할 수 있나요?", a: `법은 재직 중 DC형 적립금을 꺼내는 길로 중도인출만 두었고, 주택구입 등 대통령령 사유가 있어야 합니다(근로자퇴직급여 보장법 제22조). 사유 없이 꺼낼 수는 없습니다. 퇴사 뒤 IRP로 옮긴 돈을 깨는 것이 흔히 말하는 '퇴직연금 해지'입니다.` },
  { q: "해지 대신 일부만 꺼낼 수 있나요?", a: `55세 전에는 IRP도 주택구입·전세·요양·파산·회생·재난·담보대출 상환 같은 사유가 있어야 중도인출됩니다(시행령 제18조 제2항). 55세 이후라면 연금(5년 이상)이나 일시금으로 받을 수 있어, 연금으로 나눠 받으면 퇴직소득세가 30% 이상 줄어듭니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>IRP 안의 돈</th><th>해지(연금외수령)</th><th>55세 이후 연금수령</th></tr></thead>
    <tbody>
      <tr><th scope="row">회사에서 옮긴 퇴직금</th><td>퇴직소득세 그대로</td><td>퇴직소득세의 {Math.round(P.over20 * 100)}~{pct(P.upTo10)}</td></tr>
      <tr><th scope="row">세액공제받은 납입금·수익</th><td>기타소득 {pct(N.nonAnnuity)}</td><td>나이별 {pct(N.byAge[0].rate)}·{pct(N.byAge[1].rate)}·{pct(N.byAge[2].rate)}</td></tr>
      <tr><th scope="row">세액공제받지 않은 납입금</th><td colspan="2">세금 없음</td></tr>
    </tbody>
  </table>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>세액공제분 해지는 <a href="/guide/irp-cancellation-tax/">IRP 세액공제 해지</a>에 계산 예시가 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>
  <p>
    사유는 <a href="/guide/pension-mid-withdrawal/">퇴직연금 중도인출</a>, 받는 방법은{" "}
    <a href="/guide/pension-receipt-method/">퇴직연금 수령방법</a>에 있습니다.
  </p>
</GuideLayout>
