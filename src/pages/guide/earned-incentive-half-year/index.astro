---
/**
 * "2026 근로장려금 상반기" — 근로장려금 시리즈의 반기 신청 글.
 * 근거: 조세특례제한법 제100조의5 제2항(상반기분 35%·하반기분 차액), 제100조의6 제7항(반기 신청 기간),
 * 제100조의7 제1항 제2호(반기별 기한 뒤 3개월 안에 결정), 제100조의8 제3항(15일 안 환급)·제5항(15만원 미만은 정산 때)·제8항(다음 해 6월 30일 정산),
 * 시행령 제100조의6 제3항(근무월수), 제100조의7 제9항(근로소득만 있는 사람), 제100조의9 제4항(15만원)·제7항(환수 순서).
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/earned-incentive-2026.json";
import { firstHalf, halfYearSchedule } from "../../../lib/earned-incentive";
import { won, eokwon } from "../../../lib/won";
import { koDate } from "../../../lib/tax-deadline";

const HY = r.halfYear;
const h = halfYearSchedule(r.year);
const pct = Math.round(HY.firstHalfRate * 100);
// 예시: 홑벌이, 상반기 6개월 근무 근로소득 900만원
const ex = firstHalf("oneEarner", 9_000_000, 6);

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 earned-incentive.test.ts 가 rates 와 대조한다.
const title = "2026 근로장려금 상반기 — 9월 신청분은 12월 15일까지 결정, 15만원 미만이면 정산 때 받습니다";
const description =
  "2026 근로장려금 상반기분은 9월 1일~15일에 반기 신청한 금액으로, 신청기한 뒤 3개월 안인 12월 15일까지 결정하고 결정일부터 15일 안에 지급합니다. 1년 치 금액의 35%이고, 15만원 미만이면 다음 해 정산 때 받습니다.";

const ANSWER = `${r.year} 근로장려금 상반기분은 ${koDate(h.first.from)}~${koDate(h.first.deadline)}에 반기 신청한 금액입니다. 세무서는 ${koDate(h.first.decideBy)}까지 결정하고 결정일부터 ${HY.decisionDays}일 안에 지급합니다. 금액은 1년 치로 환산한 금액의 ${pct}%이고, ${eokwon(HY.holdUnder)} 미만이면 정산 때 받습니다.`;

const QA = [
  { q: "2026 근로장려금 상반기분은 언제 받나요?", a: `반기별 신청기한(${koDate(h.first.deadline)})이 지난 후 3개월 안, 곧 ${koDate(h.first.decideBy)}까지 결정하고(조세특례제한법 제100조의7 제1항 제2호), 결정일부터 ${HY.decisionDays}일 안에 통지·환급합니다(제100조의8 제3항). 결정이 어려운 사유가 있으면 2개월까지 늦어질 수 있습니다.` },
  { q: "근로장려금 반기 신청은 누가 할 수 있나요?", a: `본인과 배우자가 그 반기 동안 근로소득만 있는 사람입니다(시행령 제100조의7 제9항). 사업소득 등 근로소득 외의 소득이 있는 사람이 반기 신청을 하면 정기 신청을 한 것으로 봅니다(제100조의6 제3항). 반기 신청 자격은 직전 해 12월 31일 현재 상황으로 판정합니다.` },
  { q: "상반기분 근로장려금은 어떻게 계산하나요?", a: `상반기 근로소득 ÷ 근무월수 × (근무월수 + 6)을 그해 총급여액 등으로 보고 계산한 금액의 ${pct}%입니다(제100조의5 제2항). 월 15일 이상 일한 달을 1개월로 세고, 일용근로소득과 중도퇴직자는 6개월로 봅니다(시행령 제100조의6 제3항).` },
  { q: "근로장려금 하반기분은 언제 신청하나요?", a: `${r.year}년 하반기분은 ${koDate(h.second.from)}부터 ${koDate(h.second.deadline)}까지입니다(제100조의6 제7항). 상반기분을 신청했다면 본인 의사에 따라 하반기분도 신청한 것으로 봅니다(같은 조 제9항). 하반기분은 1년 치 금액에서 이미 받은 상반기분을 뺀 금액입니다.` },
  { q: "반기 신청한 근로장려금을 돌려줘야 할 수도 있나요?", a: `있습니다. 세무서는 다음 해 6월 30일까지 이미 받은 금액과 1년 치 금액을 비교해 차액을 환급하거나 환수합니다(제100조의8 제8항). 환수액은 그해 자녀장려금에서 먼저 빼고, 남으면 이후 10년간의 근로·자녀장려금에서 뺍니다(시행령 제100조의9 제7항).` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>{r.year}년 소득분</th><th>신청</th><th>법상 결정 기한</th><th>환급</th></tr></thead>
    <tbody>
      <tr><th scope="row">상반기분</th><td>{koDate(h.first.from)} ~ {koDate(h.first.deadline)}</td><td>{koDate(h.first.decideBy)}</td><td>결정일부터 {HY.decisionDays}일 안</td></tr>
      <tr><th scope="row">하반기분</th><td>{koDate(h.second.from)} ~ {koDate(h.second.deadline)}</td><td>{koDate(h.second.decideBy)}</td><td>결정일부터 {HY.decisionDays}일 안</td></tr>
    </tbody>
  </table>
  <p>
    상반기분이 {eokwon(HY.holdUnder)} 미만이면 그때 주지 않고 정산할 때 함께 환급합니다(제100조의8
    제5항 제1호, 시행령 제100조의9 제4항). 정산 때 환수가 예상되는 경우에도 미루는데, 그 기준식은
    이미지로 되어 있어 이 글에서는 읽지 않았습니다. 공휴일 달력은 대조하지 않았습니다.
  </p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>
    예를 들어 홑벌이 가구가 상반기 6개월 동안 근로소득 900만원을 받았다면 1년 치를{" "}
    {eokwon(ex.annualized)}으로 보고, 법 식으로 계산한 금액의 {pct}%인 {won(ex.amount)}이
    상반기분입니다(어림, 실제는 산정표). 1년 치 금액은{" "}
    <a href="/guide/earned-incentive-amount/">근로장려금 금액</a>에서 계산해 보세요.
  </p>

  <h2>{QA[3].q}</h2>
  <p class="qa-lead">{QA[3].a}</p>

  <h2>{QA[4].q}</h2>
  <p class="qa-lead">{QA[4].a}</p>
  <p>
    그래도 남으면 소득세로 납부 고지합니다. 신청자가 원하면 차감 대신 바로 납부 고지를 받을 수
    있습니다(시행령 제100조의9 제7항).
  </p>
</GuideLayout>
