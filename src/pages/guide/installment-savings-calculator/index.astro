---
/**
 * "적금 이자 계산기" — 적금 이자 시리즈. (적금계산기·정기적금 이자계산기·적금 만기 계산·은행 적금 계산기도 이 글, 계산기 포함)
 * 계산: src/lib/installment-savings.ts installmentSavings() — 단리·월복리, 세금은 deposit.ts depositTax().
 * 근거: 적립식예금약관 제4조 ①, 소득세법 제129조 ① 1호, 지방세법 제103조의13, 국고금 관리법 제47조 ① (rates: installment-savings-2026.json)
 * 프리셋 없음 — 자동완성(keywords/ac-installment-savings-2026-10-19.csv)에 월 납입액 금액 줄기가 없다.
 */
import GuideLayout from "../../../layouts/GuideLayout.astro";
import AnswerBox from "../../../components/AnswerBox.astro";
import AdSlot from "../../../components/AdSlot.astro";
import r from "../../../rates/installment-savings-2026.json";
import { installmentSavings } from "../../../lib/installment-savings";
import { INTEREST_RATE, LOCAL_RATIO, THRESHOLD } from "../../../lib/deposit";
import { won, eokwon } from "../../../lib/won";

const pct = (v: number) => `${+(v * 100).toFixed(2)}%`;
const p2 = (v: number) => `${(v * 100).toFixed(2)}%`;
const base = { monthly: 500_000, ratePct: 3.5, months: 12, method: "simple", tax: "normal" } as const;
const ex = installmentSavings(base);
const mc = installmentSavings({ ...base, method: "monthly" });
const m100 = installmentSavings({ ...base, monthly: 1_000_000, months: 36 });
const free = installmentSavings({ ...base, tax: "free" });

// 제목·설명은 RSS·사이트맵 메타가 문자열로 읽는다(guide-meta.ts). 숫자는 installment-savings-series.test.ts 가 rates 와 대조한다.
const title = "적금 이자 계산기 — 월 납입액·이율·기간을 넣으면 15.4%를 뗀 세후 이자와 만기 수령액이 나옵니다";
const description =
  "적금 이자 계산기는 매달 넣을 돈·연 이자율·납입 개월 수로 정기적금의 세전 이자, 소득세·지방소득세, 세후 이자와 만기에 받을 돈을 계산합니다. 단리와 월복리를 바꿔 비교하고, 회차마다 만기까지 몇 개월치 이자를 받는지 표로 보여 줍니다.";

const ANSWER = `월 50만원을 연 3.5%로 12개월 넣으면 단리 세전 이자 ${won(ex.grossInterest)}, ${pct(INTEREST_RATE * (1 + LOCAL_RATIO))}를 뗀 세후 이자 ${won(ex.netInterest)}, 만기 수령액 ${won(ex.maturity)}입니다. 월복리 상품이면 세후 ${won(mc.netInterest)}입니다.`;

const QA = [
  { q: "적금 이자 계산기 세후 금액은 어떻게 나오나요?", a: `세전 이자의 ${pct(INTEREST_RATE)}를 소득세로, 그 소득세의 10%를 지방소득세로 떼고 각각 10원 미만은 버립니다(국고금 관리법 제47조). 월 50만원 3.5% 1년이면 소득세 ${won(ex.incomeTax)}, 지방소득세 ${won(ex.localTax)}, 합계 ${won(ex.tax)}을 뗍니다.` },
  { q: "월 100만원씩 3년 적금이면 만기에 얼마인가요?", a: `연 3.5% 단리면 넣은 돈 ${won(m100.principal)}에 세전 이자 ${won(m100.grossInterest)}, 세금 ${won(m100.tax)}을 떼고 만기에 ${won(m100.maturity)}을 받습니다. 넣은 돈 대비 세후 ${p2(m100.netReturn)}입니다.` },
  { q: "비과세 적금이면 얼마나 더 받나요?", a: `세금이 없으니 세전 이자를 그대로 받습니다. 월 50만원 3.5% 1년이면 ${won(free.netInterest)}으로 일반 적금보다 ${won(free.netInterest - ex.netInterest)} 많습니다. 비과세종합저축·청년 적금 등은 가입 요건이 따로 있어 이 계산기는 요건을 따지지 않습니다.` },
];
---

<GuideLayout title={title} description={description} updated={r.verifiedOn} faq={QA}>
  <h1>{title}</h1>
  <AnswerBox text={ANSWER} />

  <div class="calc-card" data-two>
    <p class="meta">매달 같은 날 같은 돈을 넣고 만기에 한 번에 받는 정기적금 기준입니다. 회차마다 만기까지 남은 개월로 이자를 셈해 원 미만을 버리고, 세금은 만기에 한 번 뗍니다. 늦게·미리 넣은 날수, 우대금리, 중도해지는 넣지 않았습니다.</p>
    <div class="calc-input-wrap">
      <label for="is-monthly">월 납입액</label>
      <input type="text" inputmode="numeric" id="is-monthly" value="500,000" data-won />
      <span class="unit">원</span>
    </div>
    <div class="calc-input-wrap">
      <label for="is-rate">연 이자율</label>
      <input type="number" id="is-rate" value="3.5" min="0" max="30" step="0.01" inputmode="decimal" />
      <span class="unit">%</span>
    </div>
    <div class="calc-input-wrap">
      <label for="is-months">납입 기간</label>
      <input type="number" id="is-months" value="12" min="1" max="600" step="1" data-step />
      <span class="unit">개월</span>
    </div>
    <div class="calc-input-wrap">
      <label for="is-method">이자 방식</label>
      <select id="is-method" data-seg>
        <option value="simple" selected>단리</option>
        <option value="monthly">월복리</option>
      </select>
    </div>
    <div class="calc-input-wrap">
      <label for="is-tax">과세</label>
      <select id="is-tax" data-seg>
        <option value="normal" selected>일반과세 {pct(INTEREST_RATE * (1 + LOCAL_RATIO))}</option>
        <option value="free">비과세</option>
      </select>
    </div>
    <div
      class="result-hero"
      aria-live="polite"
      aria-atomic="true"
      data-bar="is-p|is-net2"
      data-bar-labels="넣은 돈|세후 이자"
      data-dock="is-hero"
    >
      <p class="label">만기 수령액(세후)</p>
      <p class="big" id="is-hero">{won(ex.maturity)}</p>
      <p class="meta" id="is-note">세후 이자 {won(ex.netInterest)} · 넣은 돈 대비 {p2(ex.netReturn)} · 예금으로 치면 세후 연 {p2(ex.depositEquivRate)}</p>
    </div>
    <div class="stat-row" data-receipt>
      <div class="stat-chip"><span class="label">세전 이자</span><span class="value" id="is-gross">{won(ex.grossInterest)}</span></div>
      <div class="stat-chip" data-group="떼는 세금"><span class="label">소득세</span><span class="value" id="is-itax">−{won(ex.incomeTax)}</span></div>
      <div class="stat-chip"><span class="label">지방소득세</span><span class="value" id="is-ltax">−{won(ex.localTax)}</span></div>
      <div class="stat-chip"><span class="label">세후 이자</span><span class="value" id="is-net">{won(ex.netInterest)}</span></div>
      <div class="stat-chip" data-group="만기 수령액"><span class="label">넣은 돈</span><span class="value" id="is-p">{won(ex.principal)}</span></div>
      <div class="stat-chip"><span class="label">세후 이자</span><span class="value" id="is-net2">{won(ex.netInterest)}</span></div>
    </div>
    <p class="meta" id="is-compare">같은 조건 월복리면 세전 이자 {won(ex.monthlyInterest)}(단리보다 {won(ex.monthlyInterest - ex.simpleInterest)} 많음)</p>
    <p class="meta" id="is-threshold" hidden>세전 이자가 {eokwon(THRESHOLD)}을 넘습니다. 한 해 이자·배당이 이 금액을 넘으면 <a href="/guide/financial-income-tax/">금융소득종합과세</a>로 다시 계산합니다.</p>

    <details>
      <summary>회차마다 받는 세전 이자</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>회차</th><th>이자 받는 기간</th><th>그 회차 이자(세전)</th></tr></thead>
          <tbody id="is-rows">
            {ex.rows.map((v) => <tr><th scope="row">{v.round}회</th><td>{v.monthsLeft}개월</td><td>{won(v.interest)}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="meta">회차마다 원 미만을 버려 보여 주므로 합이 위 세전 이자와 몇 원 다를 수 있습니다.</p>
    </details>
  </div>

  <h2>{QA[0].q}</h2>
  <p class="qa-lead">{QA[0].a}</p>
  <p>계산 순서와 월 50만원 예시표는 <a href="/guide/installment-savings-interest/">적금 이자 계산</a>에, 세율 근거는 <a href="/guide/interest-income-tax/">이자소득세</a>에 있습니다.</p>

  <h2>{QA[1].q}</h2>
  <p class="qa-lead">{QA[1].a}</p>
  <p>'예금으로 치면'은 넣은 돈 전체를 첫 달부터 예금에 맡겼다면 연 몇 %짜리와 같은지입니다. 적금 이율이 예금보다 높아 보여도 실제로 받는 이자가 적은 이유는 <a href="/guide/installment-savings-simple-compound/">적금 단리 복리</a>에 있습니다.</p>

  <AdSlot />

  <h2>{QA[2].q}</h2>
  <p class="qa-lead">{QA[2].a}</p>
  <p>몇 달치를 미리 넣고 나머지를 늦게 넣는 6-1-5·1-11 같은 방법으로 만기가 며칠 늦어지는지는 <a href="/guide/prepay-defer-calculator/">선납이연 계산기</a>로 볼 수 있습니다. 약관상 이자는 매달 넣은 것과 같습니다.</p>
  <p>목돈을 한 번에 맡기는 경우는 <a href="/guide/deposit-interest-calculator/">예금 이자 계산기</a>, 돈을 빌리는 쪽 이자는 <a href="/guide/loan-calculator/">대출 이자 계산기</a>로 볼 수 있습니다.</p>

  <script src="../../../scripts/installment-savings.ts"></script>
</GuideLayout>
