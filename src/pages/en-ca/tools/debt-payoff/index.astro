---
/**
 * Debt payoff calculator — 캐나다판. 한국어판 /tools/debt-payoff/ 와 계산(lib/debt-payoff.ts)·스크립트를 같이 쓰고
 * (문구는 scripts/debt-payoff.ts 의 EN 사전, 통화는 판의 CAD, 금액은 센트로 셈), 문장은 캐나다 영어로 새로 썼다(번역 아님).
 * 산술 투영이라 rates 와 상관없다(조사표 캐나다 칸 '같음'). 공유 파일 수정 없음.
 *
 * 소제목은 캐나다 구글 자동완성에서 왔다(keywords/ca-debt-payoff-2026-10-23.csv, hl en · gl ca):
 *   debt payoff calculator canada · debt repayment calculator canada · debt repayment calculator multiple cards /
 *   debt avalanche vs snowball (which is better · calculator) / credit card payoff calculator canada ·
 *   credit card minimum payment calculator canada · how long to pay off credit card calculator /
 *   debt repayment calculator with extra payments · biweekly / debt repayment calculator excel · spreadsheet
 * 캐나다 쪽 사실은 FCAC(canada.ca) 원문에서 확인한 것만(확인 2026-10-23):
 *   빚 순서 두 전략 — 이자율 높은 것부터(이자를 덜 냄)·잔액 작은 것부터(시간이 지나면 더 들 수 있음), 어느 쪽이든 모든 빚에 최소 납입
 *   (https://www.canada.ca/en/financial-consumer-agency/services/debt/paying-debt.html, dcterms.modified 2025-10-14) ·
 *   카드 최소 납입 = 정액(보통 $10) + 이자·수수료, 또는 $10(보통)과 잔액의 %(보통 3%) 중 큰 쪽, 퀘벡 거주자는 2025-08-01부터 5%,
 *   표 1: $2,000 · 18% · 월 $60 → 3년 11개월·이자 $793·총 $2,793 / 월 $160 → 1년 2개월·$231·$2,231
 *   (https://www.canada.ca/en/financial-consumer-agency/services/credit-cards/pay-off-credit-card.html, dcterms.modified 2025-10-15).
 *   표 1 은 이 lib(잔액 × 연율 ÷ 12, 센트 미만 버림)로 그대로 재현된다 — src/lib/__tests__/ca-debt-payoff.test.ts 가 고정.
 * 캐나다 대출·카드가 실제로 이자를 매기는 방식(일할 등)은 조사표에서 미확인이라 사실로 적지 않는다.
 * 본문 숫자는 전부 아래 frontmatter 에서 payoffPlan() 으로 계산한다(센트 단위로 넘기고 ÷ 100).
 */
import BaseHead from "../../../../components/BaseHead.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import ClarityHead from "../../../../components/ClarityHead.astro";
import GtagHead from "../../../../components/GtagHead.astro";
import TrackLinks from "../../../../components/TrackLinks.astro";
import AdSenseHead from "../../../../components/AdSenseHead.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import { payoffPlan, type Debt } from "../../../../lib/debt-payoff";
import "../../../../styles/global.css";

const title = "Debt Payoff Calculator Canada (CAD) — Credit Cards, Lines of Credit, Avalanche vs Snowball";
const description =
  "Canadian debt payoff calculator for credit cards, lines of credit and loans: avalanche vs snowball, extra payments, debt-free date and total interest in CAD.";

/** 예시 빚 — 금액은 센트 */
const sample: Debt[] = [
  { name: "Credit card", balance: 520_000, ratePct: 20.99, minPayment: 15_600, priority: 1 },
  { name: "Line of credit", balance: 800_000, ratePct: 9.95, minPayment: 20_000, priority: 2 },
  { name: "Car loan", balance: 1_400_000, ratePct: 7.49, minPayment: 34_000, priority: 3 },
];
const EXTRA = 20_000;
const ex = payoffPlan({ debts: sample, strategy: "avalanche", extra: EXTRA, extraGrowthPct: 0 });
const snow = payoffPlan({ debts: sample, strategy: "snowball", extra: EXTRA, extraGrowthPct: 0 });
const minOnly = payoffPlan({ debts: sample, strategy: "avalanche", extra: 0, extraGrowthPct: 0 });
/** FCAC 표 1 — $2,000 · 18% · 월 $60 / $160 */
const fcacMin = payoffPlan({ debts: [{ name: "Card", balance: 200_000, ratePct: 18, minPayment: 6_000, priority: 1 }], strategy: "avalanche", extra: 0, extraGrowthPct: 0 });
const fcacMore = payoffPlan({ debts: [{ name: "Card", balance: 200_000, ratePct: 18, minPayment: 16_000, priority: 1 }], strategy: "avalanche", extra: 0, extraGrowthPct: 0 });
if (!ex.ok || !snow.ok || !minOnly.ok || !fcacMin.ok || !fcacMore.ok) throw new Error("en-ca debt-payoff 예시가 계산되지 않음");
const rows = [0, 1, 2, 3, 4].map((i) => sample[i] ?? null);
const cad = (cents: number) =>
  (cents / 100).toLocaleString("en-CA", { style: "currency", currency: "CAD", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const input = (cents: number) =>
  (cents / 100).toLocaleString("en-CA", { minimumFractionDigits: 0, maximumFractionDigits: 2 });
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? "" : "s"}`;
const spell = (m: number) =>
  [Math.floor(m / 12) ? plural(Math.floor(m / 12), "year") : "", m % 12 ? plural(m % 12, "month") : ""].filter(Boolean).join(" ") || "0 months";
const gap = snow.totalInterest - ex.totalInterest;
const firstOf = (r: typeof ex) => [...r.debts].sort((a, b) => a.order - b.order)[0].name;
---

<html lang="en-CA">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>Debt Payoff Calculator</h1>
      <p>
        Carrying a balance on a couple of credit cards, a line of credit and a car loan? Enter each debt with what you
        owe, its annual interest rate and the minimum monthly payment, then add the extra you can put toward debt every
        month. You'll see which debt to tackle first, the month you'll be debt-free and how much interest you'll pay in
        Canadian dollars. When a debt is paid off, its payment rolls over to the next one, so your monthly budget stays the same.
      </p>

      <div class="calc-card" data-two>
        <div class="dp-debts">
          {rows.map((d, i) => (
            <fieldset class="dp-debt" data-row={i + 1}>
              <legend>Debt {i + 1}{i >= 3 ? " (optional)" : ""}</legend>
              <div class="calc-input-wrap">
                <label for={`dp-name-${i + 1}`}>Name</label>
                <input type="text" id={`dp-name-${i + 1}`} value={d?.name ?? ""} placeholder={`Debt ${i + 1}`} maxlength="20" autocomplete="off" />
              </div>
              <div class="calc-input-wrap">
                <label for={`dp-bal-${i + 1}`}>Balance owing ($)</label>
                <input type="text" inputmode="decimal" id={`dp-bal-${i + 1}`} value={d ? input(d.balance) : ""} placeholder="0" autocomplete="off" />
              </div>
              <div class="calc-input-wrap">
                <label for={`dp-rate-${i + 1}`}>Annual interest rate</label>
                <input type="number" id={`dp-rate-${i + 1}`} value={d ? d.ratePct : ""} min="0" max="100" step="0.01" inputmode="decimal" />
                <span class="unit">%</span>
              </div>
              <div class="calc-input-wrap">
                <label for={`dp-min-${i + 1}`}>Minimum monthly payment ($)</label>
                <input type="text" inputmode="decimal" id={`dp-min-${i + 1}`} value={d ? input(d.minPayment) : ""} placeholder="0" autocomplete="off" />
              </div>
              <div class="calc-input-wrap dp-prio">
                <label for={`dp-prio-${i + 1}`}>Your order</label>
                <select id={`dp-prio-${i + 1}`}>
                  {[1, 2, 3, 4, 5].map((n) => <option value={n} selected={(d?.priority ?? i + 1) === n}>{["1st", "2nd", "3rd", "4th", "5th"][n - 1]}</option>)}
                </select>
              </div>
            </fieldset>
          ))}
        </div>

        <div class="calc-input-wrap">
          <label for="dp-strategy">Payoff order</label>
          <select id="dp-strategy" data-seg>
            <option value="avalanche" selected>Highest interest first (avalanche)</option>
            <option value="snowball">Lowest balance first (snowball)</option>
            <option value="custom">My own order</option>
          </select>
        </div>
        <div class="calc-input-wrap">
          <label for="dp-extra">Extra payment each month ($)</label>
          <input type="text" inputmode="decimal" id="dp-extra" value={input(EXTRA)} autocomplete="off" />
        </div>
        <div class="calc-input-wrap">
          <label for="dp-growth">Raise the extra each year by</label>
          <input type="number" id="dp-growth" value="0" min="0" max="100" step="1" inputmode="decimal" />
          <span class="unit">%</span>
        </div>

        <p class="hint" id="dp-err" role="alert"></p>
        <div class="result-hero" aria-live="polite" aria-atomic="true" data-bar="dp-debt|dp-int" data-bar-labels="Principal|Interest" data-dock="dp-hero">
          <p class="label">Time until debt-free</p>
          <p class="big" id="dp-hero">{spell(ex.months)}</p>
          <p class="meta" id="dp-note">{plural(ex.months, "month")} · first-month budget {cad(ex.startBudget)}</p>
        </div>
        <div class="stat-row" data-receipt>
          <div class="stat-chip"><span class="label">Total debt</span><span class="value" id="dp-debt">{cad(ex.totalDebt)}</span></div>
          <div class="stat-chip"><span class="label">Total interest</span><span class="value" id="dp-int">{cad(ex.totalInterest)}</span></div>
          <div class="stat-chip"><span class="label">Total paid</span><span class="value" id="dp-paid">{cad(ex.totalPaid)}</span></div>
          <div class="stat-chip"><span class="label">Avalanche vs snowball interest</span><span class="value" id="dp-vs">Avalanche pays {cad(gap)} less</span></div>
          <div class="stat-chip"><span class="label">Interest saved by paying extra</span><span class="value" id="dp-saved">{cad(minOnly.totalInterest - ex.totalInterest)}</span></div>
        </div>

        <div class="table-scroll">
          <table>
            <thead><tr><th>Order</th><th>Debt</th><th>Paid off</th><th>Interest paid</th></tr></thead>
            <tbody id="dp-order">
              {[...ex.debts].sort((a, b) => a.order - b.order).map((d) => <tr><th scope="row">{d.order}</th><td>{d.name}</td><td>month {d.payoffMonth}</td><td>{cad(d.interest)}</td></tr>)}
            </tbody>
          </table>
        </div>

        <details>
          <summary>Month-by-month payoff schedule: payment, principal, interest, balance</summary>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Month</th><th>Paid</th><th>Principal</th><th>Interest</th><th>Balance</th></tr></thead>
              <tbody id="dp-rows">
                {ex.rows.map((r) => <tr><th scope="row">Month {r.month}</th><td>{cad(r.payment)}</td><td>{cad(r.principal)}</td><td>{cad(r.interest)}</td><td>{cad(r.balance)}</td></tr>)}
              </tbody>
            </table>
          </div>
        </details>

        <div class="actions">
          <button id="btn-download" type="button">Save as PNG</button>
          <button id="btn-share" type="button" class="secondary">Share</button>
        </div>
      </div>

      <h2>Debt avalanche vs snowball: which is better?</h2>
      <p>
        The Financial Consumer Agency of Canada (FCAC) describes two main ways to decide which debt to pay first. With
        either one, you keep making the minimum payment on every debt and send any extra money to a single target:
      </p>
      <ul>
        <li><strong>Avalanche</strong> — list your debts from the highest interest rate to the lowest and pay down the highest rate first. FCAC notes that this way you pay less interest.</li>
        <li><strong>Snowball</strong> — list them from the lowest balance to the highest and pay down the smallest first. You see progress quickly, which can keep you motivated, but FCAC points out it may cost more over time.</li>
      </ul>
      <p>
        In the example above ({sample.map((d) => d.name.toLowerCase()).join(", ")} and {cad(EXTRA)} extra a month),
        avalanche starts with the {firstOf(ex).toLowerCase()} and pays {cad(ex.totalInterest)} in interest over
        {" "}{spell(ex.months)}. Snowball starts with the {firstOf(snow).toLowerCase()} and pays {cad(snow.totalInterest)} over
        {" "}{spell(snow.months)}, so avalanche is {cad(gap)} cheaper here. Switch the payoff order in the calculator to see the
        gap for your own debts; when it's small, the order you'll actually stick with matters more.
      </p>

      <h2>Paying off several credit cards in Canada</h2>
      <p>
        Enter each card as its own debt and use the minimum payment from your latest statement. According to FCAC, a card's
        minimum payment is usually either a flat amount (typically $10) plus interest and fees, or the higher of a dollar
        amount (typically $10) and a percentage of the balance (typically 3%). For Quebec residents, the minimum has been 5%
        since August 1, 2025. Your credit card agreement says which method your issuer uses.
      </p>
      <p>
        This calculator keeps each minimum at the amount you enter, so it works like paying a fixed amount every month. If
        your minimum shrinks as the balance goes down, enter what you plan to keep paying. Have more than five debts? Combine
        the smallest ones or run the calculator twice. Rows left blank or with a zero balance are ignored.
      </p>

      <h2>How long will it take to pay off a credit card?</h2>
      <p>
        FCAC's own example uses a {cad(200_000)} balance at 18%. Paying {cad(6_000)} a month takes {spell(fcacMin.months)} and
        costs {cad(fcacMin.totalInterest)} in interest ({cad(fcacMin.totalPaid)} in total). Paying {cad(16_000)} a month
        clears it in {spell(fcacMore.months)} with {cad(fcacMore.totalInterest)} in interest ({cad(fcacMore.totalPaid)} in
        total). Enter the same numbers as a single debt above and you'll get the same results, which FCAC rounds to the
        dollar.
      </p>
      <p>
        For the three example debts, paying only the minimums takes {spell(minOnly.months)} and {cad(minOnly.totalInterest)}
        {" "}in interest. Adding {cad(EXTRA)} a month brings that down to {spell(ex.months)} and {cad(ex.totalInterest)}, a
        saving of {cad(minOnly.totalInterest - ex.totalInterest)}. The "Raise the extra each year" box grows only the extra
        amount every 12 months (after a raise, for example); the minimum payments stay as entered.
      </p>

      <h2>How the calculation works</h2>
      <ul>
        <li><strong>Monthly budget</strong> — all minimum payments added up, plus the extra. When a debt is paid off the budget doesn't shrink; that payment moves to the next target.</li>
        <li><strong>Interest</strong> — each month, balance × annual rate ÷ 12, rounded down to the cent.</li>
        <li><strong>Each month</strong> — interest is added, every debt gets its minimum payment, and the rest goes to the current target. If the target is paid off part-way through the month, what's left goes to the next target in the same month.</li>
        <li><strong>Order</strong> — avalanche sorts by highest rate (ties: smaller balance first), snowball by lowest starting balance (ties: higher rate first), and "My own order" uses the numbers you choose. The order is set once from what you enter.</li>
      </ul>
      <p>
        To rebuild it in Excel or Google Sheets, use one column per debt and one row per month, work out interest as
        <code>=balance*rate/12</code>, and add the leftover budget to the target column. The month-by-month schedule above
        gives you totals to check your spreadsheet against.
      </p>

      <details>
        <summary>It says my minimum payment is lower than the interest</summary>
        <p>
          That debt never gets smaller on its minimum payment alone. Enter an amount higher than the first month's interest
          (balance × rate ÷ 12). If your minimum changes with the balance, use this month's figure and treat the result as
          an estimate.
        </p>
      </details>

      <details>
        <summary>I pay every two weeks. Can I still use it?</summary>
        <p>
          The calculator works in monthly steps. A biweekly payment adds up to 26 payments a year, so a rough monthly
          equivalent is the biweekly amount × 26 ÷ 12. Because the timing of payments and interest is different, treat the
          result as an approximation.
        </p>
      </details>

      <details>
        <summary>Why doesn't it match my statement?</summary>
        <p>
          This is a planning estimate that charges the same rate every month. Your statement can differ because of how and
          when your lender calculates interest, fees, rate changes, promotional or balance transfer rates and payment dates.
          FCAC also notes that a card can have different rates for purchases and cash advances, and that payments above the
          minimum may go to the highest-rate portion or be spread across the whole balance. Check your agreement or ask your
          lender for exact figures.
        </p>
      </details>

      <h2>Sources</h2>
      <ul>
        <li><a href="https://www.canada.ca/en/financial-consumer-agency/services/debt/paying-debt.html" rel="noopener">Financial Consumer Agency of Canada — Paying back your debt</a> (modified 2025-10-14, checked 2026-10-23)</li>
        <li><a href="https://www.canada.ca/en/financial-consumer-agency/services/credit-cards/pay-off-credit-card.html" rel="noopener">Financial Consumer Agency of Canada — Paying off your credit card</a> (modified 2025-10-15, checked 2026-10-23)</li>
      </ul>
      <p>
        Related: <a href="/en-ca/tools/compound/">compound interest calculator</a> for growing your savings once the debts are gone.
      </p>

      <AdSlot label="debt-payoff-result" />
    </main>
    <SiteFooter />
    <style>
      .dp-debts { display: grid; gap: 0.75rem; }
      .dp-debt { border: 1px solid var(--rule); border-radius: var(--r-md); padding: 0.5rem 0.75rem 0.75rem; margin: 0; min-width: 0; }
      .dp-debt legend { font-weight: 600; padding: 0 0.25rem; }
      .dp-prio[hidden] { display: none; }
    </style>
    <script src="../../../../scripts/debt-payoff.ts"></script>
    <TrackLinks />
    <script src="../../../../scripts/calc-ui.ts"></script>
  </body>
</html>
