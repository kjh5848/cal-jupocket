---
/**
 * Seconds to minutes converter — 캐나다판 여섯 번째 도구(초·분·시간 변환). 한국어판 /tools/sec-convert/ 와
 * 계산(lib/sec-convert.ts)·스크립트(scripts/sec-convert.ts 의 EN 사전, 영어 판 공용)를 같이 쓰고, 문장은 캐나다 영어로 새로 썼다(번역 아님).
 * 조사표 캐나다 칸 '같음'(#91, SI 브로슈어 표 8) · '시간 → 분/초'(#parts)도 같은 페이지.
 *
 * 소제목은 캐나다 구글 자동완성에서 왔다(keywords/ca-sec-convert-2026-10-21.csv · ca-sec-convert-timesheet-2026-10-21.csv, hl en · gl ca):
 *   seconds to minutes formula·chart·timer / decimal hours canada·for payroll·to hours and minutes·conversion chart /
 *   timesheet calculator canada·payroll hours calculator canada·time card calculator canada /
 *   convert seconds to hours minutes seconds excel·google sheets·python·javascript·sql·bash / milliseconds to seconds to minutes
 * 단위 값은 SI 브로슈어 표 8(1 min = 60 s, 1 h = 3600 s, 1 d = 86 400 s)뿐 — 캐나다 법 숫자 없음.
 * 초과근무·근무시간 반올림 규칙은 canada.ca·주 정부 원문을 열지 않아 쓰지 않는다. 본문 예시 숫자는 전부 frontmatter 에서 lib 함수로 계산한다.
 */
import BaseHead from "../../../../components/BaseHead.astro";
import AdSlot from "../../../../components/AdSlot.astro";
import ClarityHead from "../../../../components/ClarityHead.astro";
import GtagHead from "../../../../components/GtagHead.astro";
import TrackLinks from "../../../../components/TrackLinks.astro";
import AdSenseHead from "../../../../components/AdSenseHead.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";
import "../../../../styles/global.css";
import {
  toNanos,
  partsToNanos,
  convertAll,
  readableEn,
  withUnitEn,
  clock,
  minSec,
  UNITS,
  UNIT_NAME_EN,
} from "../../../../lib/sec-convert";

const title = "Seconds to Minutes Converter Canada — Timesheet Decimal Hours, h:mm:ss and Milliseconds";
const description =
  "Convert seconds, minutes, hours, days or milliseconds at once, turn a Canadian timesheet shift into decimal hours, and copy Excel, Python and SQL formulas.";

const EX = "5400";
const n0 = toNanos(EX, "s")!;
const all0 = convertAll(n0);
const p0 = partsToNanos("", "2", "15", "")!;
const pAll0 = convertAll(p0);
const pMs0 = minSec(p0);

/** 본문 예시 — 270초, 8:45~17:15 근무에서 30분 휴게, 7.75시간, 100,000초, 90,000밀리초 */
const S270 = toNanos("270", "s")!;
const S270all = convertAll(S270);
const SHIFT_MIN = String(17 * 60 + 15 - (8 * 60 + 45) - 30);
const SHIFT = toNanos(SHIFT_MIN, "min")!;
const SHIFTall = convertAll(SHIFT);
const H775 = toNanos("7.75", "h")!;
const WEEK = toNanos(String(Number(SHIFT_MIN) * 5), "min")!;
const D1 = convertAll(toNanos("1", "d")!);
const S100k = toNanos("100000", "s")!;
const S100kAll = convertAll(S100k);
const MS90 = toNanos("90000", "ms")!;
const MS90all = convertAll(MS90);
const MS1 = convertAll(toNanos("1", "ms")!);
const fmt = (m: string) => Number(m).toLocaleString("en-CA");
---

<html lang="en-CA">
  <head>
    <BaseHead title={title} description={description} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main>
      <h1>Seconds to minutes converter — plus hours, days, milliseconds and decimal hours</h1>
      <p>
        Type a number and pick its unit. You get the same length of time in milliseconds, seconds, minutes, hours and days, a
        plain-English version in hours, minutes and seconds, and an h:mm:ss clock reading. The maths is fixed — 60 seconds in a
        minute, 3,600 in an hour, 86,400 in a day — and the results update while you type.
      </p>

      <div class="calc-card" data-two>
        <div class="calc-input-wrap">
          <label for="val">Amount</label>
          <input type="text" id="val" inputmode="decimal" autocomplete="off" value={EX} placeholder="e.g. 5400" />
        </div>
        <div class="calc-input-wrap">
          <label for="unit">Unit</label>
          <select id="unit" data-seg>
            {UNITS.map((u) => <option value={u} selected={u === "s"}>{UNIT_NAME_EN[u]}</option>)}
          </select>
        </div>

        <div class="result-hero" aria-live="polite" aria-atomic="true" data-dock="hero-value">
          <p class="label" id="hero-label">{withUnitEn(all0.s, "s")} is</p>
          <p class="big" id="hero-value">{readableEn(n0)}</p>
          <p class="hint" id="hero-sub">{withUnitEn(all0.min, "min")} · h:mm:ss {clock(n0)}</p>
        </div>

        <div class="stat-row" data-receipt id="receipt">
          {UNITS.map((u) => (
            <div class="stat-chip">
              <span class="label">{UNIT_NAME_EN[u]}</span>
              <span class="value" id={`v-${u}`}>{all0[u]}</span>
            </div>
          ))}
        </div>
        <p class="hint" id="err" role="alert"></p>

        <div class="actions">
          <button id="btn-download" type="button">Save as PNG</button>
          <button id="btn-share" type="button" class="secondary">Share</button>
        </div>
      </div>

      <h2 id="parts">Hours and minutes → total seconds, minutes and decimal hours</h2>
      <p>
        Already have the time in pieces — a shift length, a hockey practice, a podcast episode? Fill in whichever boxes you need
        and leave the rest blank.
      </p>
      <div class="calc-card" data-two>
        <div class="sc-parts">
          <div class="calc-input-wrap">
            <label for="p-d">Days</label>
            <input type="text" id="p-d" inputmode="decimal" autocomplete="off" placeholder="0" />
          </div>
          <div class="calc-input-wrap">
            <label for="p-h">Hours</label>
            <input type="text" id="p-h" inputmode="decimal" autocomplete="off" value="2" placeholder="0" />
          </div>
          <div class="calc-input-wrap">
            <label for="p-m">Minutes</label>
            <input type="text" id="p-m" inputmode="decimal" autocomplete="off" value="15" placeholder="0" />
          </div>
          <div class="calc-input-wrap">
            <label for="p-s">Seconds</label>
            <input type="text" id="p-s" inputmode="decimal" autocomplete="off" placeholder="0" />
          </div>
        </div>
        <div class="result-hero" aria-live="polite" aria-atomic="true">
          <p class="label">Total</p>
          <p class="big" id="p-value">{withUnitEn(pAll0.s, "s")}</p>
          <p class="hint" id="p-sub">
            {withUnitEn(pAll0.min, "min")}{pMs0.seconds === "0" ? "" : ` (${pMs0.minutes.toLocaleString("en-CA")} min ${pMs0.seconds} sec)`} · {withUnitEn(pAll0.h, "h")} · {readableEn(p0)}
          </p>
        </div>
        <p class="hint" id="p-err" role="alert"></p>
      </div>

      <h2>Seconds to minutes: the formula</h2>
      <p>
        Divide by 60. A 270-second plank is {S270all.min} minutes, or {readableEn(S270)}. Going the other way, multiply minutes
        by 60 to get seconds.
      </p>
      <p>
        Watch the decimal. {S270all.min} minutes does <strong>not</strong> mean 4 minutes 50 seconds — the part after the
        decimal point is a fraction of a minute. Multiply it by 60 to turn it into seconds: 0.5 × 60 = 30. Likewise 0.75 minutes
        is 45 seconds and 0.2 minutes is 12 seconds.
      </p>

      <h2>Decimal hours for a timesheet or time card</h2>
      <p>
        Payroll software and time card apps usually want hours as a decimal (7.75) rather than hours and minutes (7:45). Here is
        how a typical day works out:
      </p>
      <ol>
        <li>Clock in 8:45, clock out 17:15 — that is 8 hours 30 minutes on site</li>
        <li>Subtract a 30-minute unpaid break → {fmt(SHIFT_MIN)} minutes</li>
        <li>{fmt(SHIFT_MIN)} ÷ 60 = <strong>{SHIFTall.h} hours</strong></li>
        <li>Five of those shifts add up to {withUnitEn(convertAll(WEEK).h, "h")} for the week</li>
      </ol>
      <p>The minutes-to-decimal chart below covers quarter-hours and the six-minute steps (tenths of an hour).</p>
      <table>
        <thead>
          <tr><th>Minutes</th><th>Decimal hours</th><th>Hours and minutes</th></tr>
        </thead>
        <tbody>
          {["6", "12", "15", "18", "20", "24", "30", "36", "40", "42", "45", "48", "54", "90"].map((m) => {
            const n = toNanos(m, "min")!;
            return (
              <tr>
                <td>{fmt(m)}</td>
                <td>{convertAll(n).h}</td>
                <td>{readableEn(n)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p>
        To read decimal hours back as hours and minutes, keep the whole number and multiply the rest by 60: 7.75 hours is 7
        hours + 0.75 × 60 = {readableEn(H775)}. Choose "Hours" above and type 7.75 to check. The converter does plain unit
        maths only — it does not round punch times or apply overtime or break rules; those come from your employer, your payroll
        software and the employment standards that cover your job.
      </p>

      <h2>Seconds to days, hours, minutes and seconds</h2>
      <p>Start with the biggest unit and carry the remainder down. For 100,000 seconds:</p>
      <ol>
        <li>100,000 ÷ 86,400 = 1 day, remainder 13,600</li>
        <li>13,600 ÷ 3,600 = 3 hours, remainder 2,800</li>
        <li>2,800 ÷ 60 = 46 minutes, remainder 40</li>
        <li>So 100,000 seconds = <strong>{readableEn(S100k)}</strong>, or {withUnitEn(S100kAll.h, "h")}</li>
      </ol>
      <p>
        A day is 24 hours, {D1.min} minutes or {D1.s} seconds. The h:mm:ss reading keeps counting past 24 hours instead of
        wrapping to a new day, so a week of those shifts shows as {clock(WEEK)}.
      </p>

      <h2>Milliseconds to seconds to minutes</h2>
      <p>
        Milliseconds ÷ 1,000 = seconds, ÷ 60,000 = minutes and ÷ 3,600,000 = hours. A 90,000 ms timer reading is {MS90all.s}
        {" "}seconds, {MS90all.min} minutes, or {readableEn(MS90)}. Results carry six decimal places, so 1 ms shows as {MS1.s}
        {" "}seconds and rounds to {MS1.min} minutes.
      </p>

      <h2>Excel and Google Sheets formulas</h2>
      <ul>
        <li><strong>Seconds to minutes</strong>: <code>=A1/60</code> · <strong>seconds to hours</strong>: <code>=A1/3600</code></li>
        <li><strong>Minutes to hours</strong>: <code>=A1/60</code> · <strong>hours to minutes</strong>: <code>=A1*60</code></li>
        <li>
          <strong>Seconds shown as hh:mm:ss</strong>: <code>=A1/86400</code> with the custom format <code>[h]:mm:ss</code> —
          spreadsheets store time as a fraction of a day, which is why you divide by 86,400.
        </li>
        <li>
          <strong>Time card hours to decimal</strong>: with clock-in in B1 and clock-out in C1, <code>=(C1-B1)*24</code> gives
          decimal hours; subtract the break, e.g. <code>=(C1-B1)*24-0.5</code>. Format the result as a number.
        </li>
        <li>
          <strong>Weekly totals over 24 hours</strong>: use <code>[h]:mm</code> so the sum doesn't reset at a day. In Google
          Sheets, Format → Number → Duration does the same.
        </li>
      </ul>

      <h2>Python, JavaScript, SQL and bash</h2>
      <p>All of them use the divide-and-keep-the-remainder steps shown above.</p>
      <pre><code>{`# Python
h, rem = divmod(seconds, 3600)
m, s = divmod(rem, 60)

// JavaScript
const h = Math.floor(seconds / 3600);
const m = Math.floor((seconds % 3600) / 60);
const s = seconds % 60;

-- PostgreSQL (interval, e.g. 01:30:00)
SELECT 5400 * INTERVAL '1 second';

-- SQL Server (hh:mm:ss, wraps after 24 hours)
SELECT CONVERT(varchar(8), DATEADD(second, 5400, 0), 108);

# bash
printf '%d:%02d:%02d\\n' $((s/3600)) $((s%3600/60)) $((s%60))`}</code></pre>
      <p>
        Starting from milliseconds? Divide by 1,000 first. Ordinary floating-point maths can produce leftovers like
        66.00000000000001 for 1.1 × 60; this converter counts whole nanoseconds internally, so you won't see those.
      </p>

      <details>
        <summary>Why no weeks, months or years?</summary>
        <p>
          A week is always 7 days, but a month is 28 to 31 days and a year 365 or 366, so neither has one fixed number of
          seconds. For calendar spans between two dates, use the <a href="/en-ca/tools/date-diff/">days between dates
          calculator</a>.
        </p>
      </details>

      <details>
        <summary>Where do 60 and 3,600 come from?</summary>
        <p>
          The International Bureau of Weights and Measures (BIPM) lists the minute, hour and day in Table 8 of the SI Brochure
          as non-SI units accepted for use with the SI: 1 min = 60 s, 1 h = 60 min = 3,600 s, and 1 d = 24 h = 86,400 s.
        </p>
      </details>

      <details>
        <summary>Does a daylight saving time change make a day 23 or 25 hours?</summary>
        <p>
          The clock on the wall jumps an hour, but a converted duration here stays the same: 1 day is always 86,400 seconds.
          For real elapsed time across a time change, count in UTC — the <a href="/en-ca/tools/unix-time/">epoch time
          converter</a> does that.
        </p>
      </details>

      <details>
        <summary>Can I type 1,440.5 with a comma?</summary>
        <p>
          Yes — commas and spaces are ignored, and decimals are read to six places. Use a period as the decimal point; a decimal
          comma (as in 1 440,5) isn't supported. Negative numbers are rejected, since a length of time can't be below zero.
        </p>
      </details>

      <details>
        <summary>Does it handle minutes and seconds of an angle?</summary>
        <p>
          No. Degrees, minutes and seconds of latitude or longitude (1° = 60′ = 3,600″) share the names but measure angles,
          not time.
        </p>
      </details>

      <p>
        Counting down to a date? Try the <a href="/en-ca/tools/dday/">days until countdown</a>.
      </p>

      <p>
        Source: <a href="https://www.bipm.org/en/publications/si-brochure" rel="noopener">BIPM, The International System of Units (SI
        Brochure), Table 8: Non-SI units accepted for use with the SI</a> (checked October 21, 2026)
      </p>

      <AdSlot label="sec-convert-result-en-ca" />
    </main>
    <SiteFooter />
    <style>
      .sc-parts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 10px; }
      @media (max-width: 560px) { .sc-parts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      pre { overflow-x: auto; }
    </style>
    <script src="../../../../scripts/sec-convert.ts"></script>
    <TrackLinks />
    <script src="../../../../scripts/calc-ui.ts"></script>
  </body>
</html>
