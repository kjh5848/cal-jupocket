---
/**
 * 전세 용어 풀이 — HUG 전세 도우미 두 페이지(체크리스트·보증 계산기) 맨 아래.
 *
 * 2026-11-08 사용자: "전세대출 등 용어들이 다 너무 어렵다". 뜻은 조사 문서
 * docs/research/2026-11-07-hug-jeonse.md 의 출처(HUG·주택도시기금·법령)에서 확인한 것만 쉬운 말로 옮겼다.
 * 숫자는 rates(hug-jeonse-2026.json)에서만 꺼낸다 — 손으로 적지 않는다.
 */
import r from "../rates/hug-jeonse-2026.json";
import { TERM_GROUPS as groups } from "../data/jeonse-terms";


const ld = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: "전세 용어 풀이",
  hasDefinedTerm: groups.flatMap((g) => g.terms.map((x) => ({ "@type": "DefinedTerm", name: x.t, description: x.d }))),
};
---

<section class="glossary" id="terms" aria-labelledby="terms-h">
  <h2 id="terms-h">전세 용어 풀이</h2>
  <p class="glossary-lead">이 페이지에 나오는 말을 쉬운 말로 풀었습니다. 각 항목의 <b>출처</b>는 HUG·주택도시기금·법령 원문입니다(확인 {r.verifiedOn}).</p>
  {
    groups.map((g) => (
      <div class="glossary-group">
        <h3>{g.h}</h3>
        <dl>
          {g.terms.map((x) => (
            <div class="glossary-item">
              <dt>{x.t}</dt>
              <dd>
                {x.d}{" "}
                <a href={x.src} rel="noopener" target="_blank" class="glossary-src">
                  출처
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .glossary {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .glossary-lead {
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .glossary-group h3 {
    margin: 1.5rem 0 0.5rem;
  }
  .glossary dl {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }
  .glossary-item {
    padding: 0.75rem 0.9rem;
    background: var(--accent-bg);
    border-radius: var(--r-md);
  }
  .glossary dt {
    font-weight: 700;
  }
  .glossary dd {
    margin: 0.25rem 0 0;
    line-height: 1.7;
  }
  .glossary-src {
    font-size: var(--t-sm);
    color: var(--muted);
    white-space: nowrap;
  }
</style>
