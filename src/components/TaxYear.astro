---
/**
 * 한 해 세금 — 열두 달로 한 번, 가진 것으로 한 번.
 *
 * **왜 부품인가.** 지금은 단독 글 한 편이 이걸 부르지만, 홈이 계산기부터
 * 보여주는 지금 순서는 뒤집혀 있다(`docs/monetization.md` 10절 — 계산기는
 * 재방문 0 · 체류 15~40초 · 페이지뷰 1). 언젠가 홈이 이걸 먼저 보여주는
 * 게 맞을 텐데, 그때 페이지를 옮기면 URL 이 쌓은 색인을 버린다. 부품으로
 * 두면 홈에 `<TaxYear />` 한 줄이면 끝이고 이사도 리다이렉트도 없다.
 *
 * **왜 표가 둘인가.** 같은 데이터를 두 질문에 답하게 한다.
 *
 *   "이번 달에 뭐가 오지?"   → 열두 달
 *   "집이 있는데 뭘 내지?"    → 가진 것
 *
 * 사람은 후자로 검색한다(재산세·자동차세). 달력은 구조일 뿐이라 제목에
 * 쓰지 않는다 — `docs/keyword-research.md` v15.
 *
 * **빈 칸을 채우지 않는다.** 없는 달은 "정해진 기한이 없습니다" 라고
 * 적는다. 빈 칸으로 두면 "낼 게 없다" 로 읽힌다 — 우리가 아직 안 읽은
 * 것과 실제로 없는 것은 다르다.
 */
import {
  TAX_EVENTS,
  RELATIVE_DEADLINES,
  DOMAIN_LABEL,
  byMonth,
  byDomain,
  activeDomains,
  type Domain,
} from "../data/tax-calendar";

interface Props {
  /** 홈에 얹을 때는 제목을 홈 쪽 위계에 맞춘다. */
  headingLevel?: "h2" | "h3";
}
const { headingLevel = "h2" } = Astro.props;
const H = headingLevel;
const HSub = headingLevel === "h2" ? "h3" : "h4";

const months = Array.from({ length: 12 }, (_, i) => i + 1);
const domains = activeDomains();

/** 그 달에 아무것도 없으면 "없음"이라고 적는다 — 빈 칸은 오해를 부른다. */
const quiet = months.filter((m) => byMonth(m).length === 0);

/** 영역별 아이콘 대신 글자를 쓴다. 세목이 아니라 "가진 것"이 기준이다. */
const DOMAIN_HINT: Record<Domain, string> = {
  work: "3.3% 떼이거나 사업소득이 있으면",
  business: "사업자등록이 있으면",
  property: "집·땅·건물이 있으면",
  vehicle: "차가 있으면",
  living: "주소지가 있으면",
  wealth: "받거나 물려줄 일이 생기면",
  retirement: "연금을 넣거나 받으면",
};
---

<section class="ty" aria-labelledby="ty-months-h">
  <H id="ty-months-h" class="ty-h">열두 달, 언제 무엇이 오나</H>
  <p class="ty-lead">
    고지서가 오는 것과 내가 신고하는 것을 나눠 적었습니다. 날짜는 전부 법령
    조문에서 확인한 값입니다.
  </p>

  <ol class="ty-months">
    {
      months.map((m) => {
        const events = byMonth(m);
        return (
          <li class:list={["ty-month", events.length === 0 && "is-quiet"]}>
            <div class="ty-month-no">
              <span class="ty-num">{m}</span>
              <span class="ty-unit">월</span>
            </div>
            <div class="ty-month-body">
              {events.length === 0 ? (
                <p class="ty-none">이 달에 정해진 기한은 없습니다.</p>
              ) : (
                <ul class="ty-events">
                  {events.map((e) => (
                    <li class="ty-event">
                      <div class="ty-event-head">
                        <span class:list={["ty-kind", `is-${e.kind}`]}>{e.kind}</span>
                        {e.href ? (
                          <a href={e.href} class="ty-label">
                            {e.label}
                          </a>
                        ) : (
                          <span class="ty-label">{e.label}</span>
                        )}
                        <span class="ty-when">
                          {e.from}
                          {e.to ? ` ~ ${e.to}` : ""}
                        </span>
                      </div>
                      <p class="ty-who">{e.who}</p>
                      <p class="ty-src">{e.article}</p>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>

  {
    quiet.length > 0 && (
      <p class="ty-note">
        {quiet.join("·")}월이 비어 있는 것은 그 달에 낼 세금이 없다는 뜻이
        아닙니다. <strong>우리가 원문에서 확인한 기한이 없다</strong>는
        뜻입니다. 아직 읽지 않은 세금이 있습니다 — 연말정산, 취득세,
        종합부동산세, 지방소득세. 확인되는 대로 채웁니다.
      </p>
    )
  }
</section>

<section class="ty" aria-labelledby="ty-domains-h">
  <H id="ty-domains-h" class="ty-h">가진 것으로 보면</H>
  <p class="ty-lead">
    같은 표를 다시 그린 것입니다. 세금 이름이 아니라 <strong>내가 가진
    것</strong>부터 찾으세요.
  </p>

  <div class="ty-domains">
    {
      domains.map((d) => (
        <article class="ty-domain">
          <HSub class="ty-domain-h">{DOMAIN_LABEL[d]}</HSub>
          <p class="ty-domain-hint">{DOMAIN_HINT[d]}</p>
          <ul class="ty-domain-list">
            {byDomain(d).map((e) => (
              <li>
                <span class="ty-domain-when">{e.month}월</span>
                {e.href ? <a href={e.href}>{e.label}</a> : <span>{e.label}</span>}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<section class="ty" aria-labelledby="ty-rel-h">
  <H id="ty-rel-h" class="ty-h">달력에 없는 것 — 사람마다 날짜가 다릅니다</H>
  <p class="ty-lead">
    상속과 증여는 사망일·증여일에서 셉니다. 그래서 몇 월이라고 적을 수
    없습니다.
  </p>
  <ul class="ty-rel">
    {
      RELATIVE_DEADLINES.map((d) => (
        <li>
          <div class="ty-event-head">
            {d.href ? (
              <a href={d.href} class="ty-label">
                {d.label}
              </a>
            ) : (
              <span class="ty-label">{d.label}</span>
            )}
          </div>
          <p class="ty-who">{d.rule}</p>
          <p class="ty-src">{d.article}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .ty + .ty {
    margin-top: 2.5rem;
  }
  .ty-h {
    margin-bottom: 0.4rem;
  }
  .ty-lead {
    color: var(--muted);
    margin-bottom: 1.1rem;
  }

  /* ── 열두 달 ─────────────────────────────────── */
  .ty-months {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ty-month {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: 0.75rem 0.9rem;
  }
  .ty-month.is-quiet {
    background: var(--surface-2);
  }
  .ty-month-no {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.1rem;
    color: var(--muted);
  }
  .ty-num {
    font-size: 1.5rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--brand);
  }
  .ty-unit {
    font-size: 0.8125rem;
  }
  .is-quiet .ty-num {
    color: var(--muted);
  }

  .ty-events {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ty-event-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.55rem;
  }
  .ty-kind {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  .ty-kind.is-신고 {
    background: color-mix(in srgb, var(--chart-base) 18%, transparent);
    color: var(--chart-base);
  }
  .ty-kind.is-고지 {
    background: color-mix(in srgb, var(--chart-loss) 18%, transparent);
    color: var(--chart-loss);
  }
  .ty-kind.is-기준일 {
    background: var(--accent-bg);
    color: var(--muted);
  }
  .ty-label {
    font-weight: 700;
  }
  .ty-when {
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ty-who {
    margin: 0.2rem 0 0;
    font-size: 0.9375rem;
  }
  .ty-src {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .ty-none {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .ty-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* ── 가진 것 ─────────────────────────────────── */
  .ty-domains {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .ty-domain {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: 0.9rem 1rem;
  }
  .ty-domain-h {
    margin: 0;
    font-size: 1rem;
  }
  .ty-domain-hint {
    margin: 0.15rem 0 0.6rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ty-domain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }
  .ty-domain-list li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .ty-domain-when {
    flex: 0 0 2.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── 상대 기한 ───────────────────────────────── */
  .ty-rel {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ty-rel > li {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: 0.8rem 1rem;
  }

  @media (max-width: 30rem) {
    .ty-month {
      grid-template-columns: 2.5rem 1fr;
      gap: 0.5rem;
      padding: 0.7rem 0.75rem;
    }
    .ty-num {
      font-size: 1.25rem;
    }
  }
</style>
