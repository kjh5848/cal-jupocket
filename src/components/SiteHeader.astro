---
/**
 * 사이트 공통 마스트헤드. 모든 페이지 상단에 같은 모양으로 들어간다.
 * 심볼은 인라인 SVG(B안 — 포켓 라인 + ₩)라 네트워크 요청이 0이고
 * currentColor를 써서 라이트/다크에 맞춰 색이 바뀐다. 파비콘은
 * public/favicon.svg(A안 채움형)로 분리한다.
 */
import BrandMark from "./BrandMark.astro";
---

<header class="site-header">
  <a href="/" class="brand" aria-label="주포켓 계산기 홈">
    <BrandMark class="brand-mark" />
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/privacy/">개인정보처리방침</a>
  </nav>
</header>
