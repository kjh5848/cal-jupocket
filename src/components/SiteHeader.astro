---
/**
 * 사이트 공통 마스트헤드.
 *
 * 한동안 로고 심볼 하나만 두고 있었는데(2cb80b3), 계산기 다섯 개와 글
 * 열네 편, 카드뉴스가 생긴 지금은 헤더에서 아무 데도 갈 수 없는 게 더
 * 큰 문제가 됐다. 이름을 되살리고 세 갈래를 연다.
 *
 * 개인정보처리방침은 푸터에만 둔다 — 길잡이가 아니라 법적 고지다.
 *
 * 계산기·읽을거리는 홈의 구획으로 보낸다. 목록 페이지를 따로 만들면
 * 홈과 같은 내용이 두 군데가 되어 서로 순위를 갉아먹는다.
 *
 * 나라판(/ja/, /en-us/ …)은 같은 틀에 그 언어 메뉴를 단다. 카드뉴스는 한국어 계정 것이라 한국어판에만.
 * 같은 계산을 하는 다른 판이 있을 때만 언어 전환을 둔다(src/i18n/alternates.ts) — 하나면 링크,
 * 여럿이면 접히는 목록.
 */
import BrandPocket from "./BrandPocket.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { clusters } from "../data/clusters";
import { ui, localeOf, LOCALES } from "../i18n/ui";
import { meta } from "../i18n/locales";
import { alternatesFor } from "../i18n/alternates";

/** 계산기 주소는 clusters.ts 가 안다 — 여기 따로 적으면 새 계산기가 빠진다. */
const calcPaths = new Set(
  clusters.flatMap((c) => c.links.filter((l) => l.kind === "calc").map((l) => l.href)),
);

const here = Astro.url.pathname;
const locale = localeOf(here);
const T = ui(locale);
const links =
  locale !== "ko"
    ? [{ href: `${T.home}#tools`, label: T.navTools, match: (p: string) => p === T.home || p.startsWith(`${T.home}tools/`) }]
    : [
        {
          href: "/#tools",
          label: T.navTools,
          match: (p: string) => p === "/" || calcPaths.has(p),
        },
        { href: "/#reads", label: T.navReads, match: (p: string) => p.startsWith("/guide/") },
        { href: "/cards/", label: T.navCards, match: (p: string) => p.startsWith("/cards/") },
      ];
const alt = alternatesFor(here);
const others = LOCALES.filter((l) => l !== locale && alt[l]).map((l) => ({
  href: alt[l]!,
  hreflang: meta(l).hreflang,
  htmlLang: meta(l).htmlLang,
  name: ui(l).langName,
  title: ui(l).langSwitch,
}));
---

<header class="site-header">
  <a href={T.home} class="brand" aria-label={T.homeLabel}>
    <BrandPocket size={40} />
    <span class="brand-name">{T.brand}</span>
  </a>
  <nav class="site-nav" aria-label={T.navLabel}>
    {
      links.map((l) => (
        <a href={l.href} aria-current={l.match(here) ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
    {others.length === 1 && (
      <a href={others[0].href} hreflang={others[0].hreflang} lang={others[0].htmlLang} class="lang-switch" title={others[0].title}>
        {others[0].name}
      </a>
    )}
    {others.length > 1 && (
      <details class="lang-menu">
        <summary>{T.langMenu}</summary>
        <ul>
          {others.map((o) => (
            <li>
              <a href={o.href} hreflang={o.hreflang} lang={o.htmlLang}>{o.name}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </nav>
  <ThemeToggle />
</header>
