---
/**
 * "AI에게 물어보기" — 대출 계산기 위(2026-11-08 시범).
 *
 * 질문 → api.jupocket.com/api/chat. 서버의 해석기(src/lib/loan-parse)·AI 가 금액·금리·기간만 뽑고,
 * 숫자는 loan.ts 계산 결과다(모델이 쓴 문장·금액은 보여 주지 않는다). 답이 나오면 아래 계산기에 같은 값을 넣는다.
 * 광고(AdSlot) 옆에 두지 않는다 — 계산기 바로 위.
 */
interface Props {
  /** 계산기 입력 칸 id — 답의 값을 넣을 곳 */
  ids: { principal: string; months: string; rate: string; method: string; grace: string };
}
const { ids } = Astro.props;
const EXAMPLES = ["3억 4.5% 30년 원리금균등", "2억 4천 3.5% 2년 이자만", "1억 5천 4% 20년 거치 1년"];
---

<section class="ask-ai" data-ids={JSON.stringify(ids)} aria-labelledby="ask-ai-h">
  <p class="ask-ai-h" id="ask-ai-h"><span aria-hidden="true">✨</span> AI에게 물어보기 <span class="ask-ai-beta">시범</span></p>
  <form class="ask-ai-form" id="ask-ai-form">
    <label class="sr-only" for="ask-ai-q">대출 질문</label>
    <input id="ask-ai-q" type="text" maxlength="300" autocomplete="off" enterkeyhint="send" placeholder="예: 3억 4.5% 30년이면 매달 얼마?" />
    <button type="submit" id="ask-ai-go">묻기</button>
  </form>
  <div class="ask-ai-ex">
    {EXAMPLES.map((e) => <button type="button" data-ex={e}>{e}</button>)}
  </div>
  <div class="ask-ai-out" id="ask-ai-out" aria-live="polite" hidden></div>
  <p class="ask-ai-meta">말로 물으면 금액·금리·기간을 읽어 아래 계산기로 계산합니다. 은행별 금리·자격은 답하지 않습니다. 계산하지 못한 질문만 다음 글감으로 날짜와 함께 저장하고, 누가 물었는지는 저장하지 않습니다(<a href="/privacy/#ask-ai">개인정보 처리방침</a>).</p>
</section>

<script src="../scripts/ask-ai.ts"></script>

<style>
  .ask-ai {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0;
    padding: 1rem;
    background: var(--brand-wash);
    border-radius: var(--r-lg);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .ask-ai-h {
    margin: 0;
    font-weight: 800;
  }
  .ask-ai-beta {
    margin-left: 0.25rem;
    padding: 0.05rem 0.45rem;
    font-size: var(--t-xs, 0.75rem);
    font-weight: 700;
    color: var(--brand);
    background: var(--surface);
    border-radius: var(--r-pill);
  }
  .ask-ai-form {
    display: flex;
    gap: 0.5rem;
  }
  .ask-ai-form input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0 0.85rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
  }
  .ask-ai-form button {
    flex: none;
    min-height: 46px;
    padding: 0 1.1rem;
    font: inherit;
    font-weight: 700;
    color: var(--surface);
    background: var(--brand);
    border: 0;
    border-radius: var(--r-md);
    cursor: pointer;
  }
  .ask-ai-form button:disabled {
    opacity: 0.6;
  }
  .ask-ai-ex {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ask-ai-ex button {
    min-height: 32px;
    padding: 0 0.7rem;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  .ask-ai-out {
    display: grid;
    gap: 0.5rem;
    padding: 0.85rem 0.95rem;
    background: var(--surface);
    border-radius: var(--r-md);
    line-height: 1.65;
  }
  .ask-ai-out[hidden] {
    display: none;
  }
  .ask-ai-out :global(dl) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .ask-ai-out :global(dt) {
    color: var(--muted);
  }
  .ask-ai-out :global(dd) {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .ask-ai-out :global(p) {
    margin: 0;
  }
  .ask-ai-out :global(.note),
  .ask-ai-meta {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .ask-ai-out :global(.ask-ai-fill) {
    justify-self: start;
    min-height: 36px;
    padding: 0 0.9rem;
    font: inherit;
    font-weight: 700;
    color: var(--brand);
    background: transparent;
    border: 1px solid var(--brand);
    border-radius: var(--r-pill);
    cursor: pointer;
  }
</style>
