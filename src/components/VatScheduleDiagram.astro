---
/**
 * 부가세 연간 신고·납부 일정 타임라인.
 *
 * 경쟁 글은 "1기 7월, 2기 1월" 식으로 문장으로만 던진다. 정작 헷갈리는
 * 건 "개인은 예정신고가 아니라 예정고지라 4·10월에 돈만 낸다"는 점과
 * "간이는 1년에 한 번뿐"이라는 대비다. 그래서 12개월 트랙 위에 신고(파랑)
 * ·고지(주황)를 찍어 개인 일반과 간이를 나란히 비교한다.
 *
 * 좁은 화면에서는 트랙이 가로로 스크롤된다(다른 차트와 동일 규칙).
 * 각진 네모로 통일한다.
 */
interface Event {
  month: number;
  kind: "return" | "notice"; // 신고 / 고지
  label: string;
}
interface Track {
  name: string;
  events: Event[];
}

const tracks: Track[] = [
  {
    name: "개인 일반과세자",
    events: [
      { month: 1, kind: "return", label: "확정신고" },
      { month: 4, kind: "notice", label: "예정고지" },
      { month: 7, kind: "return", label: "확정신고" },
      { month: 10, kind: "notice", label: "예정고지" },
    ],
  },
  {
    name: "간이과세자",
    events: [{ month: 1, kind: "return", label: "확정신고" }],
  },
];

const months = Array.from({ length: 12 }, (_, i) => i + 1);
const eventAt = (t: Track, m: number) => t.events.find((e) => e.month === m);
---

<figure class="chart-figure">
  <div class="chart-scroll">
    <div class="vs-timeline">
      <div class="vs-row vs-monthhead">
        <span class="vs-name" aria-hidden="true"></span>
        {months.map((m) => (
          <span class="vs-month-label">{m}월</span>
        ))}
      </div>
      {
        tracks.map((t) => (
          <div class="vs-row">
            <span class="vs-name">{t.name}</span>
            {months.map((m) => {
              const ev = eventAt(t, m);
              return (
                <span
                  class:list={["vs-cell", ev && `is-${ev.kind}`]}
                >
                  {ev && <span class="vs-tag">{ev.label}</span>}
                </span>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>

  <ul class="chart-legend" aria-hidden="true">
    <li>
      <span class="swatch" style="background: var(--chart-base)"></span>
      확정신고 (직접 신고·납부)
    </li>
    <li>
      <span class="swatch" style="background: var(--chart-loss)"></span>
      예정고지 (고지서로 납부만)
    </li>
  </ul>

  <figcaption>
    개인 일반과세자는 <strong>7월·1월에 직접 신고</strong>하고, 그 사이
    4월·10월엔 예정고지서로 <strong>납부만</strong> 합니다(직전 세액의 절반).
    간이과세자는 <strong>1월에 한 번</strong>이면 끝입니다.
  </figcaption>
</figure>

<style>
  .vs-timeline {
    min-width: 34rem; /* 12개월 트랙 — 좁으면 chart-scroll이 가로 스크롤 */
    border: 1px solid var(--rule);
  }
  .vs-row {
    display: grid;
    grid-template-columns: 7rem repeat(12, 1fr);
    align-items: stretch;
  }
  .vs-row + .vs-row {
    border-top: 1px solid var(--rule);
  }
  .vs-monthhead {
    background: var(--accent-bg);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .vs-month-label {
    padding: 0.35rem 0;
    text-align: center;
    border-left: 1px solid var(--rule);
  }
  .vs-name {
    padding: 0.6rem 0.7rem;
    font-weight: 700;
    font-size: 0.875rem;
    border-right: 1px solid var(--rule);
    display: flex;
    align-items: center;
  }
  .vs-cell {
    border-left: 1px solid var(--rule);
    min-height: 2.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.15rem;
  }
  .vs-cell.is-return {
    background: color-mix(in srgb, var(--chart-base) 16%, transparent);
    box-shadow: inset 0 -3px 0 var(--chart-base);
  }
  .vs-cell.is-notice {
    background: color-mix(in srgb, var(--chart-loss) 16%, transparent);
    box-shadow: inset 0 -3px 0 var(--chart-loss);
  }
  .vs-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }
</style>
