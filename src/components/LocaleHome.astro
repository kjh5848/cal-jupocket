---
/**
 * 나라판 홈(/ja/, /en-us/ …) — 한국어판 홈과 같은 틀(히어로 + 도구 카드), 내용은 그 판의 도구 목록.
 * 각 판의 src/pages/<판>/index.astro 는 이 컴포넌트에 locale 만 넘긴다. 판이 열리는 것은 그 판의
 * 첫 도구가 나갈 때다 — 도구가 하나도 없는 빈 홈은 만들지 않는다(얇은 페이지는 색인을 해친다).
 *
 * 도감 번호·수집 진행률·검색은 두지 않는다. 도구가 몇 개 없을 때 진행률은 비어 보이기만 하고,
 * 검색은 고를 것이 생긴 뒤에 의미가 있다. 도구가 늘면 한국어판 부품을 붙인다.
 */
import BaseHead from "./BaseHead.astro";
import ClarityHead from "./ClarityHead.astro";
import GtagHead from "./GtagHead.astro";
import AdSenseHead from "./AdSenseHead.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { ui, type Locale } from "../i18n/ui";
import { toolsOf } from "../i18n/registry";
import { typeInfo } from "../data/tool-types";
import { icons } from "../data/icons";
import "../styles/global.css";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const T = ui(locale);
const list = toolsOf(locale);
---

<html lang={T.htmlLang}>
  <head>
    <BaseHead title={T.homeTitle} description={T.homeDescription} />
    <ClarityHead />
    <GtagHead />
    <AdSenseHead />
  </head>
  <body class="bg-texture">
    <SiteHeader />
    <main class="home">
      <section class="home-hero">
        <div class="home-hero-inner">
          <h1>{T.homeH1}</h1>
          <p class="hero-lede">{T.homeLede}</p>
        </div>
      </section>

      <section id="tools" aria-labelledby="tools-h">
        <h2 id="tools-h" class="home-h">{T.toolsHeading}</h2>
        <div class="tool-grid">
          {
            list.map((t) => (
              <a class="tool-card" href={t.href} data-type={t.type} style={`--cm:${typeInfo(t.type).color}`}>
                <span class="tool-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[t.icon] ?? icons.calculator} />
                </span>
                <span class="tool-body">
                  <span class="tool-title">{t.name}</span>
                  <span class="tool-blurb">{t.blurb}</span>
                  <span class="dex-type">{T.typeLabel[t.type]}</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
