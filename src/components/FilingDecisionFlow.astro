---
/**
 * "나는 종합소득세를 신고해야 하나" 판단 흐름도.
 *
 * 경쟁 글들은 신고 대상을 "1) ... 2) ... 3) ..." 나열로 던진다. 읽는
 * 사람은 자기가 몇 번인지 스스로 골라야 하는데, 조건이 겹치면 판단이
 * 안 된다. 그래서 질문을 순서대로 따라가는 형태로 만들었다.
 *
 * SVG 대신 ol/li: 질문·답 문장이 길고, 스크린리더가 순서대로 읽어야
 * 하며, 좁은 화면에서 줄바꿈이 자유로워야 한다. 각진 네모로 통일한다.
 */
interface Step {
  q: string;
  /** 이 답이면 결론이 난다 */
  branches: { answer: string; result: string; verdict: "file" | "skip" | "next" }[];
}

const steps: Step[] = [
  {
    q: "사업소득(3.3%·8.8% 등이 떼인 소득)이 있었나요?",
    branches: [
      {
        answer: "있다",
        result:
          "신고 대상입니다. 3.3%는 예납이라 정산해야 하고, 환급이 있어도 신고해야 받습니다.",
        verdict: "file",
      },
      { answer: "없다", result: "다음 질문으로", verdict: "next" },
    ],
  },
  {
    q: "근로소득만 있고, 회사에서 연말정산을 마쳤나요?",
    branches: [
      {
        answer: "그렇다 (한 곳에서만 받았다)",
        result: "확정신고를 하지 않아도 되는 경우에 해당할 수 있습니다.",
        verdict: "skip",
      },
      {
        answer: "두 곳 이상에서 근로소득을 받았다",
        result: "합산해서 확정신고해야 합니다.",
        verdict: "file",
      },
      { answer: "근로소득이 없거나 연말정산을 안 했다", result: "다음 질문으로", verdict: "next" },
    ],
  },
  {
    q: "기타소득(강연료·원고료 등)만 있고, 그 합계가 300만원 이하인가요?",
    branches: [
      {
        answer: "그렇다",
        result:
          "원천징수로 끝낼지(분리과세) 합산신고할지 선택할 수 있습니다. 합산하면 환급이 나올 수도 있습니다.",
        verdict: "skip",
      },
      {
        answer: "300만원을 넘는다",
        result: "종합소득에 합산해 신고합니다.",
        verdict: "file",
      },
    ],
  },
];

const verdictLabel = {
  file: "신고",
  skip: "선택·제외",
  next: "계속",
} as const;
---

<figure class="chart-figure">
  <ol class="flow-tree">
    {
      steps.map((s, i) => (
        <li class="flow-node">
          <p class="flow-q">
            <span class="flow-num">{i + 1}</span>
            {s.q}
          </p>
          <ul class="flow-branches">
            {s.branches.map((b) => (
              <li class:list={["flow-branch", `is-${b.verdict}`]}>
                <span class="flow-answer">{b.answer}</span>
                <span class="flow-result">
                  <span class="flow-verdict">{verdictLabel[b.verdict]}</span>
                  {b.result}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
  <figcaption>
    위에서부터 답해 내려가면 됩니다. 소득이 여러 종류 섞여 있으면 가장 위에서
    걸리는 항목이 기준입니다. 개별 사안은 국세상담센터(126)나 세무
    전문가에게 확인하세요.
  </figcaption>
</figure>
