---
/**
 * 페이지 <head> 공통 메타 태그. charset·viewport·title·description·
 * canonical·OG. 각 페이지가 <head> 안에서 이 컴포넌트를 쓰고, 필요하면
 * 그 아래에 페이지 고유 태그(JSON-LD 등)를 추가한다.
 *
 * Clarity·AdSense 로더는 여기 포함하지 않는다 — 별도 컴포넌트(추후 작업)로
 * 나눠 이 컴포넌트를 "메타 태그"라는 단일 책임으로 유지한다.
 */
import { ogPathFor } from "../lib/og-pages";
import { ui, localeOf, LOCALES } from "../i18n/ui";
import { alternatesFor } from "../i18n/alternates";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유했을 때 나가는 그림. 글마다 굽는다(social/render-og.mjs).
// 절대 URL이어야 한다 — 상대 경로는 대부분의 플랫폼이 무시한다.
const ogImage = new URL(ogPathFor(Astro.url.pathname), Astro.site);
// 언어는 주소로 정한다(/ja/ 아래면 일본어). 같은 계산을 하는 다른 언어판이 있으면 서로 가리킨다
const locale = localeOf(Astro.url.pathname);
const T = ui(locale);
const alt = alternatesFor(Astro.url.pathname);
const altLinks = LOCALES.filter((l) => alt[l]).map((l) => ({ lang: l, href: new URL(alt[l]!, Astro.site).href }));
---

<meta charset="utf-8" />
<!-- 첫 그림 전에 고른 테마를 적용한다(깜빡임 방지). 규칙은 src/lib/theme.ts 와 같다. -->
<script is:inline>
  try { var t = localStorage.getItem("jp-theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0b5cad" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{altLinks.length > 1 && altLinks.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{altLinks.length > 1 && <link rel="alternate" hreflang="x-default" href={altLinks.find((a) => a.lang === "ko")!.href} />}
{locale === "ko" && <link rel="alternate" type="application/rss+xml" title="주포켓 — 세금 가이드" href="/rss.xml" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={T.brand} />
<meta property="og:locale" content={T.ogLocale} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />