---
/**
 * 페이지 <head> 공통 메타 태그. charset·viewport·title·description·
 * canonical·OG. 각 페이지가 <head> 안에서 이 컴포넌트를 쓰고, 필요하면
 * 그 아래에 페이지 고유 태그(JSON-LD 등)를 추가한다.
 *
 * Clarity·AdSense 로더는 여기 포함하지 않는다 — 별도 컴포넌트(추후 작업)로
 * 나눠 이 컴포넌트를 "메타 태그"라는 단일 책임으로 유지한다.
 */
import { ogPathFor } from "../lib/og";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 공유했을 때 나가는 그림. 글마다 굽는다(social/render-og.mjs).
// 절대 URL이어야 한다 — 상대 경로는 대부분의 플랫폼이 무시한다.
const ogImage = new URL(ogPathFor(Astro.url.pathname), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#0b5cad" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content="주포켓" />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />