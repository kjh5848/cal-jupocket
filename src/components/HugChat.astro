---
/**
 * HUG 전세보증 AI와 대화하기 — 채팅 화면(/jeonse-chat/ 전용, 2026-11-08).
 *
 * 레이아웃은 카카오톡 대화방 느낌(사용자 요청 2026-11-08): 위 막대 / 회청색 대화 배경 /
 * 도우미는 왼쪽 프로필 + 이름 + 흰 말풍선, 내 말은 오른쪽 노란 말풍선 / 아래 흰 입력 막대.
 * 이모지는 쓰지 않는다. 대화는 페이지가 그대로 스크롤된다(안쪽 스크롤 상자 없음).
 * 첫 인사는 "하려는 일"을 고르게 한다 — 가장 큰 버튼은 "계약 날짜로 할 일 뽑기" 하나(scripts/hug-chat.ts greet).
 * 비공식 고지("HUG 아님 · 비공식 안내")는 위 막대에 붙어 스크롤해도 남는다(docs/design/jeonse-chat-ux.md S2).
 * 상황 안내·용어·일정·보증 계산은 AI 없이 확인된 자료로, 그 밖의 글 질문만 AI(api.jupocket.com/api/hug-chat).
 * 일정 날짜는 이 브라우저에만 저장된다. 광고를 넣지 않는다.
 */
---

<div class="hc-app">
  <header class="hc-top">
    <a class="hc-back" href="/guide/hug-jeonse-checklist/" aria-label="전세 체크리스트 글 보기">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
    <div class="hc-head">
      <h1 class="hc-title">JU포켓 전세 도우미</h1>
      <p class="hc-tag">HUG 아님 · 비공식 안내</p>
    </div>
    <button type="button" class="hc-new" id="hc-reset" hidden>처음으로</button>
  </header>

  <main class="hc-main">
    <p class="hc-day">HUG·주택도시기금·법령 원문을 JU포켓이 확인해 답해요</p>
    <div class="hc-log" id="hc-log" role="log" aria-live="polite" aria-label="전세 도우미와 나눈 대화"></div>
  </main>

  <div class="hc-dock">
    <div class="hc-chips" id="hc-chips" hidden></div>
    <form class="hc-form" id="hc-form">
      <label class="sr-only" for="hc-q">전세 도우미에게 질문 적기</label>
      <input type="text" id="hc-q" maxlength="500" enterkeyhint="send" autocomplete="off" placeholder="궁금한 걸 적어 보세요. 예: 대항력이 뭐예요?" />
      <button type="submit" id="hc-go">전송</button>
    </form>
    <p class="hc-meta">날짜는 이 브라우저에만 저장돼요. 적은 질문은 이름 없이 보관되니 주소·이름은 적지 마세요 · <a href="/privacy/#ask-ai">개인정보</a></p>
  </div>
</div>

<script src="../scripts/hug-chat.ts"></script>

<style>
  /* 배치는 카카오톡 대화방, 색은 JU포켓 토큰(global.css) — 라이트·다크가 토큰으로 따라간다 */
  .hc-app {
    --chat-bg: var(--bg);
    --bubble: var(--surface);
    --bubble-text: var(--text);
    --me: var(--brand);
    --me-text: var(--surface);
    --bar: var(--surface);
    --bar-line: var(--rule);
    --sub: var(--muted);
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: var(--chat-bg);
    color: var(--bubble-text);
  }
  .sr-only,
  .hc-log :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hc-top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.75rem 0.4rem 0.25rem;
    background: var(--chat-bg);
  }
  .hc-back {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--bubble-text);
    border-radius: var(--r-sm);
  }
  .hc-head {
    flex: 1;
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    min-width: 0;
  }
  .hc-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
  }
  /* 비공식 고지 — 막대가 화면 위에 붙어 있어 어느 상태에서도 남는다. 경고색은 쓰지 않고 본문 글자색으로만 띄운다 */
  .hc-tag {
    margin: 0;
    padding: 0.1rem 0.5rem;
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1.4;
    color: var(--bubble-text);
    background: var(--bubble);
    border-radius: var(--r-pill);
  }
  .hc-new {
    position: relative;
    flex: none;
    min-height: 32px;
    padding: 0 0.8rem;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--bubble-text);
    background: color-mix(in srgb, var(--bubble) 70%, transparent);
    border: 0;
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  /* 보이는 크기는 32px, 누르는 자리는 44px */
  .hc-new::after {
    content: "";
    position: absolute;
    inset: -6px 0;
  }
  .hc-new[hidden] {
    display: none;
  }

  .hc-main {
    flex: 1;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0.5rem 0.75rem 1rem;
    box-sizing: border-box;
  }
  .hc-day {
    width: fit-content;
    margin: 0.25rem auto 1rem;
    padding: 0.25rem 0.8rem;
    font-size: var(--t-xs);
    text-align: center;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: var(--r-pill);
  }

  .hc-log {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }
  .hc-log :global(p) {
    margin: 0;
  }
  .hc-log :global(.hc-user) {
    justify-self: end;
    max-width: 78%;
    padding: 0.55rem 0.8rem;
    line-height: 1.5;
    color: var(--me-text);
    background: var(--me);
    border-radius: var(--r-lg);
    border-top-right-radius: var(--r-xs);
    overflow-wrap: anywhere;
  }
  .hc-log :global(.hc-bot) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
  }
  .hc-log :global(.hc-ava) {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--surface);
    background: var(--brand);
    border-radius: var(--r-lg);
  }
  .hc-log :global(.hc-col) {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .hc-log :global(.hc-name) {
    font-size: var(--t-xs);
    color: var(--sub);
  }
  .hc-log :global(.hc-body) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    justify-self: start;
    max-width: min(100%, 34rem);
    padding: 0.65rem 0.85rem;
    line-height: 1.65;
    color: var(--bubble-text);
    background: var(--bubble);
    border-radius: var(--r-lg);
    border-top-left-radius: var(--r-xs);
    overflow-wrap: anywhere;
  }
  .hc-log :global(.hc-body > p) {
    white-space: pre-line;
  }
  .hc-log :global(.hc-typing) {
    color: var(--sub);
  }
  .hc-log :global(.hc-sub) {
    font-weight: 700;
  }
  .hc-log :global(.hc-steps) {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.2rem;
  }
  .hc-log :global(.hc-opts) {
    display: grid;
    gap: 0.4rem;
  }
  .hc-log :global(.hc-opts button) {
    display: grid;
    align-content: center;
    gap: 0.1rem;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    font: inherit;
    text-align: left;
    color: var(--bubble-text);
    background: var(--surface-2);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .hc-log :global(.hc-opts button:hover) {
    background: var(--brand-wash);
  }
  /* 이 말풍선의 주인공 하나 — 크기·굵기·색으로만 앞세운다 */
  .hc-log :global(.hc-opts button.hc-opt-main),
  .hc-log :global(.hc-opts button.hc-opt-main:hover) {
    padding: 0.8rem 0.9rem;
    color: var(--me-text);
    background: var(--me);
  }
  .hc-log :global(.hc-opt-main b) {
    font-size: var(--t-lg);
    font-weight: 800;
  }
  .hc-log :global(.hc-opts .hc-opt-main small) {
    color: inherit;
  }
  /* 작게 두는 갈래 — 배경 없이 한 줄 */
  .hc-log :global(.hc-opts button.hc-opt-minor) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-content: center;
    gap: 0 0.5rem;
    padding: 0.3rem 0.8rem;
    background: transparent;
  }
  .hc-log :global(.hc-opts button.hc-opt-minor:hover) {
    background: var(--surface-2);
  }
  .hc-log :global(.hc-opt-minor b) {
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .hc-log :global(.hc-opts .hc-opt-minor small) {
    font-size: var(--t-xs);
  }
  .hc-log :global(.hc-opts b) {
    font-weight: 700;
  }
  .hc-log :global(.hc-opts small) {
    font-size: var(--t-sm);
    line-height: 1.45;
    color: var(--sub);
  }
  /* 지나간 말풍선의 고르기 버튼 — 눌리지 않고, 고른 것은 안쪽 테두리로 남는다 */
  .hc-log :global(.hc-opts button:disabled) {
    color: var(--muted);
    cursor: default;
  }
  .hc-log :global(.hc-opts button:disabled:hover) {
    background: var(--surface-2);
  }
  .hc-log :global(.hc-opts button.hc-opt-minor:disabled:hover) {
    background: transparent;
  }
  .hc-log :global(.hc-opts button.hc-opt-main:disabled:not([aria-pressed="true"])),
  .hc-log :global(.hc-opts button.hc-opt-main:disabled:not([aria-pressed="true"]):hover) {
    color: var(--muted);
    background: var(--surface-2);
  }
  .hc-log :global(.hc-opts button.hc-opt-main:disabled[aria-pressed="true"]) {
    color: var(--me-text);
  }
  .hc-log :global(.hc-opts button[aria-pressed="true"]:disabled) {
    color: var(--bubble-text);
    box-shadow: inset 0 0 0 2px var(--brand);
  }
  .hc-log :global(.hc-opts button.hc-opt-main[aria-pressed="true"]:disabled) {
    color: var(--me-text);
  }
  .hc-log :global(.hc-date) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hc-log :global(.hc-date input) {
    flex: 1 1 9rem;
    min-width: 0;
    min-height: 44px;
    padding: 0 0.7rem;
    font: inherit;
    font-size: max(16px, 1rem);
    color: var(--bubble-text);
    background: var(--bubble);
    border: 1px solid var(--bar-line);
    border-radius: var(--r-md);
  }
  .hc-log :global(.hc-date button),
  .hc-log :global(.hc-act) {
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-weight: 700;
    color: var(--me-text);
    background: var(--me);
    border: 0;
    border-radius: var(--r-md);
    cursor: pointer;
  }
  .hc-log :global(.hc-act-inline) {
    justify-self: start;
  }
  .hc-log :global(.hc-date input[aria-invalid="true"]) {
    border-color: var(--chart-loss);
  }
  /* 입력 오류 — 색만으로 알리지 않게 굵기도 올린다 */
  .hc-log :global(.hc-err) {
    font-size: var(--t-sm);
    font-weight: 600;
    line-height: 1.5;
    color: var(--chart-loss);
  }
  .hc-log :global(.hc-err[hidden]) {
    display: none;
  }
  .hc-log :global(.hc-act-off) {
    justify-self: start;
    min-height: 44px;
    padding: 0 0.8rem;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--sub);
    background: transparent;
    border: 1px solid var(--bar-line);
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  /* 일정 결과 — 위에서 아래로: 넣은 날짜(작게) · 가장 먼저 할 일(가장 크게) · 그다음 할 일(접힘) */
  .hc-log :global(.hc-dates) {
    display: grid;
    gap: 0.2rem;
  }
  .hc-log :global(.hc-dates ul) {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hc-log :global(.hc-dates li) {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr) auto;
    column-gap: 0.5rem;
    align-items: center;
    min-height: 2.25rem;
    border-top: 1px solid var(--bar-line);
    font-size: var(--t-sm);
  }
  .hc-log :global(.hc-dates li:first-child) {
    border-top: 0;
  }
  .hc-log :global(.hc-dk) {
    color: var(--sub);
  }
  .hc-log :global(.hc-dv) {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  /* 글자 버튼 — 보이는 높이는 줄에 맞추고 누르는 자리는 44px */
  .hc-log :global(.hc-mini) {
    min-height: 44px;
    margin-block: -0.4rem;
    padding: 0 0.6rem;
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--link);
    background: transparent;
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .hc-log :global(.hc-dates-more) {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    margin-left: -0.6rem;
  }
  .hc-log :global(.hc-dates-more .hc-mini:last-child) {
    color: var(--sub);
    font-weight: 400;
  }
  .hc-log :global(.hc-summary) {
    display: grid;
    gap: 0.3rem;
    padding: 0.7rem 0.8rem;
    background: var(--brand-wash);
    border-radius: var(--r-md);
  }
  .hc-log :global(.hc-first-when) {
    font-size: var(--t-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .hc-log :global(.hc-first-title) {
    font-size: var(--t-lg);
    font-weight: 800;
    line-height: 1.35;
  }
  .hc-log :global(.hc-plan) {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hc-log :global(.hc-plan li) {
    display: grid;
    border-top: 1px solid var(--bar-line);
  }
  .hc-log :global(.hc-plan li:first-child) {
    border-top: 0;
  }
  /* 전역 details(테두리 상자·바깥 여백)는 글 속 접이식용 — 대화 안에서는 줄로만 쓴다 */
  .hc-log :global(.hc-item details),
  .hc-log :global(.hc-pastbox) {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
  }
  .hc-log :global(.hc-item details[open] > summary),
  .hc-log :global(.hc-pastbox[open] > summary) {
    margin-bottom: 0;
  }
  .hc-log :global(.hc-item summary),
  .hc-log :global(.hc-pastbox > summary) {
    font-size: var(--t-md);
    font-weight: 400;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.35rem 0;
    cursor: pointer;
    list-style: none;
  }
  .hc-log :global(.hc-item summary::-webkit-details-marker),
  .hc-log :global(.hc-pastbox > summary::-webkit-details-marker) {
    display: none;
  }
  .hc-log :global(.hc-item summary::after),
  .hc-log :global(.hc-pastbox > summary::after) {
    content: "";
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.2rem;
    border-right: 2px solid var(--sub);
    border-bottom: 2px solid var(--sub);
    transform: rotate(45deg);
    transition: transform 150ms ease-out;
  }
  .hc-log :global(details[open] > summary::after) {
    transform: rotate(-135deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-log :global(.hc-item summary::after),
    .hc-log :global(.hc-pastbox > summary::after) {
      transition: none;
    }
  }
  .hc-log :global(.hc-sum-t) {
    display: grid;
    gap: 0.05rem;
    min-width: 0;
  }
  .hc-log :global(.hc-sum-t span) {
    font-weight: 600;
  }
  .hc-log :global(.hc-what) {
    padding-bottom: 0.25rem;
  }
  .hc-log :global(.hc-item details > .hc-note) {
    padding-bottom: 0.5rem;
  }
  .hc-log :global(.hc-item .hc-warn) {
    margin-bottom: 0.5rem;
  }
  /* 지난 일은 흐리게 두지 않고 접는다. 펴면 흐린 글자색 토큰(투명도 0.5는 대비가 3:1 안팎이라 쓰지 않는다) */
  .hc-log :global(.hc-pastbox) {
    color: var(--muted);
    border-top: 1px solid var(--bar-line);
  }
  .hc-log :global(.hc-pastbox > summary) {
    font-size: var(--t-sm);
  }
  .hc-log :global(.hc-acts) {
    display: grid;
    gap: 0.4rem;
  }
  .hc-log :global(.hc-act.hc-act-sub) {
    color: var(--bubble-text);
    background: var(--surface-2);
  }
  /* 알림 > 캘린더 > 보내기 — 가장 약한 버튼은 채움 없이 가는 테두리만 */
  .hc-log :global(.hc-act.hc-act-ghost) {
    color: var(--link);
    font-weight: 600;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--bar-line);
  }
  /* 계산 결과 맨 아래의 글자 버튼 */
  .hc-log :global(.hc-share-link) {
    justify-self: start;
    min-height: 44px;
    margin-left: -0.3rem;
    padding: 0.3rem 0.3rem;
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 600;
    text-align: left;
    color: var(--link);
    background: transparent;
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  /* 도움이 됐나요 — 결과 본문 아래 가는 선으로 나눈 한 줄. 두 버튼은 같은 크기·같은 무게, 건너뛰기가 가장 약하다 */
  .hc-log :global(.hc-fb) {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--bar-line);
  }
  .hc-log :global(.hc-fb-q) {
    font-size: var(--t-sm);
    font-weight: 700;
  }
  .hc-log :global(.hc-fb-btns) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }
  .hc-log :global(.hc-fb-btn),
  .hc-log :global(.hc-pick) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.3rem 0.8rem;
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 600;
    line-height: 1.35;
    color: var(--bubble-text);
    background: var(--surface-2);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .hc-log :global(.hc-pick) {
    justify-content: flex-start;
    justify-self: start;
    font-weight: 500;
    text-align: left;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--bar-line);
    border-radius: var(--r-pill);
  }
