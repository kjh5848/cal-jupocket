---
/**
 * HUG 전세보증 AI와 대화하기 — 채팅 화면(/jeonse-chat/ 전용, 2026-11-08).
 *
 * 레이아웃은 카카오톡 대화방 느낌(사용자 요청 2026-11-08): 위 막대 / 회청색 대화 배경 /
 * 도우미는 왼쪽 프로필 + 이름 + 흰 말풍선, 내 말은 오른쪽 노란 말풍선 / 아래 흰 입력 막대.
 * 이모지는 쓰지 않는다. 대화는 페이지가 그대로 스크롤된다(안쪽 스크롤 상자 없음).
 * 첫 인사는 "하려는 일"을 고르게 한다 — 가장 큰 버튼은 "계약 날짜로 할 일 뽑기" 하나(scripts/hug-chat.ts greet).
 * 비공식 고지("HUG 아님 · 비공식 안내")는 위 막대에 붙어 스크롤해도 남는다(docs/design/jeonse-chat-ux.md S2).
 * 상황 안내·용어·일정·보증 계산은 AI 없이 확인된 자료로, 그 밖의 글 질문만 AI(api.jupocket.com/api/hug-chat).
 * 일정 날짜는 이 브라우저에만 저장된다. 광고를 넣지 않는다.
 */
---

<div class="hc-app">
  <header class="hc-top">
    <a class="hc-back" href="/guide/hug-jeonse-checklist/" aria-label="전세 체크리스트 글 보기">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
    <div class="hc-head">
      <h1 class="hc-title">JU포켓 전세 도우미</h1>
      <p class="hc-tag">HUG 아님 · 비공식 안내</p>
    </div>
    <button type="button" class="hc-new" id="hc-reset" hidden>처음으로</button>
  </header>

  <main class="hc-main">
    <p class="hc-day">HUG·주택도시기금·법령 원문을 JU포켓이 확인해 답해요</p>
    <div class="hc-log" id="hc-log" role="log" aria-live="polite" aria-label="전세 도우미와 나눈 대화"></div>
  </main>

  <div class="hc-dock">
    <div class="hc-chips" id="hc-chips" hidden></div>
    <form class="hc-form" id="hc-form">
      <label class="sr-only" for="hc-q">전세 도우미에게 질문 적기</label>
      <input type="text" id="hc-q" maxlength="500" enterkeyhint="send" autocomplete="off" placeholder="궁금한 걸 적어 보세요. 예: 대항력이 뭐예요?" />
      <button type="submit" id="hc-go">전송</button>
    </form>
    <p class="hc-meta">날짜는 이 브라우저에만 저장돼요. 적은 질문은 이름 없이 보관되니 주소·이름은 적지 마세요 · <a href="/privacy/#ask-ai">개인정보</a></p>
  </div>
</div>

<script src="../scripts/hug-chat.ts"></script>

<style>
  /* 배치는 카카오톡 대화방, 색은 JU포켓 토큰(global.css) — 라이트·다크가 토큰으로 따라간다 */
  .hc-app {
    --chat-bg: var(--bg);
    --bubble: var(--surface);
    --bubble-text: var(--text);
    --me: var(--brand);
    --me-text: var(--surface);
    --bar: var(--surface);
    --bar-line: var(--rule);
    --sub: var(--muted);
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: var(--chat-bg);
    color: var(--bubble-text);
  }
  .sr-only,
  .hc-log :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hc-top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.75rem 0.4rem 0.25rem;
    background: var(--chat-bg);
  }
  .hc-back {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--bubble-text);
    border-radius: var(--r-sm);
  }
  .hc-head {
    flex: 1;
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    min-width: 0;
  }
  .hc-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
  }
  /* 비공식 고지 — 막대가 화면 위에 붙어 있어 어느 상태에서도 남는다. 경고색은 쓰지 않고 본문 글자색으로만 띄운다 */
  .hc-tag {
    margin: 0;
    padding: 0.1rem 0.5rem;
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1.4;
    color: var(--bubble-text);
    background: var(--bubble);
    border-radius: var(--r-pill);
  }
  .hc-new {
    position: relative;
    flex: none;
    min-height: 32px;
    padding: 0 0.8rem;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--bubble-text);
    background: color-mix(in srgb, var(--bubble) 70%, transparent);
    border: 0;
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  /* 보이는 크기는 32px, 누르는 자리는 44px */
  .hc-new::after {
    content: "";
    position: absolute;
    inset: -6px 0;
  }
  .hc-new[hidden] {
    display: none;
  }

  .hc-main {
    flex: 1;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0.5rem 0.75rem 1rem;
    box-sizing: border-box;
  }
  .hc-day {
    width: fit-content;
    margin: 0.25rem auto 1rem;
    padding: 0.25rem 0.8rem;
    font-size: var(--t-xs);
    text-align: center;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: var(--r-pill);
  }

  .hc-log {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }
  .hc-log :global(p) {
    margin: 0;
  }
  .hc-log :global(.hc-user) {
    justify-self: end;
    max-width: 78%;
    padding: 0.55rem 0.8rem;
    line-height: 1.5;
    color: var(--me-text);
    background: var(--me);
    border-radius: var(--r-lg);
    border-top-right-radius: var(--r-xs);
    overflow-wrap: anywhere;
  }
  .hc-log :global(.hc-bot) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
  }
  .hc-log :global(.hc-ava) {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--surface);
    background: var(--brand);
    border-radius: var(--r-lg);
  }
  .hc-log :global(.hc-col) {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .hc-log :global(.hc-name) {
    font-size: var(--t-xs);
    color: var(--sub);
  }
  .hc-log :global(.hc-body) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    justify-self: start;
    max-width: min(100%, 34rem);
    padding: 0.65rem 0.85rem;
    line-height: 1.65;
    color: var(--bubble-text);
    background: var(--bubble);
    border-radius: var(--r-lg);
    border-top-left-radius: var(--r-xs);
    overflow-wrap: anywhere;
  }
  .hc-log :global(.hc-body > p) {
    white-space: pre-line;
  }
  .hc-log :global(.hc-typing) {
    color: var(--sub);
  }
  .hc-log :global(.hc-sub) {
    font-weight: 700;
  }
  .hc-log :global(.hc-steps) {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.2rem;
  }
  .hc-log :global(.hc-opts) {
    display: grid;
    gap: 0.4rem;
  }
  .hc-log :global(.hc-opts button) {
    display: grid;
    align-content: center;
    gap: 0.1rem;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    font: inherit;
    text-align: left;
    color: var(--bubble-text);
    background: var(--surface-2);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .hc-log :global(.hc-opts button:hover) {
    background: var(--brand-wash);
  }
  /* 이 말풍선의 주인공 하나 — 크기·굵기·색으로만 앞세운다 */
  .hc-log :global(.hc-opts button.hc-opt-main),
  .hc-log :global(.hc-opts button.hc-opt-main:hover) {
    padding: 0.8rem 0.9rem;
    color: var(--me-text);
    background: var(--me);
  }
  .hc-log :global(.hc-opt-main b) {
    font-size: var(--t-lg);
    font-weight: 800;
  }
  .hc-log :global(.hc-opts .hc-opt-main small) {
    color: inherit;
  }
  /* 작게 두는 갈래 — 배경 없이 한 줄 */
  .hc-log :global(.hc-opts button.hc-opt-minor) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-content: center;
    gap: 0 0.5rem;
    padding: 0.3rem 0.8rem;
    background: transparent;
  }
  .hc-log :global(.hc-opts button.hc-opt-minor:hover) {
    background: var(--surface-2);
  }
  .hc-log :global(.hc-opt-minor b) {
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .hc-log :global(.hc-opts .hc-opt-minor small) {
    font-size: var(--t-xs);
  }
  .hc-log :global(.hc-opts b) {
    font-weight: 700;
  }
  .hc-log :global(.hc-opts small) {
    font-size: var(--t-sm);
    line-height: 1.45;
    color: var(--sub);
  }
  .hc-log :global(.hc-date) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hc-log :global(.hc-date input) {
    flex: 1 1 9rem;
    min-width: 0;
    min-height: 44px;
    padding: 0 0.7rem;
    font: inherit;
    font-size: max(16px, 1rem);
    color: var(--bubble-text);
    background: var(--bubble);
    border: 1px solid var(--bar-line);
    border-radius: var(--r-md);
  }
  .hc-log :global(.hc-date button),
  .hc-log :global(.hc-act) {
    min-height: 44px;
    padding: 0 1rem;
    font: inherit;
    font-weight: 700;
    color: var(--me-text);
    background: var(--me);
    border: 0;
    border-radius: var(--r-md);
    cursor: pointer;
  }
  .hc-log :global(.hc-act-inline) {
    justify-self: start;
  }
  .hc-log :global(.hc-date input[aria-invalid="true"]) {
    border-color: var(--chart-loss);
  }
  /* 입력 오류 — 색만으로 알리지 않게 굵기도 올린다 */
  .hc-log :global(.hc-err) {
    font-size: var(--t-sm);
    font-weight: 600;
    line-height: 1.5;
    color: var(--chart-loss);
  }
  .hc-log :global(.hc-err[hidden]) {
    display: none;
  }
  .hc-log :global(.hc-act-off) {
    justify-self: start;
    min-height: 44px;
    padding: 0 0.8rem;
    font: inherit;
    font-size: var(--t-sm);
    color: var(--sub);
    background: transparent;
    border: 1px solid var(--bar-line);
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  .hc-log :global(.hc-summary) {
    padding: 0.6rem 0.75rem;
    background: var(--brand-wash);
    border-radius: var(--r-md);
  }
  .hc-log :global(.hc-plan) {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hc-log :global(.hc-plan li) {
    display: grid;
    gap: 0.05rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--bar-line);
  }
  .hc-log :global(.hc-plan li:first-child) {
    border-top: 0;
  }
  .hc-log :global(.hc-plan li.hc-next b) {
    color: var(--brand);
  }
  /* 지난 일 — 투명도(0.5)는 대비가 3:1 안팎으로 떨어진다. 흐린 글자색 토큰으로 가라앉힌다 */
  .hc-log :global(.hc-plan li.hc-past) {
    color: var(--muted);
  }
  .hc-log :global(.hc-warn) {
    margin-top: 0.2rem;
    padding: 0.35rem 0.55rem;
    font-size: var(--t-sm);
    line-height: 1.5;
    background: var(--accent-bg);
    border-radius: var(--r-sm);
  }
  .hc-log :global(.hc-warn strong) {
    font-weight: 800;
  }
  .hc-log :global(.hc-checks) {
    display: grid;
    gap: 0.45rem;
    margin: 0.4rem 0;
    padding-left: 1.1rem;
  }
  .hc-log :global(.hc-checks small) {
    display: block;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .hc-log :global(.hc-plan b) {
    font-size: var(--t-sm);
    color: var(--sub);
    font-variant-numeric: tabular-nums;
  }
  .hc-log :global(dl) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 0.8rem;
    margin: 0;
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
  }
  .hc-log :global(dt) {
    color: var(--sub);
  }
  .hc-log :global(dd) {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .hc-log :global(.hc-src) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: var(--t-xs);
    color: var(--sub);
  }
  .hc-log :global(.hc-src a),
  .hc-log :global(.hc-read a) {
    color: var(--link);
  }
  .hc-log :global(.hc-read) {
    display: grid;
    gap: 0.3rem;
    padding-top: 0.55rem;
    font-size: var(--t-sm);
    border-top: 1px solid var(--bar-line);
  }
  .hc-log :global(.hc-read-h) {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--sub);
  }
  .hc-log :global(.hc-ex) {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.75rem;
    font-size: var(--t-sm);
    line-height: 1.6;
    background: var(--surface-2);
    border-radius: var(--r-sm);
  }
  .hc-log :global(.hc-ex-h) {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--brand);
  }
  .hc-log :global(.hc-note) {
    font-size: var(--t-xs);
    color: var(--sub);
  }

  .hc-dock {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: grid;
    gap: 0.45rem;
    padding-top: 0.5rem;
    background: linear-gradient(to bottom, transparent, var(--chat-bg) 0.6rem);
  }
  .hc-chips {
    display: flex;
    gap: 0.4rem;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 0.75rem;
    box-sizing: border-box;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .hc-chips::-webkit-scrollbar {
    display: none;
  }
  .hc-chips[hidden] {
    display: none;
  }
  .hc-chips :global(button) {
    flex: none;
    min-height: 44px;
    padding: 0 0.9rem;
    font: inherit;
    font-size: var(--t-sm);
    white-space: nowrap;
    color: var(--bubble-text);
    background: var(--bubble);
    border: 1px solid var(--bar-line);
    border-radius: var(--r-pill);
    cursor: pointer;
  }
  .hc-chips :global(button.hc-primary) {
    font-weight: 700;
    color: var(--me-text);
    background: var(--me);
    border-color: var(--me);
  }
  .hc-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    background: var(--bar);
    border-top: 1px solid var(--bar-line);
  }
  /* 입력칸은 테두리가 없어 초점 고리 대신 막대 윗선을 브랜드색 2px 로 바꿔 알린다 */
  .hc-form:focus-within {
    border-top-color: var(--brand);
    box-shadow: inset 0 1px 0 var(--brand);
  }
  .hc-form input::placeholder {
    color: var(--sub);
    opacity: 1;
  }
  .hc-form input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    text-overflow: ellipsis;
    padding: 0;
    font: inherit;
    font-size: max(16px, 1rem);
    color: var(--bubble-text);
    background: transparent;
    border: 0;
    outline: none;
  }
  .hc-form button {
    flex: none;
    min-height: 44px;
    padding: 0 0.95rem;
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--me-text);
    background: var(--me);
    border: 0;
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .hc-form button:disabled {
    opacity: 0.45;
  }
  .hc-meta {
    margin: -0.45rem 0 0;
    padding: 0 0.9rem calc(0.4rem + env(safe-area-inset-bottom, 0px));
    font-size: var(--t-xs);
    color: var(--sub);
    background: var(--bar);
  }
  .hc-meta a {
    color: inherit;
  }

  /* 초점 표시 — 버튼은 global.css 의 고리(3px --link)를 그대로 받고, 링크와 날짜·금액 칸도 같은 고리로 맞춘다.
     눌렀을 때 들어가는 느낌(scale 0.96)도 global.css 의 button:active 가 맡는다 */
  .hc-app :global(a:focus-visible),
  .hc-log :global(.hc-date input:focus-visible) {
    outline: 3px solid var(--link);
    outline-offset: 2px;
  }
</style>
