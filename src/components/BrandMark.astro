---
/**
 * 주포켓 마크 — 주머니에 ₩.
 *
 * 같은 그림이 헤더·파비콘·카드 아트보드·OG 이미지에 따로 그려져 있었고,
 * 그래서 허브에는 주머니 없이 ₩ 글자만 들어가 있었다. 웹에서 쓰는 곳은
 * 전부 이 컴포넌트를 쓴다.
 *
 * 색은 currentColor 를 따른다 — 감싸는 쪽에서 color 만 정하면 된다.
 */
interface Props {
  /** 가로 크기(px). */
  size?: number;
  /**
   * 여백을 걷어낸 viewBox 를 쓴다.
   *
   * 그림은 64 격자 안에서 y 24~54 에만 있어서 위쪽 37.5% 가 비어 있다.
   * 헤더처럼 작게 쓸 때는 티가 안 나지만 크게 키우면 마크가 아래로
   * 가라앉아 보인다. 크게 쓰는 자리에서는 이걸 켠다.
   */
  tight?: boolean;
  class?: string;
}
const { size = 28, tight = false, class: cls = "" } = Astro.props;

// 실측 경계 x 12~52, y 24~54 에 선 굵기(3.5)의 절반씩 여유를 준다.
const VIEW = tight ? "10 22 44 34" : "0 0 64 64";
const ratio = tight ? 34 / 44 : 1;
---

<svg
  class={cls}
  viewBox={VIEW}
  width={size}
  height={Math.round(size * ratio)}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  <path d="M12 24 L32 32 L52 24"></path>
  <path d="M12 24 L12 50 Q12 54 16 54 L48 54 Q52 54 52 50 L52 24"></path>
  <text
    x="32"
    y="49"
    text-anchor="middle"
    font-size="17"
    font-weight="600"
    fill="currentColor"
    stroke="none">₩</text>
</svg>
