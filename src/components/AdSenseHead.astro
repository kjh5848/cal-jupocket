---
/**
 * 애드센스 로더 스크립트. <head>에 넣는다.
 *
 * PUBLISHER_ID는 계정 단위 값이라 jupocket.com 계열 사이트 전체에서 동일하다.
 * 광고 단위(slot)는 사이트별로 새로 만들어야 하며, AdSlot.astro가 slot이
 * 비어 있을 때 요청을 보내지 않는 것으로 처리한다.
 *
 * 주의 — 아직 어떤 페이지에도 연결하지 않는다. ClarityHead와 달리 이 컴포넌트는
 * 빈 값일 때 안전하게 무동작하는 가드가 없다 — PUBLISHER_ID가 있으면 무조건
 * 실제 구글 애드센스 로더를 실행한다. cal.jupocket.com은 아직 애드센스에
 * 사이트로 등록되지 않았으므로(Task 10에서 등록), 지금 연결하면 미등록
 * 서브도메인에서 실제 광고 네트워크 요청이 나가 계정에 문제가 될 수 있다.
 * Task 10에서 사이트 등록을 마친 뒤 각 페이지 <head>에 연결한다.
 */
export const PUBLISHER_ID = "ca-pub-5677538881877371";
---

<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUBLISHER_ID}`}
  crossorigin="anonymous"></script>
