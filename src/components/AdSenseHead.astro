---
/**
 * 애드센스 로더 스크립트. <head>에 넣는다.
 *
 * PUBLISHER_ID는 계정 단위 값이라 jupocket.com 계열 사이트 전체에서 동일하다.
 * 광고 단위(slot)는 사이트별로 새로 만들어야 하며, AdSlot.astro가 slot이
 * 비어 있을 때 요청을 보내지 않는 것으로 처리한다. slot ID가 생기기 전까지는
 * 로더만 실행되고 실제 광고 요청은 나가지 않는다.
 *
 * 값은 data/adsense.ts 가 갖는다 — ads.txt 도 같은 값을 써야 해서
 * 여기 적어두면 반드시 한쪽이 낡는다.
 */
import { PUBLISHER_ID } from "../data/adsense";
export { PUBLISHER_ID };
---

<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUBLISHER_ID}`}
  crossorigin="anonymous"></script>
