---
/**
 * 애드센스 로더 스크립트. <head>에 넣는다.
 *
 * PUBLISHER_ID는 계정 단위 값이라 jupocket.com 계열 사이트 전체에서 동일하다.
 * 광고 단위(slot)는 사이트별로 새로 만들어야 하며, AdSlot.astro가 slot이
 * 비어 있을 때 요청을 보내지 않는 것으로 처리한다.
 *
 * 주의 — 아직 어떤 페이지에도 연결하지 않는다. 지금 연결해도 로더 스크립트만
 * 실행될 뿐 실제 광고 요청은 나가지 않는다(광고 요청은 AdSlot의 push()가
 * 만드는데 현재 모든 slot이 비어 있다) — 그래서 지금 연결해도 득이 없다.
 * cal.jupocket.com이 애드센스에 사이트로 등록되고(Task 10) 실제 slot ID가
 * 생기면 그때 어차피 각 페이지 <head>를 다시 손대야 하므로, 지금 미리
 * 연결해봐야 나중에 또 건드리는 중복 작업만 된다. Task 10에서 등록·slot
 * 발급 후 한 번에 연결한다.
 */
export const PUBLISHER_ID = "ca-pub-5677538881877371";
---

<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUBLISHER_ID}`}
  crossorigin="anonymous"></script>
