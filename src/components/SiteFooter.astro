---
/**
 * 사이트 공통 푸터. 모든 페이지 맨 아래에 같은 모양으로 들어간다.
 * 연도는 하드코딩하지 않고 빌드 시점 연도를 쓴다.
 *
 * 계정 링크는 data/social.ts 에서 온다. 아직 글이 없는 계정(live: false)은
 * 여기 나오지 않는다 — 빈 계정으로 보내면 신뢰가 깎인다.
 *
 * 일본어판은 한국어 계정·카드뉴스 링크를 걸지 않는다 — 읽을 수 없는 곳으로 보내는 셈이다.
 */
import { liveSocials } from "../data/social";
import { ui, localeOf } from "../i18n/ui";

const year = new Date().getFullYear();
const locale = localeOf(Astro.url.pathname);
const T = ui(locale);
---

<footer class="site-footer">
  <nav class="site-footer-nav" aria-label="Site">
    {locale === "ko" && <a href="/cards/">{T.navCards}</a>}
    <a href="/privacy/">{T.privacy}</a>
    {
      locale === "ko" &&
        liveSocials.map((s) => (
          <a href={s.url} rel="me noopener" target="_blank">
            {s.label}
          </a>
        ))
    }
  </nav>
  <p class="site-footer-note">{T.footerNote}</p>
  <p class="site-footer-copy">© {year} {T.footerCopy}</p>
</footer>
