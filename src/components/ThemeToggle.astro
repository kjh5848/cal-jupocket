---
import { ui, localeOf } from "../i18n/ui";
const T = ui(localeOf(Astro.url.pathname));
/**
 * 테마 전환 버튼 — 누를 때마다 라이트 → 다크 → 기기 설정. 설계 6-5.
 * 처음 그림의 data-theme 는 BaseHead 인라인 스크립트가 이미 정했다. 여기서는 버튼 상태만 맞춘다.
 */
---

<button type="button" class="theme-toggle" data-state="system" aria-label={T.themeAria(T.themeLabel.system, T.themeLabel.light)}>
  <svg data-icon="light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg data-icon="dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
  <svg data-icon="system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
</button>

<script src="../scripts/theme-toggle.ts"></script>
