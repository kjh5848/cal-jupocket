---
/* 합친 글 섹션 — 원래 /guide/withholding-receipt/#withholding-receipt-vs-income-certificate (2026-11-07, scripts/merge/merge-group.mjs) */
/**
 * "원천징수영수증 소득금액증명원 차이" — 원천징수영수증 시리즈.
 * 확인한 쪽은 원천징수영수증(소득세법 제143조·제144조·제146조 — 돈을 준 쪽이 발급)뿐이다.
 * 소득금액증명의 법적 근거는 읽지 않아, '누가 발급하나' 수준의 차이만 쓰고 나머지는 밝힌다.
 */
import w from "../../../rates/withholding-receipt-2026.json";

const title = "원천징수영수증 소득금액증명원 차이 — 회사가 주는 것과 세무서가 확인해 주는 것";
const description =
  "원천징수영수증은 세금을 떼고 소득을 준 회사·거래처가 발급하는 서류이고, 소득금액증명원은 세무서(국세청)가 신고된 소득을 확인해 주는 증명입니다. 발급하는 쪽과 담긴 범위가 다릅니다.";

const ANSWER = "원천징수영수증은 회사·거래처가 '내가 얼마 주고 얼마 뗐다'고 적어 주는 서류이고, 소득금액증명원은 세무서가 '이 사람 소득이 이만큼으로 신고됐다'고 확인해 주는 증명입니다. 한 곳의 지급 내역이냐, 신고된 소득 전체냐가 다릅니다.";

const QA = [
  { q: "원천징수영수증과 소득금액증명원은 무엇이 다른가요?", a: "발급하는 쪽이 다릅니다. 원천징수영수증은 소득을 준 원천징수의무자가 발급할 의무를 지는 서류이고(소득세법 제143조 등), 소득금액증명원은 세무서(국세청)에 신청해 받는 증명입니다." },
  { q: "원천징수영수증에는 어떤 소득이 담기나요?", a: "그 회사나 거래처가 준 소득과 뗀 세금만 담깁니다. 두 곳에서 일했다면 영수증도 두 장이고, 연말정산을 합쳤다면 주된 근무지의 영수증에 합친 결과가 담깁니다." },
  { q: "어떤 서류를 내야 할지 모르겠으면 어떻게 하나요?", a: "요구하는 곳이 정한 서류를 냅니다. 둘은 서로 대신할 수 있는 같은 서류가 아니라서, 은행·관공서가 어느 쪽을 요구하는지 먼저 확인하는 편이 빠릅니다." },
];
---
  <h3>{QA[0].q}</h3>
  <p class="qa-lead">{QA[0].a}</p>
  <table>
    <thead><tr><th>&nbsp;</th><th>원천징수영수증</th><th>소득금액증명원</th></tr></thead>
    <tbody>
      <tr><th scope="row">발급하는 쪽</th><td>소득을 준 회사·거래처</td><td>세무서(국세청)</td></tr>
      <tr><th scope="row">담기는 범위</th><td>그 지급처가 준 소득과 뗀 세금</td><td>신고된 소득</td></tr>
      <tr><th scope="row">근거</th><td>소득세법 제143조·제144조·제146조</td><td>이 글에서 확인하지 않음</td></tr>
    </tbody>
  </table>

  <h3>{QA[1].q}</h3>
  <p class="qa-lead">{QA[1].a}</p>
  <h3>{QA[2].q}</h3>
  <p class="qa-lead">{QA[2].a}</p>
