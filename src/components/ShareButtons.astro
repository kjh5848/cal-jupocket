---
/**
 * 경량 공유 버튼 — 외부 SDK/스크립트 없음(요청 0).
 *  - 링크 복사(clipboard), 네이티브 공유(navigator.share, 미지원 시 복사로 폴백)
 *  - X·페이스북은 순수 a href(공유 URL), 클릭 시에만 새 창
 * 카카오 리치공유는 SDK가 필요해 제외한다(네이티브 공유가 모바일 카톡 커버).
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
const xHref = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`;
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
---

<div class="share" data-share-title={title}>
  <button type="button" class="share-btn" id="share-native" aria-label="공유하기">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line><line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line></svg>
    <span>공유</span>
  </button>
  <button type="button" class="share-btn" id="share-copy" aria-label="링크 복사">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12a3 3 0 0 1 3-3h4a3 3 0 0 1 0 6h-2"></path><path d="M15 12a3 3 0 0 1-3 3H8a3 3 0 0 1 0-6h2"></path></svg>
    <span id="share-copy-label">링크 복사</span>
  </button>
  <a class="share-btn" href={xHref} target="_blank" rel="noopener noreferrer" aria-label="X에 공유">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3l7 9-7 9h2.2l5.9-7.6L17.8 21H21l-7.3-9.4L20.6 3h-2.2l-5.5 7.1L7 3z"></path></svg>
  </a>
  <a class="share-btn" href={fbHref} target="_blank" rel="noopener noreferrer" aria-label="페이스북에 공유">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5h2V6h-2.2C11.8 6 11 7.2 11 8.8V10H9v2.5h2V21h2.6v-8.5H16l.4-2.5h-2.8V9c0-.4.2-.5.6-.5z"></path></svg>
  </a>
</div>

<script>
  const box = document.querySelector<HTMLElement>(".share");
  if (box) {
    const title = box.dataset.shareTitle || document.title;
    const nativeBtn = document.getElementById("share-native");
    const copyBtn = document.getElementById("share-copy");
    const copyLabel = document.getElementById("share-copy-label");

    if (!(navigator as any).share) nativeBtn?.setAttribute("hidden", "");

    nativeBtn?.addEventListener("click", async () => {
      try {
        await (navigator as any).share({ title, url: location.href });
      } catch {
        /* 취소/미지원 무시 */
      }
    });

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        if (copyLabel) {
          const prev = copyLabel.textContent;
          copyLabel.textContent = "복사됨";
          setTimeout(() => (copyLabel.textContent = prev), 1600);
        }
      } catch {
        /* 무시 */
      }
    });
  }
</script>
