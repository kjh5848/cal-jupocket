---
/**
 * 가이드 글 옆(데스크톱) / 아래(모바일) 관련 콘텐츠 사이드바.
 *
 * 같은 클러스터의 계산기·글을 data/clusters.ts에서 뽑아 보여준다.
 * 계산기는 배지로 구분하고, 각진 네모 스타일로 통일한다. 클러스터에
 * 속하지 않는 경로면 아무것도 렌더하지 않는다.
 */
import { relatedFor } from "../data/clusters";

interface Props {
  path: string;
}
const { path } = Astro.props;
const related = relatedFor(path);
---

{
  related && (
    <aside class="related" aria-labelledby="related-heading">
      <p id="related-heading" class="related-heading">
        <span class="related-kicker">함께 보기</span>
        {related.title}
      </p>
      <ul class="related-list">
        {related.links.map((l) => (
          <li class:list={["related-item", `is-${l.kind}`]}>
            <a href={l.href}>
              {l.kind === "calc" && <span class="related-badge">계산기</span>}
              <span class="related-link-text">{l.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
