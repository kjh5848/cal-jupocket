---
/**
 * 측정 로더 — GA4(gtag.js)와 네이버 애널리틱스(wcslog.js). <head>에 넣는다.
 *
 * GTM 을 거치지 않고 직접 붙인다. 이 사이트는 배포가 git push 한 번이라
 * "코드 없이 태그 추가" 라는 GTM 의 이점이 거의 없는 반면, 로더가 하나
 * 더 붙고 GTM 에서 '게시'를 빠뜨리면 조용히 수집이 멈추는 비용은 그대로다.
 *
 * define:vars 를 쓰지 않는다. 그러면 Astro 가 스크립트를 블록으로 감싸고,
 * 블록 안의 function 선언은 전역에 올라가지 않는다. 페이지뷰는 dataLayer
 * 큐로 처리돼서 멀쩡히 수집되지만 window.gtag 가 없어, 나중에
 * gtag("event", …) 를 부르는 순간 터진다. 실제로 그렇게 나갔다가 고쳤다.
 *
 * 측정 ID가 비었거나 형식이 틀리면 아무것도 렌더하지 않는다 — 틀린 ID로
 * 스크립트만 부르면 무게만 늘고 데이터는 안 쌓이는데, 그걸 한참 뒤에야
 * 알게 된다.
 */
import {
  GA4_MEASUREMENT_ID,
  GA4_ENABLED,
  NAVER_ANALYTICS_ID,
  NAVER_ENABLED,
} from "../data/analytics";

const boot = `
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
window.gtag = gtag;
gtag("js", new Date());
gtag("config", ${JSON.stringify(GA4_MEASUREMENT_ID)});
`.trim();

/**
 * 네이버 애널리틱스(wcslog.js).
 *
 * 네이버가 주는 코드는 </body> 앞에 동기 스크립트로 붙이라고 한다. 그대로
 * <head> 에 넣으면 렌더를 막는다. 그래서 wcs_add 를 먼저 정해 두고 로더를
 * async 로 부른 뒤, 다 받으면 onload 에서 wcs_do() 를 호출한다. 네이버 원문의
 * `if(window.wcs) wcs_do()` 는 로더가 동기일 때만 맞는 코드라, async 로 바꾸면서
 * 그 줄을 그대로 두면 아무것도 수집되지 않는다.
 *
 * GA 와 같은 컴포넌트에 둔 이유: 수집 범위를 GA 와 똑같이 맞추려고. 이
 * 컴포넌트가 빠진 페이지(낱장 아트보드·디자인 참조)는 둘 다 수집하지 않는다.
 */
const naverBoot = `if(!window.wcs_add) window.wcs_add = {}; wcs_add["wa"] = ${JSON.stringify(NAVER_ANALYTICS_ID)};`;
---

{
  GA4_ENABLED && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
      />
      <script is:inline set:html={boot} />
    </>
  )
}
{
  NAVER_ENABLED && (
    <>
      <script is:inline set:html={naverBoot} />
      <script
        is:inline
        async
        src="https://wcs.pstatic.net/wcslog.js"
        onload="window.wcs && wcs_do();"
      />
    </>
  )
}
