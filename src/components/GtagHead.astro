---
/**
 * GA4 로더(gtag.js). <head>에 넣는다.
 *
 * GTM 을 거치지 않고 직접 붙인다. 이 사이트는 배포가 git push 한 번이라
 * "코드 없이 태그 추가" 라는 GTM 의 이점이 거의 없는 반면, 로더가 하나
 * 더 붙고 GTM 에서 '게시'를 빠뜨리면 조용히 수집이 멈추는 비용은 그대로다.
 *
 * 측정 ID가 비어 있거나 형식이 틀리면 아무것도 렌더하지 않는다 — 잘못된
 * ID로 스크립트만 부르는 것은 무게만 늘리고 데이터는 안 쌓인다.
 */
import { GA4_MEASUREMENT_ID, GA4_ENABLED } from "../data/analytics";
---

{
  GA4_ENABLED && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
      />
      <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());
        gtag("config", GA4_MEASUREMENT_ID);
      </script>
    </>
  )
}
