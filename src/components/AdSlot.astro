---
import { PUBLISHER_ID } from "./AdSenseHead.astro";
import { slotFor } from "../data/adsense";

/**
 * 개별 광고 단위.
 *
 * 자리는 label 이 정한다(`guide-…-mid`, `…-result`). 어느 광고 단위를 쓸지는
 * data/adsense.ts 의 slotFor 가 라벨 꼬리를 보고 고른다 — 페이지마다 slot ID
 * 를 적어두면 40군데가 되고, 단위를 바꿀 때 한 곳이 반드시 남는다.
 *
 * slot 을 직접 넘기면 그걸 쓴다. 둘 다 없으면 자리표시자만 그리고 광고
 * 요청은 나가지 않는다.
 */
interface Props {
  slot?: string;
  label?: string;
}

const { slot: given, label } = Astro.props;
const slot = given ?? slotFor(label);
---

{
  slot ? (
    <div class="ad-slot" data-ad={label}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={PUBLISHER_ID}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  ) : (
    <div class="ad-slot" data-ad={label} data-ad-pending="true" />
  )
}
