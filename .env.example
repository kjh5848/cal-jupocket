# 네이버 검색광고 API — 키워드도구 절대 검색량 조회용
#
# 실제 값은 이 파일이 아니라 .env 에 넣는다 (.env 는 .gitignore 로 커밋 안 됨).
# 토큰을 chat 에 붙여넣지 말 것 — .env 파일에만 둔다.
# 배포 Worker 에서 쓸 경우엔 `wrangler secret put <NAME>` 으로 넣는다.
#
# 검색광고 → 도구 → API 사용 관리에서 발급되는 3개 값:
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ── Threads API (Meta 개발자 앱) — 소셜 업로드 자동화 ─────────
# 설정 순서는 social/README.md 참고.
#
# App Dashboard > Threads > 설정 의 값. Threads 유스케이스 앱은 ID·시크릿이
# 두 쌍 나오는데, 일반 앱 것이 아니라 Threads 전용 값을 써야 한다.
THREADS_APP_ID=
THREADS_APP_SECRET=

# App Dashboard 에 등록한 리다이렉트 URI 와 글자 하나까지 같아야 한다.
THREADS_REDIRECT_URI=https://jupocket.com/oauth/threads/

# 아래 3개는 `npm run social:auth` 가 자동으로 채운다. 비워둘 것.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_REFRESHED_AT=

# ── Instagram (같은 Meta 앱의 Instagram 이용 사례) ───────────
# App Dashboard > 이용 사례 > Instagram >
# "Instagram 로그인이 포함된 API 설정" > 2. 액세스 토큰 생성 > 계정 추가
# 에서 발급받은 토큰을 넣는다. 아래 두 개는 `npm run ig:setup` 이 채운다.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_REFRESHED_AT=

# ── Google 검색·분석 읽기 (npm run seo) ──────────────────────
# 비밀키는 .env 가 아니라 .secrets/google.json 에 둔다(둘 다 gitignore).
#
# 준비: GCP 프로젝트에서 Google Analytics Data API 와
# Google Search Console API 를 사용 설정하고, 서비스 계정을 만들어
# JSON 키를 .secrets/google.json 으로 저장한다. 그 서비스 계정 주소를
#   GA4  > 관리 > 속성 액세스 관리   에 '뷰어'로
#   GSC  > 설정 > 사용자 및 권한     에 '전체'로
# 추가해야 조회가 된다. 권한이 없으면 빈 결과로 보여서 헷갈린다.
#
# GA4 속성 ID 는 측정 ID(G-...)가 아니라 숫자다.
# GA4 > 관리 > 속성 설정, 또는 주소창 .../pNNNNNNNNN/... 의 숫자.
GA4_PROPERTY_ID=

# `npm run seo -- --check` 가 접근 가능한 속성 목록을 찍어준다. 그중 하나.
# 도메인 속성이면 sc-domain:example.com, URL 접두어면 https://example.com/
GSC_SITE_URL=
