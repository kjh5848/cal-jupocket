# 네이버 검색광고 API — 키워드도구 절대 검색량 조회용
#
# 실제 값은 이 파일이 아니라 .env 에 넣는다 (.env 는 .gitignore 로 커밋 안 됨).
# 토큰을 chat 에 붙여넣지 말 것 — .env 파일에만 둔다.
# 배포 Worker 에서 쓸 경우엔 `wrangler secret put <NAME>` 으로 넣는다.
#
# 검색광고 → 도구 → API 사용 관리에서 발급되는 3개 값:
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ── Threads API (Meta 개발자 앱) — 소셜 업로드 자동화 ─────────
# 설정 순서는 social/README.md 참고.
#
# App Dashboard > Threads > 설정 의 값. Threads 유스케이스 앱은 ID·시크릿이
# 두 쌍 나오는데, 일반 앱 것이 아니라 Threads 전용 값을 써야 한다.
THREADS_APP_ID=
THREADS_APP_SECRET=

# App Dashboard 에 등록한 리다이렉트 URI 와 글자 하나까지 같아야 한다.
THREADS_REDIRECT_URI=https://jupocket.com/oauth/threads/

# 아래 3개는 `npm run social:auth` 가 자동으로 채운다. 비워둘 것.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_REFRESHED_AT=
